# ──────────────────────────────────────────────────────────────────────────────
# Development environment – uses your own external Keycloak instance.
# Copy to .env.local to override these values without committing secrets.
#
# Vite loads .env.development automatically when running `npm run dev`.
# ──────────────────────────────────────────────────────────────────────────────

# Point to your own Keycloak instance running on localhost
VITE_KEYCLOAK_URL=http://localhost:8080
VITE_KEYCLOAK_REALM=warehouse
VITE_KEYCLOAK_CLIENT=warehouse-app

# Backend API (dotnet run starts on port 5000 in Development)
# Note: must be VITE_API_URL to match src/shared/services/api.ts
VITE_API_URL=http://localhost:5000
