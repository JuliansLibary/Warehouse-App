<file path="WarehouseApp/nAG.Warehouse.App.LabelGenerator/controller/warehouseController.js">
 1: const SL = require("@nag/servicelayerconnector");
 2: const { getError, generateBasicAuth, getInstance } = require("../controller/utilsController.js");
 3: async function getWarehouses(req, res) {
 4:   try {
 5:     const instance = await getInstance();
 6:     const authHeaders = await generateBasicAuth(req.headers, req.params.tenant);
 7:     SL.GET(
 8:       "Warehouses?$select=WarehouseCode,WarehouseName,EnableBinLocations",
 9:       null,
10:       authHeaders,
11:       {
12:         retryTimes: 2,
13:         retryDelay: 750,
14:         SLURL: instance.SLURL,
15:         SLPort: instance.SLPort,
16:       },
17:       async (errorWarehouse, warehousesResponse) => {
18:         if (errorWarehouse) {
19:           console.error("Error fetching warehouses:", errorWarehouse);
20:           res.status(errorWarehouse.httpStatusCode || 500).send(await getError(errorWarehouse));
21:         } else {
22:           res.status(200).send(warehousesResponse.value || []);
23:         }
24:       }
25:     );
26:   } catch (error) {
27:     console.error("Error in getWarehouses:", error);
28:     res.status(500).send({
29:       body: {
30:         message: "Failed to retrieve warehouses: " + error.message,
31:         helpUrl: null
32:       }
33:     });
34:   }
35: }
36: async function getBinLocations(req, res) {
37:   try {
38:     const { warehouseCode, tenant } = req.params;
39:     if (!warehouseCode) {
40:       return res.status(400).send({
41:         error: {
42:           message: "WarehouseCode is required",
43:           errorcode: "MISSING_WAREHOUSE_CODE"
44:         }
45:       });
46:     }
47:     const instance = await getInstance();
48:     const auth = await generateBasicAuth(req.headers, tenant);
49:     // Direct SL.GET call like in checkcodeController
50:     const queryURL = `SQLQueries('AvailableBinLocations2')/List?WhsCode='${warehouseCode}'`;
51:     SL.GET(
52:       queryURL,
53:       null,
54:       auth,
55:       {
56:         retryTimes: 2,
57:         retryDelay: 750,
58:         SLURL: instance.SLURL,
59:         SLPort: instance.SLPort,
60:       },
61:       async (error, response) => {
62:         if (error) {
63:           return res.status(error.httpStatusCode || 500).send(await getError(error));
64:         }
65:         // Transform result to match expected format
66:         const binLocations = response.value || [];
67:         const transformedResult = binLocations.map(item => ({
68:           BinCode: item.BinCode,
69:           BinName: item.BinDescription,
70:           WhsCode: item.WhsCode,
71:           AbsEntry: item.AbsEntry
72:         }));
73:         return res.status(200).send(transformedResult);
74:       }
75:     );
76:   } catch (error) {
77:     res.status(500).send({
78:       error: {
79:         message: "Failed to retrieve bin locations: " + error.message,
80:         errorcode: "BIN_LOCATION_ERROR"
81:       }
82:     });
83:   }
84: }
85: module.exports = {
86:   getWarehouses,
87:   getBinLocations,
88: };
