198:     getUrlVars: function () {
199:       var vars = {},
200:         parts = window.location.href.replace(/[?&]+([^=&]+)=([^&#]*)/gi, function (m, key, value) {
201:           vars[key] = value;
202:         });
203:       return vars;
204:     },
205:     setViewModel: function (oModel, sName) {
206:       return this.getView().setModel(oModel, sName);
207:     },
208:     getViewModel: function (sName) {
209:       return this.getView().getModel(sName);
210:     },
211:     getAppConfig: function () {
212:       var that = this,
213:         pickmode = null,
214:         listmode = null;
215:       $.ajax({
216:         url: "businesslogic/AppConfig",
217:         crossDomain: true,
