<file path="WarehouseApp/nAG.Warehouse.App.Pack/webapp/model/formatter.js">
  1: sap.ui.define(["sap/ui/model/type/Currency"], function (Currency) {
  2:   "use strict";
  3:   return {
  4:     /**
  5:      * COMPREHENSIVE QUANTITY FORMATTERS
  6:      * =================================
  7:      * Enhanced formatters that work with the new quantity management system
  8:      */
  9:     /**
 10:      * Formats the packed vs total picked quantity display (e.g., "3/4" packed)
 11:      * This is the main display formatter for fragments and dialogs
 12:      * 
 13:      * @public
 14:      * @param {number} iPickedQuantity - Total picked quantity from picking
 15:      * @param {number} iPackedQuantity - Currently packed quantity
 16:      * @returns {string} formatted display like "3/4" 
 17:      */
 18:     formatPackedVsTotal: function (iPickedQuantity, iPackedQuantity) {
 19:       const iTotalPicked = parseInt(iPickedQuantity, 10) || 0;
 20:       const iPacked = parseInt(iPackedQuantity, 10) || 0;
 21:       return `${iPacked}/${iTotalPicked}`;
 22:     },
 23:     /**
 24:      * Formats remaining quantity that can still be packed in current session
 25:      * 
 26:      * @public
 27:      * @param {number} iPickedQuantity - Total picked quantity
 28:      * @param {number} iPackedQuantity - Currently packed quantity  
 29:      * @returns {number} remaining quantity
 30:      */
 31:     formatRemainingToPack: function (iPickedQuantity, iPackedQuantity) {
 32:       const iTotalPicked = parseInt(iPickedQuantity, 10) || 0;
 33:       const iPacked = parseInt(iPackedQuantity, 10) || 0;
 34:       return Math.max(0, iTotalPicked - iPacked);
 35:     },
 36:     /**
 37:      * Formats progress percentage for packed items
 38:      * 
 39:      * @public
 40:      * @param {number} iPickedQuantity - Total picked quantity
 41:      * @param {number} iPackedQuantity - Currently packed quantity
 42:      * @returns {number} percentage (0-100)
 43:      */
 44:     formatPackingProgress: function (iPickedQuantity, iPackedQuantity) {
 45:       const iTotalPicked = parseInt(iPickedQuantity, 10) || 0;
 46:       const iPacked = parseInt(iPackedQuantity, 10) || 0;
 47:       if (iTotalPicked === 0) return 0;
 48:       return Math.round((iPacked / iTotalPicked) * 100);
 49:     },
 50:     /**
 51:      * Determines if item is fully packed (for UI state)
 52:      * 
 53:      * @public
 54:      * @param {number} iPickedQuantity - Total picked quantity
 55:      * @param {number} iPackedQuantity - Currently packed quantity
 56:      * @returns {boolean} true if fully packed
 57:      */
 58:     formatIsFullyPacked: function (iPickedQuantity, iPackedQuantity) {
 59:       const iTotalPicked = parseInt(iPickedQuantity, 10) || 0;
 60:       const iPacked = parseInt(iPackedQuantity, 10) || 0;
 61:       return iPacked >= iTotalPicked && iTotalPicked > 0;
 62:     },
 63:     /**
 64:      * LEGACY FORMATTERS (UPDATED)
 65:      * ===========================
 66:      * Existing formatters updated to use consistent calculation
 67:      */
 68:     /**
