<file path="WarehouseApp/nAG.Warehouse.App.AdminPanel/middleware/configCheck.js">
 1: let http = require("http");
 2: async function configCheck(req, res, next) {
 3:   try {
 4:     const result = await getConfiguration("AdminPanel", req.headers.referer, req.headers);
 5:     if (result === 200) {
 6:       next(); // Proceed to the route handler
 7:     } else if (result === 403 || result === 404 || result === 423) {
 8:       res.sendStatus(result); // Send the appropriate status if configuration fails
 9:     }
10:   } catch (error) {
11:     // Handle any unexpected errors (e.g., if getConfiguration throws an error)
12:     console.error(error);
13:     res.sendStatus(500);
14:   }
15: }
16: function getConfiguration(module, referer, headers) {
17:   return new Promise((resolve, reject) => {
18:     // Extract tenant from headers
19:     let url;
20:     try {
21:       url = new URL(referer);
22:     } catch (error) {
23:       resolve(200);
24:     }
25:     const tenant = url.searchParams.get("Tenant");
26:     if (tenant == null || tenant == "null") {
27:       resolve(200);
28:     } else {
29:       const configUrl = `http://Module-AdminPanel.warehouseapp:8005/databaseConfiguration/configurationForModule/${module}/${tenant}`;
30:       http
31:         .get(configUrl, (response) => {
32:           let rawData = "";
33:           // Collect data chunks
34:           response.on("data", (chunk) => {
35:             rawData += chunk;
36:           });
37:           // Process data after the end of the response
38:           response.on("end", () => {
39:             try {
40:               if (response.statusCode === 423) {
41:                 return resolve(response.statusCode);
42:               }
43:               // Parse JSON response
44:               const parsedData = JSON.parse(rawData);
45:               // Update global configuration if available
46:               if (parsedData.conf_config && parsedData.conf_config !== "{}") {
47:                 const config = JSON.parse(parsedData.conf_config.replace(/\\/g, ""));
48:                 Object.entries(config).forEach(([key, value]) => {
49:                   global.gConfig[key] = value;
50:                 });
51:               }
52:               resolve(response.statusCode);
53:             } catch (e) {
54:               reject(new Error(`Failed to parse configuration data: ${e.message}`));
55:             }
56:           });
57:         })
58:         .on("error", (e) => {
59:           reject(new Error(`Request error: ${e.message}`));
60:         });
61:     }
62:   });
63: }
64: module.exports = configCheck;
</file>

