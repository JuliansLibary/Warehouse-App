192: /**
193:  * Process package lines with comprehensive validation
194:  * @param {Object} req - Express request object
195:  * @param {Object} res - Express response object
196:  */
197: async function processPackageLine(req, res) {
198:   try {
199:     const { packageContext, modelContext, batchLine, deliveryData } = req.body;
200:     // Validate complete item information
201:     const object = modelContext;
202:     if (!object.ItemCode || !object.ItemDescription) {
203:       return res.status(400).send({
204:         message: "Incomplete item information",
205:         code: 400,
206:         skipped: true
207:       });
208:     }
209:     // Process the package line
210:     let updatedDeliveryData = JSON.parse(JSON.stringify(deliveryData));
211:     const packageNum = packageContext.packageIndex;
212:     const pack = updatedDeliveryData.Package;
213:     // Find or create delivery line
214:     let found = false;
215:     for (let j = 0; j < pack[packageNum].DeliveryLines.length; j++) {
216:       const deliveryLine = pack[packageNum].DeliveryLines[j];
217:       if (isMatchingItem(deliveryLine, object)) {
218:         found = true;
219:         if (object.ManageSerialNumbers === "N") {
220:           const quantityDifference = object.PackedQuantity - object.PreviouslyPackedQuantity;
221:           deliveryLine.PackedQuantity += quantityDifference;
222:         } else if (object.ManageSerialNumbers === "Y") {
223:           const serialsForPackage = object.SerialNumbers?.filter((serial) => 
224:             parseInt(serial.Package) === parseInt(packageNum)) || [];
225:           if (serialsForPackage.length > 0) {
226:             if (!deliveryLine.SerialNumbers) deliveryLine.SerialNumbers = [];
227:             serialsForPackage.forEach(newSerial => {
228:               const exists = deliveryLine.SerialNumbers.some(existingSerial => 
229:                 (existingSerial.SerialNumber || existingSerial.DistNumber) === 
230:                 (newSerial.SerialNumber || newSerial.DistNumber)
231:               );
232:               if (!exists) {
233:                 deliveryLine.SerialNumbers.push(newSerial);
234:               }
235:             });
236:             deliveryLine.PackedQuantity = deliveryLine.SerialNumbers.length;
237:           }
238:         }
239:         if (batchLine !== null) {
240:           addBatchToPackage(packageNum, batchLine, j, object, updatedDeliveryData);
241:         }
242:         break;
243:       }
244:     }
245:     // Create new delivery line if not found
246:     if (!found && isValidForNewLine(object)) {
247:       const newLine = createCleanItemClone(object);
248:       const quantityDifference = object.PackedQuantity - object.PreviouslyPackedQuantity;
249:       if (object.ManageSerialNumbers === "N" && quantityDifference > 0) {
250:         newLine.PackedQuantity = quantityDifference;
251:         pack[packageNum].DeliveryLines.push(newLine);
252:       } else if (object.ManageSerialNumbers === "Y") {
253:         const serialsForPackage = object.SerialNumbers?.filter((serial) => 
254:           parseInt(serial.Package) === parseInt(packageNum)) || [];
255:         if (serialsForPackage.length > 0) {
256:           newLine.SerialNumbers = serialsForPackage;
257:           newLine.PackedQuantity = serialsForPackage.length;
258:           pack[packageNum].DeliveryLines.push(newLine);
259:         }
260:       }
261:     }
262:     // Clean up empty lines
263:     cleanupEmptyDeliveryLines(updatedDeliveryData, packageNum);
264:     res.send({
265:       updatedDeliveryData,
266:       processed: true,
267:       timestamp: new Date().toISOString()
