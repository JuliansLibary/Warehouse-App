 766:     if (line.DocumentLinesBinAllocations && line.DocumentLinesBinAllocations.length > 0) {
 767:       // Falls Serial- oder Batchnummern vorhanden sind, weisen wir den Bin Allocations fortlaufende Indizes zu.
 768:       if (serialOrBatchExists) {
