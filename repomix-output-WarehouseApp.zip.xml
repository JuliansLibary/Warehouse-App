 86:     try {
 87:       const updateCriteria = {
 88:         itemCode: request.params.itemCode,
 89:         tenantId: request.params.tenantId,
 90:       };
 91:       const result = await this.itemDataRepository.update(
 92:         updateCriteria,
 93:         request.body
 94:       );
