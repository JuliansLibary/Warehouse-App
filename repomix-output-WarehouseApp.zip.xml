<file path="WarehouseApp/nAG.Warehouse.App.Proxy/metrics.js">
  1: "use strict";
  2: const metrics = {
  3:   startedAt: Date.now(),
  4:   totals: { requests: 0, errors: 0 },
  5:   targets: new Map(), // key: Ziel-URL, value: TargetMetrics
  6: };
  7: /**
  8:  * Struktur einer Target-Metrik:
  9:  * {
 10:  *   target: string,                 // Ziel-URL (z. B. http://Module-Pack.warehouseapp:8116)
 11:  *   requests: number,               // Gesamtanzahl Requests
 12:  *   errors: number,                 // Gesamtanzahl Fehler (5xx)
 13:  *   inflight: number,               // Aktuell laufende Requests
 14:  *   window: Array<{t:number,ms:number,ok:boolean}>, // Samples der letzten 5 Min
 15:  *   rolling: { avgMs1m:number, avgMs5m:number },    // Gleitende Ø-Dauern
 16:  *   lastUpdate: number              // Zeitstempel letzte Aktualisierung
 17:  * }
 18:  */
 19: function getTargetMetrics(targetUrl) {
 20:   let eintrag = metrics.targets.get(targetUrl);
 21:   if (!eintrag) {
 22:     eintrag = {
 23:       target: targetUrl,
 24:       requests: 0,
 25:       errors: 0,
 26:       inflight: 0,
 27:       window: [],
 28:       rolling: { avgMs1m: 0, avgMs5m: 0 },
 29:       lastUpdate: Date.now(),
 30:     };
 31:     metrics.targets.set(targetUrl, eintrag);
 32:   }
 33:   return eintrag;
 34: }
 35: // Routing Sample für Monitoring
 36: function pushSampleToTarget(targetMetrics, sample) {
 37:   const jetzt = Date.now();
 38:   targetMetrics.window.push(sample);
 39:   const cutoff5m = jetzt - 5 * 60 * 1000;
 40:   while (targetMetrics.window.length && targetMetrics.window[0].t < cutoff5m) {
 41:     targetMetrics.window.shift();
 42:   }
 43:   // durchschnittliche Dauer 1 Min / 5 Min berechnen
 44:   const cutoff1m = jetzt - 60 * 1000;
 45:   let sum1 = 0,
 46:     n1 = 0,
 47:     sum5 = 0,
 48:     n5 = 0;
 49:   for (const s of targetMetrics.window) {
 50:     if (s.t >= cutoff1m) {
 51:       sum1 += s.ms;
 52:       n1++;
 53:     }
 54:     sum5 += s.ms;
 55:     n5++;
 56:   }
 57:   targetMetrics.rolling.avgMs1m = n1 ? sum1 / n1 : 0;
 58:   targetMetrics.rolling.avgMs5m = n5 ? sum5 / n5 : 0;
 59:   targetMetrics.lastUpdate = jetzt;
 60: }
 61: /**
 62:  * Globaler Request-Test
 63:  * - Vor allen Routen mounten
 64:  * - Misst Dauer jedes Requests
 65:  * - Erhöht globale Request-Zahl
 66:  */
 67: function requestTapMiddleware(req, res, next) {
 68:   const startNs = process.hrtime.bigint();
 69:   metrics.totals.requests++;
 70:   res.on("finish", () => {
 71:     const dauerMs = Number(process.hrtime.bigint() - startNs) / 1e6;
 72:     const zielUrl = res.locals && res.locals.__proxyTargetUrl;
 73:     if (!zielUrl) return;
 74:     const ziel = getTargetMetrics(zielUrl);
 75:     if (ziel.inflight > 0) ziel.inflight--;
 76:     if (res.statusCode >= 500) {
 77:       ziel.errors++;
 78:       metrics.totals.errors++;
 79:     }
 80:     pushSampleToTarget(ziel, {
 81:       t: Date.now(),
 82:       ms: dauerMs,
 83:       ok: res.statusCode < 500,
 84:     });
 85:   });
 86:   next();
 87: }
 88: function markProxyRequest(res, targetUrl) {
 89:   const ziel = getTargetMetrics(targetUrl);
 90:   ziel.requests++;
 91:   ziel.inflight++;
 92:   res.locals.__proxyTargetUrl = targetUrl;
 93: }
 94: function markProxyResponse(res) {
 95:   const zielUrl = res.locals && res.locals.__proxyTargetUrl;
 96:   if (!zielUrl) return;
 97:   const ziel = getTargetMetrics(zielUrl);
 98:   if (ziel.inflight > 0) ziel.inflight--;
 99: }
100: // Fehler zählen
101: function markProxyError(res) {
102:   const zielUrl = res.locals && res.locals.__proxyTargetUrl;
103:   if (!zielUrl) return;
104:   const ziel = getTargetMetrics(zielUrl);
105:   if (ziel.inflight > 0) ziel.inflight--;
106:   ziel.errors++;
107:   metrics.totals.errors++;
108: }
109: module.exports = {
110:   metrics,
111:   requestTapMiddleware,
112:   markProxyRequest,
113:   markProxyResponse,
114:   markProxyError,
115: };
</file>

