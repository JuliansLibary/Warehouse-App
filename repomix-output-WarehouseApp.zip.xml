<file path="WarehouseApp/nAG.Warehouse.App.InfoPoint/webapp/BaseController.js">
  1: /*global history */
  2: /* eslint-disable no-console */
  3: /* eslint no-unused-expressions: ["error", { "allowShortCircuit": true }]*/
  4: sap.ui.define([
  5:   "sap/ui/core/mvc/Controller",
  6:   "sap/ui/core/EventBus",
  7:   "sap/ui/core/routing/History",
  8:   "sap/ui/model/json/JSONModel",
  9:   "sap/ui/Device",
 10:   "sap/m/MessageBox"
 11: ], function (Controller, EventBus, History, JSONModel, Device, MessageBox) {
 12:   return Controller.extend("nag.WarehouseApp.InfoPoint.BaseController", {
 13:     /**
 14:      * Convenience method for saving the BaseController in a global variable and creating fields that need to be accessed
 15:      * @public
 16:      */
 17:     register: function () {
 18:       this.oEventBus = sap.ui.getCore().getEventBus();
 19:       $.sap.control = this;
 20:       this.oEventBus.subscribe("nAG", "showBusyDialog", this.showBusyDialog, this);
 21:       this.oEventBus.subscribe("nAG", "hideBusyDialog", this.hideBusyDialog, this);
 22:       this.oEventBus.subscribe("nAG", "changeAppView", this.changeAppViewLayout, this);
 23:       this.oEventBus.subscribe("nAG", "getAppView", this.getViewElement, this);
 24:     },
 25:     /**
 26:      *
 27:      * @param {String} method: Can be at nAG: POST,PATCH,GET
 28:      * @param {String} url:  url for the ajax Call
 29:      * @param {JSON} postContent : JSON Body for a patch/post
 30:      * @param {String} i18n : String for a call of the error dialogue via i18n
 31:      * @param {JSON} callback :  Returns a JSON after a successful Ajax call. Can be further used in the frontend
 32:      * NOTE: No IF is needed to build the postContent dynamically for the AJAX. With a GET, the postContent is not transferred to the backend.
 33:      */
 34:     makeAjaxRequest: function (method, url, postContent, i18n, callback) {
 35:       var that = this;
 36:       $.ajax({
 37:         url: url,
 38:         xhrFields: {
 39:           withCredentials: true
 40:         },
 41:         data: postContent,
 42:         crossDomain: true,
 43:         type: method,
 44:         tryCount: 0,
 45:         retryLimit: 3,
 46:         headers: {
 47:           "prefer": "odata.maxpagesize=0"
 48:         },
 49:         success: function (response, status, xhr) {
 50:           callback(response);
 51:         },
 52:         error: function (jqXHR, textStatus) {
 53:           if (textStatus === 'timeout') {
 54:             this.tryCount++;
 55:             if (this.tryCount <= this.retryLimit) {
 56:               $.ajax(this);
 57:               return;
 58:             } else {
 59:               that.showError(
 60:                 "NetworkError",
 61:                 "9000"
 62:               );
 63:             }
 64:           }
 65:           if (typeof jqXHR.responseText !== "undefined") {
 66:             that.showError(i18n, jqXHR.responseText, jqXHR.status);
 67:           } else {
 68:             that.showError(i18n, jqXHR.responseText, jqXHR.status);
 69:           }
 70:         }
 71:       });
 72:     },
 73:     /**
 74:      * Convenience method for accessing the router in every controller of the application.
 75:      * @public
 76:      * @returns {sap.ui.core.routing.Router} the router for this component
 77:      */
 78:     getRouter: function () {
 79:       this.getDebugMode() && console.log("BASE GET ROUTER");
 80:       return sap.ui.core.UIComponent.getRouterFor(this);
 81:     },
 82:     /**
 83:      * Convenience method for getting the view model by name in every controller of the application.
 84:      * @public
 85:      * @param {string} sName the model name
 86:      * @returns {sap.ui.model.Model} the model instance
 87:      */
 88:     getModel: function (sName) {
 89:       this.getDebugMode() && console.log("BASE GET MODEL: " + sName);
 90:       return sap.ui.getCore().getModel(sName);
 91:     },
 92:     /**
 93:      * Convenience method for setting the view model in every controller of the application.
 94:      * @public
 95:      * @param {sap.ui.model.Model} oModel the model instance
 96:      * @param {string} sName the model name
 97:      * @returns {sap.ui.mvc.View} the view instance
 98:      */
 99:     setModel: function (oModel, sName) {
100:       return sap.ui.getCore().setModel(oModel, sName);
101:     },
102:     /**
103:      * Convenience method for getting the resource bundle.
104:      * @public
105:      * @returns {sap.ui.model.resource.ResourceModel} the resourceModel of the component
106:      */
107:     getResourceBundle: function () {
108:       return this.getOwnerComponent().getModel("i18n").getResourceBundle();
109:     },
110:     /**
111:      * Event handler for navigating back.
112:      * It there is a history entry we go one step back in the browser history
113:      * If not, it will replace the current entry of the browser history with the master route.
114:      * @public
115:      */
116:     onNavBack: function () {
117:       this.getDebugMode() && console.log("onNavBack");
118:       var sPreviousHash = History.getInstance().getPreviousHash();
119:       if (sPreviousHash !== undefined) {
120:         history.go(-1);
121:       } else {
122:         this.getRouter().navTo("Orders", {}, false);
123:       }
124:     },
125:     /**
126:      * Convenience method for setting Debugmode
127:      */
128:     setDebugMode: function (boolean) {
129:       var debugMode = boolean;
130:       $.sap.debugMode = debugMode;
131:     },
132:     /**
133:      * Convenience method for  getting Debugmode
134:      */
135:     getDebugMode: function () {
136:       return $.sap.debugMode;
137:     },
138:     /**
139:      * Convenience method for saving the BusyDialog in a global variable
140:      * @public
141:      */
142:     getBusyDialog: function () {
143:       var busyDialog = sap.ui.xmlfragment("busyDialog", "nag.WarehouseApp.InfoPoint.view.BusyDialog", this);
144:       this.getView().addDependent(busyDialog);
145:       this.busyDialog = busyDialog;
146:     },
147:     /**
148:      * Convenience method for opening the BusyDialog
149:      * @public
150:      */
151:     showBusyDialog: function () {
152:       this.getDebugMode() && console.log("busy dialog opened");
153:       var busyDialog = this.busyDialog;
154:       busyDialog.open();
155:     },
156:     /**
157:      * Convenience method for closing the BusyDialog
158:      * @public
159:      */
160:     hideBusyDialog: function () {
161:       this.getDebugMode() && console.log("busy dialog closed");
162:       var busyDialog = this.busyDialog;
163:       busyDialog.close();
164:     },
165:     /**
166:      * Convenience method for getting the count of a value 'val' inside a jsons property 'prop'
167:      * @public
168:      * @returns int
169:      */
170:     getCount: function (json, prop, val) {
171:       var count = 0;
172:       for (var i = 0; i < json.length; i++) {
173:         if (json[i][prop] === val) {
174:           count++;
175:         }
176:       }
177:       return count;
178:     },
179:     /**
180:      * showError(i18nFehlermeldung, zusätzlicheInformation, Fehlercode)
181:      */
182:      showError: function (i18nInfo, extraInfo, errorCode) {
183:       this.oEventBus.publish("nAG", "hideBusyDialog");
184:       var that = this,
185:         errorText = this.getMessage(i18nInfo),
186:         saperror = "",
187:         details = "",
188:         errorTextn = "",
189:         errorTitle = errorCode,
190:         bCompact = !!this.getView().$().closest(".sapUiSizeCompact").length;
191:       if (errorCode === 403) {
192:         errorTitle = this.getMessage("errorTitle");
193:         saperror = this.getMessage("saperror");
194:         extraInfo = this.getMessage("extraInfo");
195:         errorTextn = this.getMessage("errorTextn");
196:       }
197:       errorText += "\n" + "\n" + errorTextn;
198:       sap.m.MessageBox.error(extraInfo, {
199:         icon: sap.m.MessageBox.Icon.Error,
200:         title: errorTitle,
201:         actions: [sap.m.MessageBox.Action.CLOSE],
202:         id: "messageBoxId2",
203:         styleClass: bCompact ? "sapUiSizeCompact" : "",
204:         contentWidth: "100px",
205:         onClose: function (oAction) {
206:           if (
207:             errorCode === 301 ||
208:             errorCode === 501 ||
209:             errorCode === 503 ||
210:             errorCode === 403 ||
211:             errorCode === 404
212:           ) {
213:             return;
214:           }
215:         }
216:       });
217:     },
218:     getMessage: function (i18nInfo) {
219:       return this.getViewModel("i18n").getResourceBundle().getText(i18nInfo);
220:     },
221:     /**
