 95:   try {
 96:     const { tenantId, docEntry, baseType } = req.params,
 97:           warehouses = await getWarehouses(tenantId, req, res);
 98:     if (docEntry && baseType) {
 99:       const warehouseCodes = new Set(req.DocumentLines.DocumentLines.map((line) => line.WarehouseCode));
100:       if (warehouseCodes.size === 1) {
101:         const warehousesFrontend = warehouses.map((warehouse) => ({
102:           EnableBinLocations: warehouse.EnableBinLocations,
103:           WarehouseCode: warehouse.WarehouseCode,
104:           WarehouseName: warehouse.WarehouseName,
105:           Selected: warehouseCodes.has(warehouse.WarehouseCode),
106:         }));
107:         res.send(warehousesFrontend);
108:       } else {
109:         res.send(warehouses);
110:       }
111:     } else {
112:       res.send(warehouses);
113:     }
114:   } catch (error) {
115:     console.error(error);
116:     res.status(500).send({ body: { message: "Internal server error" } });
117:   }
118: };
119: // Fetch bin location for a specific warehouse
120: const getBinLocations = async (req, res) => {
