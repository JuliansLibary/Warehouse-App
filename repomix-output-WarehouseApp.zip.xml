225:           const busyDialog = this.busyDialog;
226:           busyDialog.open();
227:         },
228:         /**
229:           * Convenience method for closing the BusyDialog
230:           * @public
231:           */
232:         hideBusyDialog: function () {
233:           const busyDialog = this.busyDialog;
234:           busyDialog.close();
235:         },
236:         /**
237:           * Standard Error-Call improved by Maciej
238:           * 21.08.2019 Improved the Messagebox and added SAP Error Messages
239:           * showError(i18nFehlermeldung, zusätzlicheInformation, Fehlercode)
240:           */
241:         showError: function (errorDetails, errorCode) {
242:           this.oEventBus.publish("nAG", "hideBusyDialog");
243:           const that = this;
244:           const dialog = new sap.m.Dialog({
245:             title: errorCode,
246:             type: "Message",
247:             state: sap.ui.core.ValueState.Error,
248:             content: new sap.m.VBox({
249:               items: [
250:                 new sap.m.Text({ text: errorDetails.message }),
251:                 new sap.m.Link({ text: errorDetails.helpUrl, href: errorDetails.helpUrl, target: "_blank" })
252:               ]
253:             }),
254:             beginButton: new sap.m.Button({
255:               text: "Close",
256:               press: function () {
257:                 dialog.close();
258:               }
259:             }),
260:             afterClose: () => {
261:               dialog.destroy();
262:               if (errorCode === 423) {
263:                 that.window.open("/launchpad/", "_top");
264:               }
265:             }
266:           });
267:           dialog.open();
268:         },
269:         getMessage: function (i18nInfo) {
270:           return this.getViewModel("i18n").getResourceBundle().getText(i18nInfo);
271:         },
272:         /**
273:           * Convenience method for getting Variable from URL
274:           */
275:         setViewModel: function (oModel, sName) {
276:           return this.getView().setModel(oModel, sName);
277:         },
