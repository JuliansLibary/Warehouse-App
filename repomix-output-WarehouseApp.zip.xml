416:      * Printint starts because of Function in HTML Header in Label
417:      * @param {string} htmlContent - HTML to Print
418:      */
419:     _printLabel: function (htmlContent) {
420:       const nAGLabel = window.open("", "PRINT", "height=400,width=600");
