1545:     _removeSerialNumbers: function (itemData, serialsToDelete) {
1546:       // Remove from delivery model
1547:       if (itemData.SerialNumbers && Array.isArray(itemData.SerialNumbers)) {
1548:         itemData.SerialNumbers = itemData.SerialNumbers.filter((serial) => {
1549:           const serialNumber = serial.SerialNumber || serial.DistNumber || serial.InternalSerialNumber;
1550:           return !serialsToDelete.includes(serialNumber);
1551:         });
1552:         itemData.PackedQuantity = itemData.SerialNumbers.length;
1553:       }
1554:       // Update corresponding DetailModel item
1555:       const detailData = this.getModel("DetailModel").getData();
1556:       const detailItem = detailData.PackListLines?.find((line) => 
1557:         line.ItemCode === itemData.ItemCode && 
1558:         line.WarehouseCode === itemData.WarehouseCode && 
1559:         line.AbsoluteEntry === itemData.AbsoluteEntry && 
1560:         line.DocNum === itemData.DocNum && 
1561:         line.OrderEntry === itemData.OrderEntry && 
1562:         line.OrderRowID === itemData.OrderRowID
1563:       );
1564:       if (detailItem) {
1565:         if (detailItem.SerialNumbers && Array.isArray(detailItem.SerialNumbers)) {
1566:           detailItem.SerialNumbers = detailItem.SerialNumbers.filter((serial) => {
1567:             const serialNumber = serial.SerialNumber || serial.DistNumber || serial.InternalSerialNumber;
1568:             return !serialsToDelete.includes(serialNumber);
1569:           });
1570:         }
1571:         // Aggregate total quantities across all packages for this item
1572:         const deliveryData = this.getModel("deliveryModel").getData();
1573:         let totalSerialCount = 0;
1574:         if (deliveryData.Package && Array.isArray(deliveryData.Package)) {
1575:           deliveryData.Package.forEach((pkg) => {
1576:             if (pkg.DeliveryLines && Array.isArray(pkg.DeliveryLines)) {
1577:               pkg.DeliveryLines.forEach((deliveryLine) => {
1578:                 if (deliveryLine.ItemCode === itemData.ItemCode && 
1579:                     deliveryLine.WarehouseCode === itemData.WarehouseCode &&
1580:                     deliveryLine.AbsoluteEntry === itemData.AbsoluteEntry &&
1581:                     deliveryLine.DocNum === itemData.DocNum &&
1582:                     deliveryLine.OrderEntry === itemData.OrderEntry &&
1583:                     deliveryLine.OrderRowID === itemData.OrderRowID) {
1584:                   totalSerialCount += (deliveryLine.SerialNumbers?.length || 0);
1585:                 }
1586:               });
1587:             }
1588:           });
1589:         }
1590:         detailItem.PackedQuantity = totalSerialCount;
1591:         detailItem.PreviouslyPackedQuantity = totalSerialCount;
1592:       }
1593:       // Remove from all packages in delivery model to ensure consistency
1594:       const deliveryData = this.getModel("deliveryModel").getData();
1595:       if (deliveryData.Package && Array.isArray(deliveryData.Package)) {
1596:         deliveryData.Package.forEach((pkg) => {
1597:           if (pkg.DeliveryLines && Array.isArray(pkg.DeliveryLines)) {
1598:             pkg.DeliveryLines.forEach((deliveryLine) => {
1599:               if (deliveryLine.ItemCode === itemData.ItemCode && 
1600:                   deliveryLine.WarehouseCode === itemData.WarehouseCode &&
1601:                   deliveryLine.SerialNumbers && Array.isArray(deliveryLine.SerialNumbers)) {
1602:                 deliveryLine.SerialNumbers = deliveryLine.SerialNumbers.filter((serial) => {
1603:                   const serialNumber = serial.SerialNumber || serial.DistNumber || serial.InternalSerialNumber;
1604:                   return !serialsToDelete.includes(serialNumber);
1605:                 });
1606:                 deliveryLine.PackedQuantity = deliveryLine.SerialNumbers.length;
1607:               }
1608:             });
1609:           }
1610:         });
1611:       }
