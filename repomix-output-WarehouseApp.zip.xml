296:     // Update PackedQuantity to reflect serial count
297:     frontendModel.PackedQuantity = frontendModel.SerialNumbers.length;
298:     // Update delivery model
299:     if (!deliveryModel.Package[packageContext]) {
300:       deliveryModel.Package[packageContext] = { DeliveryLines: [] };
301:     }
302:     // Find or create delivery line for this item
303:     let deliveryLine = null;
304:     for (const line of deliveryModel.Package[packageContext].DeliveryLines) {
305:       if (line.ItemCode === serialNumberDetails.ItemCode) {
306:         deliveryLine = line;
307:         break;
308:       }
309:     }
310:     if (!deliveryLine) {
311:       // Create new delivery line if it doesn't exist
312:       deliveryLine = {
313:         ItemCode: serialNumberDetails.ItemCode,
314:         SerialNumbers: [],
315:         SerialNumbersFrontend: "",
316:         DocumentLinesBinAllocations: [],
317:       };
318:       deliveryModel.Package[packageContext].DeliveryLines.push(deliveryLine);
319:     }
320:     // Initialize arrays if they don't exist
321:     if (!deliveryLine.SerialNumbers) {
322:       deliveryLine.SerialNumbers = [];
323:     }
324:     if (!deliveryLine.DocumentLinesBinAllocations) {
325:       deliveryLine.DocumentLinesBinAllocations = [];
326:     }
327:     // Add serial to delivery line
328:     deliveryLine.SerialNumbers.push(newSerial);
329:     // Update delivery line display string
330:     const deliverySerialNumbers = deliveryLine.SerialNumbers.map((s) => s.SerialNumber);
331:     deliveryLine.SerialNumbersFrontend = deliverySerialNumbers.join("\r\n") + (deliverySerialNumbers.length > 0 ? "\r\n" : "");
332:     // Add bin allocation to delivery line
333:     if (serialNumberDetails.BinAbs) {
334:       deliveryLine.DocumentLinesBinAllocations.push({
335:         BinAbsEntry: serialNumberDetails.BinAbs,
336:         BaseLineNumber: frontendModel.LineNumber,
337:         SerialAndBatchNumbersBaseLine: deliveryLine.SerialNumbers.length - 1,
338:         Quantity: 1,
339:         SerialNumber: serialNumber,
340:       });
341:     }
342:     // Update frontendModelChange
343:     if (frontendModelChange.PackListLines) {
344:       frontendModelChange.PackListLines.forEach((element) => {
345:         if (element.ItemCode === frontendModel.ItemCode) {
346:           element.SerialNumbers = frontendModel.SerialNumbers;
347:           element.DocumentLinesBinAllocations = frontendModel.DocumentLinesBinAllocations;
348:           element.PackedQuantity = frontendModel.SerialNumbers.length;
349:           element.SerialNumbersFrontend = frontendModel.SerialNumbersFrontend;
350:         }
351:       });
352:     }
353:     // Send successful response
354:     res.send({
355:       frontendModelChange: JSON.stringify(frontendModelChange),
356:       frontendModel: frontendModel,
357:       deliveryModel: JSON.stringify(deliveryModel),
358:       serialNumber: serialNumber,
359:       totalSerials: frontendModel.SerialNumbers.length,
360:     });
361:   } catch (error) {
362:     res.status(500).send({
363:       message: "Internal server error while processing serial number",
364:       code: 500,
365:       isDuplicateError: false,
366:       error: error.message,
367:     });
368:   }
369: }
