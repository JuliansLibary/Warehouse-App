24: async function buildNVE(docNum, packageIndex, cookie) {
25:   // Reserve Nummer
26:   let reserveNumber = 0,
27:     // GLN Number aus SAP
28:     basicNumber = await getBasicGlobalLocationNumber(cookie),
29:     NVENumber,
30:     nveContent = "" + reserveNumber + basicNumber + packageIndex + docNum;
31:   // Sollte die NVE Ausgangsnummer kleiner wie 17 sein muss die Nummer mit 0 aufgefüllt werden
32:   // NVE COde ist immer 17 stellig + die Prüfziffer
33:   if (17 - nveContent.length > 0) {
34:     nveContent = nveContent.padEnd(17, "0");
35:   }
36:   // Checksumme errechnen lasssen nach Vorgabe der NVE
37:   let nveCheckSum = await createCheckSum("" + nveContent);
38:   NVENumber = "" + nveContent + nveCheckSum;
39:   return NVENumber;
40: }
41: // Calculate the SCC CHecksum for the NVE Label
42: async function createCheckSum(barcode) {
43:   return new Promise(function (resolve, reject) {
44:     try {
45:       let array = barcode.split("").reverse(),
46:       total = 0,
47:       i = 1;
48:     array.forEach((number) => {
49:       number = parseInt(number);
50:       if (i % 2 === 0) {
51:         total = total + number;
52:       } else {
53:         total = total + number * 3;
54:       }
55:       i++;
56:     });
57:     let checkSum = Math.ceil(total / 10) * 10 - total;
58:     resolve(checkSum);
59:     } catch (error) {
60:       console.error(error);
61:       reject()
62:     }
63:   });
64: }
