 660: // compute the packed Quantity of Sales Bill of Material Head Items
 661: async function computeBoMQuantity(deliveryNote, productTree) {
 662:   // Durchläuft alle DocumentLines im deliveryNote und berechnet die Mengen für Sales Tree Items
 663:   deliveryNote.DocumentLines.forEach((line, lineIndex) => {
 664:     // Verarbeitung von Sales Tree Items
 665:     if (line.TreeType === "S" || line.TreeType === "iSalesTree") {
 666:       let packedIngredients = [];
 667:       let quantity;
 668:       // Sammeln aller Zutaten (Ingredients) nach dem Sales Tree Item
 669:       for (let i = lineIndex + 1; i < deliveryNote.DocumentLines.length; i++) {
 670:         if (deliveryNote.DocumentLines[i].TreeType === "I" || deliveryNote.DocumentLines[i].TreeType === "iIngredient") {
 671:           packedIngredients.push({
 672:             ItemCode: deliveryNote.DocumentLines[i].ItemCode,
 673:             Quantity: deliveryNote.DocumentLines[i].Quantity,
 674:           });
 675:         } else {
 676:           break;
 677:         }
 678:       }
 679:       // Finden der entsprechenden Produktbaumdefinition und Berechnung der Mindestmenge
 680:       productTree.forEach((tree) => {
 681:         if (tree.TreeCode === line.ItemCode) {
 682:           tree.ProductTreeLines.forEach((productTreeLine) => {
 683:             packedIngredients.forEach((ingredient) => {
 684:               if (ingredient.ItemCode === productTreeLine.ItemCode) {
 685:                 // Berechnung des Faktors und Festlegen der Menge auf den niedrigsten Wert
 686:                 const currentFactor = ingredient.Quantity / productTreeLine.Quantity;
 687:                 quantity = quantity !== undefined ? Math.min(quantity, currentFactor) : currentFactor;
 688:               }
 689:             });
 690:           });
 691:         }
 692:       });
 693:       // Aktualisieren der Quantity im Delivery Note für das Sales Tree Item
 694:       line.Quantity = quantity;
 695:     }
 696:   });
 697:   // Rückgabe des aktualisierten deliveryNote
 698:   return deliveryNote;
 699: }
 700: // remove unpacked Lines of Order
 701: async function cleanDelivery(deliveryNote) {
 702:   // Entferne leere Zeilen aus DocumentLines basierend auf den TreeType und Quantity Bedingungen
 703:   deliveryNote.DocumentLines = deliveryNote.DocumentLines.filter((line) => {
 704:     return !(
 705:       ((line.TreeType === "N" ||
 706:         line.TreeType === "iNotATree" ||
 707:         line.TreeType === "iProductionTree" ||
 708:         line.TreeType === "iIngredient" ||
 709:         line.TreeType === "P") && parseInt(line.Quantity) === 0) ||
 710:       line.Quantity === "undefined"
 711:     );
 712:   });
 713:   // Aktualisiere VisualOrder und sammle BaseVisualOrder-Werte für die Dokumentzeilen
 714:   let lineNumbers = [];
 715:   deliveryNote.DocumentLines.forEach((line, idx) => {
 716:     line.VisualOrder = idx;
 717:     lineNumbers.push(line.BaseVisualOrder);
 718:   });
 719:   // Entferne nicht zugeordnete oder ungültige Spezialzeilen aus DocumentSpecialLines
 720:   if (deliveryNote.DocumentSpecialLines.length > 0) {
 721:     for (let i = deliveryNote.DocumentSpecialLines.length - 1; i >= 0; i--) {
 722:       let specialLine = deliveryNote.DocumentSpecialLines[i];
 723:       // Prüfen, ob AfterLineNumber in lineNumbers enthalten ist
 724:       if (!lineNumbers.includes(specialLine.AfterLineNumber)) {
 725:         if (specialLine.LineType === "dslt_Text") {
 726:           // Suchen der nächstgelegenen gültigen AfterLineNumber
 727:           let j = 0;
 728:           while (lineNumbers[++j] < specialLine.AfterLineNumber);
 729:           let closest = lineNumbers[--j];
 730:           specialLine.AfterLineNumber = specialLine.AfterLineNumber < lineNumbers[0] ? -1 : lineNumbers.indexOf(closest);
 731:         } else {
 732:           // Entfernen von ungültigen Spezialzeilen
 733:           deliveryNote.DocumentSpecialLines.splice(i, 1);
 734:         }
 735:       } else {
 736:         // Aktualisieren von AfterLineNumber auf den Index in lineNumbers
 737:         specialLine.AfterLineNumber = lineNumbers.indexOf(specialLine.AfterLineNumber);
 738:       }
 739:     }
 740:     // Entferne "BaseVisualOrder" aus DocumentLines
 741:     deliveryNote.DocumentLines.forEach((line) => {
 742:       delete line["BaseVisualOrder"];
 743:     });
 744:   }
 745:   // Rückgabe des bereinigten deliveryNote
 746:   return deliveryNote;
 747: }
