  1: const SL = require("@nag/servicelayerconnector");
  2: const axios = require("axios");
  3: const { getInstance, getError } = require("../controller/utilsController.js");
  4: const BASE_URL = "http://System-DatabaseConnector.warehouseapp:3000";
  5: /*
  6: 1. check the packages and add VK BOM items
  7: 2. calculate the quantities from Bom Items including VK item
  8: 3. create UDT content according to defined nAG pattern
  9: */
 10: async function getSalesTreeItemsOrders(baseLineIndices, baseOrders) {
 11:   const Head = [];
 12:   baseOrders.forEach((baseOrder) => {
 13:     baseLineIndices.forEach((index) => {
 14:       const result = baseOrder.DocumentLines.find((line) => line.LineNum === index);
 15:       if (result && (result.TreeType === "iIngredient" || result.TreeType === "I")) {
 16:         // Rückwärtssuche, um den ersten `iSalesTree` oder `S` zu finden
 17:         for (let i = result.LineNum; i >= 0; i--) {
 18:           const line = baseOrder.DocumentLines[i];
 19:           if (line && (line.TreeType === "iSalesTree" || line.TreeType === "S")) {
 20:             Head.push(line);
 21:             break;
 22:           }
 23:         }
 24:       }
 25:     });
 26:   });
 27:   return Array.from(new Set(Head));
 28: }
 29: function getProductTrees(salesTreeItems, cookie) {
 30:   // Get Unique ItemCodes
 31:   let mySet = new Set();
 32:   salesTreeItems.forEach((Item) => {
 33:     mySet.add(Item.ItemCode);
 34:   });
 35:   let promises = [],
 36:     uniqueItems = Array.from(mySet);
 37:   uniqueItems.forEach((Item) => {
 38:     promises.push(_getProductTree(Item, cookie));
 39:   });
 40:   return Promise.all(promises).then((data) => {
 41:     return data;
 42:   });
 43:   async function _getProductTree(ItemCode, auth) {
 44:     let productTreeURL = "ProductTrees('" + ItemCode + "')";
 45:     let instance = await getInstance();
 46:     return new Promise((resolve, reject) => {
 47:       SL.GET(productTreeURL, null, auth, {
 48:         retryTimes: 2,
 49:         retryDelay: 750,
 50:         SLURL: instance.SLURL,
 51:         SLPort: instance.SLPort
 52:       }, async function (error, resp) {
 53:         if (error) {
 54:           reject(await getError(error));
 55:         } else {
 56:           resolve(resp);
 57:         }
 58:       });
 59:     });
 60:   }
 61: }
 62: async function createUDTContentForBatch(
 63:   deliveryNote,
 64:   packageModel,
 65:   productTree
 66: ) {
 67:   return new Promise(function (resolve, reject) {
 68:     try {
 69:       checkPackages(packageModel).then((deliveryNoteModelPackagesUpdate) => {
 70:         computeBoMQuantityPackage(
 71:           deliveryNoteModelPackagesUpdate,
 72:           productTree
 73:         ).then((content) => {
 74:           createUDTContent(deliveryNote, content).then((resolveContent) => {
 75:             resolve(resolveContent);
 76:           });
 77:         });
 78:       });
 79:     } catch (error) {
 80:       console.error(error);
 81:       reject()
 82:     }
 83:   });
 84: }
 85: async function getProductTree(pickList, cookie, tenantId) {
 86:   let orders = [];
 87:   let bom = [];
 88:   let frontendSalesArticles = [];
 89:   let OrderEntries = new Set();
 90:   pickList.forEach((line) => {
 91:     OrderEntries.add({
 92:       BaseEntry: line.DocEntry,
 93:       BaseObjectType: line.BaseObjectType,
 94:     });
 95:   });
 96:   let gettingOrder;
 97:   for (const entry of OrderEntries) {
 98:     gettingOrder = await getOrders(entry.BaseEntry, entry.BaseObjectType, cookie, tenantId);
 99:     orders.push(gettingOrder);
100:   }
101:   orders.forEach((order) => {
102:     if (typeof order.DocumentLines !== "undefined") {
103:       order.DocumentLines.forEach((line) => {
104:         if (line.TreeType !== "N" || line.TreeType !== "iNotATree") {
105:           bom.push(line.LineNum);
106:         }
107:       });
108:     }
109:   });
110:   const salesTreeItems = await getSalesTreeItemsOrders(bom, orders);
111:   const productTrees = await getProductTrees(salesTreeItems, cookie);
112:   let bool = false;
113:   let setProductTree = new Set();
114:   productTrees.forEach((productTree) => {
115:     for (let x = 0; x < productTree.ProductTreeLines.length; x++) {
116:       for (let i = 0; i < pickList.length; i++) {
117:         for (let m = 0; m < pickList[i].PackListLines.length; m++) {
118:           if (productTree.ProductTreeLines[x].ItemCode === pickList[i].PackListLines[m].ItemCode) {
119:             pickList[i].PackListLines[m].TreeCode = productTree.TreeCode;
120:             bool = true;
121:           } else {
122:             bool = false;
123:           }
124:           if (bool) {
125:             if (!setProductTree.has(productTree.TreeCode)) {
126:               setProductTree.add(productTree.TreeCode);
127:               frontendSalesArticles.push({
128:                 [productTree.TreeCode]: productTree.ProductTreeLines,
129:               });
130:             }
131:           }
132:         }
133:       }
134:     }
135:   });
136:   return {
137:     frontendSalesModel: frontendSalesArticles,
138:     pickList: pickList,
139:   };
140: }
141: // Promise Method to GET Orders
142: async function getOrders(orderEntry, BaseObjectType, cookie, tenantId) {
143:   try {
144:     const responseDocumentDetails = await axios.get(`${BASE_URL}/documentDetail/Pack/${tenantId}/getOrders/${orderEntry}`);
145:     return responseDocumentDetails.data.content;
146:   } catch (error) {
147:     // If the database returns a 404 status (resource not found),
148:     // the following code triggers a fallback mechanism to fetch real-time data
149:     // from the SAP system via the service layer.
150:     if (error.response && error.response.status === 404) {
151:       let orderURL;
152:       if (parseInt(BaseObjectType) === 13) {
153:         orderURL = `Invoices(${orderEntry})`;
154:       } else if (parseInt(BaseObjectType) === 17) {
155:         orderURL = `Orders(${orderEntry})`;
156:       }
157:       try {
158:         const instance = await getInstance();
159:         const options = {
160:           retryTimes: 2,
161:           retryDelay: 750,
162:           SLURL: instance.SLURL,
163:           SLPort: instance.SLPort
164:         };
165:         return await new Promise((resolve, reject) => {
166:           SL.GET(orderURL, null, cookie, options, (errorSLCall, resp) => {
167:             if (errorSLCall) {
168:               reject(errorSLCall);
169:             } else {
170:               resolve(resp);
171:             }
172:           });
173:         });
174:       } catch (slError) {
175:         return await getError(slError);
176:       }
177:     } else {
178:       throw error;
179:     }
180:   }
181: }
182: // Creates UDT Content for U_NAG_Packlist that Layouts and EDI can work with it
183: async function createUDTContent(deliverNote, packageModel) {
184:   let udtModel = [];
185:   packageModel.forEach((packageLine) => {
186:     if (packageLine.TreeType !== "I") {
187:       udtModel.push({
188:         U_DocEntry: packageLine.OrderEntry,
189:         U_BasicDocType: packageLine.BaseObjectType,
190:         U_LineNumber: packageLine.OrderRowID,
191:         U_ItemCode: packageLine.ItemCode,
192:         U_PackedQuantity: packageLine.Quantity,
193:         U_DocEntry_LS: deliverNote.DocEntry,
194:         U_Package_Number: packageLine.PackageNumber,
195:       });
196:     }
197:   });
198:   return udtModel;
199: }
200: // compute the packed Quantity of Sales Bill of Material Head Items
201: async function computeBoMQuantityPackage(dN, pT) {
202:   async function bomQuantityPackage(deliveryNote, productTree) {
203:     deliveryNote.forEach((line, lineIndex) => {
204:       if (line.TreeType === "S" || line.TreeType === "iSalesTree") {
205:         let packedIngredients = [];
206:         let quantity;
207:         for (let i = lineIndex + 1; i < deliveryNote.length; i++) {
208:           packedIngredients.push({
209:             ItemCode: deliveryNote[i].ItemCode,
210:             Quantity: deliveryNote[i].Quantity,
211:           });
212:         }
213:         for (let x = 0; x < productTree.length; x++) {
214:           if (productTree[x][line.ItemCode]) {
215:             productTree[x][line.ItemCode].forEach((productTreeLine) => {
216:               for (let y = 0; y < packedIngredients.length; y++) {
217:                 if (packedIngredients[y].ItemCode === productTreeLine.ItemCode) {
218:                   if (typeof quantity !== "undefined") {
219:                     quantity = Math.min(
220:                       quantity,
221:                       packedIngredients[y].Quantity / productTreeLine.Quantity
222:                     );
223:                   } else {
224:                     quantity = packedIngredients[y].Quantity / productTreeLine.Quantity;
225:                   }
226:                   return;
227:                 }
228:               }
229:             });
230:           }
231:         }
232:         line.Quantity = quantity;
233:       }
234:     });
235:     return deliveryNote;
236:   }
237:   return bomQuantityPackage(dN, pT);
238: }
239: // check if a bom Article exists and add it with Quantity 0 to the Package
240: // No need to check if a Bom Article is complete in the Package because Frontend catch this
241: async function checkPackages(packageModel) {
242:   let packageContent = [],
243:     bomSet = new Set();
244:   packageModel.Package.forEach((package, index) => {
245:     package.DeliveryLines.forEach((packageLine) => {
246:       if (
247:         !bomSet.has(packageLine.TreeCode) &&
248:         packageLine.TreeType === "I" &&
249:         typeof packageLine.TreeCode !== "undefined"
250:       ) {
251:         bomSet.add(packageLine.TreeCode);
252:         packageContent.push({
253:           ItemCode: packageLine.TreeCode,
254:           Quantity: 0,
255:           PackageNumber: index + 1,
256:           OrderEntry: packageLine.OrderEntry,
257:           TreeType: "iSalesTree",
258:           OrderRowID: packageLine.OrderRowID,
259:           BaseObjectType: packageLine.BaseObjectType,
260:         });
261:       }
262:       packageContent.push({
263:         ItemCode: packageLine.ItemCode,
264:         Quantity: packageLine.PackedQuantity,
265:         PackageNumber: index + 1,
266:         OrderEntry: packageLine.OrderEntry,
267:         TreeType: packageLine.TreeType,
268:         OrderRowID: packageLine.OrderRowID,
269:         BaseObjectType: packageLine.BaseObjectType,
270:       });
271:     });
272:   });
273:   return packageContent;
274: }
