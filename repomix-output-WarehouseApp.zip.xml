  1: //InventoryCountlogic.js
  2: module.exports = {
  3:   formatForPost,
  4:   formatForPatch,
  5: };
  6: /*
  7:  * prepares Transfer for Post
  8:  * @param {json} InventoryCount Model with DocumentLines
  9:  */
 10: function formatForPost(inventoryModel, additionalInformation) {
 11:   return new Promise(function (resolve, reject) {
 12:     var inventoryPostModel = {
 13:       InventoryCountingLines: [],
 14:     };
 15:     if (inventoryModel.DocumentEntry !== undefined) {
 16:       inventoryPostModel.DocumentEntry = inventoryModel.DocumentEntry;
 17:     }
 18:     if (typeof additionalInformation.Comments !== "undefined") {
 19:       inventoryPostModel.Remarks = additionalInformation.Comments;
 20:     }
 21:     inventoryModel.InventoryCountingLines.forEach((transferLine, index) => {
 22:       transferLine.SerialOrBatchModel.forEach((SerialOrBatchModel, index) => {
 23:         // Prepare Serial or Batch Number Model for Post
 24:         var InventoryCountingSerialNumbers, InventoryCountingBatchNumbers, InventoryCountingLineUoMs, quantity, InventoryUoMEntry;
 25:         // Check if the Line is a Serial or a BatchNumber and prepare Model for this
 26:         if (SerialOrBatchModel.InternalSerialNumber) {
 27:           InventoryCountingSerialNumbers = {
 28:             Quantity: 1,
 29:             BaseLineNumber: inventoryPostModel.InventoryCountingLines.length,
 30:           };
 31:           // if (global.gConfig.InternalSerialNumber === true) {
 32:           //   InventoryCountingSerialNumbers.InternalSerialNumber =
 33:           //     SerialOrBatchModel.InternalSerialNumber;
 34:           // } else {
 35:           // if (global.gConfig.ManufacturerSerialNumber === true) {
 36:           //   InventoryCountingSerialNumbers.ManufacturerSerialNumber =
 37:           //     SerialOrBatchModel.InternalSerialNumber;
 38:           // }
 39:           //}
 40:         }
 41:         if (SerialOrBatchModel.ManufacturerSerialNumber) {
 42:           InventoryCountingSerialNumbers.ManufacturerSerialNumber = SerialOrBatchModel.ManufacturerSerialNumber;
 43:         }
 44:         if (SerialOrBatchModel.BatchNumber) {
 45:           // Count UOM Key
 46:           // Don't judge me!! SAP doesn't calculate the quantity --> checked with Consulting
 47:           if (SerialOrBatchModel.QuantityCount > 0 && SerialOrBatchModel.uOMKey && SerialOrBatchModel.UoMCode) {
 48:             quantity = parseInt(SerialOrBatchModel.Quantity) * parseInt(SerialOrBatchModel.QuantityCount);
 49:           } else {
 50:             quantity = SerialOrBatchModel.Quantity;
 51:           }
 52:           InventoryCountingBatchNumbers = {
 53:             BatchNumber: SerialOrBatchModel.BatchNumber,
 54:             Quantity: quantity,
 55:             BaseLineNumber: inventoryPostModel.InventoryCountingLines.length,
 56:             ExpiryDate: SerialOrBatchModel.ExpiryDate,
 57:           };
 58:         }
 59:         // If a UoM Entry exists Add the CountedQuantity and the UoMCode
 60:         if (SerialOrBatchModel.UoMCode) {
 61:           InventoryCountingLineUoMs = [
 62:             {
 63:               UoMCode: SerialOrBatchModel.UoMCode,
 64:               UoMCountedQuantity: transferLine.QuantityBasicUOM,
 65:               LineNumber: inventoryPostModel.InventoryCountingLines.length,
 66:             },
 67:           ];
 68:           InventoryUoMEntry = SerialOrBatchModel.UuOMKey;
 69:         } else {
 70:           InventoryUoMEntry = null;
 71:         }
 72:         // If a ItemCode is already added findIndex and Push new Information like BatchNumbers, SerialNumbers
 73:         if (inventoryPostModel.InventoryCountingLines.findIndex((inventoryLine) => inventoryLine.BinEntry === SerialOrBatchModel.BinAbs && inventoryLine.ItemCode === SerialOrBatchModel.ItemCode) != -1) {
 74:           var findIndex = inventoryPostModel.InventoryCountingLines.findIndex((inventoryLine) => inventoryLine.BinEntry === SerialOrBatchModel.BinAbs);
 75:           if (SerialOrBatchModel.BatchNumber) {
 76:             InventoryCountingBatchNumbers.BaseLineNumber = findIndex;
 77:             inventoryPostModel.InventoryCountingLines[findIndex].InventoryCountingBatchNumbers.push(InventoryCountingBatchNumbers);
 78:             inventoryPostModel.InventoryCountingLines[findIndex].CountedQuantity = parseInt(inventoryPostModel.InventoryCountingLines[findIndex].CountedQuantity) + parseInt(quantity);
 79:           }
 80:           if (SerialOrBatchModel.InternalSerialNumber) {
 81:             InventoryCountingSerialNumbers.BaseLineNumber = findIndex;
 82:             inventoryPostModel.InventoryCountingLines[findIndex].InventoryCountingSerialNumbers.push(InventoryCountingSerialNumbers);
 83:             inventoryPostModel.InventoryCountingLines[findIndex].CountedQuantity = parseInt(inventoryPostModel.InventoryCountingLines[findIndex].CountedQuantity) + 1;
 84:           }
 85:         } else {
 86:           // Create a Entry for InventoryCountingLines
 87:           // No need for DocumentLinesBinAllocations there is only a BinEntry
 88:           var inventoryCountingLine = {
 89:             LineNumber: inventoryPostModel.InventoryCountingLines.length,
 90:             ItemCode: SerialOrBatchModel.ItemCode,
 91:             CountedQuantity: SerialOrBatchModel.Quantity,
 92:             WarehouseCode: transferLine.WarehouseCode,
 93:             BinEntry: SerialOrBatchModel.BinAbs,
 94:             Counted: "tYES",
 95:             InventoryCountingBatchNumbers: [InventoryCountingBatchNumbers],
 96:             InventoryCountingLineUoMs: InventoryCountingLineUoMs,
 97:             InventoryCountingSerialNumbers: [InventoryCountingSerialNumbers],
 98:           };
 99:           if (InventoryUoMEntry !== null) {
100:             inventoryCountingLine.InventoryUoMEntry = InventoryUoMEntry;
101:           }
102:           inventoryPostModel.InventoryCountingLines.push(inventoryCountingLine);
103:         }
104:       });
105:     });
106:     resolve(inventoryPostModel);
107:   });
108: }
109: function formatForPatch(inventoryModel) {
110:   return new Promise(function (resolve, reject) {
111:     var inventoryPostModel = {
112:       InventoryCountingLines: [],
113:     };
114:     if (inventoryModel.DocumentEntry !== undefined) {
115:       inventoryPostModel.DocumentEntry = inventoryModel.DocumentEntry;
116:     }
117:     inventoryModel.InventoryCountingLines.forEach((transferLine, index) => {
118:       var inventoryCountingLine = {
119:         DocumentEntry: transferLine.DocumentEntry,
120:         LineNumber: transferLine.LineNumber,
121:         ItemCode: transferLine.ItemCode,
122:         CountedQuantity: transferLine.CountedQuantity,
123:         WarehouseCode: transferLine.WarehouseCode,
124:         BinEntry: transferLine.BinAbs,
125:         Counted: "tYES",
126:         InventoryCountingBatchNumbers: transferLine.InventoryCountingBatchNumbers,
127:         InventoryCountingLineUoMs: transferLine.InventoryCountingLineUoMs,
128:         InventoryCountingSerialNumbers: transferLine.InventoryCountingSerialNumbers,
129:       };
130:       inventoryPostModel.InventoryCountingLines.push(inventoryCountingLine);
131:     });
132:     resolve(inventoryPostModel);
133:   });
134: }
