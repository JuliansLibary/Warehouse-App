  7: // Define the base URL for the DatabaseConnector
  8: const BASE_URL = "http://System-DatabaseConnector.warehouseapp:3000";
  9: const secretKey = "GCm6xZimEfaxZyd3RDo4iVm8VDMW1A6EKH0YwXcgojQwaypgg0iGs6cwBiK41fo2G38QDJTZAZpAQ5aUsMiL9kujPtTJp2j7gY7u";
 10: const ncryptObject = new ncrypt(secretKey);
 11: // Helper function to decode JWT token
 12: function getToken(req) {
 13:   return jose.decodeJwt(req.headers.authorization);
 14: }
 15: // Helper function to encrypt password
 16: function encryptPassword(password) {
 17:   return ncryptObject.encrypt(password);
 18: }
 19: // Helper function to get user data by token username
 20: async function getUserDataByUsername(username) {
 21:   try {
 22:     const response = await axios.get(`${BASE_URL}/User/${username}`);
 23:     return response.data;
 24:   } catch (error) {
 25:     console.error("Error fetching user data:", error);
 26:     throw new Error("Failed to fetch user data");
 27:   }
 28: }
 29: // Save service layer credentials
 30: async function saveServiceLayerCredentials(req, res) {
 31:   try {
 32:     const instance = await getInstance();
 33:     const instanceID = instance.id;
 34:     if (!instanceID) {
 35:       return res.status(500).send({ body: { message: "Instance ID not found", helpUrl: null } });
 36:     }
 37:     const token = getToken(req);
 38:     if (!token || !token.preferred_username) {
 39:       return res.status(401).send({ body: { message: "Invalid token", helpUrl: null } });
 40:     }
 41:     const encryptedPassword = encryptPassword(req.body.Password);
 42:     const profilePicture = Buffer.from("\\x" + Buffer.from("Placeholder", "base64").toString("hex"));
 43:     const response = await axios.post(`${BASE_URL}/PostUser`, {
 44:       SLUsername: req.body.UserName,
 45:       SLPassword: encryptedPassword,
 46:       instanceId: instanceID,
 47:       themeSetting: "sap_horizon",
 48:       identityID: token.preferred_username,
 49:       language: "de-DE",
 50:       profilePicture: profilePicture,
 51:     });
 52:     if (response.status === 201) {
 53:       return res.send(true);
 54:     } else {
 55:       return res.status(500).send({ body: { message: "Failed to create user", helpUrl: null } });
 56:     }
 57:   } catch (error) {
 58:     console.error("Error saving service layer credentials:", error);
 59:     if (error.response && error.response.status) {
 60:       return res.status(error.response.status).send({ body: { message: "Failed to save credentials", helpUrl: null } });
 61:     }
 62:     return res.status(500).send({ body: { message: "Failed to save credentials", helpUrl: null } });
 63:   }
 64: }
 65: // Update service layer credentials
 66: async function updateServiceLayerCredentials(req, res) {
 67:   try {
 68:     const instance = await getInstance();
 69:     const instanceID = instance.id;
 70:     if (!instanceID) {
 71:       return res.status(500).send({ body: { message: "Instance ID not found", helpUrl: null } });
 72:     }
 73:     const token = getToken(req);
 74:     if (!token || !token.preferred_username) {
 75:       return res.status(401).send({ body: { message: "Invalid token", helpUrl: null } });
 76:     }
 77:     const userData = await getUserDataByUsername(token.preferred_username);
 78:     if (!userData) {
 79:       return res.status(404).send({ body: { message: "User not found", helpUrl: null } });
 80:     }
 81:     const encryptedPassword = encryptPassword(req.query.Password);
 82:     const patchData = {
 83:       SLUsername: req.query.UserName,
 84:       SLPassword: encryptedPassword,
 85:     };
 86:     const response = await axios.patch(`${BASE_URL}/PatchUser/${userData.id}`, patchData);
 87:     if (response.status === 200) {
 88:       return res.send(true);
 89:     } else {
 90:       return res.status(500).send({ body: { message: "Failed to update credentials", helpUrl: null } });
 91:     }
 92:   } catch (error) {
 93:     console.error("Error updating service layer credentials:", error);
 94:     if (error.response && error.response.status === 404) {
 95:       return res.status(404).send({ body: { message: "User not found", helpUrl: null } });
 96:     }
 97:     return res.status(500).send({ body: { message: "Failed to update credentials", helpUrl: null } });
 98:   }
 99: }
100: async function checkServiceLayerCredentials(req, res) {
101:   try {
102:     const token = {
103:       B1ServiceLayerUsername: req.query.UserName,
104:       B1ServiceLayerPassword: req.query.Password,
105:       database: req.query.database,
106:     };
107:     // Fetch instances from DatabaseConnector
108:     const instanceResponse = await axios.get(`${BASE_URL}/Instances`);
109:     const instances = instanceResponse.data;
110:     if (!instances || instances.length === 0) {
111:       return res.status(500).send({ body: { message: "No instances found", helpUrl: null } });
112:     }
113:     const instance = instances[0];
114:     // Authentifizierung generieren
115:     const authHeader = await generateBasicAuthServiceLayerLogin(token);
116:     // POST Request an den Service Layer (Login)
117:     SL.POST(
118:       "Login",
119:       null,
120:       null,
121:       authHeader,
122:       {
123:         retryTimes: 3,
124:         retryDelay: 500,
125:         SLURL: instance.SLURL,
126:         SLPort: instance.SLPort,
127:       },
128:       async function (error) {
129:         if (error) {
130:           const errorResponse = await getError(error);
131:           res.status(error.httpStatusCode || 500).send(errorResponse);
132:         } else {
133:           res.send(true);
134:         }
135:       }
136:     );
137:   } catch (error) {
138:     console.error("Error checking service layer credentials:", error);
139:     if (error.response && error.response.status) {
140:       return res.status(error.response.status).send({ body: { message: "Failed to check credentials", helpUrl: null } });
141:     }
142:     return res.status(500).send({ body: { message: "Failed to check credentials", helpUrl: null } });
143:   }
144: }
145: module.exports = {
146:   saveServiceLayerCredentials,
147:   updateServiceLayerCredentials,
148:   checkServiceLayerCredentials,
149: };
