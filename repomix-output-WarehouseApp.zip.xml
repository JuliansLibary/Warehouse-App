 67:                 $.ajax(this);
 68:                 return;
 69:               } else {
 70:                 that.showError({ message: "NetworkError", helpUrl: null }, "9000");
 71:               }
 72:             }
 73:             if (
 74:               typeof jqXHR.responseText !== "undefined" &&
 75:               jqXHR.status !== "undefined"
 76:             ) {
 77:               if (typeof jqXHR.responseJSON !== "undefined") {
 78:                 that.showError(that.findTranslation(jqXHR.responseJSON, Language), jqXHR.status);
 79:               } else {
 80:                 let errorMessage;
 81:                 if (jqXHR.status === 423) {
