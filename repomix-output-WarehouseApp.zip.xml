 26:     return Controller.extend(
 27:       "nag.WarehouseApp.InventoryCounting.BaseController",
 28:       {
 29:         /**
 30:          * Convenience method for saving the BaseController in a global variable and creating fields that need to be accessed
 31:          * @public
 32:          */
 33:         register: function () {
 34:           this.oEventBus = sap.ui.getCore().getEventBus();
 35:           $.sap.control = this;
 36:           this.oEventBus.subscribe(
 37:             "nAG",
 38:             "showBusyDialog",
