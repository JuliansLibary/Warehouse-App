16: function formatOpenInventoryCountings(inventoryCountings, cacheData, documentLockString) {
17:   return new Promise(function (resolve, reject) {
18:     var response = [],
19:       inventoryCountingset = new Set(),
20:       hasEntry;
21:     //InventoryCountings
22:     inventoryCountings.forEach((inventoryCount) => {
23:       if (JSON.parse(cacheData).find((element) => element.documentNumber === inventoryCount.DocumentEntry && element.isDeleted === false)) {
24:         hasEntry = true;
25:       } else {
26:         hasEntry = false;
27:       }
28:       try {
29:         let currentDate = new Date();
30:         if (JSON.parse(documentLockString).find((element) => element.documentNumber === inventoryCount.DocumentEntry && new Date(Date.parse(element.latestChangeDate)).getTime() + parseInt(global.gConfig.documentLockTimer) * 60000 >= currentDate.getTime())) {
31:           isLocked = true;
32:         } else {
33:           isLocked = false;
34:         }
35:       } catch (error) {
36:         isLocked = false;
37:       }
38:       if (!inventoryCountingset.has(inventoryCount.DocumentEntry)) {
39:         response.push({
40:           DocEntry: inventoryCount.DocumentEntry,
41:           CountDate: inventoryCount.CountDate,
42:           Remarks: inventoryCount.Remarks,
43:           DocumentNumber: inventoryCount.DocumentNumber,
44:           isCached: hasEntry,
45:           isLocked: isLocked,
46:         });
47:         inventoryCountingset.add(inventoryCount.DocumentEntry);
48:       }
49:     });
50:     resolve(
51:       response.sort(function (a, b) {
52:         return new Date(b.CountDate) - new Date(a.CountDate);
53:       })
54:     );
55:   });
56: }
57: function formatInventoryCountingsDetails(inventoryCountingDetails, headers) {
