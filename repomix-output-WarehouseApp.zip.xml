1388:         if (line.ItemCode === object.ItemCode && line.LineNum === object.LineNum && !line.markedforDeletion) {
1389:           line.openQuantity -= object.Quantity;
1390:           line.BatchNumbers = line.BatchNumbers.filter((batchLine) => batchLine !== object.BatchNumbers);
1391:           line.DocumentLinesBinAllocations = line.DocumentLinesBinAllocations.filter((allocation) => allocation !== object.DocumentLinesBinAllocations);
1392:         }
