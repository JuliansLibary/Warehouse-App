1880:     _interpretCode: function (input) {
1881:       const packListLines = this.getModel("DetailModel").getData().PackListLines;
1882:       let found = false;
1883:       for (let i = 0; i < packListLines.length; i++) {
1884:         const itemBarCodes = packListLines[i].ItemBarCodeCollection;
1885:         for (let k = 0; k < itemBarCodes.length; k++) {
1886:           if (itemBarCodes[k].Barcode.toUpperCase() === input.ItemCode.toUpperCase()) {
1887:             if (packListLines[i].PackedQuantity < packListLines[i].PickedQuantity) {
1888:               found = true;
1889:               if (packListLines[i].ManageSerialNumbers === "Y") {
1890:                 if (Object.prototype.hasOwnProperty.call(input, "SN/BN")) {
1891:                   this._onConfirmSerialScan(packListLines[i], i, "ScanDialog", this._oPackScanDialog.packageContext, input);
1892:                 } else {
1893:                   this.handleFocusOutScanDialog("PackScanDialog--itemInput", "remove");
1894:                   // Use the new serial number dialog
1895:                   const oContext = new sap.ui.model.Context(this.getModel("DetailModel"), `/PackListLines/${i}`);
1896:                   this.openNewSerialNumberDialog(oContext, this._oPackScanDialog.packageContext, "ScanDialog");
1897:                   this._setPackedState("multi");
1898:                 }
1899:               } else {
1900:                 this._upByOne(i);
1901:                 this._focusPickedLine(packListLines[i]);
1902:               }
1903:               // Artikel gefunden und verarbeitet, Schleife nicht abbrechen, falls weitere Artikel existieren
1904:             }
1905:           }
1906:         }
1907:       }
1908:       if (!found) {
1909:         const audio = new Audio("Audio/Error.wav");
1910:         audio.oncanplaythrough = () => audio.play();
1911:         this.showError({ message: this.getMessage("itemNotFoundDetail"), helpUrl: null }, "418");
1912:       }
