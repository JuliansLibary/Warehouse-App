<file path="WarehouseApp/nAG.Warehouse.App.InventoryCount/webapp/model/formatter.js">
  1: sap.ui.define(["sap/ui/model/type/Currency", "sap/ui/Device"], function (Currency, Device) {
  2:   "use strict";
  3:   return {
  4:     /**
  5:      * Rounds the currency value to 2 digits
  6:      *
  7:      * @public
  8:      * @param {string} sValue value to be formatted
  9:      * @returns {string} formatted currency value with 2 digits
 10:      */
 11:     currencyValue: function (sValue) {
 12:       if (!sValue) {
 13:         return "";
 14:       }
 15:       return parseFloat(sValue).toFixed(2);
 16:     },
 17:     /**
 18:      * Rounds the currency value to 2 digits
 19:      *
 20:      * @public
 21:      * @param {number} iQuantity product quantity
 22:      * @param {number} fPrice product price
 23:      * @param {string} sCurrencyCode currency code for the price
 24:      * @returns {string} formatted currency value with 2 digits
 25:      */
 26:     calculateItemTotal: function (iQuantity, fPrice, sCurrencyCode) {
 27:       var oCurrency = new Currency({
 28:           showMeasure: false,
 29:         }),
 30:         fTotal = iQuantity * fPrice;
 31:       return oCurrency.formatValue([fTotal.toFixed(2), sCurrencyCode], "string");
 32:     },
 33:     /**
 34:      * Converts a binary string into an image format suitable for the src attribute
 35:      *
 36:      * @public
 37:      * @param {string} vData a binary string representing the image data
 38:      * @returns {string} formatted string with image metadata based on the input or a default image when the input is empty
 39:      */
 40:     handleBinaryContent: function (vData) {
 41:       if (vData) {
 42:         var sMetaData1 = "data:image/jpeg;base64,",
 43:           sMetaData2 = vData.substr(104); // stripping the first 104 bytes from the binary data when using base64 encoding.
 44:         return sMetaData1 + sMetaData2;
 45:       } else {
 46:         return "../images/Employee.png";
 47:       }
 48:     },
 49:     concatString: function (string1, string2) {
 50:       var output = string1 + " " + string2;
 51:       return output;
 52:     },
 53:     visibleState: function (inp1, inp2) {
 54:       if (inp1 == inp2) {
 55:         return false;
 56:       } else {
 57:         return true;
 58:       }
 59:     },
 60:     // Todo check i18n
 61:     numText: function (frotendModel) {
 62:       var frontendString;
 63:       if (frotendModel.length > 0) {
 64:         frotendModel.forEach((check) => {
 65:           if (check.Check === "Batch") {
 66:             frontendString = "Chargennummern:  \n";
 67:           }
 68:           if (check.Check === "Serial") {
 69:             frontendString = "Seriennummern:  \n";
 70:           }
 71:           if (check.Check === "Bin") {
 72:             frontendString = "Lagerplätze:  \n";
 73:           }
 74:           if (frontendString.split(/\s+|\\n/).includes(check.SerialorBatch) === false || frontendString === "") {
 75:             frontendString += check.SerialorBatch + " \n";
 76:           }
 77:           return frontendString;
 78:         });
 79:       } else {
 80:         return "";
 81:       }
 82:     },
 83:     numCheck: function (oRequired) {
 84:       if (oRequired === "tNO" || oRequired === false) {
 85:         return false;
 86:       } else {
 87:         return true;
 88:       }
 89:     },
 90:     valueCheck: function (oRequired) {
 91:       console.log(oRequired, "OReq");
 92:       if (oRequired === "tNO" || oRequired === false) {
 93:         return 0;
 94:       } else {
 95:         return 1;
 96:       }
 97:     },
 98:     // Dynamischer Check ob ein Artikel Serien oder Chargennummern geführt ist.
 99:     // Aufgrund dieses Status wird im Frontend der Input gesteuert
100:     numCheckSerialandBatch: function (batch, Serial) {
101:       if ((batch === "tNO" && Serial === "tNO") || (batch === false && Serial === false)) {
102:         return false;
103:       } else {
104:         return true;
105:       }
106:     },
107:     localDate: function (date) {
108:       var options = {
109:           day: "2-digit",
110:           month: "2-digit",
111:           year: "numeric",
112:         },
113:         parts,
114:         datestring;
115:       if (date !== null && typeof date === "string" && date.includes(".")) {
116:         parts = date.split(".");
117:         datestring = new Date(parseInt(parts[2], 10), parseInt(parts[1], 10) - 1, parseInt(parts[0], 10));
118:         return datestring.toLocaleDateString(navigator.language, options);
119:       }
120:       if (date !== null && typeof date === "string" && date.includes("-")) {
121:         parts = date.split("-");
122:         datestring = new Date(parseInt(parts[0], 10), parseInt(parts[1], 10) - 1, parseInt(parts[2], 10));
123:         return datestring.toLocaleDateString(navigator.language, options);
124:       } else if (date !== null && typeof date === "number") {
125:         var datenumber = new Date(date);
126:         return datenumber.toLocaleDateString(navigator.language, options);
127:       } else {
128:         return date;
129:       }
130:     },
131:     pickStatus: function (status) {
132:       switch (status) {
133:         case "P":
134:           return sap.ui.getCore().getModel("i18n").getResourceBundle().getText("partlyPicked");
135:         case "R":
136:           return sap.ui.getCore().getModel("i18n").getResourceBundle().getText("released");
137:         case "Y":
138:           return sap.ui.getCore().getModel("i18n").getResourceBundle().getText("picked");
139:         case "D":
140:           return sap.ui.getCore().getModel("i18n").getResourceBundle().getText("partlyDelivered");
141:         case "ps_Picked":
142:           return sap.ui.getCore().getModel("i18n").getResourceBundle().getText("partlyPicked");
143:         case "ps_Released":
144:           return sap.ui.getCore().getModel("i18n").getResourceBundle().getText("released");
145:         case "ps_PartiallyDelivered":
146:           return sap.ui.getCore().getModel("i18n").getResourceBundle().getText("partlyDelivered");
147:         default:
148:           return sap.ui.getCore().getModel("i18n").getResourceBundle().getText("picked");
149:       }
150:     },
151:     pickState: function (status) {
152:       switch (status) {
153:         case "P":
154:           return sap.ui.core.ValueState.Warning;
155:         case "R":
156:           return sap.ui.core.ValueState.Error;
157:         case "Y":
158:           return sap.ui.core.ValueState.Success;
159:         case "D":
160:           return sap.ui.core.ValueState.Warning;
161:         case "ps_Picked":
162:           return sap.ui.core.ValueState.Warning;
163:         case "ps_Released":
164:           return sap.ui.core.ValueState.Error;
165:         case "ps_PartiallyDelivered":
166:           return sap.ui.core.ValueState.Warning;
167:         default:
168:           return sap.ui.core.ValueState.Success;
169:       }
170:     },
171:     serialNumText: function (statusSerial, statusBatch, serialNum, batchNum) {
172:       if (typeof serialNum !== "undefined") {
173:         return serialNum;
174:       } else if (typeof batchNum !== "undefined") {
175:         return batchNum;
176:       } else if (statusSerial === "tYES") {
177:         return sap.ui.getCore().getModel("i18n").getResourceBundle().getText("serialNumberRequired");
178:       } else if (statusBatch === "tYES") {
179:         return sap.ui.getCore().getModel("i18n").getResourceBundle().getText("batchNumberRequired");
180:       } else {
181:         return sap.ui.getCore().getModel("i18n").getResourceBundle().getText("unmanaged");
182:         //return sap.ui.getCore().getModel("i18n").getResourceBundle().getText("noNumberRequired");
183:       }
184:     },
185:     serialNumState: function (statusSerial, statusBatch) {
186:       if (statusSerial === "tYES") {
187:         return "Error";
188:       } else if (statusBatch === "tYES") {
189:         return "Warning";
190:       } else {
191:         return "Success";
192:       }
193:     },
194:     selectQuantity: function (onHandQty, Quantity, CommitQty) {
195:       if (onHandQty !== null) {
196:         return onHandQty;
197:       } else {
198:         return Quantity - CommitQty;
199:       }
200:     },
201:     printIfNotEmpty: function (string1, string2) {
202:       if (string1 !== "" && string1 !== null && string2 !== "" && string2 !== null) {
203:         return string1 + " " + string2;
204:       } else {
205:         return "";
206:       }
207:     },
208:     isZero: function (string1) {
209:       if (string1 === 0 || string1 === "0") {
210:         return true;
211:       } else {
212:         return false;
213:       }
214:     },
215:     localDate: function (date) {
216:       var dateString = new Date(date);
217:       return dateString.toLocaleDateString(navigator.language, { year: "numeric", month: "2-digit", day: "2-digit" }) + " " + dateString.toLocaleTimeString(navigator.language, { hour: "2-digit", minute: "2-digit" });
218:     },
219:   };
220: });
</file>

