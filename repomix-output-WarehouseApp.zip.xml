702: router.post("/processBinLocations", async (req, res) => {
703:   try {
704:     const { items, sessionData, targetBinLocation, targetBinAbsEntry } = req.body;
705:     // Parse alle Werte
706:     const parsedItems = JSON.parse(items);
707:     const parsedSessionData = JSON.parse(sessionData);
708:     const parsedTargetBinLocation = JSON.parse(targetBinLocation);
709:     const parsedTargetBinAbsEntry = JSON.parse(targetBinAbsEntry);
710:     const processedItems = parsedItems.map((item) => {
711:       const rowData = { ...item };
712:       // Initialisierung
713:       rowData.SerialNumbers = [];
714:       rowData.BatchNumbers = [];
715:       rowData.toBookQuantity = rowData.OnHand;
716:       rowData.toBookBinLocations = [];
717:       // Seriennummern zuweisen
718:       if (rowData.ManageSerialNumbers === "Y") {
719:         const serialNumbersSession = (parsedSessionData.serialNumbers || []).filter((serial) => serial.ItemCode === rowData.ItemCode);
720:         if (serialNumbersSession.length > 0) {
721:           serialNumbersSession.forEach((serial, index) => {
722:             const serialCopy = { ...serial };
723:             serialCopy.Quantity = 1;
724:             serialCopy.systemSerialNumber = serial.SysNumber;
725:             serialCopy.InternalSerialNumber = serial.DistNumber;
726:             serialCopy.warehouseTo = parsedTargetBinAbsEntry;
727:             rowData.SerialNumbers.push(serialCopy);
728:           });
729:           rowData.toBookQuantity = rowData.SerialNumbers.length;
730:         }
731:       }
732:       // Chargennummern zuweisen
733:       if (rowData.ManageBatchNumbers === "Y") {
734:         const batchNumbersSession = (parsedSessionData.batchNumbers || []).filter((batch) => batch.ItemCode === rowData.ItemCode);
735:         if (batchNumbersSession.length > 0) {
736:           batchNumbersSession.forEach((batch) => {
737:             const batchCopy = { ...batch };
738:             batchCopy.Quantity = batch.Quantity || 1;
739:             batchCopy.BatchNumber = batch.DistNumber;
740:             batchCopy.warehouseTo = parsedTargetBinAbsEntry;
741:             const existingBatch = rowData.BatchNumbers.find((b) => b.BatchNumber === batch.DistNumber);
742:             if (existingBatch) {
743:               existingBatch.Quantity += batchCopy.Quantity;
744:             } else {
745:               rowData.BatchNumbers.push(batchCopy);
746:             }
747:           });
748:           rowData.toBookQuantity = rowData.BatchNumbers.reduce((sum, batch) => sum + batch.Quantity, 0);
749:         }
750:       }
751:       // toBookBinLocations erstellen
752:       if (rowData.ManageSerialNumbers === "Y" && rowData.SerialNumbers.length > 0) {
753:         rowData.toBookBinLocations = rowData.SerialNumbers.map((serial, index) => ({
754:           binLocationTo: parsedTargetBinLocation,
755:           binLocationAbsTo: parsedTargetBinAbsEntry,
756:           quantity: 1,
757:           SerialAndBatchNumbersBaseLine: index,
758:         }));
759:       } else if (rowData.ManageBatchNumbers === "Y" && rowData.BatchNumbers.length > 0) {
760:         rowData.toBookBinLocations = rowData.BatchNumbers.map((batch, index) => ({
761:           binLocationTo: parsedTargetBinLocation,
762:           binLocationAbsTo: parsedTargetBinAbsEntry,
763:           quantity: batch.Quantity || 1,
764:           SerialAndBatchNumbersBaseLine: index,
765:         }));
766:       } else {
767:         rowData.toBookBinLocations = [
768:           {
769:             binLocationTo: parsedTargetBinLocation,
770:             binLocationAbsTo: parsedTargetBinAbsEntry,
771:             quantity: rowData.OnHand,
772:             SerialAndBatchNumbersBaseLine: null,
773:           },
774:         ];
775:       }
776:       return rowData;
777:     });
778:     res.status(200).json({ processedItems });
779:   } catch (error) {
780:     console.error("Error processing bin locations:", error);
781:     res.status(500).json({ error: "An error occurred while processing bin locations." });
782:   }
783: });
