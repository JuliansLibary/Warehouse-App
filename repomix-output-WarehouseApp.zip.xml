 21:         DocumentSpecialLines: orders.DocumentSpecialLines,
 22:         DocumentLines: [],
 23:         DocumentPackages: [],
 24:       };
 25:       orders.DocumentLines.forEach((transferLine, index) => {
 26:         if (transferLine.Quantity > 0 && transferLine.PickStatus !== "tYes" && transferLine.LineStatus === "bost_Open" && transferLine.WarehouseCode === WarehouseCode && transferLine.TreeType !== "iSalesTree") {
 27:           newOrder.DocumentLines.push({
 28:             LineNum: transferLine.LineNum,
 29:             DocNum: orders.DocNum,
 30:             ItemCode: transferLine.ItemCode,
 31:             ItemDescription: transferLine.ItemDescription,
 32:             TreeType: transferLine.TreeType,
 33:             BaseType: BaseType,
 34:             BaseEntry: transferLine.BaseEntry,
 35:             RemainingOpenQuantity: transferLine.RemainingOpenQuantity,
 36:             QuantityFrontend: transferLine.RemainingOpenQuantity,
 37:             Quantity: 0,
 38:             BatchNumbers: [],
 39:             DocumentLinesBinAllocations: [],
 40:             SerialNumbers: [],
 41:             WarehouseCode: transferLine.WarehouseCode,
 42:             SerialOrBatchModel: [],
 43:             SerialOrBatch: null,
 44:             NodeID: index,
 45:             HierarchyLevel: 0,
 46:             isCopy: "false",
 47:             _id: 0,
 48:             DrillState: "expanded",
 49:           });
 50:         }
 51:       });
 52:       resolve(newOrder);
 53:     } catch (error) {
 54:       reject(error);
 55:     }
 56:   });
 57: }
 58: /**
 59:  * formats the Response from ServiceLayer for Frontend
 60:  * @param {json} orders
 61:  */
 62: function formatOrderForFrontend(orders, Invoices, cacheData, documentLockData) {
 63:   return new Promise((resolve) => {
 64:     const response = [];
 65:     const orderSet = new Set();
 66:     const invoiceSet = new Set();
 67:     const cacheEntries = cacheData;
 68:     const documentLocks = documentLockData;
 69:     const isDocumentCached = (docEntry) => cacheEntries.some((entry) => entry.documentNumber === docEntry && !entry.isDeleted);
 70:     const isDocumentLocked = (docEntry) => {
 71:       try {
 72:         const currentDate = dayjs().valueOf();
 73:         return documentLocks.some((lock) => {
 74:           const lockTime = dayjs(lock.latestChangeDate).valueOf();
 75:           return lock.documentNumber === docEntry && lockTime + parseInt(global.gConfig.documentLockTimer, 10) * 60000 >= currentDate;
 76:         });
 77:       } catch (error) {
 78:         return false;
 79:       }
 80:     };
 81:     const formatDate = (date) => {
 82:       if (!date) return date;
 83:       const parsedDate = dayjs(date);
 84:       return parsedDate.isValid() ? parsedDate.format("DD.MM.YYYY") : date;
 85:     };
 86:     const processEntity = (entity, baseType, entitySet, sourceArray) => {
 87:       const hasEntry = isDocumentCached(entity.DocEntry);
 88:       const isLocked = isDocumentLocked(entity.DocEntry);
 89:       if (!entitySet.has(entity.DocEntry)) {
 90:         const checkDeliveryState = sourceArray.filter((item) => item.DocEntry === entity.DocEntry && item.OnHand - item.Quantity - item.DeliveredQuantity >= 0);
 91:         const itemCounter = sourceArray.filter((item) => item.DocEntry === entity.DocEntry);
 92:         response.push({
 93:           CardCode: entity.CardCode,
 94:           CardName: entity.CardName,
 95:           DocDueDate: formatDate(entity.DocDueDate),
 96:           DocEntry: entity.DocEntry,
 97:           DocNum: entity.DocNum,
 98:           NumAtCard: entity.NumAtCard,
 99:           Comments: entity.Comments,
100:           BaseType: baseType,
101:           isCached: hasEntry,
102:           isLocked: isLocked,
103:           completeDelivery: checkDeliveryState.length === itemCounter.length ? "tYES" : "tNO",
104:         });
105:         entitySet.add(entity.DocEntry);
106:       }
107:     };
108:     // Process Orders
109:     orders.forEach((order) => {
110:       processEntity(order, 17, orderSet, orders);
111:     });
112:     // Process Invoices
113:     Invoices.forEach((invoice) => {
114:       processEntity(invoice, 13, invoiceSet, Invoices);
115:     });
116:     // Sort by DocDueDate in descending order
117:     resolve(response.sort((a, b) => dayjs(b.DocDueDate).valueOf() - dayjs(a.DocDueDate).valueOf()));
118:   });
119: }
