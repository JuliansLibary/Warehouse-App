 8:   return new Promise((resolve, reject) => {
 9:     http.get("http://Module-AdminPanel.warehouseapp:8005/businesslogic/configurationForModule/" + module + "/" + tenant, function (response) {
10:       let rawData = "";
11:       response.on("data", (chunk) => {
12:         rawData += chunk;
13:       });
14:       response.on("end", () => {
15:         try {
16:           rawData = JSON.parse(rawData);
17:           global.gConfig.SLURL = rawData.instance_SLURL;
18:           global.gConfig.SLPort = rawData.instance_SLPort;
19:           global.gConfig.database = tenant;
20:           if (rawData.conf_config !== "{}") {
21:             Object.entries(JSON.parse(rawData.conf_config.replaceAll("\\", ""))).forEach(([key, value]) => {
22:               global.gConfig[key] = value;
23:             });
24:           }
25:           resolve(response.statusCode);
26:         } catch (e) {
27:           reject(e);
28:         }
29:       });
30:     });
31:   });
32: }
