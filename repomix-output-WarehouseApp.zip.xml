 486:     dropDocumentLock: function () {
 487:       const that = this;
 488:       const docEntry = that.getModel("openOrdersFrontend").getData().DocEntry;
 489:       const tenantId = that.getModel("SessionModel").getData().tenantId;
 490:       that.makeAjaxRequest(
 491:         "GET",
 492:         `documentLock/checkdocumentLock/${docEntry}/SalesOrderDelivery/${tenantId}`,
 493:         null,
 494:         "loginError",
 495:         (response_getDocumentLock) => {
 496:           if (response_getDocumentLock !== false) {
 497:             const documentLock = response_getDocumentLock;
 498:             that.makeAjaxRequest("GET", "user/getUser", null, "loginError", (response_getCurrentUser) => {
 499:               if (documentLock !== null && documentLock.createUserLock === response_getCurrentUser.id) {
 500:                 that.makeAjaxRequest("DELETE", `documentLock/deleteDocumentLock/${documentLock.id}`, null, "loginError", () => { });
 501:               }
 502:             });
 503:           }
 504:         }
 505:       );
 506:     },
 507:     checkDocumentLock: function (checkFromWorker) {
 508:       const that = this;
 509:       return new Promise((resolve, reject) => {
 510:         try {
 511:           const docEntry = that.getModel("openOrdersFrontend").getData().DocEntry;
 512:           const tenantId = that.getModel("SessionModel").getData().tenantId;
 513:           that.makeAjaxRequest(
 514:             "GET",
 515:             `documentLock/checkdocumentLock/${docEntry}/SalesOrderDelivery/${tenantId}`,
 516:             null,
 517:             "loginError",
 518:             (response_getDocumentLock) => {
 519:               const documentLock = response_getDocumentLock;
 520:               if (documentLock !== null) {
 521:                 const currentDate = new Date();
 522:                 const lockExpiryTime = new Date(Date.parse(documentLock.latestChangeDate)).getTime() +
 523:                   parseInt(that.getViewModel("appView").getProperty("/documentLockTimer")) * 60000;
 524:                 if (checkFromWorker && lockExpiryTime < currentDate.getTime()) {
 525:                   resolve(200);
 526:                 } else {
 527:                   that.makeAjaxRequest(
 528:                     "GET",
 529:                     `user/compareCurrentUser/${documentLock.createUserLock}`,
 530:                     null,
 531:                     "loginError",
 532:                     (response_getCurrentUser) => {
 533:                       resolve(200);
 534:                     }
 535:                   );
 536:                 }
 537:               } else {
 538:                 resolve(200);
 539:               }
 540:             }
 541:           );
 542:         } catch (error) {
 543:           console.error(error);
 544:           resolve(200);
 545:         }
 546:       });
 547:     },
