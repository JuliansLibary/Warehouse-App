 641:     _addPackLine: function (packageContext, modelContext, batchLine) {
 642:       const pack = this.getModel("deliveryModel").getData().Package;
 643:       const packageNum = packageContext.getPath().split("/").pop();
 644:       const object = typeof modelContext.getObject() !== "object" ? modelContext : modelContext.getObject();
 645:       let found = false;
 646:       for (let j = 0; j < pack[packageNum].DeliveryLines.length; j++) {
 647:         const deliveryLine = pack[packageNum].DeliveryLines[j];
 648:         if (object.AbsoluteEntry === deliveryLine.AbsoluteEntry &&
 649:           object.DocNum === deliveryLine.DocNum &&
 650:           object.ItemCode === deliveryLine.ItemCode &&
 651:           object.OrderEntry === deliveryLine.OrderEntry &&
 652:           object.OrderRowID === deliveryLine.OrderRowID) {
 653:           found = true;
 654:           if (object.ManageSerialNumbers === "N") {
 655:             deliveryLine.PackedQuantity += object.PackedQuantity - object.PreviouslyPackedQuantity;
 656:           }
 657:           if (batchLine !== null) {
 658:             this._addBatch(packageNum, batchLine, j, object);
 659:           }
 660:         }
 661:       }
 662:       const modelDeliveryLines = this.getModel("deliveryModel").getProperty(packageContext.getPath()).DeliveryLines;
 663:       if (!found) {
 664:         if (batchLine !== null && batchLine !== undefined) {
 665:           object.BatchNumbers[batchLine].Quantity = object.PackedQuantity - object.PreviouslyPackedQuantity;
 666:         }
 667:         if (object.PackedQuantity - object.PreviouslyPackedQuantity > 0 && object.ManageSerialNumbers === "N") {
 668:           const newLine = JSON.parse(JSON.stringify(object));
 669:           newLine.PackedQuantity = object.PackedQuantity - object.PreviouslyPackedQuantity;
 670:           newLine.DetailPath = modelContext.getPath();
 671:           modelDeliveryLines.push(newLine);
 672:         } else if (object.ManageSerialNumbers === "Y") {
 673:           const modelToCheck = JSON.parse(JSON.stringify(object));
 674:           modelToCheck.SerialNumbers = modelToCheck.SerialNumbers.filter(deliveryLine => parseInt(deliveryLine.Package) === parseInt(packageNum));
 675:           const quantity = modelToCheck.SerialNumbers.length;
 676:           if (quantity > 0) {
 677:             modelToCheck.DocumentLinesBinAllocations = modelToCheck.DocumentLinesBinAllocations.filter(deliveryLine => parseInt(deliveryLine.Package) === parseInt(packageNum));
 678:             modelDeliveryLines.push(modelToCheck);
 679:             modelDeliveryLines[modelDeliveryLines.length - 1].PackedQuantity = quantity;
 680:           }
 681:         }
 682:       }
 683:       this._updatePackListLines();
 684:       object.PreviouslyPackedQuantity = object.PackedQuantity;
 685:       this.oEventBus.publish("nAG", "hideBusyDialog");
 686:       this.getModel("deliveryModel").refresh();
 687:     },
