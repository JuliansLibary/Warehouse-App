 1: const request = require("request");
 2: const jose = require("jose");
 3: const baseUrl = "http://System-DatabaseConnector.warehouseapp:3000";
 4: // Compare the current user with a given user ID
 5: async function compareCurrentUser(req, res) {
 6:   try {
 7:     const claims = jose.decodeJwt(req.headers.authorization);
 8:     request.get(`${baseUrl}/User/${claims.preferred_username}`, {}, (error, response) => {
 9:       if (error) return res.send(false);
10:       try {
11:         const item = JSON.parse(response.body);
12:         return item.id === req.params.userId.toString() ? res.status(200).send(true) : res.send(false);
13:       } catch (errorCatch) {
14:         console.error(errorCatch);
15:         return res.send(false);
16:       }
17:     });
18:   } catch (error) {
19:     console.error(error);
20:     return res.status(500).send(false);
21:   }
22: }
23: // Get the currently logged-in user's details
24: async function getUser(req, res) {
25:   try {
26:     const claims = jose.decodeJwt(req.headers.authorization);
27:     request.get(`${baseUrl}/User/${claims.preferred_username}`, {}, (error, response) => {
28:       if (error) return res.status(500).send({ body: { message: "Error fetching user data" } });
29:       return res.send(JSON.parse(response.body));
30:     });
31:   } catch (error) {
32:     console.error(error);
33:     return res.status(500).send({ body: { message: "Error decoding token" } });
34:   }
35: }
36: // Get tenant details by tenant name
37: async function getTenantByName(req, res) {
38:   request.get(`${baseUrl}/TenantByName/${req.params.tenant}`, {}, (error, response) => {
39:     if (error || response.statusCode !== 200) {
40:       return res.status(500).send({ body: { message: "Error fetching tenant data" } });
41:     }
42:     return res.send(response.body);
43:   });
44: }
45: // Get all users
46: async function getAllUsers(req, res) {
47:   request.get(`${baseUrl}/Users`, {}, (error, response) => {
48:     if (response.body !== "null") {
49:       if (!error && response.statusCode === 200) {
50:         try {
51:           res.send(JSON.parse(response.body));
52:         } catch (errorCatch) {
53:           res.status(400).send({ body: { message: errorCatch } });
54:         }
55:       } else {
56:         res.send(false);
57:       }
58:     }
59:   });
60: }
61: // App configuration
62: async function appConfig(req, res) {
63:   const appconfig = {
64:     bookQSWarehouse: global.gConfig.bookQSWarehouse,
65:     useCustomBatchGenerator: global.gConfig.useCustomBatchGenerator,
66:     customBatchOperations: global.gConfig.customBatchOperations,
67:     saveInterval: global.gConfig.saveIntervall,
68:     isDeleted: global.gConfig.isDeleted,
69:     documentLockTimer: global.gConfig.documentLockTimer,
70:     OrderPurchaseView: global.gConfig.OrderPurchaseView,
71:     continuePosting: global.gConfig.continuePosting
72:   };
73:   res.send(appconfig);
74: }
75: module.exports = {
76:   compareCurrentUser,
77:   getUser,
78:   getTenantByName,
79:   getAllUsers,
