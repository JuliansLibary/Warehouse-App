131:     // Calculate total booked serials across all packages (exact frontend logic)
132:     let totalBookedSerials = 0;
133:     if (deliveryData.Package && Array.isArray(deliveryData.Package)) {
134:       deliveryData.Package.forEach((pkg) => {
135:         if (pkg.DeliveryLines && Array.isArray(pkg.DeliveryLines)) {
136:           pkg.DeliveryLines.forEach((deliveryLine) => {
137:             if (deliveryLine.ItemCode === itemData.ItemCode && 
138:                 deliveryLine.WarehouseCode === itemData.WarehouseCode &&
139:                 deliveryLine.AbsoluteEntry === itemData.AbsoluteEntry &&
140:                 deliveryLine.DocNum === itemData.DocNum &&
141:                 deliveryLine.OrderEntry === itemData.OrderEntry &&
142:                 deliveryLine.OrderRowID === itemData.OrderRowID) {
143:               totalBookedSerials += (deliveryLine.SerialNumbers?.length || 0);
144:             }
145:           });
146:         }
147:       });
148:     }
149:     // Update quantities exactly as frontend does
150:     detailItem.PackedQuantity = totalBookedSerials;
151:     detailItem.PreviouslyPackedQuantity = totalBookedSerials;
152:     // Update SerialNumbersFrontend string for display (exact frontend logic)
153:     const allSerials = [];
154:     if (deliveryData.Package && Array.isArray(deliveryData.Package)) {
155:       deliveryData.Package.forEach((pkg) => {
156:         if (pkg.DeliveryLines && Array.isArray(pkg.DeliveryLines)) {
157:           pkg.DeliveryLines.forEach((deliveryLine) => {
158:             if (deliveryLine.ItemCode === itemData.ItemCode && 
159:                 deliveryLine.WarehouseCode === itemData.WarehouseCode &&
160:                 deliveryLine.SerialNumbers && Array.isArray(deliveryLine.SerialNumbers)) {
161:               deliveryLine.SerialNumbers.forEach((serial) => {
