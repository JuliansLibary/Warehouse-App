  1: /* eslint no-unused-expressions: ["error", { "allowShortCircuit": true }]*/
  2: sap.ui.define(["nag/WarehouseApp/SalesOrderDelivery/BaseController"], function (BaseController) {
  3:   "use strict";
  4:   return BaseController.extend("nag.WarehouseApp.SalesOrderDelivery.controller.Warehouse", {
  5:     /**
  6:      * Called when a controller is instantiated and its View controls (if available) are already created.
  7:      * Can be used to modify the View before it is displayed, to bind event handlers and do other one-time initialization.
  8:      * @memberOf nAG.PurchaseDeliveryNote.view.Master
  9:      */
 10:     onInit: function () {
 11:       // Initialize the Event Bus
 12:       this.eventBus = sap.ui.getCore().getEventBus();
 13:       this._initializeRoute();
 14:     },
 15:     _initializeRoute: function () {
 16:       // Set up route matching for the "Warehouse" route
 17:       this.getRouter().getRoute("Warehouse").attachPatternMatched(this._onWarehouseMatched, this);
 18:     },
 19:     onLogout: function () {
 20:       // Navigate back to the launchpad with specific theme, language, and tenant
 21:       const queryParams = this._getUrlParameters();
 22:       const launchpadUrl = `/launchpad/?Theme=${queryParams.theme}&Language=${queryParams.language}&Tenant=${queryParams.tenant}#/Dashboard`;
 23:       window.open(launchpadUrl, "_top");
 24:     },
 25:     _getUrlParameters: function () {
 26:       // Helper function to retrieve URL parameters
 27:       return {
 28:         theme: this.getUrlVars().Theme,
 29:         language: this.getUrlVars().Language,
 30:         tenant: this.getUrlVars().Tenant
 31:       };
 32:     },
 33:     _onWarehouseMatched: function () {
 34:       // Show busy dialog using Event Bus
 35:       this.eventBus.publish("nAG", "showBusyDialog");
 36:       if (window.location.href.includes("?Theme=")) {
 37:         sap.ui.getCore().applyTheme(this.getUrlVars().Theme);
 38:       }
 39:       if (window.location.href.includes("&Language=")) {
 40:         sap.ui.getCore().getConfiguration().applySettings({
 41:           language: this.getUrlVars().Language,
 42:         });
 43:       }
 44:       // Initialize SessionModel if not already defined
 45:       if (!this.getModel("SessionModel")) {
 46:         const sessionModel = new sap.ui.model.json.JSONModel({
 47:           WarehouseCode: null
 48:         });
 49:         this.setModel(sessionModel, "SessionModel");
 50:         this.setViewModel(sessionModel, "SessionModel");
 51:         sessionModel.refresh();
 52:       }
 53:       const warehouseURL = this._buildWarehouseURL();
 54:       // Initialize WarehouseModel if not already defined
 55:       const warehouseModel = new sap.ui.model.json.JSONModel();
 56:       this.setModel(warehouseModel, "WarehouseModel");
 57:       this.setViewModel(warehouseModel, "WarehouseModel");
 58:       this.makeAjaxRequest("GET", warehouseURL, null, "warehouseError", (response) => {
 59:         warehouseModel.setData(response);
 60:         warehouseModel.refresh();
 61:         if (response.length === 1) {
 62:           this._handleSingleWarehouseResponse(response);
 63:         } else {
 64:           this._handleMultipleWarehouseResponse(response);
 65:         }
 66:       });
 67:     },
 68:     onSearch: function (oEvent) {
 69:       // Build filters based on search query
 70:       const query = oEvent.getParameter("query");
 71:       const filters = query
 72:         ? [
 73:           new sap.ui.model.Filter({
 74:             filters: [
 75:               new sap.ui.model.Filter("WarehouseCode", sap.ui.model.FilterOperator.EQ, query),
 76:               new sap.ui.model.Filter("WarehouseName", sap.ui.model.FilterOperator.Contains, query)
 77:             ],
 78:             and: false
 79:           })
 80:         ]
 81:         : [];
 82:       // Apply filters to the list binding
 83:       const list = this.byId("lstWarehouse");
 84:       const binding = list.getBinding("items");
 85:       binding.filter(filters);
 86:     },
 87:     _buildWarehouseURL: function () {
 88:       // Helper to construct the warehouse URL
 89:       const tenant = this.getUrlVars().Tenant;
 90:       let url = `warehouse/warehouse/${tenant}`;
 91:       const location = decodeURIComponent(this.getUrlVars().location);
 92:       if (location !== "undefined") {
 93:         url += `/${location}`;
 94:       }
 95:       return url;
 96:     },
 97:     _handleSingleWarehouseResponse: function (response) {
 98:       // Handle scenario when only one warehouse is returned
 99:       const appViewModel = this.getViewModel("appView");
100:       const sessionModel = this.getModel("SessionModel");
101:       appViewModel.setProperty("/layout", "TwoColumnsMidExpanded");
102:       sessionModel.getData().WarehouseCode = response[0].WarehouseCode;
103:       sessionModel.getData().EnableBinLocations = response[0].EnableBinLocations;
104:       sessionModel.refresh();
105:       this.getRouter().navTo("OpenOrders");
106:       this.eventBus.publish("nAG", "hideBusyDialog");
107:     },
108:     _handleMultipleWarehouseResponse: function (response) {
109:       // Handle scenario when multiple warehouses are returned
110:       const warehouseModel = this.getModel("WarehouseModel");
111:       const sessionModel = this.getModel("SessionModel");
112:       if (warehouseModel.getData().length === 1) {
113:         sessionModel.getData().WarehouseCode = warehouseModel.getData()[0].WarehouseCode;
114:         this.getRouter().navTo("WarehouseTo");
115:       }
116:       this.eventBus.publish("nAG", "hideBusyDialog");
117:     },
118:     onItemPressed: function (oEvent) {
119:       // Show busy dialog using Event Bus
120:       this.eventBus.publish("nAG", "showBusyDialog");
121:       // Retrieve selected warehouse details
122:       const warehouse = oEvent.getSource().getSelectedItem().getBindingContext("WarehouseModel").getObject();
123:       const sessionModel = this.getModel("SessionModel");
124:       // Update SessionModel with selected warehouse details
125:       Object.assign(sessionModel.getData(), {
126:         WarehouseCode: warehouse.WarehouseCode,
127:         EnableBinLocations: warehouse.BinLocations,
128:         DefaultBin: warehouse.DefaultBin,
129:         DefaultBinEnforced: warehouse.DefaultBinEnforced
130:       });
131:       sessionModel.refresh();
132:       // Navigate to OpenOrders and hide busy dialog
133:       this.getRouter().navTo("OpenOrders");
134:       this.eventBus.publish("nAG", "hideBusyDialog");
135:     },
136:     onRefreshWarehouses: function () {
137:       this._onWarehouseMatched()
138:     },
139:   });
140: });
