222:         this.getRouter().navTo("Orders", {}, false);
223:       }
224:     },
225:     /**
226:      * Convenience method for setting Debugmode
227:      */
228:     setDebugMode: function (boolean) {
229:       $.sap.debugMode = boolean;
230:     },
231:     /**
232:      * Convenience method for  getting Debugmode
233:      */
234:     getDebugMode: function () {
235:       return $.sap.debugMode;
236:     },
237:     // #endregion
238:     // #region Dialog Management
239:     /**
240:      * Convenience method for saving the BusyDialog in a global variable
241:      * @public
242:      */
243:     getBusyDialog: function () {
244:       const busyDialog = sap.ui.xmlfragment("busyDialog", "nAG.WarehouseApp_Pack.view.BusyDialog", this);
245:       this.getView().addDependent(busyDialog);
246:       this.busyDialog = busyDialog;
247:     },
248:     /**
