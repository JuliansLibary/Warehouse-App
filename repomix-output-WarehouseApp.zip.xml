43: 						type="Active"
44: 						title="{InventoryModel>DocumentNumber}"
45: 						number="{InventoryModel>CountDate}"
46: 						id="itmWarehouse"
47: 					/>
48: 				</items>
49: 				<headerToolbar>
50: 					<OverflowToolbar
51: 						width="100%"
52: 						id="tlb3"
53: 					>
54: 						<SearchField
55: 							id="sfd"
56: 							tooltip="{i18n>WarehouseSearchTooltip}"
57: 							width="100%"
58: 							search="onSearch"
59: 						>
60: 							<layoutData>
61: 								<OverflowToolbarLayoutData
