  2: function mountManagerRoutes(app, metrics, options = {}) {
  3:   const withAuth = options.withAuth === true;
  4:   const ensureAuth =
  5:     typeof options.requireAuthMiddleware === "function"
  6:       ? options.requireAuthMiddleware
  7:       : (req, res, next) => next();
  8:   const chain = withAuth ? [ensureAuth] : [];
  9:   /* ======================================================
 10:    * 1) Balancer-Manager
 11:    * ====================================================== */
 12:   app.get("/balancer-manager", ...chain, (_req, res) => {
 13:     const now = Date.now();
 14:     const minus1m = now - 60 * 1000;
 15:     const minus5m = now - 5 * 60 * 1000;
 16:     const rows = [];
 17:     for (const t of metrics.targets.values()) {
 18:       let tp1m = 0,
 19:         tp5m = 0;
 20:       for (const s of t.window) {
 21:         if (s.t >= minus1m) tp1m++;
 22:         if (s.t >= minus5m) tp5m++;
 23:       }
 24:       rows.push(`
 25:         <tr>
 26:           <td>${t.target}</td>
 27:           <td class="num">${t.requests}</td>
 28:           <td class="num">${t.errors}</td>
 29:           <td class="num">${t.inflight}</td>
 30:           <td class="num">${tp1m}/min</td>
 31:           <td class="num">${tp5m}/5min</td>
 32:           <td class="num">${t.rolling.avgMs1m.toFixed(0)} ms</td>
 33:           <td class="num">${t.rolling.avgMs5m.toFixed(0)} ms</td>
 34:         </tr>
 35:       `);
 36:     }
 37:     res.setHeader("content-type", "text/html; charset=utf-8");
 38:     res.end(`<!doctype html>
 39: <html>
 40: <head>
 41:   <meta charset="utf-8"/>
 42:   <title>nAG Balancer-Manager</title>
 43:   <meta http-equiv="refresh" content="3"/>
 44:   <style>
 45:     :root { --fg:#111; --muted:#666; --line:#e6e6e6; }
 46:     body { font-family: ui-sans-serif, system-ui, -apple-system, Segoe UI, Roboto, Arial; margin: 24px; color: var(--fg); }
 47:     h1 { margin: 0 0 12px 0; }
 48:     table { border-collapse: collapse; width: 100%; }
 49:     th, td { padding: 8px 10px; border-bottom: 1px solid var(--line); }
 50:     th { text-align:left; background:#fafafa; position: sticky; top: 0; }
 51:     .muted { color: var(--muted); font-size: 12px; margin-bottom: 8px; }
 52:     .kpi { display:inline-block; margin-right: 16px; }
 53:     .num { text-align: right; }
 54:   </style>
 55: </head>
 56: <body>
 57:   <h1>nAG Warehouse App Balancer-Manager</h1>
 58:   <div class="muted">
 59:     <span class="kpi">Laufzeit: ${Math.round(
 60:       (Date.now() - metrics.startedAt) / 1000
 61:     )}s</span>
 62:     <span class="kpi">Anfragen (gesamt): ${metrics.totals.requests}</span>
 63:     <span class="kpi">Fehler (gesamt): ${metrics.totals.errors}</span>
 64:     <span class="kpi">Ziele: ${metrics.targets.size}</span>
 65:   </div>
 66:   <table>
 67:     <thead>
 68:       <tr>
 69:         <th>Ziel</th>
 70:         <th class="num">Anfragen (gesamt)</th>
 71:         <th class="num">Fehler (gesamt)</th>
 72:         <th class="num">In-Flight</th>
 73:         <th class="num">Aufrufe 1&nbsp;min</th>
 74:         <th class="num">Aufrufe 5&nbsp;min</th>
 75:         <th class="num">Ø Dauer 1&nbsp;min</th>
 76:         <th class="num">Ø Dauer 5&nbsp;min</th>
 77:       </tr>
 78:     </thead>
 79:     <tbody>${
 80:       rows.join("") ||
 81:       `<tr><td colspan="8">Noch keine Proxy-Requests.</td></tr>`
 82:     }</tbody>
 83:   </table>
 84: </body>
 85: </html>`);
 86:   });
 87:   /* ======================================================
 88:    * 2) /__metrics: EN – Standard Prometheus Namen
 89:    *    (für bestehende Dashboards beibehalten)
 90:    * ====================================================== */
 91:   app.get("/balancer_manager_EN", ...chain, (_req, res) => {
 92:     let out = "";
 93:     out += `# HELP requests_total Total number of requests\n`;
 94:     out += `# TYPE requests_total counter\n`;
 95:     out += `requests_total ${metrics.totals.requests}\n\n`;
 96:     out += `# HELP errors_total Total number of 5xx proxy errors\n`;
 97:     out += `# TYPE errors_total counter\n`;
 98:     out += `errors_total ${metrics.totals.errors}\n\n`;
 99:     for (const t of metrics.targets.values()) {
100:       const label = `target="${t.target.replace(/"/g, '\\"')}"`;
101:       out += `target_requests_total{${label}} ${t.requests}\n`;
102:       out += `target_errors_total{${label}} ${t.errors}\n`;
