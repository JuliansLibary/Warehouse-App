 1: //worker.js
 2: var content,
 3:   xmlHttp = new XMLHttpRequest();
 4: const result = "";
 5: var tenantId,
 6: AbsoluteEntry,
 7: userId;
 8: onmessage = function (event) {
 9:   content = event.data;
10:   this.tenantId = event.data.tenantId;
11:   this.userId = event.data.userId;
12:   this.AbsoluteEntry = event.data.AbsEntry;
13:   return new Promise(function (resolve, reject) {
14:     resolve(checkSaveState());
15:   })
16:     .then((responseCheck) => {
17:       return patchContent(responseCheck);
18:     })
19:     .catch((err) => {
20:       console.log(err, "error");
21:       return postContent();
22:     });
23: };
24: async function checkSaveState() {
25:   const response = await _checkSaveState();
26:   return response;
27: }
28: async function _checkSaveState() {
29:   return new Promise(function (resolve, reject) {
30:     xmlHttp.open("GET", "cachelogic/checkCache/" + AbsoluteEntry + "/InventoryCount/" + tenantId);
31:     xmlHttp.withCredentials = true;
32:     xmlHttp.onreadystatechange = function () {
33:       if (xmlHttp.readyState == 4 && xmlHttp.status == 209) {
34:         reject("No Data found for patch");
35:       } else if (xmlHttp.readyState == 4 && xmlHttp.status == 200 && xmlHttp.response) {
36:         resolve(xmlHttp.response);
37:       }else if(xmlHttp.readyState == 4 && xmlHttp.status == 202){
38:         resolve(xmlHttp.status);
39:       }
40:     };
41:     xmlHttp.onerror = function () {
42:       reject(Error("Network Error"));
43:     };
44:     xmlHttp.send();
45:   });
46: }
47: async function postContent() {
48:   // Do the usual XHR stuff
49:   xmlHttp.open("POST", "cachelogic/saveCache", false);
50:   xmlHttp.setRequestHeader("Content-type", "application/json");
51:   xmlHttp.onreadystatechange = function () {
52:     if (xmlHttp.readyState == 4 && xmlHttp.status == 200) {
53:       postMessage("true");
54:     }
55:   };
56:   // Handle network errors
57:   xmlHttp.onerror = function () {
58:     reject(Error("Network Error"));
59:   };
60:   // Make the request
61:   xmlHttp.send(
62:     JSON.stringify({
63:       documentNumber: AbsoluteEntry,
64:       module: "InventoryCount",
65:       documentType: "Inventurliste",
66:       content: JSON.stringify(content),
67:       tenantId: tenantId,
68:       createDate: new Date(Date.now()).toISOString(),
69:       updateDate: new Date(Date.now()).toISOString(),
70:       updatedByUser: userId,
71:       createdByUser: userId,
72:       // For now set the Remark to empty string
73:       remark: "",
74:       isDeleted:false,
75:     })
76:   );
77: }
78: async function patchContent(responseCheck) {
79:   xmlHttp.open("POST", "cachelogic/patchCache/" + JSON.parse(responseCheck).id, false);
80:   xmlHttp.setRequestHeader("Content-type", "application/json");
81:   xmlHttp.onreadystatechange = function () {
82:     if (xmlHttp.readyState == 4 && xmlHttp.status == 200) {
83:       postMessage("true");
84:     } else if (xmlHttp.readyState == 4 && xmlHttp.status == 209) {
85:       postMessage("true");
86:     }else if (xmlHttp.readyState == 4 && xmlHttp.status !== 209 && xmlHttp.status !== 200) {
87:       postMessage("false");
88:     }
89:   };
90:   xmlHttp.send(
91:     JSON.stringify(
92:     {
93:     content: JSON.stringify(content),
94:     updateDate: new Date(Date.now()).toISOString(),
95:     updatedByUser: userId,
96:     // For now set the Remark to empty string
97:     remark: "",
98:   }));
99: }
