 547:     savePickedQuantity: function (oEvent) {
 548:       const object = oEvent.getSource().getBindingContext("purchaseOrderModel").getObject(),
 549:         dateFormatter = DateFormat.getDateInstance({ pattern: "YYYY-MM-dd" }),
 550:         batchDialog = "batchDialog",
 551:         scanDialog = "ScanDialog",
 552:         itemDetailsDialog = "itemDetailsDialog",
 553:         purchaseDeliveryNoteModel = this.getModel("purchaseDeliveryNoteModel");
 554:       // Set DeliveryLine to scanned
 555:       purchaseDeliveryNoteModel.getData().DeliveryLines.forEach((deliveryLine) => {
 556:         if (deliveryLine.ItemCode === object.ItemCode) {
 557:           deliveryLine.isScanned = "true";
 558:         }
 559:       });
 560:       if (object.ManageBatchNumbers === "tYES") {
 561:         const batchPickedQuantity = parseInt(Fragment.byId(batchDialog, "PickedQuantity").getValue()),
 562:           batchNumber = Fragment.byId(batchDialog, "inpBatchNumber").getValue(),
 563:           batchDateValue = Fragment.byId(batchDialog, "inpBatchDate").getDateValue();
 564:         // Create batch object
 565:         const tempBatch = {
 566:           Quantity: batchPickedQuantity,
 567:           BatchNumber: batchNumber,
 568:           BaseLineNumber: object.LineNum,
 569:           BinAbsEntry: Fragment.byId(scanDialog, "inpBatch").getSelectedKey(),
 570:           ItemCode: batchNumber,
 571:           _id: object.DocumentLinesBinAllocations.length + 1,
 572:           _idItemCode: object.ItemCode,
 573:           ...(batchDateValue && { ExpiryDate: dateFormatter.format(batchDateValue), openQuantity: batchPickedQuantity }),
 574:         };
 575:         // Find existing batch
 576:         const findBatchNumbers = object.BatchNumbers?.find((batch) => batch.BatchNumber === batchNumber);
 577:         if (findBatchNumbers) {
 578:           // Update existing batch
 579:           object.BatchNumbers.forEach((batchNumbersLine) => {
 580:             if (batchNumbersLine.BatchNumber === batchNumber) {
 581:               batchNumbersLine.Quantity += batchPickedQuantity;
 582:               batchNumbersLine.openQuantity += batchPickedQuantity;
 583:             }
 584:           });
 585:           object.openQuantity += batchPickedQuantity;
 586:         } else {
 587:           // Add new batch
 588:           object.BatchNumbers.push(tempBatch);
 589:         }
 590:         // Update bin locations if applicable
 591:         this._updateBinAllocations(object, batchPickedQuantity, scanDialog);
 592:         object.RemainingOpenQuantity -= batchPickedQuantity;
 593:         this._finalizeUpdate();
 594:         this.confirmPackScan();
 595:         this.closePopoverBatch();
 596:       } else {
 597:         const pickedQuantity = parseInt(Fragment.byId(itemDetailsDialog, "PickedQuantity").getValue());
 598:         // Update bin locations for non-batch items
 599:         this._updateBinAllocations(object, pickedQuantity, scanDialog);
 600:         object.RemainingOpenQuantity -= pickedQuantity;
 601:         this._oItemDetailsDialog.close();
 602:       }
 603:       object.isScanned = "true";
 604:       this._finalizeUpdate();
 605:       this.oEventBus.publish("nAG", "hideBusyDialog");
 606:       this._focusPickedLine(object);
 607:     },
 608:     _updateBinAllocations: function (object, quantity, scanDialog) {
 609:       const binKey = Fragment.byId(scanDialog, "inpBatch").getSelectedKey();
 610:       object.DocumentLinesBinAllocations = object.DocumentLinesBinAllocations || [];
 611:       const findLocation = object.DocumentLinesBinAllocations.find((location) => location.BinAbsEntry === binKey);
 612:       if (findLocation) {
 613:         findLocation.Quantity += quantity;
 614:         findLocation.openQuantity += quantity;
 615:       } else {
 616:         object.DocumentLinesBinAllocations.push({
 617:           Quantity: quantity,
 618:           BinAbsEntry: binKey,
 619:           SerialAndBatchNumbersBaseLine: object.DocumentLinesBinAllocations.length + 1,
 620:         });
 621:       }
 622:       object.openQuantity += quantity;
 623:     },
