234:       const aItems = oList.getItems();
235:       const oFoundItem = aItems.find((oItem) => {
236:         const oContext = oItem.getBindingContext("WarehouseModel");
237:         if (!oContext) return false;
238:         const sWarehouseName = (oContext.getProperty("WarehouseName") || "").toLowerCase();
239:         const sWarehouseCode = (oContext.getProperty("WarehouseCode") || "").toLowerCase();
240:         return sWarehouseName.includes(sQuery) || sWarehouseCode.includes(sQuery);
241:       });
242:       if (oFoundItem) {
243:         oList.setSelectedItem(oFoundItem);
244:         setTimeout(function () {
245:           if (typeof oFoundItem.getDomRef === "function" && oFoundItem.getDomRef()) {
