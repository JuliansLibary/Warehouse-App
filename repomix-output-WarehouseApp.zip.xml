374:         if (this.getSession() !== null) {
375:           this.removeCookie();
376:         }
377:       },
378:       getPartsFromCookie: function () {
379:         if (this.getSession() !== null) {
380:           const x = atob(this.getCookie("ServiceLayer").substring(6));
381:           const y = JSON.parse(
382:             x.split(":")[0] + ":" + x.split(":")[1] + ":" + x.split(":")[2]
383:           );
384:           const user = y.UserName;
385:           const company = y.CompanyDB;
386:           const pass = x.split(":")[3];
387:           return [user, pass, company];
388:         } else {
389:           return null;
390:         }
391:       },
392:       /**
393:        * Maps HTTP status codes to user-friendly i18n error messages
394:        * @param {number} status - HTTP status code
395:        * @param {object} jqXHR - jQuery XHR object
396:        * @param {string} languageCode - Current language code
397:        * @returns {object} Error message object with message and helpUrl
398:        * @private
399:        */
400:       _getErrorMessageForStatus: function (status, jqXHR, languageCode) {
401:         const i18n = this.getModel("i18n")?.getResourceBundle();
402:         let errorKey = "networkError";
403:         let helpUrl = null;
404:         // First check for custom backend error messages
405:         if (jqXHR.responseJSON) {
406:           const customError = this.findTranslation(jqXHR.responseJSON, languageCode);
407:           if (customError && customError.message) {
408:             return customError;
409:           }
410:         }
411:         // Map status codes to appropriate i18n keys
412:         switch (status) {
413:           case 400:
414:             errorKey = "badRequest";
415:             break;
416:           case 401:
417:             errorKey = "unauthorized";
418:             break;
419:           case 403:
420:             errorKey = "forbidden";
421:             break;
422:           case 404:
423:             errorKey = "notFound";
424:             break;
425:           case 405:
426:             errorKey = "methodNotAllowed";
427:             break;
428:           case 409:
429:             errorKey = "conflict";
430:             break;
431:           case 423:
432:             errorKey = "invalidTenant";
433:             break;
434:           case 500:
435:             errorKey = "internalServerError";
436:             break;
437:           case 502:
438:             errorKey = "badGateway";
439:             break;
440:           case 503:
441:             errorKey = "serviceUnavailable";
442:             break;
443:           case 504:
444:             errorKey = "gatewayTimeout";
445:             break;
446:           case 0:
447:           default:
448:             // Network error or timeout
449:             if (jqXHR.statusText === "timeout" || !status) {
450:               errorKey = "connectionTimeout";
451:             } else {
452:               errorKey = "networkError";
453:             }
454:             break;
455:         }
456:         const message = i18n?.getText(errorKey) || `HTTP Error ${status}`;
457:         return {
458:           message: message,
459:           helpUrl: helpUrl
460:         };
461:       },
462:     });
463:   }
464: );
