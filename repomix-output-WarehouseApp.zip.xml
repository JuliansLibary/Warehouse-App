  1: sap.ui.define(["sap/ui/model/type/Currency"], function (Currency) {
  2:   "use strict";
  3:   return {
  4:     /**
  5:      * Rounds the currency value to 2 digits
  6:      *
  7:      * @public
  8:      * @param {string} sValue value to be formatted
  9:      * @returns {string} formatted currency value with 2 digits
 10:      */
 11:     currencyValue: function (sValue) {
 12:       if (!sValue) {
 13:         return "";
 14:       }
 15:       return parseFloat(sValue).toFixed(2);
 16:     },
 17:     /**
 18:      * Rounds the currency value to 2 digits
 19:      *
 20:      * @public
 21:      * @param {number} iQuantity product quantity
 22:      * @param {number} fPrice product price
 23:      * @param {string} sCurrencyCode currency code for the price
 24:      * @returns {string} formatted currency value with 2 digits
 25:      */
 26:     calculateItemTotal: function (iQuantity, fPrice, sCurrencyCode) {
 27:       let oCurrency = new Currency({
 28:         showMeasure: false,
 29:       }),
 30:         fTotal = iQuantity * fPrice;
 31:       return oCurrency.formatValue([fTotal.toFixed(2), sCurrencyCode], "string");
 32:     },
 33:     /**
 34:      * Converts a binary string into an image format suitable for the src attribute
 35:      *
 36:      * @public
 37:      * @param {string} vData a binary string representing the image data
 38:      * @returns {string} formatted string with image metadata based on the input or a default image when the input is empty
 39:      */
 40:     handleBinaryContent: function (vData) {
 41:       if (vData) {
 42:         let sMetaData1 = "data:image/jpeg;base64,",
 43:           sMetaData2 = vData.substr(104); // stripping the first 104 bytes from the binary data when using base64 encoding.
 44:         return sMetaData1 + sMetaData2;
 45:       } else {
 46:         return "../images/Employee.png";
 47:       }
 48:     },
 49:     css: function (PicklistQuantity, PickedQuantity) {
 50:       if (PickedQuantity < PicklistQuantity) {
 51:         return "Critical";
 52:       } else {
 53:         return "Good";
 54:       }
 55:     },
 56:     localDate: function (date) {
 57:       if (!date) return date;
 58:       const options = {
 59:         day: "2-digit",
 60:         month: "2-digit",
 61:         year: "numeric",
 62:       };
 63:       if (typeof date === "string") {
 64:         if (date.includes(".")) {
 65:           const [day, month, year] = date.split(".").map(Number);
 66:           return new Date(year, month - 1, day).toLocaleDateString(undefined, options);
 67:         }
 68:         if (date.includes("-")) {
 69:           const [year, month, day] = date.split("-").map(Number);
 70:           return new Date(year, month - 1, day).toLocaleDateString(undefined, options);
 71:         }
 72:         if (date !== "null") {
 73:           const y = date.substr(0, 4),
 74:             m = date.substr(4, 2),
 75:             d = date.substr(6, 2);
 76:           let datestring = new Date(y, m - 1, d);
 77:           return datestring.toLocaleDateString(undefined, options);
 78:         } else {
 79:           return null;
 80:         }
 81:       } else if (typeof date === "number") {
 82:         const datenumber = new Date(date);
 83:         return new Date(datenumber.getFullYear(), datenumber.getMonth(), datenumber.getDate()).toLocaleDateString(undefined, options);
 84:       }
 85:       return date;
 86:     },
 87:     pickStatus: function (status) {
 88:       switch (status) {
 89:         case "P":
 90:           return sap.ui.getCore().getModel("i18n").getResourceBundle().getText("partlyPicked");
 91:         case "R":
 92:           return sap.ui.getCore().getModel("i18n").getResourceBundle().getText("released");
 93:         case "Y":
 94:           return sap.ui.getCore().getModel("i18n").getResourceBundle().getText("picked");
 95:         case "D":
 96:           return sap.ui.getCore().getModel("i18n").getResourceBundle().getText("partlyDelivered");
 97:         case "ps_Picked":
 98:           return sap.ui.getCore().getModel("i18n").getResourceBundle().getText("partlyPicked");
 99:         case "ps_Released":
100:           return sap.ui.getCore().getModel("i18n").getResourceBundle().getText("released");
101:         case "ps_PartiallyDelivered":
102:           return sap.ui.getCore().getModel("i18n").getResourceBundle().getText("partlyDelivered");
103:         default:
104:           return sap.ui.getCore().getModel("i18n").getResourceBundle().getText("picked");
105:       }
106:     },
107:     pickState: function (status) {
108:       switch (status) {
109:         case "P":
110:           return sap.ui.core.ValueState.Warning;
111:         case "R":
112:           return sap.ui.core.ValueState.Error;
113:         case "Y":
114:           return sap.ui.core.ValueState.Success;
115:         case "D":
116:           return sap.ui.core.ValueState.Warning;
117:         case "ps_Picked":
118:           return sap.ui.core.ValueState.Warning;
119:         case "ps_Released":
120:           return sap.ui.core.ValueState.Error;
121:         case "ps_PartiallyDelivered":
122:           return sap.ui.core.ValueState.Warning;
123:         default:
124:           return sap.ui.core.ValueState.Success;
125:       }
126:     },
127:     dynamicLabelText: function (baseObjectType, binLocation, ToWarehouse) {
128:       let i18nKey;
129:       let value;
130:       // Überprüfung des BaseObjectType
131:       const baseObjectTypeInventoryTransfer = "1250000001";
132:       if (String(baseObjectType) === baseObjectTypeInventoryTransfer) {
133:         i18nKey = "detailLineItemTableBinColumnInventoryTransfer";
134:         value = ToWarehouse; // Verwende WarehouseCode
135:       } else {
136:         i18nKey = "detailLineItemTableBinColumn";
137:         value = binLocation; // Verwende BinLocation
138:       }
139:       if (value === null) {
140:         return "";
141:       }
142:       return sap.ui.getCore().getModel("i18n").getResourceBundle().getText(i18nKey) + (value ? ": " + value : "");
143:     },
144:     orderBuild: function (order, completeOrder) {
145:       let orderEntry = [...new Set(completeOrder.map((obj) => obj.OrderEntry))];
146:       let number = orderEntry.indexOf(order) + 1;
147:       if (orderEntry.length >= 1) {
148:         return "Kundenauftrag: " + number;
149:       } else {
150:         return "";
151:       }
152:     },
153:     selectQuantityforCalc: function (onHandQty, PickedQuantity) {
154:       return parseFloat(onHandQty - PickedQuantity);
155:     },
156:     serialNumState: function (statusSerial, statusBatch) {
157:       switch (statusSerial) {
158:         case "Y":
159:           return "Warning";
160:       }
161:       switch (statusBatch) {
162:         case "Y":
163:           return "Error";
164:         default:
165:           return "Success";
166:       }
167:     },
168:     deliveryState: function (oRequiredDate) {
169:       let today = new Date(),
170:         dateToCheck = new Date(oRequiredDate);
171:       if (today === null) {
172:         return "None";
173:       }
174:       // delivery is urgent (takes more than 7 days)
175:       if (dateToCheck - today > 0 && dateToCheck - today <= 432000000) {
176:         return "Warning";
177:       } else if (dateToCheck < today) {
178:         // delivery is too late
179:         return "Error";
180:       } else {
181:         // delivery is in time
182:         return "Success";
183:       }
184:     },
185:     numCheck: function (oRequiredBatch, oRequiredSerial) {
186:       if (oRequiredBatch === "tNO" || oRequiredSerial === "tNO") {
187:         return false;
188:       } else {
189:         return true;
190:       }
191:     },
192:     buildFrontendView: function (PickListFromOrder, AbsoluteEntry) {
193:       if (this.getViewModel("appView").getProperty("/mergePickLists") === "true") {
194:         let returnString = " ";
195:         PickListFromOrder.forEach((orderFromPickLists) => {
196:           returnString = returnString + orderFromPickLists + " ";
197:         });
198:         return sap.ui.getCore().getModel("i18n").getResourceBundle().getText("titlePickList") + returnString + " ";
199:       } else {
200:         return sap.ui.getCore().getModel("i18n").getResourceBundle().getText("titlePickList") + AbsoluteEntry;
201:       }
202:     },
203:   };
204: });
</file>

