 527:       if (!this._DashboardDialog) {
 528:         this._DashboardDialog = Fragment.load({
 529:           id: "dialogAvatar",
 530:           name: "nAG.WarehouseApp.Launchpad.view.dashboard",
 531:           controller: this,
 532:         }).then(
 533:           function (oDialog) {
 534:             return oDialog;
 535:           }.bind(that)
 536:         );
 537:       }
 538:       const tenant = that.getUrlVars().Tenant.split("#")[0];
 539:       const oDashboardModel = that.getModel("DashboardModel").getData();
 540:       this.oEventBus.publish("nAG", "showBusyDialog");
 541:       this._getCustomModules(tenant)
 542:         .then((customModules) => {
 543:           const existingPaths = oDashboardModel.services.map(function (module) {
 544:             return module.path;
 545:           });
 546:           for (const module of customModules) {
 547:             if (!existingPaths.includes(module.route)) {
 548:               let displayName;
 549:               try {
 550:                 displayName = JSON.parse(module.config).displayName || module.module;
 551:               } catch (e) {
 552:                 console.error("Error parsing module config for module:", module.module, e);
 553:                 displayName = module.module;
 554:               }
 555:               oDashboardModel.services.push({
 556:                 displayName: displayName,
 557:                 name: module.module,
 558:                 hasLicense: true,
 559:                 isAvailableModule: module.isConfigurable,
 560:                 route: module.route,
 561:                 Status: null,
 562:                 nameConfig: module.module,
 563:               });
 564:             }
 565:           }
 566:           return that._getModulesStatus(tenant);
 567:         })
 568:         .then((availabilityModules) => {
 569:           for (const availableModules of availabilityModules) {
 570:             const found = oDashboardModel.services.find(function (m) {
 571:               return m.name === availableModules.name;
 572:             });
 573:             if (found) {
 574:               found.Status = availableModules.Status; // "Success", "Error" oder "Information"
 575:             }
 576:           }
 577:           const oGrid = that.getView().byId("idDashboardModulesGrid");
 578:           const i18n = sap.ui.getCore().getModel("i18n");
 579:           const notReachableText = i18n?.getResourceBundle()?.getText("moduleNotReachableSupport");
 580:           const notReachableSystemInfo = i18n?.getResourceBundle()?.getText("moduleNotReachableSystemInfo");
 581:           const getLicense = i18n?.getResourceBundle()?.getText("getLicense");
 582:           const noLicense = i18n?.getResourceBundle()?.getText("noLicense");
 583:           for (const module of oDashboardModel.services) {
 584:             const status = module.Status || "Success";
 585:             const reachable = status === "Success";
 586:             // Create ID mapping for static tiles defined in XML
 587:             const moduleIdMapping = {
 588:               Pick: "idPickGenericTile",
 589:               Pack: "idPackGenericTile",
 590:               InventoryTransfer: "idInventoryTransferGenericTile",
 591:               StockTransfer: "idStockTransferGenericTile",
 592:               PurchaseDeliveryNote: "idPurchaseDeliveryNoteGenericTile",
 593:               PurchaseDeliveryNoteAdhoc: "idPurchaseDeliveryNoteAdhocGenericTile",
 594:               LabelGenerator: "idLabelGeneratorGenericTile",
 595:               OrdersToDelivery: "idOrdersToDeliveryGenericTile",
 596:               InventoryCount: "idInventoryCountGenericTile",
 597:               InfoPoint: "idInfoPointGenericTile",
 598:             };
 599:             const tileId = moduleIdMapping[module.name] || module.name;
 600:             const oTile = that.getView().byId(tileId);
 601:             // Process module for tile updates
 602:             if (oTile) {
 603:               if (reachable) {
 604:                 if (!module.hasLicense) {
 605:                   oTile.setState("Failed");
 606:                   oTile.setSystemInfo(noLicense);
 607:                   oTile.setFailedText(getLicense);
 608:                 } else {
 609:                   oTile.setState("Loaded");
 610:                 }
 611:               } else {
 612:                 oTile.setState("Failed");
 613:                 oTile.setSystemInfo(notReachableSystemInfo);
 614:                 oTile.setFailedText(notReachableText);
 615:               }
 616:             } else if (module.hasLicense && module.isAvailableModule) {
 617:               const state = reachable ? "Loaded" : "Failed";
 618:               const newTile = new sap.m.GenericTile({
 619:                 id: "Dynamic-" + module.name,
 620:                 frameType: "Auto",
 621:                 headerImage: "sap-icon://developer-settings",
 622:                 state: state,
 623:                 press: that.onClick.bind(that),
 624:                 tileContent: [
 625:                   new sap.m.TileContent({
 626:                     content: new sap.m.Text({ text: module.nameConfig || module.displayName }),
 627:                   }),
 628:                 ],
 629:               });
 630:               if (!reachable) {
 631:                 newTile.setSystemInfo(notReachableSystemInfo);
 632:                 newTile.setFailedText(notReachableText);
 633:               }
 634:               oGrid.addContent(newTile);
 635:             }
 636:           }
 637:         })
 638:         .catch((error) => {
 639:           console.error("Error setting visibility:", error);
 640:           const i18n = that.getModel("i18n");
 641:           MessageBox.error(i18n.getResourceBundle().getText("loginError") + ": " + (error && error.message ? error.message : error));
 642:         })
 643:         .finally(() => {
 644:           that.oEventBus.publish("nAG", "hideBusyDialog");
 645:         });
