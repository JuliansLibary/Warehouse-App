 69:       /**
 70:        * Modern Promise-based AJAX request method without callbacks
 71:        * @param {String} method HTTP method (GET, POST, PATCH, etc.)
 72:        * @param {String} url Request URL
 73:        * @param {Object} postContent Request body for POST/PATCH requests (null for GET)
 74:        * @param {Object} options Configuration options
 75:        * @param {Boolean} options.showErrorDialog Whether to show error dialog (default: true)
 76:        * @param {String} options.errorContext Context for error logging (optional)
 77:        * @returns {Promise} Promise that resolves with {success, data, status} or rejects with error info
 78:        */
 79:       makeAjaxRequest: function (method, url, postContent, options = {}) {
 80:         const that = this;
 81:         const config = {
 82:           showErrorDialog: true,
 83:           errorContext: "",
 84:           ...options
 85:         };
 86:         return new Promise((resolve, reject) => {
 87:           $.ajax({
 88:             url: url,
 89:             xhrFields: {
 90:               withCredentials: true,
 91:             },
 92:             data: postContent,
 93:             crossDomain: true,
 94:             type: method,
 95:             tryCount: 0,
 96:             retryLimit: 3,
 97:             headers: {
 98:               prefer: "odata.maxpagesize=0",
 99:             },
100:             success: function (response, status, xhr) {
101:               const result = {
102:                 success: true,
103:                 data: response,
104:                 status: xhr.status,
105:                 statusText: status,
106:                 hasData: typeof response !== "undefined" && xhr.responseText !== ""
107:               };
108:               resolve(result);
109:             },
110:             error: function (jqXHR, textStatus) {
111:               const Language = that.getUrlVars()?.Language;
112:               const errorResult = {
113:                 success: false,
114:                 status: jqXHR.status || 0,
115:                 statusText: textStatus,
116:                 responseText: jqXHR.responseText,
117:                 responseJSON: jqXHR.responseJSON,
118:                 isTimeout: false
119:               };
120:               // Handle timeout with retry logic
121:               if (textStatus === "timeout") {
122:                 this.tryCount++;
123:                 if (this.tryCount <= this.retryLimit) {
124:                   $.ajax(this);
125:                   return;
126:                 }
127:                 errorResult.isTimeout = true;
128:                 errorResult.message = "Network timeout";
129:               }
130:               // Process error message with proper status code mapping
131:               let errorMessage = that._getErrorMessageForStatus(jqXHR.status, jqXHR, Language);
132:               errorResult.errorMessage = errorMessage;
133:               // Log error with context
134:               if (config.errorContext) {
135:                 console.error(`AJAX Error in ${config.errorContext}:`, {
136:                   status: jqXHR.status,
137:                   statusText: textStatus,
138:                   context: config.errorContext,
139:                   message: errorMessage.message,
140:                   url: url
141:                 });
142:               } else {
143:                 console.error("AJAX Error:", errorResult);
144:               }
145:               // Show error dialog if not suppressed
146:               if (config.showErrorDialog) {
147:                 that.showError(errorMessage, jqXHR.status || "Error");
148:               }
149:               reject(errorResult);
150:             },
151:           });
152:         });
153:       },
