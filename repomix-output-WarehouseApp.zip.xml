337:           text: "Close",
338:           press: function () {
339:             dialog.close();
340:           },
341:         }),
342:         afterClose: function () {
343:           dialog.destroy();
344:           if (errorCode === 423) {
345:             that.goToTenantChoose();
346:           }
347:         },
348:       });
349:       dialog.open();
350:     },
351:     getMessage: function (i18nInfo) {
