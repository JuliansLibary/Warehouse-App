<file path="WarehouseApp/nAG.Warehouse.App.SalesOrderDelivery/controller/deliveryController.js">
  1: const SL = require("@nag/servicelayerconnector");
  2: const { getInstance, generateBasicAuth, getError } = require("../controller/utilsController.js");
  3: function createDeliverynote(detailModel, AbsoluteEntryPicture) {
  4:   return new Promise((resolve, reject) => {
  5:     // Headinformation
  6:     const deliveryNote = {
  7:       CardCode: detailModel.CardCode,
  8:       DocumentLines: [],
  9:       DocumentPackages: [],
 10:       DocumentAdditionalExpenses: detailModel.DocumentAdditionalExpenses,
 11:       DocumentSpecialLines: detailModel.DocumentSpecialLines,
 12:       ...(AbsoluteEntryPicture !== null && { AttachmentEntry: AbsoluteEntryPicture }),
 13:     };
 14:     detailModel.DocumentLines.forEach((transferLine) => {
 15:       // Create base DocumentLine
 16:       const documentLine = {
 17:         BaseLine: transferLine.LineNum,
 18:         BaseType: transferLine.BaseType,
 19:         BaseEntry: detailModel.DocEntry,
 20:         ItemCode: transferLine.ItemCode,
 21:         Quantity: transferLine.Quantity,
 22:         TreeType: transferLine.TreeType,
 23:         BatchNumbers: [],
 24:         DocumentLinesBinAllocations: [],
 25:         SerialNumbers: [],
 26:         WarehouseCode: transferLine.WarehouseCode,
 27:       };
 28:       // Add BatchNumbers if they exist
 29:       if (transferLine.BatchNumbers?.length) {
 30:         documentLine.BatchNumbers = transferLine.BatchNumbers.map((batch) => ({
 31:           BaseLineNumber: deliveryNote.DocumentLines.length - 1,
 32:           BatchNumber: batch.BatchNumber,
 33:           Quantity: batch.Quantity,
 34:         }));
 35:       }
 36:       // Add SerialNumbers if they exist
 37:       if (transferLine.SerialNumbers?.length) {
 38:         documentLine.SerialNumbers = transferLine.SerialNumbers.map((serial) => ({
 39:           BaseLineNumber: 1,
 40:           InternalSerialNumber: serial.SerialNumber,
 41:           Quantity: serial.Quantity,
 42:           SystemSerialNumber: serial.SysNumber,
 43:         }));
 44:       }
 45:       // Add BinAllocations if they exist
 46:       if (transferLine.DocumentLinesBinAllocations?.length) {
 47:         documentLine.DocumentLinesBinAllocations = transferLine.DocumentLinesBinAllocations.map((allocation) => ({
 48:           BaseLineNumber: 1,
 49:           BinAbsEntry: allocation.BinAbsEntry,
 50:           Quantity: allocation.Quantity,
 51:           SerialAndBatchNumbersBaseLine: allocation.SerialAndBatchNumbersBaseLine,
 52:         }));
 53:       }
 54:       // Push the completed DocumentLine
 55:       deliveryNote.DocumentLines.push(documentLine);
 56:     });
 57:     resolve(deliveryNote);
 58:   });
 59: }
 60: // Logic to check for Sales Bill of Materials in Order
 61: async function checkForBoM(deliveryNote, orderID, basetype, cookie, callback) {
 62:   try {
 63:     const billOfMaterial = [];
 64:     // Check if there is at least one Item included in a Bill of Materials
 65:     deliveryNote.DocumentLines.forEach((line) => {
 66:       if (line.TreeType !== "iNotATree") {
 67:         billOfMaterial.push(line.BaseLine);
 68:       }
 69:     });
 70:     // Get the Base Order
 71:     const baseOrder = await getOrder(orderID, basetype, cookie);
 72:     // Rebuild DeliveryNote to look like Order
 73:     deliveryNote = await getDeliveryNoteLikeOrder(deliveryNote, baseOrder);
 74:     // If there are Bill of Materials, process further
 75:     if (billOfMaterial.length > 0) {
 76:       // Get unique Sales Tree Head Items
 77:       const salesTreeItems = await getSalesTreeItems(billOfMaterial, baseOrder);
 78:       // Get Sales Bill of Materials Definition
 79:       const productTrees = await getProductTrees(salesTreeItems, cookie);
 80:       // Compute the Quantity of the Sales Bill of Materials Head item
 81:       deliveryNote = await computeBoMQuantity(deliveryNote, productTrees);
 82:     }
 83:     // Clean up the DeliveryNote
 84:     deliveryNote = await cleanDelivery(deliveryNote);
 85:     // Set the BaseLine numbers in bin, serial, and batch
 86:     const result = await setBaseLines(deliveryNote);
 87:     callback(null, result);
 88:   } catch (error) {
 89:     // Handle any errors from any of the async calls
 90:     callback(error, null);
 91:   }
 92: }
 93: // Get Order
 94: async function getOrder(orderEntry, baseObjectType, cookie) {
 95:   const baseType = parseInt(baseObjectType, 10); // Parse with base 10 for clarity
 96:   const orderURL = baseType === 13 ? `Invoices(${orderEntry})` : baseType === 17 ? `Orders(${orderEntry})` : null;
 97:   if (!orderURL) {
 98:     throw new Error(`Invalid BaseObjectType: ${baseObjectType}`);
 99:   }
100:   const instance = await getInstance();
101:   if (!instance) return { body: { message: "Failed to get Instance", helpUrl: null } };
102:   return new Promise((resolve, reject) => {
103:     try {
104:       SL.GET(
105:         orderURL,
106:         null,
107:         cookie,
108:         {
109:           retryTimes: 5,
110:           retryDelay: 750,
111:           SLURL: instance.SLURL,
112:           SLPort: instance.SLPort,
113:         },
114:         async (error, resp) => {
115:           if (error) {
116:             const errorResponse = await getError(error);
117:             reject(errorResponse);
118:           } else {
119:             resolve(resp);
120:           }
121:         }
122:       );
123:     } catch (error) {
124:       reject(error);
125:     }
126:   });
127: }
128: function getDeliveryNoteLikeOrder(dN, bO) {
129:   return new Promise((resolve, reject) => {
130:     buildDeliveryNote(dN, bO, (error, resp) => {
131:       if (error) {
132:         reject(error);
133:       } else {
134:         resolve(resp);
135:       }
136:     });
137:   });
138: }
139: async function buildDeliveryNote(deliveryNote, baseOrder, callback) {
140:   try {
141:     // Sort deliveryNote DocumentLines by BaseLine
142:     deliveryNote.DocumentLines.sort((a, b) => (a.BaseLine > b.BaseLine ? 1 : -1));
143:     // Copy UDFs from baseOrder to deliveryNote
144:     const udfs = Object.keys(baseOrder).filter((key) => key.includes("U_"));
145:     udfs.forEach((key) => {
146:       deliveryNote[key] = baseOrder[key];
147:     });
148:     // Handle "U_NAG_Packplatz" specifically if defined
149:     // Wird bebehalten weil es in Zukunft vielleicht verwendet wird
150:     // if (udfs.includes("U_NAG_Packplatz") && typeof packplatz !== "undefined") {
151:     //   deliveryNote["U_NAG_Packplatz"] = packplatz;
152:     // }
153:     // Reset and copy DocumentAdditionalExpenses
154:     deliveryNote.DocumentAdditionalExpenses = baseOrder.DocumentAdditionalExpenses.map((expense, idx) => ({
155:       BaseDocEntry: baseOrder.DocEntry,
156:       BaseDocLine: expense.LineNum,
157:       BaseDocType: 17,
158:     }));
159:     // Copy DocumentSpecialLines and other properties
160:     deliveryNote.DocumentSpecialLines = baseOrder.DocumentSpecialLines;
161:     deliveryNote.AddressExtension = baseOrder.AddressExtension;
162:     deliveryNote.TaxExtension = baseOrder.TaxExtension;
163:     // Process each line from the base order
164:     baseOrder.DocumentLines.forEach((baseOrderLine, baseOrderIndex) => {
165:       const existingLine = deliveryNote.DocumentLines[baseOrderIndex];
166:       if (baseOrderIndex >= deliveryNote.DocumentLines.length || baseOrderLine.LineNum !== parseInt(existingLine?.BaseLine, 10)) {
167:         // Add a new line if it doesn't exist or if BaseLine doesn't match
168:         const headItem = createHeadItem(baseOrderLine);
169:         deliveryNote.DocumentLines.splice(baseOrderIndex, 0, headItem);
170:       } else {
171:         // Update existing line if BaseLine matches
172:         existingLine.BaseVisualOrder = baseOrderLine.VisualOrder;
173:         existingLine.DocumentLineAdditionalExpenses = baseOrderLine.DocumentLineAdditionalExpenses;
174:         // Copy UDFs from baseOrderLine to existingLine
175:         copyUDFs(baseOrderLine, existingLine);
176:       }
177:     });
178:     callback(null, deliveryNote);
179:   } catch (error) {
180:     callback(error, null);
181:   }
182: }
183: // Helper function to create a new head item
184: function createHeadItem(baseOrderLine) {
185:   const headItem = {
186:     ItemCode: baseOrderLine.ItemCode,
187:     TreeType: baseOrderLine.TreeType,
188:     Quantity: 0,
189:     BaseEntry: baseOrderLine.DocEntry,
190:     BaseLine: baseOrderLine.LineNum,
191:     BaseType: baseOrderLine.BaseType,
192:     BaseVisualOrder: baseOrderLine.VisualOrder,
193:     DocumentLineAdditionalExpenses: baseOrderLine.DocumentLineAdditionalExpenses,
194:   };
195:   // Copy UDFs from baseOrderLine to headItem
196:   copyUDFs(baseOrderLine, headItem);
197:   return headItem;
198: }
199: // Helper function to copy UDFs
200: function copyUDFs(source, target) {
201:   const udfs = Object.keys(source).filter((key) => key.includes("U_"));
202:   udfs.forEach((key) => {
203:     target[key] = source[key];
204:   });
205: }
206: // Get unique Sales Tree Items
207: function getSalesTreeItems(baseLineIndices, baseOrder) {
208:   return new Promise((resolve, reject) => {
209:     salesTreeItem(baseLineIndices, baseOrder, (error, resp) => {
210:       if (error) {
211:         reject(error);
212:       } else {
213:         resolve(resp);
214:       }
215:     });
216:   });
217:   // Get Items
218:   async function salesTreeItem(baseLineIndices, baseOrder, callback) {
219:     try {
220:       const headItems = [];
221:       baseLineIndices.forEach((index) => {
222:         const result = baseOrder.DocumentLines.find((line) => line.LineNum === index);
223:         if (result?.TreeType === "iIngredient" || result?.TreeType === "I") {
224:           // Iterate backwards to find SalesTree items
225:           for (let i = parseInt(index, 10); i >= 0; i--) {
226:             const currentLine = baseOrder.DocumentLines[i];
227:             if (currentLine && (currentLine.TreeType === "iSalesTree" || currentLine.TreeType === "S")) {
228:               headItems.push(currentLine);
229:             }
230:           }
231:         }
232:       });
233:       // Remove duplicates using a Set
234:       const uniqueHeadItems = Array.from(new Set(headItems));
235:       callback(null, uniqueHeadItems);
236:     } catch (error) {
237:       callback(error, null);
238:     }
239:   }
240: }
241: // Get Product Tree Definition
242: function getProductTrees(salesTreeItems, cookie) {
243:   // Extract unique ItemCodes
244:   const uniqueItems = [...new Set(salesTreeItems.map((item) => item.ItemCode))];
245:   // Create promises to fetch product trees for each unique ItemCode
246:   const promises = uniqueItems.map((itemCode) => getProductTree(itemCode, cookie));
247:   // Resolve all promises and return the data
248:   return Promise.all(promises);
249:   async function getProductTree(itemCode, cookie) {
250:     const productTreeURL = `ProductTrees('${itemCode}')`;
251:     const instance = await getInstance();
252:     if (!instance) return { body: { message: "Failed to get Instance", helpUrl: null } };
253:     return new Promise((resolve, reject) => {
254:       SL.GET(
255:         productTreeURL,
256:         null,
257:         cookie,
258:         {
259:           retryTimes: 5,
260:           retryDelay: 750,
261:           SLURL: instance.SLURL,
262:           SLPort: instance.SLPort,
263:         },
264:         async (error, resp) => {
265:           if (error) {
266:             const errorResponse = await getError(error);
267:             reject(errorResponse);
268:           } else {
269:             resolve(resp);
270:           }
271:         }
272:       );
273:     });
274:   }
275: }
276: // Compute the packed Quantity of Sales Bill of Material Head Items
277: function computeBoMQuantity(deliveryNoteParam, productTreeParam) {
278:   return new Promise((resolve, reject) => {
279:     bomQuantity(deliveryNoteParam, productTreeParam, (error, resp) => {
280:       if (error) {
281:         reject(error);
282:       } else {
283:         resolve(resp);
284:       }
285:     });
286:   });
287:   async function bomQuantity(deliveryNote, productTree, callback) {
288:     try {
289:       deliveryNote.DocumentLines.forEach((line, lineIndex) => {
290:         // Process only Sales Tree Items
291:         if (line.TreeType === "S" || line.TreeType === "iSalesTree") {
292:           const packedIngredients = [];
293:           let quantity;
294:           // Collect all ingredients for the Sales Tree Item
295:           for (let i = lineIndex + 1; i < deliveryNote.DocumentLines.length; i++) {
296:             const currentLine = deliveryNote.DocumentLines[i];
297:             if (currentLine.TreeType === "I" || currentLine.TreeType === "iIngredient") {
298:               packedIngredients.push({
299:                 ItemCode: currentLine.ItemCode,
300:                 Quantity: currentLine.Quantity,
301:               });
302:             } else {
303:               break;
304:             }
305:           }
306:           // Get the corresponding Sales Tree Definition
307:           productTree.forEach((tree) => {
308:             if (tree.TreeCode === line.ItemCode) {
309:               tree.ProductTreeLines.forEach((productTreeLine) => {
310:                 // Compare collected ingredients with defined ingredients
311:                 packedIngredients.forEach((ingredient) => {
312:                   if (ingredient.ItemCode === productTreeLine.ItemCode) {
313:                     const factor = ingredient.Quantity / productTreeLine.Quantity;
314:                     quantity = quantity !== undefined ? Math.min(quantity, factor) : factor;
315:                   }
316:                 });
317:               });
318:             }
319:           });
320:           // Update the line's Quantity
321:           line.Quantity = quantity;
322:         }
323:       });
324:       callback(null, deliveryNote);
325:     } catch (error) {
326:       callback(error, null);
327:     }
328:   }
329: }
330: // Remove unpacked lines of Order
331: function cleanDelivery(dN) {
332:   return new Promise((resolve, reject) => {
333:     removeEmptyLines(dN, (error, resp) => {
334:       if (error) {
335:         reject(error);
336:       } else {
337:         resolve(resp);
338:       }
339:     });
340:   });
341:   async function removeEmptyLines(deliveryNote, callback) {
342:     try {
343:       // Filter out lines with specific TreeTypes and zero Quantity
344:       deliveryNote.DocumentLines = deliveryNote.DocumentLines.filter((line) => !(["N", "iNotATree", "iProductionTree", "iIngredient", "P"].includes(line.TreeType) && line.Quantity === 0));
345:       const lineNumbers = [];
346:       deliveryNote.DocumentLines.forEach((line, idx) => {
347:         line.VisualOrder = idx;
348:         lineNumbers.push(line.BaseVisualOrder);
349:       });
350:       if (deliveryNote.DocumentSpecialLines.length > 0) {
351:         for (let i = deliveryNote.DocumentSpecialLines.length - 1; i >= 0; i--) {
352:           const specialLine = deliveryNote.DocumentSpecialLines[i];
353:           if (!lineNumbers.includes(specialLine.AfterLineNumber)) {
354:             if (specialLine.LineType === "dslt_Text") {
355:               let j = 0;
356:               while (lineNumbers[++j] < specialLine.AfterLineNumber);
357:               const closest = lineNumbers[--j];
