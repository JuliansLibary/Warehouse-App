  8: async function formatForResponse(picklist, cacheData, documentLockString, remarkList, displayRemarks) {
  9:   return new Promise((resolve, reject) => {
 10:     try {
 11:       const response = [];
 12:       const parsedCacheData = cacheData;
 13:       const parsedDocumentLock = documentLockString;
 14:       const documentLockTimer = parseInt(global.gConfig.documentLockTimer) * 60000;
 15:       const currentDate = new Date();
 16:       picklist.forEach((picklistItem, index) => {
 17:         try {
 18:           // Check if item is cached
 19:           const hasEntry = parsedCacheData.some((element) => 
 20:             element.documentNumber === picklistItem.Absoluteentry && !element.isDeleted
 21:           );
 22:           // Check if item is locked
 23:           const isLocked = parsedDocumentLock.some((element) => 
 24:             element.documentNumber === picklistItem.Absoluteentry && 
 25:             new Date(Date.parse(element.latestChangeDate)).getTime() + documentLockTimer >= currentDate.getTime()
 26:           );
 27:           // Find remark
 28:           let remarkElement;
 29:           try {
 30:             remarkElement = remarkList.find(
 31:               (element) => parseInt(element.AbsEntry) === parseInt(picklistItem.Absoluteentry) && 
 32:               element.Remarks !== null && element.Remarks !== "null"
 33:             );
 34:           } catch {
 35:             remarkElement = null;
 36:           }
 37:           const remark = remarkElement ? remarkElement.Remarks : "";
 38:           // Find existing entry in the response
 39:           const existingEntry = response.find((entry) => entry.OrderEntry === picklistItem.OrderEntry);
 40:           if (existingEntry) {
 41:             // Update existing entry for duplicates
 42:             existingEntry.PickListsFromOrder.push(picklistItem.Absoluteentry);
 43:             existingEntry.isMultiPickList = "true";
 44:           } else {
 45:             // Add new entry to the response
 46:             response.push({
 47:               AbsoluteEntry: picklistItem.Absoluteentry,
 48:               Status: picklistItem.Status,
 49:               OrderEntry: picklistItem.OrderEntry,
 50:               Name: picklistItem.Name,
 51:               PickDate: picklistItem.PickDate,
 52:               Remarks: remark,
 53:               BaseObjectType: picklistItem.BaseObjectType,
 54:               PickListsFromOrder: [picklistItem.Absoluteentry],
 55:               isMultiPickList: "false",
 56:               isCached: hasEntry,
 57:               UpdateDate: picklistItem.UpdateDate,
 58:               isLocked: isLocked,
 59:               RemarksVisible: displayRemarks
 60:             });
 61:           }
 62:         } catch (itemError) {
 63:           reject(new Error(`Error processing picklist item at index ${index}: ${itemError.message}`));
 64:           return;
 65:         }
 66:       });
 67:       resolve(response.sort((a, b) => parseInt(b.AbsoluteEntry) - parseInt(a.AbsoluteEntry)));
 68:     } catch (error) {
 69:       reject(new Error(`Error in formatForResponse: ${error.message}`));
 70:     }
