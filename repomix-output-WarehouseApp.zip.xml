<file path="WarehouseApp/nAG.Warehouse.App.StockTransfer/webapp/BaseController.js">
  1: sap.ui.define(["sap/ui/core/mvc/Controller", "sap/ui/core/routing/History", "sap/m/Dialog", "sap/m/Text", "sap/m/Link", "sap/m/Button", "sap/ui/core/ValueState", "sap/m/VBox"], function (Controller, History, Dialog, Text, Link, Button, ValueState, VBox) {
  2:   return Controller.extend("nag.WarehouseApp.StockTransferRequest.BaseController", {
  3:     /**
  4:      * Convenience method for saving the BaseController in a global variable and creating fields that need to be accessed
  5:      * @public
  6:      */
  7:     register: function () {
  8:       this.oEventBus = sap.ui.getCore().getEventBus();
  9:       $.sap.control = this;
 10:       this.oEventBus.subscribe("nAG", "showBusyDialog", this.showBusyDialog, this);
 11:       this.oEventBus.subscribe("nAG", "hideBusyDialog", this.hideBusyDialog, this);
 12:       this.oEventBus.subscribe("nAG", "changeAppView", this.changeAppViewLayout, this);
 13:       this.oEventBus.subscribe("nAG", "getAppView", this.getViewElement, this);
 14:     },
 15:     /**
 16:      *
 17:      * @param {String} method: Can be at nAG: POST,PATCH,GET
 18:      * @param {String} url:  url for the ajax Call
 19:      * @param {JSON} postContent : JSON Body for a patch/post
 20:      * @param {String} i18n : String for a call of the error dialogue via i18n
 21:      * @param {JSON} callback :  Returns a JSON after a successful Ajax call. Can be further used in the frontend
 22:      * NOTE: No IF is needed to build the postContent dynamically for the AJAX. With a GET, the postContent is not transferred to the backend.
 23:      */
 24:     makeAjaxRequest: function (method, url, postContent, i18n, callback) {
 25:       let that = this;
 26:       $.ajax({
 27:         url: url,
 28:         xhrFields: {
 29:           withCredentials: true,
 30:         },
 31:         data: postContent,
 32:         crossDomain: true,
 33:         type: method,
 34:         tryCount: 0,
 35:         retryLimit: 3,
 36:         headers: {
 37:           prefer: "odata.maxpagesize=0",
 38:         },
 39:         success: function (response) {
 40:           callback(response);
 41:         },
 42:         error: function (jqXHR, textStatus) {
 43:           let Language = that.getUrlVars().Language;
 44:           if (textStatus === "timeout") {
 45:             this.tryCount++;
 46:             if (this.tryCount <= this.retryLimit) {
 47:               $.ajax(this);
 48:               return;
 49:             } else {
 50:               that.showError({ message: "NetworkError", helpUrl: null }, "9000");
 51:             }
 52:           }
 53:           if (typeof jqXHR.responseText !== "undefined" && jqXHR.status !== "undefined") {
 54:             if (typeof jqXHR.responseJSON !== "undefined") {
 55:               that.showError(that.findTranslation(jqXHR.responseJSON, Language), jqXHR.status);
 56:             } else {
 57:               let errorMessage;
 58:               if (jqXHR.status === 423) {
 59:                 errorMessage = {
 60:                   message: that.getModel("i18n").getResourceBundle().getText("invalidTenant"),
 61:                   helpUrl: null,
 62:                 };
 63:               } else {
 64:                 errorMessage = {
 65:                   message: jqXHR.responseText,
 66:                   helpUrl: null,
 67:                 };
 68:               }
 69:               that.showError(errorMessage, jqXHR.status);
 70:             }
 71:           } else {
 72:             that.showError(that.findTranslation(jqXHR.responseJSON, Language), 400);
 73:           }
 74:         },
 75:       });
 76:     },
 77:     findTranslation: function (json, languageCode) {
 78:       let response;
 79:       if (json.body.helpUrl) {
 80:         response = {
 81:           message: "",
 82:           helpUrl: json.body.helpUrl || null,
 83:         };
 84:       } else {
 85:         response = {
 86:           message: "",
 87:         };
 88:       }
 89:       if (json.body.translations && json.body.translations.length > 0) {
 90:         let translation = json.body.translations.find((translationFind) => translationFind.language === languageCode);
 91:         if (translation) {
 92:           response.message = translation.text;
 93:         }
 94:       }
 95:       if (!response.message && json.body.message) {
 96:         response.message = json.body.message;
 97:       }
 98:       return response;
 99:     },
100:     /**
101:      * Convenience method for accessing the router in every controller of the application.
102:      * @public
103:      * @returns {sap.ui.core.routing.Router} the router for this component
104:      */
105:     getRouter: function () {
106:       this.getDebugMode() && console.info("BASE GET ROUTER");
107:       return sap.ui.core.UIComponent.getRouterFor(this);
108:     },
109:     /**
110:      * Convenience method for getting the view model by name in every controller of the application.
111:      * @public
112:      * @param {string} sName the model name
113:      * @returns {sap.ui.model.Model} the model instance
114:      */
115:     getModel: function (sName) {
116:       this.getDebugMode() && console.info("BASE GET MODEL: " + sName);
117:       return sap.ui.getCore().getModel(sName);
118:     },
119:     /**
120:      * Convenience method for setting the view model in every controller of the application.
121:      * @public
122:      * @param {sap.ui.model.Model} oModel the model instance
123:      * @param {string} sName the model name
124:      * @returns {sap.ui.mvc.View} the view instance
125:      */
126:     setModel: function (oModel, sName) {
127:       return sap.ui.getCore().setModel(oModel, sName);
128:     },
129:     /**
130:      * Convenience method for  getting Debugmode
131:      */
132:     getDebugMode: function () {
133:       return $.sap.debugMode;
134:     },
135:     /**
136:      * Convenience method for saving the BusyDialog in a global variable
137:      * @public
138:      */
139:     getBusyDialog: function () {
140:       let busyDialog = sap.ui.xmlfragment("busyDialog", "nag.WarehouseApp.StockTransferRequest.view.BusyDialog", this);
141:       this.getView().addDependent(busyDialog);
142:       this.busyDialog = busyDialog;
143:     },
144:     /**
145:      * Convenience method for opening the BusyDialog
146:      * @public
147:      */
148:     showBusyDialog: function () {
149:       this.getDebugMode() && console.info("busy dialog opened");
150:       let busyDialog = this.busyDialog;
151:       busyDialog.open();
152:     },
153:     /**
154:      * Convenience method for closing the BusyDialog
155:      * @public
156:      */
157:     hideBusyDialog: function () {
158:       this.getDebugMode() && console.info("busy dialog closed");
159:       let busyDialog = this.busyDialog;
160:       busyDialog.close();
161:     },
162:     /**
163:      * Standard Error-Call improved by Maciej
164:      * 21.08.2019 Improved the Messagebox and added SAP Error Messages
165:      * showError(i18nFehlermeldung, zusätzlicheInformation, Fehlercode)
166:      */
167:     showError: function (extraInfo, errorCode) {
168:       let that = this;
169:       if (!extraInfo.helpUrl) {
170:         extraInfo.helpUrl = null;
171:       }
172:       this.oEventBus.publish("nAG", "hideBusyDialog");
173:       let dialog = new Dialog({
174:         title: errorCode,
175:         type: "Message",
176:         state: ValueState.Error,
177:         content: new VBox({
178:           items: [new Text({ text: extraInfo.message }), new Link({ text: extraInfo.helpUrl, href: extraInfo.helpUrl, target: "_blank" })],
179:         }),
180:         beginButton: new Button({
181:           text: "Close",
182:           press: function () {
183:             dialog.close();
184:           },
185:         }),
186:         afterClose: function () {
187:           dialog.destroy();
188:           if (errorCode === 423) {
189:             that.goToTenantChoose();
190:           }
191:         },
192:       });
193:       dialog.open();
194:     },
195:     /**
196:      * Convenience method for getting Variable from URL
197:      */
198:     getUrlVars: function () {
199:       let vars = {};
200:       window.location.href.replace(/[?&]+([^=&]+)=([^&#]*)/gi, function (m, key, value) {
201:         vars[key] = value;
202:       });
203:       return vars;
204:     },
205:     setViewModel: function (oModel, sName) {
206:       return this.getView().setModel(oModel, sName);
207:     },
208:     getViewModel: function (sName) {
209:       return this.getView().getModel(sName);
210:     },
211:     goToTenantChoose: function () {
212:       window.open("/launchpad/", "_top");
213:     },
214:     getMessage: function (i18nInfo) {
215:       return this.getViewModel("i18n").getResourceBundle().getText(i18nInfo);
216:     },
217:     getAppConfig: function () {
218:       let that = this,
219:         pickmode = null,
220:         listmode = null;
221:       $.ajax({
222:         url: "utils/AppConfig",
223:         crossDomain: true,
224:         type: "GET",
225:         dataType: "json",
226:         success: function (data) {
227:           if (data.singlePick) {
228:             pickmode = "Single";
229:           } else {
230:             pickmode = "Multi";
231:           }
232:           if (data.onlyScan) {
233:             listmode = "Inactive";
234:           } else {
235:             listmode = "Active";
236:           }
237:           // fürs testen immer true
238:           data.patchOrder = true;
239:           that.getViewModel("appView").setProperty("/pickMode", pickmode);
240:           that.getViewModel("appView").setProperty("/listMode", listmode);
241:           that.getViewModel("appView").setProperty("/patchOrder", data.patchOrder);
242:           // Check if Launchpad is a Parameter at Configuration
243:           if (data.launchpad) {
244:             that.getViewModel("appView").setProperty("/launchpad", data.launchpad);
245:           }
246:         },
247:         error: function (jqXHR) {
248:           that.showError(
249:             {
250:               message: jqXHR.responseJSON?.error?.message?.value || "Unknown error occurred",
251:               helpUrl: null,
252:             },
253:             jqXHR.responseJSON?.error?.code || "Unknown Code"
254:           );
255:         },
256:       });
257:     },
258:   });
259: });
