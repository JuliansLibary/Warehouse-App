249:        * debug: Information ist fürs debugging wichtig
250:        **/
251:       createLog: function (loglevel, bezeichnung, additionalinfo) {
252:         additionalinfo = additionalinfo || "";
253:         if (loglevel === "error") {
254:           jQuery.sap.log.error(bezeichnung, additionalinfo);
255:         } else if (loglevel === "warning") {
256:           jQuery.sap.log.warning(bezeichnung, additionalinfo);
257:         } else if (loglevel === "fatal") {
258:           jQuery.sap.log.fatal(bezeichnung, additionalinfo);
259:         } else if (loglevel === "trace") {
260:           jQuery.sap.log.trace(bezeichnung, additionalinfo);
261:         } else if (loglevel === "debug") {
262:           jQuery.sap.log.debug(bezeichnung, additionalinfo);
263:         }
264:       },
