<file path="WarehouseApp/nAG.Warehouse.App.Pack/webapp/view/Master.view.xml">
  1: <!-- Conditional Expression Binding:  https://sapui5.hana.ondemand.com/#/topic/daf6852a04b44d118963968a1239d2c0.html -->
  2: <mvc:View
  3: 	xmlns:core="sap.ui.core"
  4: 	xmlns:mvc="sap.ui.core.mvc"
  5: 	xmlns="sap.m"
  6: 	xmlns:s="sap.f.semantic"
  7: 	xmlns:html="http://www.w3.org/1999/xhtml"
  8: 	controllerName="nAG.WarehouseApp_Pack.controller.Master"
  9: 	xmlns:customData="http://schemas.sap.com/sapui5/extension/sap.ui.core.CustomData/1"
 10: >
 11: 	<s:SemanticPage
 12: 		id="pageMaster"
 13: 		headerPinnable="false"
 14: 		toggleHeaderOnTitleClick="false"
 15: 	>
 16: 		<s:titleHeading>
 17: 			<Title
 18: 				xmlns="sap.m"
 19: 				text="{i18n>titlePickList} {MasterModel>/0/AbsoluteEntry/} - {=${appView>/packMode} === 'Order' ? ${i18n>titleOrders} : ${i18n>titleShipToCode}}"
 20: 				id="ttlMaster"
 21: 				wrapping="true"
 22: 			/>
 23: 		</s:titleHeading>
 24: 		<s:content>
 25: 			<List
 26: 				noDataText="{i18n>MasterViewNoData}"
 27: 				id="lstMaster"
 28: 				items="{
 29: 					path: 'MasterModel>/',
 30: 					sorter: {
 31: 						path: 'isCached',
 32: 						descending: true
 33: 					}
 34: 				}"
 35: 				itemPress="onItemPressed"
 36: 				mode="SingleSelectMaster"
 37: 			>
 38: 				<items>
 39: 					<ObjectListItem
 40: 						type="Active"
 41: 						title="{
 42: 							=${MasterModel>BaseObjectType} === 1250000001 
 43: 							? ${i18n>InventoryRequest} 
 44: 							: (${appView>/packMode} === 'Order' 
 45: 								? ${i18n>DocNum} 
 46: 								: ${i18n>ShipToCode}) 
 47: 						} {
 48: 							=${MasterModel>BaseObjectType} === 1250000001 
 49: 							? '' 
 50: 							: (${appView>/packMode} === 'Order' 
 51: 								? ${MasterModel>Orders} 
 52: 								: ${MasterModel>ShipToDescription})
 53: 						}"
 54: 						intro="{MasterModel>Remarks}"
 55: 						id="itmMaster"
 56: 						icon="{= ${MasterModel>isLocked} === true ? 'sap-icon://locked':''}"
 57: 					>
 58: 						<firstStatus>
 59: 							<ObjectStatus
 60: 								class="sapUiSmallMarginBottom"
 61: 								text="{i18n>deleteIntermediateState}"
 62: 								active="true"
 63: 								visible="{MasterModel>isCached}"
 64: 								state="Information"
 65: 								customData:AbsoluteEntry="{MasterModel>AbsoluteEntry}"
 66: 								press="handleStatusPressed"
 67: 								icon="sap-icon://delete"
 68: 							/>
 69: 						</firstStatus>
 70: 						<attributes>
 71: 							<ObjectAttribute
 72: 								text=" {MasterModel>CardCode} {MasterModel>CardName} {=${appView>packMode}==='Order' ? ${i18n>ShipToCode} : ''}"
 73: 								id="attOrderStructure"
 74: 							/>
 75: 							<ObjectAttribute
 76: 								text="{i18n>CompleteItemOrders} {MasterModel>CompleteItemQuanity}"
 77: 								id="attCompleteItemQuantityOrder"
 78: 							/>
 79: 							<ObjectAttribute
 80: 								text="{i18n>ItemLength} {MasterModel>ItemLength}"
 81: 								id="attdifferentItems"
 82: 							/>
 83: 						</attributes>
 84: 					</ObjectListItem>
 85: 				</items>
 86: 			</List>
 87: 		</s:content>
 88: 		<s:closeAction>
 89: 			<s:CloseAction
 90: 				tooltip="{i18n>closeAction}"
 91: 				id="claDetail"
 92: 				press="onPressClose"
 93: 			/>
 94: 		</s:closeAction>
 95: 		<s:headerContent>
 96: 			<OverflowToolbar
 97: 				id="tlb3"
 98: 				style="Clear"
 99: 			>
100: 				<Button
101: 					id="btnScan"
102: 					press="onScanData"
103: 					icon="sap-icon://bar-code"
104: 					tooltip="{i18n>scanTooltip}"
105: 					text="{i18n>scanBarcode}"
106: 					type="Emphasized"
107: 				/>
108: 				<layoutData>
109: 					<OverflowToolbarLayoutData minWidth="150px" />
110: 				</layoutData>
111: 				<SearchField
112: 					id="sfd"
113: 					tooltip="{i18n>masterSearchTooltip}"
114: 					width="100%"
115: 					liveChange="onSearch"
116: 				>
117: 					<layoutData>
118: 						<OverflowToolbarLayoutData
119: 							minWidth="150px"
120: 							shrinkable="true"
121: 						/>
122: 					</layoutData>
123: 				</SearchField>
124: 				<Button
125: 					icon="sap-icon://sort"
126: 					press="onSortPress"
127: 					tooltip="{i18n>sort}"
128: 				/>
129: 				<Button
130: 					id="btnRefresh"
131: 					press="onRefreshData"
132: 					icon="sap-icon://synchronize"
133: 					type="Emphasized"
134: 					tooltip="{i18n>refreshTooltip}"
135: 					visible="false"
136: 				/>
137: 				<Button
138: 					id="btnSort"
139: 					press="onOpenViewSettings"
140: 					icon="sap-icon://action-settings"
141: 					type="Transparent"
142: 					tooltip="{i18n>sortTooltip}"
143: 					visible="false"
144: 				/>
145: 			</OverflowToolbar>
146: 		</s:headerContent>
147: 	</s:SemanticPage>
148: </mvc:View>
</file>

