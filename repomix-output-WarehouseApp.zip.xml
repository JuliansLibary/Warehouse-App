332:         }
333:       },
334:       setCookie: function (cname, cvalue, exminutes) {
335:         const d = new Date();
336:         d.setTime(d.getTime() + exminutes * 60 * 1000);
337:         const expires = "expires=" + d.toUTCString();
338:         document.cookie = cname + "=" + cvalue + ";" + expires;
339:       },
340:       removeCookie: function () {
341:         document.cookie = "ServiceLayer=;expires=Thu, 01 Jan 1970 00:00:00 GMT";
342:       },
343:       getCookie: function (cname) {
344:         const name = cname + "=";
345:         const ca = document.cookie.split(";");
346:         for (let i = 0; i < ca.length; i++) {
347:           let c = ca[i];
348:           while (c.charAt(0) == " ") {
349:             c = c.substring(1);
350:           }
351:           if (c.indexOf(name) == 0) {
352:             return c.substring(name.length, c.length);
353:           }
354:         }
355:         return null;
356:       },
