 855:     onClick: function (oEvent) {
 856:       if (oEvent.getSource().getState() === "Failed") {
 857:         MessageBox.information(oEvent.getSource().getFailedText());
 858:       } else {
 859:         const that = this;
 860:         const fullId = oEvent.getSource().getId();
 861:         const urlVars = this.getUrlVars();
 862:         const theme = urlVars.Theme;
 863:         const language = urlVars.Language;
 864:         const tenant = urlVars.Tenant.split("#")[0];
 865:         let urlContent;
 866:         let moduleName;
 867:         // Extract the actual ID from UI5 generated ID (e.g., "__xmlview2--idPickGenericTile" -> "idPickGenericTile")
 868:         const actualId = fullId.includes("--") ? fullId.split("--").pop() : fullId;
 869:         // Create reverse mapping from tile ID to module name
 870:         const idToModuleMapping = {
 871:           idPickGenericTile: "Pick",
 872:           idPackGenericTile: "Pack",
 873:           idInventoryTransferGenericTile: "InventoryTransfer",
 874:           idStockTransferGenericTile: "StockTransfer",
 875:           idPurchaseDeliveryNoteGenericTile: "PurchaseDeliveryNote",
 876:           idPurchaseDeliveryNoteAdhocGenericTile: "PurchaseDeliveryNoteAdhoc",
 877:           idLabelGeneratorGenericTile: "LabelGenerator",
 878:           idOrdersToDeliveryGenericTile: "OrdersToDelivery",
 879:           idInventoryCountGenericTile: "InventoryCount",
 880:           idInfoPointGenericTile: "InfoPoint",
 881:         };
 882:         if (actualId?.startsWith("Dynamic-")) {
 883:           // For dynamic modules, extract module name from ID
 884:           moduleName = actualId.split("Dynamic-")[1];
 885:           this.oEventBus.publish("nAG", "showBusyDialog");
 886:           this._checkDynamicModule(moduleName)
 887:             .then((isAvailable) => {
 888:               if (isAvailable) {
 889:                 urlContent = `/${moduleName}/`;
 890:                 if (theme !== undefined) {
 891:                   urlContent = urlContent + "?Theme=" + theme;
 892:                 }
 893:                 if (language !== undefined) {
 894:                   urlContent = urlContent + "&Language=" + language;
 895:                 }
 896:                 window.open(urlContent + "&Tenant=" + tenant, "_top");
 897:               } else {
 898:                 const i18n = that.getModel("i18n");
 899:                 MessageBox.error(i18n.getResourceBundle().getText("errorCreatingRoutes"));
 900:               }
 901:             })
 902:             .catch((error) => {
 903:               console.error("Dynamic module check failed:", error);
 904:               const i18n = that.getModel("i18n");
 905:               MessageBox.error(i18n.getResourceBundle().getText("dynamicModuleError"));
 906:             })
 907:             .finally(() => {
 908:               that.oEventBus.publish("nAG", "hideBusyDialog");
 909:             });
 910:         } else {
 911:           // For static modules, use the ID mapping to get module name
 912:           moduleName = idToModuleMapping[actualId];
 913:           if (moduleName === "InstanceConfiguration") {
 914:             urlContent = `/${moduleName}/`;
 915:             window.open(urlContent + "?Theme=" + theme + "&Language=" + language + "&Tenant=" + tenant + "/#Modules", "_top");
 916:           } else if (moduleName) {
 917:             urlContent = `/${moduleName}/`;
 918:             if (theme !== undefined) {
 919:               urlContent = urlContent + "?Theme=" + theme;
 920:             }
 921:             if (language !== undefined) {
 922:               urlContent = urlContent + "&Language=" + language;
 923:             }
 924:             window.open(urlContent + "&Tenant=" + tenant, "_top");
 925:           } else {
 926:             console.error("Unknown module ID:", actualId, "Full ID:", fullId);
 927:             const i18n = that.getModel("i18n");
 928:             MessageBox.error(i18n.getResourceBundle().getText("errorCreatingRoutes"));
 929:           }
 930:         }
 931:       }
 932:     },
