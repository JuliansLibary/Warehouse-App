 791:     _showBinDialog: function (data, context, mode) {
 792:       const binModel = new sap.ui.model.json.JSONModel(data);
 793:       const pickListDetailModel = context.getObject();
 794:       sap.ui.getCore().setModel(binModel, "selectBinModel");
 795:       // Überprüfen, ob ein Artikel mehr als einen Lagerplatz hat und Dialog öffnen
 796:       if (binModel.getData()) {
 797:         if (!this._oBinDialog) {
 798:           this._oBinDialog = sap.ui.xmlfragment("nAG.WarehouseApp_Pick.view.binLocationDialog", this);
 799:           this._oBinDialog.setModel(binModel);
 800:           this._oBinDialog.setModel(pickListDetailModel, "PickListsDetailModel");
 801:           jQuery.sap.syncStyleClass("sapUiSizeCompact", this.getView(), this._oBinDialog);
 802:         } else {
 803:           this._oBinDialog.setModel(binModel);
 804:           this._oBinDialog.setModel(pickListDetailModel, "PickListsDetailModel");
 805:         }
 806:         binModel.refresh();
 807:       }
 808:       const handleSingleMode = () => {
 809:         this._oBinDialog.open();
 810:       };
 811:       const handleBinLocationCheck = () => {
 812:         if (pickListDetailModel.BinLocation) {
 813:           this._mergeModels("Bin", binModel.getData(), pickListDetailModel);
 814:           const binLocationIndex = binModel
 815:             .getData()
 816:             .findIndex(
 817:               (binLocation) =>
 818:                 binLocation.AbsEntry === pickListDetailModel.BinAbs &&
 819:                 binLocation.BinCode === pickListDetailModel.BinLocation
 820:             );
 821:           if (
 822:             binLocationIndex !== -1 &&
