858:       controls.forEach(control => {
859:         const controlId = control.getId();
860:         const isProtected = protectedControls.some(id => controlId.includes(id));
861:         if (!isProtected && control.setEnabled && typeof control.setEnabled === "function") {
862:           control.setEnabled(!disable);
863:         }
864:         // Handle nested controls in form content
865:         if (control.getContent && typeof control.getContent === "function") {
866:           const nestedControls = control.getContent();
867:           nestedControls.forEach(nested => {
868:             const nestedId = nested.getId();
869:             const isNestedProtected = protectedControls.some(id => nestedId.includes(id));
870:             if (!isNestedProtected && nested.setEnabled && typeof nested.setEnabled === "function") {
871:               nested.setEnabled(!disable);
872:             }
873:           });
874:         }
875:       });
876:     },
877:     /**
878:      * Update panel states based on current data
879:      */
880:     _updatePanelStates: function() {
881:       const foundItems = this.getView().getModel("FoundItems");
882:       const hasItemData = foundItems && foundItems.getProperty("/ItemCode");
883:       const viewModel = this.getView().getModel("viewModel");
884:       // Keep label mode button enabled
885:       const labelModeButton = this.getView().byId("buttonLabelMode");
886:       if (labelModeButton) {
887:         labelModeButton.setEnabled(true);
888:       }
889:       // Keep label format button enabled
890:       const labelFormatButton = this.getView().byId("buttonLabelformat");
891:       if (labelFormatButton) {
892:         labelFormatButton.setEnabled(true);
893:       }
894:       // Keep article input enabled for non-warehouse modes
895:       const selectedMode = viewModel && viewModel.getProperty("/selectedMode");
896:       const articleInput = this.getView().byId("inpItemSearch");
897:       if (articleInput && selectedMode && selectedMode !== "Lager") {
898:         articleInput.setEnabled(true);
899:         articleInput.setVisible(true);
900:       }
901:       // Update panel states via CSS classes
902:       const additionalDataPanel = this.getView().byId("panelAdditionalData");
903:       const gs1DataPanel = this.getView().byId("panelGS1Data");
904:       if (additionalDataPanel) {
905:         if (hasItemData) {
906:           additionalDataPanel.removeStyleClass("panelDisabled");
907:         } else {
908:           additionalDataPanel.addStyleClass("panelDisabled");
909:         }
910:       }
911:       if (gs1DataPanel) {
912:         if (hasItemData) {
913:           gs1DataPanel.removeStyleClass("panelDisabled");
914:         } else {
915:           gs1DataPanel.addStyleClass("panelDisabled");
916:         }
917:       }
918:       // Update view model states
919:       if (viewModel) {
920:         viewModel.setProperty("/printEnabled", this._calculatePrintEnabled());
921:       }
922:       // Update workflow status whenever panel states change
923:       this._updateWorkflowStatus();
924:     },
925:     /**
926:      * Calculate if print button should be enabled
927:      */
928:     _calculatePrintEnabled: function() {
929:       const foundItems = this.getView().getModel("FoundItems");
930:       const hasItemData = foundItems && foundItems.getProperty("/ItemCode");
931:       const viewModel = this.getView().getModel("viewModel");
932:       const selectedMode = viewModel && viewModel.getProperty("/selectedMode");
933:       const selectedFormat = viewModel && viewModel.getProperty("/selectedFormat");
934:       if (selectedMode === "Lager") {
935:         // For warehouse mode, check if warehouse and bin locations are selected
936:         const warehouseSelection = this.getView().byId("cbWarehouseSelection");
937:         const warehouse = warehouseSelection ? warehouseSelection.getSelectedKey() : "";
938:         const binLocationSelection = this.getView().byId("cbBinLocationSelection");
939:         const binLocations = binLocationSelection ? binLocationSelection.getSelectedKeys() : [];
940:         return !!(warehouse && warehouse !== "" && binLocations && binLocations.length > 0);
941:       } else {
942:         // For other modes, need item data and format
943:         return !!(hasItemData && selectedFormat && selectedFormat !== "");
944:       }
945:     },
946:     /**
947:      * Auto-scroll to additional data section
948:      */
949:     _scrollToAdditionalData: function() {
950:       setTimeout(() => {
951:         const additionalPanel = this.getView().byId("panelAdditionalData");
952:         if (additionalPanel && additionalPanel.getVisible()) {
953:           additionalPanel.getDomRef().scrollIntoView({ behavior: 'smooth' });
954:         }
955:       }, 500);
956:     }
957:   });
958: });
