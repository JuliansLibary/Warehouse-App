<file path="WarehouseApp/nAG.Warehouse.App.StockTransfer/webapp/controller/StockTransfer.controller.js">
  1: /* eslint no-unused-expressions: ["error", { "allowShortCircuit": true }]*/
  2: sap.ui.define(["nag/WarehouseApp/StockTransferRequest/BaseController", "nag/WarehouseApp/StockTransferRequest/model/formatter", "sap/ui/core/Fragment", "sap/m/MessageBox"], function (BaseController, formatter, Fragment, MessageBox) {
  3:   "use strict";
  4:   return BaseController.extend("nag.WarehouseApp.StockTransferRequest.controller.StockTransfer", {
  5:     formatter: formatter,
  6:     /**
  7:      * BEGIN: Initialization Chain
  8:      */
  9:     onInit: function () {
 10:       this.oEventBus = sap.ui.getCore().getEventBus();
 11:       this._setupRoute();
 12:     },
 13:     _setupRoute: function () {
 14:       this.getRouter().getRoute("StockTransfer").attachPatternMatched(this._onDetailMatched, this);
 15:     },
 16:     _onDetailMatched: function () {
 17:       if (this.getModel("SessionModel") === undefined) {
 18:         this.getViewModel("appView").setProperty("/layout", "OneColumn");
 19:         this.getRouter().navTo("Login");
 20:         this.oEventBus.publish("nAG", "hideBusyDialog");
 21:       }
 22:       if (this.getModel("stockTransferFrontend") === undefined) {
 23:         this.setModel(new sap.ui.model.json.JSONModel(), "stockTransferFrontend");
 24:         this.setViewModel(this.getModel("stockTransferFrontend"), "stockTransferFrontend");
 25:       }
 26:       this._getTranferRequestDetails();
 27:     },
 28:     // GET clicked TransferRequest
 29:     _getTranferRequestDetails: function () {
 30:       const sessionModel = this.getModel("SessionModel").getData();
 31:       const tenant = this.getUrlVars().Tenant;
 32:       const url = `inventoryTransfer/InventoryTransferRequests/${sessionModel.OrderEntry}/${sessionModel.WarehouseCode}/${tenant}`;
 33:       const headers = { prefer: "odata.maxpagesize=0" };
 34:       $.ajax({
 35:         url,
 36:         type: "GET",
 37:         headers,
 38:         xhrFields: { withCredentials: true },
 39:         crossDomain: true,
 40:         success: (response) => this._handleSuccess(response),
 41:         error: (jqXHR) => this._handleError(jqXHR),
 42:       });
 43:     },
 44:     _handleSuccess: function (response) {
 45:       const parsedData = JSON.parse(JSON.stringify(response));
 46:       const stockTransferModel = this.getModel("stockTransferFrontend");
 47:       stockTransferModel.setData(parsedData);
 48:       stockTransferModel.refresh();
 49:       this.oEventBus.publish("nAG", "hideBusyDialog");
 50:     },
 51:     _handleError: function (jqXHR) {
 52:       const errorMessage = jqXHR.responseText || jqXHR.responseJSON?.value || "Unknown error";
 53:       const status = jqXHR.status;
 54:       this.showError({ message: errorMessage, helpUrl: null }, status);
 55:     },
 56:     /**
 57:      * END: Initialization Chain
 58:      */
 59:     /**
 60:      * BEGIN: Functions for Buttons
 61:      */
 62:     // Changes Keyboard for Inputs field using Dialog ids and Input ids
 63:     // Check which type the input field has --> number input e.g. Quantity must have no text input
 64:     // After setting the inputmodes, the element must be re-rendered.
 65:     // After that the focus can be set automatically via  the jQuery call and a scroll can be canceled.
 66:     // https://developer.mozilla.org/en-US/docs/Web/HTML/Global_attributes/inputmode
 67:     changeInput: function (oEvent) {
 68:       const { fragmentId, buttonId } = this._extractIds(oEvent);
 69:       const button = Fragment.byId(fragmentId, buttonId);
 70:       const saveButton = Fragment.byId(fragmentId, "btnSave");
 71:       this._toggleButtonValue(button);
 72:       saveButton.setEnabled(false);
 73:       this._attachFocusOutHandler(button, saveButton);
 74:       this._setFocusWithDelay(button);
 75:     },
 76:     _extractIds: function (oEvent) {
 77:       const inputIdParts = oEvent.getSource().getId().split("--");
 78:       const fragmentId = inputIdParts[0];
 79:       const buttonId = Fragment.byId(fragmentId, inputIdParts[1]).getAttributes()[0].mProperties.key;
 80:       return { fragmentId, buttonId };
 81:     },
 82:     _toggleButtonValue: function (button) {
 83:       const currentValue = button.getAttributes()[0].mProperties.value;
 84:       const newValue = currentValue === "none" ? button.getAttributes()[0].mProperties.key : "none";
 85:       button.getAttributes()[0].mProperties.value = newValue;
 86:     },
 87:     _attachFocusOutHandler: function (button, saveButton) {
 88:       button.attachBrowserEvent("focusout", () => {
 89:         if (!saveButton.getEnabled()) {
 90:           saveButton.setEnabled(true);
 91:         }
 92:       });
 93:     },
 94:     _setFocusWithDelay: function (button) {
 95:       jQuery.sap.delayedCall(500, null, () => {
 96:         button.focus({ preventScroll: true });
 97:       });
 98:     },
 99:     onPressClose: function () {
100:       this.getRouter().navTo("InventoryRequest");
101:     },
102:     packSingle: function () {
103:       const that = this;
104:       this.oEventBus.publish("nAG", "showBusyDialog");
105:       that._getPackSinlgeDialog(that).then((dialog) => {
106:         dialog.setModel(this.getModel("stockTransferFrontend"), "stockTransferFrontend");
107:         dialog.open();
108:       });
109:     },
110:     _getPackSinlgeDialog: async function (that) {
111:       return new Promise((resolve) => {
112:         if (!that.packSingleDialog) {
113:           Fragment.load({
114:             name: "nag.WarehouseApp.StockTransferRequest.view.PackSingleDialog",
115:             id: "packSingleDialog",
116:             controller: that,
117:           }).then(function (oDialog) {
118:             that.packSingleDialog = oDialog;
119:             resolve(that.packSingleDialog);
120:           });
121:         } else {
122:           resolve(that.packSingleDialog);
123:         }
124:       });
125:     },
126:     // Check if Serial/Batch number is registered at SAPcheckIfValid: function (oEvent) {
127:     checkIfValid: function (oEvent) {
128:       const batchNumber = Fragment.byId("itemDetailsDialog", "inpBatchNumber").getValue();
129:       const object = oEvent.getSource().getBindingContext("stockTransferFrontend").getObject();
130:       const checkCode = object.ManageBatchNumbers === "tYES" ? "Batch" : "Serial";
131:       // AJAX Request to validate the batch/serial number
132:       this.makeAjaxRequest("POST", "item/ItemCode", { codeString: batchNumber }, "codeError", (scannedObject) => {
133:         const value = scannedObject["SN/BN"] || scannedObject.SerialNumber || null;
134:         if (value) {
135:           Fragment.byId("itemDetailsDialog", "inpBatchNumber").setValue(value);
136:         }
137:         this._checkAvailability(object, checkCode);
138:       });
139:       // Handle cases where ManageSerialNumbers is enabled
140:       if (object.ManageSerialNumbers === "tYES") {
141:         this._checkAvailability(object, checkCode);
142:       }
143:     },
144:     _checkAvailability: function (object, checkCode) {
145:       const batchNumber = Fragment.byId("itemDetailsDialog", "inpBatchNumber").getValue();
146:       const tenant = this.getUrlVars().Tenant;
147:       const warehouseCode = this.getModel("SessionModel").getData().WarehouseCode;
148:       this.oEventBus.publish("nAG", "showBusyDialog");
149:       this.makeAjaxRequest(
150:         "POST",
151:         `batchNumber/AvailabilityCheck/${tenant}`,
152:         {
153:           check: checkCode,
154:           ItemCode: object.ItemCode,
155:           WhsCode: warehouseCode,
156:           SerialOrBatch: batchNumber,
157:         },
158:         "codeError",
159:         (response) => {
160:           this.oEventBus.publish("nAG", "hideBusyDialog");
161:           if (response && object.ManageSerialNumbers === "tYES") {
162:             this._updateBinInfo(response);
163:           } else {
164:             Fragment.byId("itemDetailsDialog", "inpBatchNumber").setValueState("None");
165:           }
166:         }
167:       );
168:     },
169:     _updateBinInfo: function (response) {
170:       const sessionData = this.getModel("SessionModel").getData();
171:       sessionData.InpBinFrom = response.BinAbs;
172:       sessionData.SystemSerialNumber = response.SysNumber;
173:       Fragment.byId("itemDetailsDialog", "inpBatchNumber").setValueState("None");
174:       Fragment.byId("itemDetailsDialog", "InpBinFrom").setValue(response.BinCode);
175:     },
176:     // Close Dialog
177:     savePickedQuantity: function () {
178:       const that = this;
179:       that._getItemDetailsDialog().then((dialog) => {
180:         dialog.close();
181:       });
182:       this.getModel("stockTransferFrontend").refresh();
183:       this.oEventBus.publish("nAG", "hideBusyDialog");
184:     },
185:     handleConfirm: function (oEvent) {
186:       const context = oEvent.getParameter("selectedItem").getBindingContext("stockTransferFrontend");
187:       this._openQuantityDialog(context, true);
188:     },
189:     // Open Dialog with context from clicked Line
190:     openfromPress: function (oEvent) {
191:       const bindingPath = oEvent.getParameter("listItem").getBindingContext("stockTransferFrontend");
192:       this._openQuantityDialog(bindingPath, true);
193:     },
194:     // Handles packsingle close action
195:     handleClose: function () {
196:       this.oEventBus.publish("nAG", "hideBusyDialog");
197:     },
198:     _openQuantityDialog: function (context, serialNumberState) {
199:       this._getItemDetailsDialog().then((dialog) => {
200:         this._initializeDialogModels(dialog, context);
201:         dialog.open();
202:         const inputField = this._getInputFieldFromDialog(dialog);
203:         this._setupInputFieldFocus(inputField);
204:         this._setValueStateSerial(context, serialNumberState);
205:       });
206:     },
207:     _initializeDialogModels: function (dialog, context) {
208:       dialog.setModel(this.getModel("stockTransferFrontend"), "stockTransferFrontend");
209:       dialog.setModel(this.getModel("SessionModel"), "SessionModel");
210:       dialog.setBindingContext(context, "stockTransferFrontend");
211:     },
212:     _getInputFieldFromDialog: function (dialog) {
213:       const inputFieldId = dialog.$().find(".sapMInput")[0].id;
214:       return sap.ui.getCore().byId(inputFieldId);
215:     },
216:     _setupInputFieldFocus: function (inputField) {
217:       inputField.addEventDelegate({
218:         onfocusin: function () {
219:           $("#PickedQuantity-inner").select();
220:         },
221:       });
222:       jQuery.sap.delayedCall(300, null, () => {
223:         inputField.focus();
224:       });
225:     },
226:     _getItemDetailsDialog: async function () {
227:       if (!this.ItemDetailsDialog) {
228:         this.ItemDetailsDialog = await Fragment.load({
229:           name: "nag.WarehouseApp.StockTransferRequest.view.ItemDetails",
230:           id: "itemDetailsDialog",
231:           controller: this,
232:         });
233:       }
234:       return this.ItemDetailsDialog;
235:     },
236:     _setValueStateSerial: function (contextPath, serialNumberState) {
237:       const stockTransferLines = this.getModel("stockTransferFrontend").getData().StockTransferLines;
238:       const lineIndex = contextPath.sPath.split("/StockTransferLines/")[1];
239:       const lineData = stockTransferLines[lineIndex];
240:       const isSerialManaged = lineData.ManageSerialNumbers === "tYES";
241:       Fragment.byId("itemDetailsDialog", "PickedQuantity").setValue(isSerialManaged ? 1 : 0);
242:       Fragment.byId("itemDetailsDialog", "btnInc").setEnabled(!isSerialManaged);
243:       Fragment.byId("itemDetailsDialog", "btnDec").setEnabled(!isSerialManaged);
244:       if (serialNumberState !== null) {
245:         const batchNumber = Fragment.byId("itemDetailsDialog", "inpBatchNumber").getValue();
246:         const tenant = this.getUrlVars().Tenant;
247:         const warehouseCode = this.getModel("SessionModel").getData().WarehouseCode;
248:         this.makeAjaxRequest(
249:           "POST",
250:           `batchNumber/AvailabilityCheck/${tenant}`,
251:           {
252:             check: "Serial",
253:             ItemCode: lineData.ItemCode,
254:             WhsCode: warehouseCode,
255:             SerialOrBatch: batchNumber,
256:           },
257:           "codeError",
258:           (response) => {
259:             if (response && isSerialManaged) {
260:               Fragment.byId("itemDetailsDialog", "inpBatchNumber").setValueState("None");
261:               this.getModel("SessionModel").getData().InpBinFrom = response.BinAbs;
