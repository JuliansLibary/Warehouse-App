 689:       const packListLines = this.getModel("DetailModel").getData().PackListLines;
 690:       packListLines.forEach(line => {
 691:         line.visible = parseFloat(line.PackedQuantity) !== parseFloat(line.PickedQuantity);
 692:       });
 693:       const visibleCount = packListLines.filter(line => line.visible).length;
 694:       this._toggleButtons(visibleCount > 0);
 695:       this.getModel("DetailModel").refresh();
 696:     },
