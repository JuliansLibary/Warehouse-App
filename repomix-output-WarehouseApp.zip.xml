360: async function mergePickListWithBinLocations(picklistSL, picklistlinesQuery, multiPickList) {
361:   return new Promise((resolve, reject) => {
362:     const mySet = new Set();
363:     // Create a new Picklist Object
364:     const newPickList = {
365:       Absoluteentry: picklistSL.Absoluteentry,
366:       Name: picklistSL.Name,
367:       PickDate: picklistSL.PickDate,
368:       Remarks: picklistSL.Remarks,
369:       OrderEntry: picklistSL.OrderEntry,
370:       PickListsLines: [],
371:       multiPickList: multiPickList,
372:     };
373:     // If PicklistLine has entries, process them
374:     if (picklistlinesQuery.length > 0) {
375:       picklistlinesQuery.forEach((binLocation) => {
376:         picklistSL.PickListsLines.forEach((pickListsLines) => {
377:           if (pickListsLines.AbsoluteEntry === binLocation.AbsoluteEntry && pickListsLines.LineNumber === binLocation.LineNumber) {
378:             newPickList.PickListsLines.push(createPickListLine(binLocation, pickListsLines));
379:             mySet.add(
380:               JSON.stringify({
381:                 LineNumber: binLocation.LineNumber,
382:                 OrderEntry: binLocation.OrderEntry,
383:                 AbsoluteEntry: pickListsLines.AbsoluteEntry,
384:               })
385:             );
386:           }
387:         });
388:       });
389:     } else {
390:       // Default fallback for ServiceLayer Entity preparation
391:       picklistSL.PickListsLines.forEach((pickListsLines) => {
392:         if (pickListsLines.ReleasedQuantity > 0) {
393:           newPickList.PickListsLines.push(createDefaultPickListLine(pickListsLines));
394:           mySet.add(
395:             JSON.stringify({
396:               LineNumber: pickListsLines.LineNumber,
397:               OrderEntry: pickListsLines.OrderEntry,
398:               AbsoluteEntry: pickListsLines.AbsoluteEntry,
399:             })
400:           );
401:         }
402:       });
403:     }
404:     // Add non-stock articles to the picklist
405:     picklistSL.PickListsLines.forEach((pickListsLines) => {
406:       if (
407:         !mySet.has(
408:           JSON.stringify({
409:             LineNumber: pickListsLines.LineNumber,
410:             OrderEntry: pickListsLines.OrderEntry,
411:             AbsoluteEntry: pickListsLines.AbsoluteEntry,
412:           })
413:         )
414:       ) {
415:         newPickList.PickListsLines.push(createNonStockPickListLine(pickListsLines));
416:       }
417:     });
418:     resolve(newPickList);
419:   });
420: }
