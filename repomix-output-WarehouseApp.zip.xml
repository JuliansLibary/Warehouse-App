2766:         // Use the original backend system for each serial
2767:         const requestPayload = {
2768:           FrontendModel: JSON.stringify(cleanItem),
2769:           FrontendModelchange: JSON.stringify({
2770:             PackListLines: (that.getModel("DetailModel").getData().PackListLines || []).map((packLine) => ({
2771:               ItemCode: packLine.ItemCode,
2772:               ItemDescription: packLine.ItemDescription,
2773:               PackedQuantity: packLine.PackedQuantity,
