<file path="WarehouseApp/nAG.Warehouse.App.InventoryCount/webapp/view/openInventoryCounts.view.xml">
 1: <mvc:View
 2: 	xmlns:core="sap.ui.core"
 3: 	xmlns:mvc="sap.ui.core.mvc"
 4: 	xmlns="sap.m"
 5: 	xmlns:s="sap.f.semantic"
 6: 	xmlns:html="http://www.w3.org/1999/xhtml"
 7: 	controllerName="nag.WarehouseApp.InventoryCounting.controller.openInventoryCounts"
 8: >
 9: 	<s:SemanticPage id="pageWarehouse">
10: 		<s:titleHeading>
