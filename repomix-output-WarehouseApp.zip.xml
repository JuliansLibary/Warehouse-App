<file path="WarehouseApp/nAG.WarehouseApp.PurchaseDeliveryNoteAdhoc/server.js">
 1: /* eslint-disable no-unused-vars */
 2: require("tls").DEFAULT_MIN_VERSION = "TLSv1";
 3: const bodyParser = require("body-parser");
 4: var http = require("http");
 5: var express = require("express");
 6: var app = express();
 7: var modulelogic = require("./routes/modulelogic.js");
 8: // environment variables
 9: if (
10:   process.env.NODE_ENV === "" ||
11:   process.env.NODE_ENV === null ||
12:   process.env.NODE_ENV === undefined
13: ) {
14:   process.env.NODE_ENV = "development";
15: }
16: // Uncomment line below for Self Signed Service Layer
17: process.env["NODE_TLS_REJECT_UNAUTHORIZED"] = 0;
18: // Initialise UI5 App
19: app.use(express.static("./webapp"));
20: // configure the app to use bodyParser()
21: app.use(
22:   bodyParser.urlencoded({
23:     extended: true,
24:   })
25: );
26: app.use(bodyParser.json({}));
27: // For every businesslogic call we read the configuration
28: // Only businesslogic as its the router logic PurchaseDeliveryNoteAdhoc
29: app.all("/businesslogic/*", async function (req, res, next) {
30:   var result = await modulelogic.getConfiguration(
31:     "PurchaseDeliveryNoteAdhoc",
32:     req.headers.referer
33:   );
34:   // Checks if Tenant in URL is valid
35:   if (result === 200) {
36:     next();
37:   } else if (result === 403 || result === 404 || result === 423) {
38:     res.sendStatus(result);
39:   }
40: });
41: // Starts Node JS Instance and read Configuration
42: // After the configuration is loaded from the App we set global Variable and create a "Link" to the businesslogic
43: app.listen(8113, function () {
44:   http.get(
45:     "http://Module-AdminPanel.warehouseapp:8005/internalConfig/initConfigForStart/PurchaseDeliveryNoteAdhoc",
46:     function (response) {
47:       let rawData = "";
48:       response.on("data", (chunk) => {
49:         rawData += chunk;
50:       });
51:       response.on("end", () => {
52:         global.gConfig = JSON.parse(rawData);
53:         // Use the Businesslogic after the variable is set
54:         app.use("/businesslogic", require("./routes/businesslogic.js"));
55:         app.use("/itemlogic", require("./routes/itemlogic.js"));
56:         app.use("/user", require("./routes/userRoutes.js"));
57:         app.use("/tenant", require("./routes/tenantRoutes.js"));
58:       });
59:     }
60:   );
61: });
</file>

