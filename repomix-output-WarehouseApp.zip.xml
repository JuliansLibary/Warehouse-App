 280:       // Finde den Index des Elements im Modell
 281:       const indexOfModel = baseOrder.DocumentLines.findIndex((documentLine) => documentLine.LineNum === result.LineNum);
 282:       // Rückwärts durchlaufen, um das zugehörige Sales Tree Element zu finden
 283:       for (let i = indexOfModel; i >= 0; i--) {
 284:         let currentLine = baseOrder.DocumentLines[i];
 285:         if (currentLine && (currentLine.TreeType === "iSalesTree" || currentLine.TreeType === "S")) {
 286:           Head.push(currentLine);
 287:           break; // Nach erstem Treffer abbrechen, da nur das nächste übergeordnete Element benötigt wird
 288:         }
 289:       }
 290:     }
 291:   });
 292:   // Rückgabe einer Array-Kopie mit einzigartigen Elementen in `Head`
