 42:      */
 43:     handleBinaryContent: function (vData) {
 44:       if (vData) {
 45:         var sMetaData1 = "data:image/jpeg;base64,",
 46:           sMetaData2 = vData.substr(104); // stripping the first 104 bytes from the binary data when using base64 encoding.
 47:         return sMetaData1 + sMetaData2;
 48:       } else {
 49:         return "../images/Employee.png";
 50:       }
 51:     },
 52:     concatString: function (string1, string2) {
 53:       var output = string1 + ' ' + string2;
 54:       return output;
 55:     },
 56:     visibleState: function (inp1, inp2) {
 57:       if (inp1 == inp2) {
 58:         return false;
 59:       } else {
 60:         return true;
 61:       }
 62:     },
 63:     // Todo check i18n
 64:     numText: function (frotendModel) {
 65:       var frontendString;
 66:       if (frotendModel.length > 0) {
 67:         frotendModel.forEach(check => {
 68:           if (check.Check === "Batch") {
 69:             frontendString = "Chargennummern:  \n";
 70:           }
 71:           if (check.Check === "Serial") {
 72:             frontendString = "Seriennummern:  \n";
 73:           }
 74:           if (check.Check === "Bin") {
 75:             frontendString = "Lagerplätze:  \n";
 76:           }
 77:           if (frontendString.split(/\s+|\\n/).includes(check.SerialorBatch) === false || frontendString === "") {
 78:             frontendString += check.SerialorBatch + " \n"
 79:           }
 80:           return frontendString;
 81:         });
 82:       } else {
 83:         return "";
 84:       }
 85:     },
 86:     numCheck: function (oRequired) {
 87:       if (oRequired === "tNO" || oRequired === false) {
 88:         return false;
 89:       } else {
 90:         return true;
 91:       }
 92:     },
 93:     // Dynamischer Check ob ein Artikel Serien oder Chargennummern geführt ist.
 94:     // Aufgrund dieses Status wird im Frontend der Input gesteuert
 95:     numCheckSerialandBatch: function (batch, Serial) {
 96:       if (batch === "tNO" && Serial === "tNO" || batch === false && Serial === false) {
 97:         return false;
 98:       } else {
 99:         return true;
100:       }
101:     },
102:     localDate: function (date) {
103:       var options = {
104:           day: "2-digit",
105:           month: "2-digit",
106:           year: "numeric"
107:         },
108:         parts,
109:         datestring;
110:       if (date !== null && typeof date === "string" && date.includes(".")) {
111:         parts = date.split(".");
112:         datestring = new Date(parseInt(parts[2], 10),
113:           parseInt(parts[1], 10) - 1,
114:           parseInt(parts[0], 10));
115:         return datestring.toLocaleDateString(navigator.language, options);
116:       }
117:       if (date !== null && typeof date === "string" && date.includes("-")) {
118:         parts = date.split("-");
119:         datestring = new Date(parseInt(parts[0], 10),
120:           parseInt(parts[1], 10) - 1,
121:           parseInt(parts[2], 10));
122:         return datestring.toLocaleDateString(navigator.language, options);
123:       } else
124:       if (date !== null && typeof date === "number") {
125:         var datenumber = new Date(date);
126:         return datenumber.toLocaleDateString(navigator.language, options);
127:       } else {
128:         return date;
129:       }
130:     },
131:     pickStatus: function (status) {
132:       switch (status) {
133:         case "P":
134:           return sap.ui.getCore().getModel("i18n").getResourceBundle().getText("partlyPicked");
135:         case "R":
136:           return sap.ui.getCore().getModel("i18n").getResourceBundle().getText("released");
137:         case "Y":
138:           return sap.ui.getCore().getModel("i18n").getResourceBundle().getText("picked");
139:         case "D":
140:           return sap.ui.getCore().getModel("i18n").getResourceBundle().getText("partlyDelivered");
141:         case "ps_Picked":
142:           return sap.ui.getCore().getModel("i18n").getResourceBundle().getText("partlyPicked");
143:         case "ps_Released":
144:           return sap.ui.getCore().getModel("i18n").getResourceBundle().getText("released");
145:         case "ps_PartiallyDelivered":
146:           return sap.ui.getCore().getModel("i18n").getResourceBundle().getText("partlyDelivered");
147:         default:
148:           return sap.ui.getCore().getModel("i18n").getResourceBundle().getText("picked");
149:       }
150:     },
151:     pickState: function (status) {
152:       switch (status) {
153:         case "P":
154:           return sap.ui.core.ValueState.Warning;
155:         case "R":
156:           return sap.ui.core.ValueState.Error;
157:         case "Y":
158:           return sap.ui.core.ValueState.Success;
159:         case "D":
160:           return sap.ui.core.ValueState.Warning;
161:         case "ps_Picked":
162:           return sap.ui.core.ValueState.Warning;
163:         case "ps_Released":
164:           return sap.ui.core.ValueState.Error;
165:         case "ps_PartiallyDelivered":
166:           return sap.ui.core.ValueState.Warning;
167:         default:
168:           return sap.ui.core.ValueState.Success;
169:       }
170:     },
171:     serialNumText: function (statusSerial, statusBatch, serialNum, batchNum) {
172:       if (typeof serialNum !== "undefined") {
173:         return serialNum;
174:       } else if (typeof batchNum !== "undefined") {
175:         return batchNum;
176:       } else if (statusSerial === "tYES") {
177:         return sap.ui.getCore().getModel("i18n").getResourceBundle().getText("serialNumberRequired");
178:       } else if (statusBatch === "tYES") {
179:         return sap.ui.getCore().getModel("i18n").getResourceBundle().getText("batchNumberRequired");
180:       } else {
181:         return sap.ui.getCore().getModel("i18n").getResourceBundle().getText("unmanaged");
182:         //return sap.ui.getCore().getModel("i18n").getResourceBundle().getText("noNumberRequired");
183:       }
