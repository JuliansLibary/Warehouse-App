<file path="WarehouseApp/nAG.WarehouseApp.PurchaseDeliveryNoteAdhoc/webapp/BaseController.js">
  1: sap.ui.define(
  2:   [
  3:     "sap/ui/core/mvc/Controller",
  4:     "sap/ui/core/EventBus",
  5:     "sap/ui/core/routing/History",
  6:     "sap/ui/model/json/JSONModel",
  7:     "sap/ui/Device",
  8:     "sap/m/MessageBox",
  9:     "sap/ui/core/Fragment",
 10:     "sap/m/Dialog",
 11:     "sap/m/Text",
 12:     "sap/m/Link",
 13:     "sap/m/Button",
 14:     "sap/ui/core/ValueState",
 15:     "sap/m/VBox",
 16:   ],
 17:   function (
 18:     Controller,
 19:     EventBus,
 20:     History,
 21:     JSONModel,
 22:     Device,
 23:     MessageBox,
 24:     Fragment,
 25:     Dialog,
 26:     Text,
 27:     Link,
 28:     Button,
 29:     ValueState,
 30:     VBox
 31:   ) {
 32:     return Controller.extend(
 33:       "nag.WarehouseApp.PurchaseDeliveryNoteAdhoc.BaseController",
 34:       {
 35:         /**
 36:          * Convenience method for saving the BaseController in a global variable and creating fields that need to be accessed
 37:          * @public
 38:          */
 39:         register: function () {
 40:           this.oEventBus = sap.ui.getCore().getEventBus();
 41:           $.sap.control = this;
 42:           this.oEventBus.subscribe(
 43:             "nAG",
 44:             "showBusyDialog",
 45:             this.showBusyDialog,
 46:             this
 47:           );
 48:           this.oEventBus.subscribe(
 49:             "nAG",
 50:             "hideBusyDialog",
 51:             this.hideBusyDialog,
 52:             this
 53:           );
 54:           this.oEventBus.subscribe(
 55:             "nAG",
 56:             "changeAppView",
 57:             this.changeAppViewLayout,
 58:             this
 59:           );
 60:           this.oEventBus.subscribe(
 61:             "nAG",
 62:             "getAppView",
 63:             this.getViewElement,
 64:             this
 65:           );
 66:         },
 67:         // Returns the Namespace for use
 68:         _getNamespace: function () {
 69:           var oViewName = this.getOwnerComponent()
 70:             .getMetadata()
 71:             .getRootView().viewName;
 72:           return oViewName.split(".App")[0];
 73:         },
 74:         /**
 75:          * @param {Controller} activeController: current controller where t he dialog should be rendered
 76:          * @param {String} nameOfDialog:  name of the fragment to be called
 77:          * @param {String} idOfDialog : id of the Dialog
 78:          */
 79:         getDialog: async function (activeController, nameOfDialog, idOfDialog) {
 80:           var that = this;
 81:           return new Promise((resolve, reject) => {
 82:             if (!activeController[nameOfDialog]) {
 83:               Fragment.load({
 84:                 name: that._getNamespace() + "." + nameOfDialog,
 85:                 id: idOfDialog,
 86:                 controller: activeController,
 87:               }).then(function (oDialog) {
 88:                 activeController[nameOfDialog] = oDialog;
 89:                 resolve(activeController[nameOfDialog]);
 90:               });
 91:             } else {
 92:               resolve(activeController[nameOfDialog]);
 93:             }
 94:           });
 95:         },
 96:         /**
 97:          * @param {String} method: Can be at nAG: POST,PATCH,GET
 98:          * @param {String} url:  url for the ajax Call
