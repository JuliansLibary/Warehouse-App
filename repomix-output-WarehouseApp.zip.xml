220:         success: function (data) {
221:           if (data.singlePick) {
222:             pickmode = "Single";
223:           } else {
224:             pickmode = "Multi";
225:           }
226:           if (data.onlyScan) {
227:             listmode = "Inactive";
228:           } else {
229:             listmode = "Active";
230:           }
231:           that.getViewModel("appView").setProperty("/pickMode", pickmode);
232:           that.getViewModel("appView").setProperty("/listMode", listmode);
233:           if (typeof data.isDeleted !== "undefined") {
234:             that.getViewModel("appView").setProperty("/isDeleted", data.isDeleted);
235:           }
236:           if (data.launchpad) {
237:             that.getViewModel("appView").setProperty("/launchpad", data.launchpad);
238:           }
239:         },
240:         error: function (jqXHR) {
241:           that.showError("appConfigError", jqXHR.responseJSON.error.message.value, jqXHR.responseJSON.error.code);
242:         },
243:       });
244:     },
245:     getUrlVars: function () {
246:       var vars = {},
