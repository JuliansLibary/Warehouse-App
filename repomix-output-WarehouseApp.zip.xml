427: /**
428:  * Process serial scan with backend validation
429:  * Migrated from: _processSerialScan in Detail.controller.js
430:  */
431: async function processSerialScan(req, res) {
432:   try {
433:     const { serialNumber, itemCode, warehouseCode, tenantId, scannedSerials = [] } = req.body;
434:     if (!serialNumber || !itemCode || !warehouseCode) {
435:       return res.status(400).json({
436:         success: false,
437:         error: "Missing required fields: serialNumber, itemCode, warehouseCode",
438:       });
439:     }
440:     // Normalize serial number
441:     const normalizedSerial = normalizeSerialNumber(serialNumber);
442:     // Check for local duplicates first
443:     const isDuplicate = scannedSerials.some((serial) => {
444:       const serialNum = serial.DistNumber || serial.SerialNumber;
445:       const manufacturerSerialNum = serial.ManufacturerSerialNumber || serial.InternalSerialNumber;
446:       return normalizeSerialNumber(serialNum) === normalizedSerial || normalizeSerialNumber(manufacturerSerialNum) === normalizedSerial;
447:     });
448:     if (isDuplicate) {
449:       return res.status(400).json({
450:         success: false,
451:         error: "DUPLICATE_SERIAL",
452:         message: `Serial number "${serialNumber}" is already scanned`,
453:       });
454:     }
455:     // Backend validation - decode barcode first
456:     try {
457:       // Validate serial availability with backend
458:       const instance = await getInstance();
459:       SL.Request(
460:         `Items('${itemCode}')/ItemCode`,
461:         "POST",
462:         JSON.stringify({ codeString: serialNumber }),
463:         await generateBasicAuth(req.headers, tenantId),
464:         {
465:           retryTimes: 2,
466:           retryDelay: 750,
467:           SLURL: instance.SLURL,
468:           SLPort: instance.SLPort,
469:         },
470:         async function (error, decodeResponse) {
471:           if (error) {
472:             return res.status(error.httpStatusCode).json({
473:               success: false,
474:               error: "DECODE_ERROR",
475:               message: "Failed to decode barcode",
476:             });
477:           }
478:           const codeToCheck = decodeResponse && decodeResponse["SN/BN"] ? decodeResponse["SN/BN"] : serialNumber;
479:           // Validate serial availability
480:           SL.Request(
481:             `SerialNumbers?$filter=ItemCode eq '${itemCode}' and WarehouseCode eq '${warehouseCode}' and SerialNumber eq '${codeToCheck}'`,
482:             "GET",
483:             null,
484:             await generateBasicAuth(req.headers, tenantId),
485:             {
486:               retryTimes: 2,
487:               retryDelay: 750,
488:               SLURL: instance.SLURL,
489:               SLPort: instance.SLPort,
490:             },
491:             async function (error, serialResponse) {
492:               if (error) {
493:                 return res.status(error.httpStatusCode).json({
494:                   success: false,
495:                   error: "VALIDATION_ERROR",
496:                   message: "Failed to validate serial number",
497:                 });
498:               }
499:               if (serialResponse && serialResponse.value && serialResponse.value.length > 0) {
500:                 const serialData = serialResponse.value[0];
501:                 res.json({
502:                   success: true,
503:                   serialData: serialData,
504:                   normalizedSerial: codeToCheck,
505:                   originalSerial: serialNumber,
506:                 });
507:               } else {
508:                 res.status(404).json({
509:                   success: false,
510:                   error: "SERIAL_NOT_AVAILABLE",
511:                   message: `Serial number "${codeToCheck}" is not available`,
512:                 });
513:               }
514:             }
515:           );
516:         }
517:       );
518:     } catch (error) {
519:       res.status(500).json({
520:         success: false,
521:         error: "PROCESSING_ERROR",
522:         message: "Unexpected error during serial processing",
523:       });
524:     }
525:   } catch (error) {
526:     res.status(500).json({
527:       success: false,
528:       error: "INTERNAL_ERROR",
529:       message: error.message,
530:     });
531:   }
532: }
533: /**
534:  * Check if serial is duplicate in local context
535:  * Migrated from: _isDuplicateLocal in Detail.controller.js
536:  */
537: async function checkLocalDuplicate(req, res) {
538:   try {
539:     const { serialNumber, scannedSerials = [] } = req.body;
540:     if (!serialNumber) {
541:       return res.status(400).json({
542:         success: false,
543:         error: "Serial number is required",
544:       });
545:     }
546:     const normalizedSerial = normalizeSerialNumber(serialNumber);
547:     const isDuplicate = scannedSerials.some((serial) => {
548:       const serialNum = serial.DistNumber || serial.SerialNumber;
549:       const manufacturerSerialNum = serial.ManufacturerSerialNumber || serial.InternalSerialNumber;
550:       return normalizeSerialNumber(serialNum) === normalizedSerial || normalizeSerialNumber(manufacturerSerialNum) === normalizedSerial;
551:     });
552:     res.json({
553:       success: true,
554:       isDuplicate: isDuplicate,
555:       serialNumber: serialNumber,
556:       normalizedSerial: normalizedSerial,
557:     });
558:   } catch (error) {
559:     res.status(500).json({
560:       success: false,
561:       error: "Failed to check for duplicates",
562:       message: error.message,
563:     });
564:   }
565: }
566: module.exports = {
567:   checkSerialNumber,
568:   pushSerialNumber,
569:   getAvailableSerialNumbers,
570:   validateSerialForDuplicates,
571:   batchValidateSerials,
572:   validateModelIntegrityEndpoint,
573:   normalizeSerialNumber,
574:   checkForDuplicates,
575:   processSerialScan,
576:   checkLocalDuplicate,
577: };
