297:     },
298:     /**
299:      * Erstellt einen Log eintrag in der SAP Log DB
300:      * Folgende Log Level gibt es:
301:      * error: Fehler
302:      * warning: nicht erwünschte aber vorausgesehene Situation
303:      * fatal: Programm funktioniert nicht mehr
304:      * trace: Programmfluss verfolgen
305:      * debug: Information ist fürs debugging wichtig
306:      **/
307:     createLog: function (loglevel, bezeichnung, additionalinfo) {
308:       additionalinfo = additionalinfo || "";
309:       if (loglevel === "error") {
310:         jQuery.sap.log.error(bezeichnung, additionalinfo);
311:       } else if (loglevel === "warning") {
312:         jQuery.sap.log.warning(bezeichnung, additionalinfo);
313:       } else if (loglevel === "fatal") {
314:         jQuery.sap.log.fatal(bezeichnung, additionalinfo);
315:       } else if (loglevel === "trace") {
316:         jQuery.sap.log.trace(bezeichnung, additionalinfo);
317:       } else if (loglevel === "debug") {
318:         jQuery.sap.log.debug(bezeichnung, additionalinfo);
319:       }
320:     },
321:     /**
322:      * Standard Error-Call improved by Maciej
323:      * 21.08.2019 Improved the Messagebox and added SAP Error Messages
324:      * showError(i18nFehlermeldung, zusätzlicheInformation, Fehlercode)
325:      */
326:     showError: function (extraInfo, errorCode) {
327:       const that = this;
328:       this.oEventBus.publish("nAG", "hideBusyDialog");
329:       const dialog = new sap.m.Dialog({
330:         title: errorCode,
331:         type: "Message",
332:         state: sap.ui.core.ValueState.Error,
333:         content: new sap.m.VBox({
