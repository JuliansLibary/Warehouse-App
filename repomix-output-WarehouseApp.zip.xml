346:      * Convenience method for getting Variable from URL
347:      */
348:     getUrlVars: function () {
349:       var vars = {},
350:         parts = window.location.href.replace(/[?&]+([^=&]+)=([^&#]*)/gi, function (m, key, value) {
351:           vars[key] = value;
352:         });
353:       return vars;
354:     },
355:     setViewModel: function (oModel, sName) {
356:       return this.getView().setModel(oModel, sName);
357:     },
358:     getViewModel: function (sName) {
359:       return this.getView().getModel(sName);
360:     },
361:     getSession: function (view) {
362:       var cookie = this.getCookie("ServiceLayer");
363:       if (cookie !== null) {
364:         return cookie;
365:       } else {
366:         return null;
367:       }
368:     },
369:     removeCookie: function (Username, Password, CompanyDB) {
370:       document.cookie = "ServiceLayer=;expires=Thu, 01 Jan 1970 00:00:00 GMT";
371:     },
372:     getCookie: function (cname) {
373:       var name = cname + "=";
374:       var ca = document.cookie.split(';');
375:       for (var i = 0; i < ca.length; i++) {
376:         var c = ca[i];
377:         while (c.charAt(0) == ' ') {
378:           c = c.substring(1);
379:         }
380:         if (c.indexOf(name) == 0) {
381:           return c.substring(name.length, c.length);
382:         }
383:       }
384:       return null;
385:     },
386:     goToLogin: function () {
387:       var that = this;
388:       sap.m.MessageBox.show(this.getMessage("noSession"), {
389:         icon: sap.m.MessageBox.Icon.WARNING,
390:         title: this.getMessage("noSessionTitle"),
391:         actions: [sap.m.MessageBox.Action.OK],
392:         // Wenn die Warnung angenommen wird öffne den Zeitbuchungsdialog mit ausgefüllten Daten
393:         onClose: function (par) {
394:           if (par === "OK") {
395:             that.getViewModel("appView").setProperty("/layout", "OneColumn");
396:             that.getRouter().navTo("Login");
397:             that._loggedOut();
398:           }
399:         }
400:       });
401:     },
402:     _loggedOut: function () {
403:       var x = this.getPartsFromCookie();
404:       if (this.getSession() !== null) {
405:         this.removeCookie(x[0], x[1], x[2]);
406:       }
407:     },
408:     getPartsFromCookie: function () {
409:       if (this.getSession() !== null) {
410:         var x = atob(this.getCookie("ServiceLayer").substring(6)),
411:           y = JSON.parse(x.split(':')[0] + ":" + x.split(':')[1] + ":" + x.split(':')[2]),
412:           user = y.UserName,
413:           company = y.CompanyDB,
414:           pass = x.split(":")[3];
415:         return [user, pass, company];
416:       } else {
417:         return null;
418:       }
419:     },
420:     getAppConfig: function () {
421:       var that = this,
422:         packBy = null;
423:       $.ajax({
424:         url: "internalConfig/appConfig",
425:         crossDomain: true,
426:         type: "GET",
427:         dataType: "json",
428:         success: function (data) {
429:           if (data.packBy === "Order") {
430:             packBy = "Order";
431:           } else if (data.packBy === "ShipTo") {
432:             packBy = "ShipTo";
433:           }
434:           that.getViewModel("appView").setProperty("/packMode", packBy);
435:           // Check if Launchpad is a Parameter at Configuration
436:           if (data.launchpad) {
437:             that.getViewModel("appView").setProperty("/launchpad", data.launchpad);
438:           }
439:           // Check if shippingType is a Parameter at Configuration
440:           if (data.shippingType) {
441:             that.getViewModel("appView").setProperty("/shippingType", data.shippingType);
442:           }
443:         },
444:         error: function (jqXHR) {
445:           that.showError("appConfigError", jqXHR.responseJSON.error.message.value, jqXHR.responseJSON.error.code);
446:         }
447:       });
448:     }
449:   });
450: });
</file>

