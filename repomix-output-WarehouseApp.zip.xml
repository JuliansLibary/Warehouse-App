430:     /**
431:      * Creates a multi-page print window with separate pages for each bin location
432:      * @param {Array} printResults - Array of print results with response HTML content
433:      */
434:     _printMultiPageLabels: function(printResults) {
435:       const nAGLabel = window.open("", "PRINT_MULTIPAGE", "height=800,width=1000");
436:       // Build multi-page HTML document
437:       let multiPageHTML = `
438:         <!DOCTYPE html>
439:         <html>
440:         <head>
441:           <title>Lagerplatz Labels</title>
442:           <style>
443:             @page {
444:               size: A4;
445:               margin: 0;
446:             }
447:             .page {
448:               page-break-after: always;
449:               width: 100%;
450:               height: 100vh;
451:               display: flex;
452:               justify-content: center;
453:               align-items: center;
454:             }
455:             .page:last-child {
456:               page-break-after: avoid;
457:             }
458:             body {
459:               margin: 0;
460:               padding: 0;
461:             }
462:           </style>
463:           <script>
464:             window.onload = function() {
465:               window.print();
466:             };
467:           </script>
468:         </head>
469:         <body>
470:       `;
471:       // Add each label as a separate page
472:       printResults.forEach((result, index) => {
473:         // Extract body content from the HTML response
474:         const bodyMatch = result.response.match(/<body[^>]*>([\s\S]*?)<\/body>/i);
475:         const bodyContent = bodyMatch ? bodyMatch[1] : result.response;
476:         multiPageHTML += `
477:           <div class="page">
478:             <div style="width: 100%; height: 100%;">
479:               ${bodyContent}
480:             </div>
481:           </div>
482:         `;
483:       });
484:       multiPageHTML += `
485:         </body>
486:         </html>
487:       `;
488:       // Write the multi-page content
489:       nAGLabel.document.write(multiPageHTML);
490:       nAGLabel.document.close();
491:       nAGLabel.focus();
