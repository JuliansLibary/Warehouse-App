 45:             this
 46:           );
 47:           this.oEventBus.subscribe(
 48:             "nAG",
 49:             "getAppView",
 50:             this.getViewElement,
 51:             this
 52:           );
 53:         },
 54:         /**
 55:          *
 56:          * @param {String} method: Can be at nAG: POST,PATCH,GET
 57:          * @param {String} url:  url for the ajax Call
 58:          * @param {JSON} postContent : JSON Body for a patch/post
 59:          * @param {String} i18n : String for a call of the error dialogue via i18n
 60:          * @param {JSON} callback :  Returns a JSON after a successful Ajax call. Can be further used in the frontend
 61:          * NOTE: No IF is needed to build the postContent dynamically for the AJAX. With a GET, the postContent is not transferred to the backend.
 62:          */
 63:         makeAjaxRequest: function (method, url, postContent, i18n, callback) {
 64:           const that = this;
 65:           $.ajax({
 66:             url: url,
 67:             xhrFields: {
 68:               withCredentials: true,
 69:             },
 70:             data: postContent,
 71:             crossDomain: true,
 72:             type: method,
 73:             tryCount: 0,
 74:             retryLimit: 3,
 75:             contentType: "application/json",
 76:             headers: {
 77:               prefer: "odata.maxpagesize=0",
 78:             },
 79:             success: function (response, status, xhr) {
 80:               callback(response);
 81:             },
 82:             error: function (jqXHR, textStatus) {
 83:               const Language = that.getUrlVars().Language
 84:               if (textStatus === "timeout") {
 85:                 this.tryCount++;
 86:                 if (this.tryCount <= this.retryLimit) {
 87:                   $.ajax(this);
 88:                   return;
 89:                 } else {
 90:                   that.showError({ message: "NetworkError", helpUrl: null }, "9000");
 91:                 }
 92:               }
 93:               if (
 94:                 typeof jqXHR.responseText !== "undefined" &&
 95:                 jqXHR.status !== "undefined"
 96:               ) {
 97:                 if (typeof jqXHR.responseJSON !== "undefined") {
 98:                   that.showError(that.findTranslation(jqXHR.responseJSON, Language), jqXHR.status);
 99:                 } else {
100:                   let errorMessage;
101:                   if (jqXHR.status === 423) {
102:                     errorMessage = {
103:                       message: that.getModel("i18n").getResourceBundle().getText("invalidTenant"),
104:                       helpUrl: null
105:                     }
106:                   } else {
107:                     errorMessage = {
108:                       message: jqXHR.responseText,
109:                       helpUrl: null
110:                     }
111:                   }
112:                   that.showError(errorMessage, jqXHR.status);
113:                 }
114:               } else {
115:                 that.showError(that.findTranslation(jqXHR.responseJSON, Language), 400);
116:               }
117:             },
118:           });
119:         },
120:         findTranslation: function (data, langCode) {
121:           let response;
122:           if (data.body.helpUrl) {
123:             response = {
124:               message: "",
125:               helpUrl: data.body.helpUrl || null
126:             };
127:           } else {
128:             response = {
129:               message: ""
130:             };
131:           }
132:           if (data.body.translations && data.body.translations.length > 0) {
133:             const translation = data.body.translations.find(entry => entry.language === langCode);
134:             if (translation) {
135:               response.message = translation.text;
136:             }
137:           }
138:           if (!response.message && data.body.message) {
139:             response.message = data.body.message;
140:           }
141:           return response;
142:         },
143:         // Returns the Namespace for use
144:         _getNamespace: function () {
145:           const oViewName = this.getOwnerComponent()
146:             .getMetadata()
147:             .getRootView().viewName;
148:           return oViewName.split(".App")[0];
149:         },
150:         /**
151:           * @param {Controller} activeController: current controller where t he dialog should be rendered
152:           * @param {String} nameOfDialog:  name of the fragment to be called
153:           * @param {String} idOfDialog : id of the Dialog
154:           */
155:         getDialog: async function (activeController, nameOfDialog, idOfDialog) {
156:           const that = this;
157:           return new Promise((resolve, reject) => {
158:             if (!activeController[nameOfDialog]) {
159:               Fragment.load({
160:                 name: that._getNamespace() + "." + nameOfDialog,
161:                 id: idOfDialog,
162:                 controller: activeController,
163:               }).then(function (oDialog) {
164:                 activeController[nameOfDialog] = oDialog;
165:                 resolve(activeController[nameOfDialog]);
166:               });
167:             } else {
168:               resolve(activeController[nameOfDialog]);
169:             }
170:           });
171:         },
172:         /**
173:           * Convenience method for accessing the router in every controller of the application.
174:           * @public
175:           * @returns {sap.ui.core.routing.Router} the router for this component
176:           */
177:         getRouter: function () {
178:           return sap.ui.core.UIComponent.getRouterFor(this);
179:         },
180:         getUrlVars: function () {
181:           const queryParams = {};
182:           const url = window.location.href;
183:           url.replace(/[?&]+([^=&]+)=([^&#]*)/gi, (match, key, value) => {
184:             queryParams[key] = value;
185:           });
186:           return queryParams;
187:         },
188:         /**
189:           * Convenience method for getting the view model by name in every controller of the application.
190:           * @public
191:           * @param {string} sName the model name
192:           * @returns {sap.ui.model.Model} the model instance
193:           */
194:         getModel: function (sName) {
195:           return sap.ui.getCore().getModel(sName);
196:         },
197:         /**
198:           * Convenience method for setting the view model in every controller of the application.
199:           * @public
200:           * @param {sap.ui.model.Model} oModel the model instance
201:           * @param {string} sName the model name
202:           * @returns {sap.ui.mvc.View} the view instance
203:           */
204:         setModel: function (oModel, sName) {
205:           return sap.ui.getCore().setModel(oModel, sName);
206:         },
207:         /**
208:           * Convenience method for saving the BusyDialog in a global variable
209:           * @public
210:           */
211:         getBusyDialog: function () {
212:           const busyDialog = sap.ui.xmlfragment(
213:             "busyDialog",
214:             "nag.WarehouseApp.SalesOrderDelivery.view.BusyDialog",
215:             this
216:           );
217:           this.getView().addDependent(busyDialog);
218:           this.busyDialog = busyDialog;
219:         },
