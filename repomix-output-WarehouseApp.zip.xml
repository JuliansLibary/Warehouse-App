 51:                     context: "otherPackage",
 52:                     package: pkgIndex,
 53:                     message: `Serial number "${serialNumber}" is already assigned to another package for this item.`,
 54:                   };
 55:                 } else {
 56:                   return {
 57:                     isDuplicate: true,
 58:                     context: "crossItem",
 59:                     package: pkgIndex,
 60:                     message: `Serial number "${serialNumber}" is already assigned to a different item.`,
 61:                   };
 62:                 }
 63:               }
 64:             }
 65:           }
 66:         }
 67:       }
 68:     }
 69:   }
