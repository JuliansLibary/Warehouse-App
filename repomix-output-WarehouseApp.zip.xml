  2:  * BACKEND API SERVICE
  3:  * Central service for all backend API calls to replace business logic in Detail.controller.js
  4:  * This service layer provides clean interfaces to the migrated backend business logic
  5:  */
  6: sap.ui.define([
  7:     "sap/ui/base/Object",
  8:     "sap/m/MessageToast"
  9: ], function (BaseObject, MessageToast) {
 10:     "use strict";
 11:     return BaseObject.extend("nag.warehouse.app.pack.services.BackendApiService", {
 12:         /**
 13:          * Base URL for backend API calls
 14:          */
 15:         _baseUrl: "",
 16:         /**
 17:          * Initialize the service with base URL
 18:          */
 19:         init: function() {
 20:             // Keep it simple - use relative URLs like the original system
 21:             this._baseUrl = "";
 22:             console.info("BackendApiService initialized - using relative URLs");
 23:         },
 24:         /**
 25:          * Safely stringify data, removing circular references
 26:          * @param {Object} data - Data to stringify
 27:          * @returns {string} Safe JSON string
 28:          */
 29:         _safeStringify: function(data) {
 30:             const seen = new Set();
 31:             const replacer = (key, value) => {
 32:                 // Remove UI5 specific properties that cause circular references
 33:                 if (key === 'aBindings' || key === 'oModel' || key === 'mEventRegistry' || 
 34:                     key === 'oParent' || key === '_oProxy' || key === 'oDomRef') {
 35:                     return undefined;
 36:                 }
 37:                 if (typeof value === 'object' && value !== null) {
 38:                     if (seen.has(value)) {
 39:                         return undefined; // Remove circular reference
 40:                     }
 41:                     seen.add(value);
 42:                 }
 43:                 return value;
 44:             };
 45:             try {
 46:                 return JSON.stringify(data || {}, replacer);
 47:             } catch (error) {
 48:                 console.warn("Failed to stringify data, using fallback", error);
 49:                 // Fallback: return minimal data structure
 50:                 return JSON.stringify({
 51:                     type: "fallback_data",
 52:                     timestamp: new Date().toISOString()
 53:                 });
 54:             }
 55:         },
 56:         /**
 57:          * Clean data object by removing UI5-specific properties and converting to plain objects
 58:          * @param {Object} data - Data to clean
 59:          * @returns {Object} Cleaned data object
 60:          */
 61:         _cleanDataForBackend: function(data) {
 62:             const seen = new Set();
 63:             function cleanValue(key, value) {
 64:                 // Remove UI5 specific properties that cause problems
 65:                 if (key === 'aBindings' || key === 'oModel' || key === 'mEventRegistry' || 
 66:                     key === 'oParent' || key === '_oProxy' || key === 'oDomRef' ||
 67:                     key === 'sPath' || key === 'bForceRefresh' || key === 'sDeepPath') {
 68:                     return undefined;
 69:                 }
 70:                 if (typeof value === 'object' && value !== null) {
 71:                     if (seen.has(value)) {
 72:                         return undefined; // Remove circular reference
 73:                     }
 74:                     seen.add(value);
 75:                     // If it's an array, clean each element
 76:                     if (Array.isArray(value)) {
 77:                         return value.map((item, index) => cleanValue(index.toString(), item)).filter(item => item !== undefined);
 78:                     }
 79:                     // If it's an object, clean each property
 80:                     const cleanedObj = {};
 81:                     for (const [objKey, objValue] of Object.entries(value)) {
 82:                         const cleanedValue = cleanValue(objKey, objValue);
 83:                         if (cleanedValue !== undefined) {
 84:                             cleanedObj[objKey] = cleanedValue;
 85:                         }
 86:                     }
 87:                     return cleanedObj;
 88:                 }
 89:                 return value;
 90:             }
 91:             try {
 92:                 return cleanValue('root', data);
 93:             } catch (error) {
 94:                 console.warn("Failed to clean data, using fallback", error);
 95:                 return {
 96:                     type: "fallback_data",
 97:                     timestamp: new Date().toISOString(),
 98:                     originalError: error.message
 99:                 };
100:             }
101:         },
102:         /**
103:          * Make an API call to the backend using BaseController's makeAjaxRequest
104:          * @param {string} endpoint - API endpoint
105:          * @param {Object} data - Request payload
106:          * @param {string} method - HTTP method (default: POST)
107:          * @returns {Promise} API response
108:          */
109:         _makeApiCall: function(endpoint, data, method = "POST") {
110:             console.info("=== BACKEND API SERVICE CALL ===");
111:             console.info("Endpoint:", endpoint);
112:             console.info("Method:", method);
113:             console.info("Data before cleaning:", data);
114:             // Clean the data to remove UI5-specific properties
