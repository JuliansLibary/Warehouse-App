  3: sap.ui.define(
  4:   ["nag/WarehouseApp/PurchaseDeliveryNoteAdhoc/BaseController"],
  5:   function (BaseController) {
  6:     "use strict";
  7:     return BaseController.extend(
  8:       "nag.WarehouseApp.PurchaseDeliveryNoteAdhoc.controller.Warehouse",
  9:       {
 10:         /**
 11:          * Called when a controller is instantiated and its View controls (if available) are already created.
 12:          * Can be used to modify the View before it is displayed, to bind event handlers and do other one-time initialization.
 13:          * @memberOf nAG.PurchaseDeliveryNote.view.Master
 14:          */
 15:         onInit: function () {
 16:           this.oEventBus = sap.ui.getCore().getEventBus();
 17:           this._setupRoute();
 18:         },
 19:         _setupRoute: function () {
 20:           this.getRouter()
 21:             .getRoute("Warehouse")
 22:             .attachPatternMatched(this._onWarehouseMatched, this);
 23:         },
 24:         onLogout: function () {
 25:           window.open("/launchpad/?Theme=" + this.getUrlVars().Theme + "&Language=" + this.getUrlVars().Language + "&Tenant=" + this.getUrlVars().Tenant + "#/Dashboard", "_top");
 26:         },
 27:         onBeforeRendering: function () {
 28:           if (window.location.href.includes("?Theme=")) {
 29:             sap.ui.getCore().applyTheme(this.getUrlVars().Theme);
 30:           }
 31:         },
 32:         /*  Laden der verfügbaren Lagerplätze
 33:         Wenn nur ein Lagerplatz vorhanden ist wird dieser automatisch ausgewählt
 34:     */
 35:         _onWarehouseMatched: function () {
 36:           this.oEventBus.publish("nAG", "showBusyDialog");
 37:           var that = this,
 38:             warehouseURL = "businesslogic/Warehouse/" + this.getUrlVars().Tenant;
 39:           // filter Warehouse per location
 40:           if (decodeURIComponent(this.getUrlVars().location) !== "undefined") {
 41:             warehouseURL +=
 42:               "/" + decodeURIComponent(this.getUrlVars().location);
 43:           }
 44:           if (this.getModel("SessionModel") === undefined) {
 45:             this.setModel(new sap.ui.model.json.JSONModel(), "SessionModel");
 46:             this.setViewModel(this.getModel("SessionModel"), "SessionModel");
 47:             this.getModel("SessionModel").setData({
 48:               WarehouseCode: null,
 49:             });
 50:             this.getModel("SessionModel").refresh();
 51:           }
 52:           if (this.getModel("WarehouseModel") === undefined) {
 53:             this.setModel(new sap.ui.model.json.JSONModel(), "WarehouseModel");
 54:             this.setViewModel(
 55:               this.getModel("WarehouseModel"),
 56:               "WarehouseModel"
 57:             );
 58:             that = this;
 59:             this.makeAjaxRequest(
 60:               "GET",
 61:               warehouseURL,
 62:               null,
 63:               "warehouseError",
 64:               function (response) {
 65:                 that.getModel("WarehouseModel").setData(response);
 66:                 that.getModel("WarehouseModel").refresh();
 67:                 if (response.length === 1) {
 68:                   that
 69:                     .getViewModel("appView")
 70:                     .setProperty("/layout", "TwoColumnsMidExpanded");
 71:                   that.getModel("SessionModel").getData().WarehouseCode =
 72:                     response[0].WarehouseCode;
 73:                   that.getModel("SessionModel").getData().EnableBinLocations =
 74:                     response[0].EnableBinLocations;
 75:                   that.getModel("SessionModel").refresh();
 76:                   that.getRouter().navTo("PickLists");
 77:                   that.oEventBus.publish("nAG", "hideBusyDialog");
 78:                 } else {
 79:                   if (that.getModel("WarehouseModel").getData().length === 1) {
 80:                     that.getModel("SessionModel").getData().WarehouseCode = that
 81:                       .getModel("WarehouseModel")
 82:                       .getData()[0].WarehouseCode;
 83:                     that.getRouter().navTo("WarehouseTo");
 84:                   }
 85:                   that.oEventBus.publish("nAG", "hideBusyDialog");
 86:                 }
 87:               }
 88:             );
 89:           }
 90:         },
 91:         onSearch: function (oEvent) {
 92:           var aFilter = [];
 93:           var sQuery = oEvent.getParameter("query");
 94:           if (sQuery) {
 95:             aFilter.push(
 96:               new sap.ui.model.Filter({
 97:                 filters: [
 98:                   new sap.ui.model.Filter(
 99:                     "WarehouseCode",
100:                     sap.ui.model.FilterOperator.EQ,
101:                     sQuery
102:                   ),
103:                   new sap.ui.model.Filter(
104:                     "WarehouseName",
105:                     sap.ui.model.FilterOperator.EQ,
106:                     sQuery
107:                   ),
108:                 ],
109:                 and: false,
110:               })
111:             );
112:           }
113:           this.getDebugMode();
114:           // filter binding
115:           var oList = this.byId("lstWarehouse");
116:           var oBinding = oList.getBinding("items");
117:           this.getDebugMode();
118:           this.getDebugMode();
119:           oBinding.filter(aFilter);
120:         },
121:         /*
122:     Sobald in der Liste ein Lager ausgewählt wurde wird dieses in das Session Modell für das Pick App geschrieben.
123:     Der nächste View wird aufgerufen
124:     */
125:         onItemPressed: function (oEvent) {
126:           this.oEventBus.publish("nAG", "showBusyDialog");
127:           var warehouse = oEvent
128:             .getSource()
129:             .getSelectedItem()
130:             .getBindingContext("WarehouseModel")
131:             .getObject();
132:           this.getModel("SessionModel").getData().WarehouseCode =
133:             warehouse.WarehouseCode;
134:           this.getModel("SessionModel").getData().EnableBinLocations =
135:             warehouse.BinLocations;
136:           this.getModel("SessionModel").getData().DefaultBin =
137:             warehouse.DefaultBin;
138:           this.getModel("SessionModel").getData().DefaultBinEnforced =
139:             warehouse.DefaultBinEnforced;
140:           this.getModel("SessionModel").refresh();
141:           this.getRouter().navTo("BusinessPartners");
142:         },
143:       }
144:     );
145:   }
146: );
