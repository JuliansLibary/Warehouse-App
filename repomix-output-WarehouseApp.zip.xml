 2:  * MODEL SYNCHRONIZATION ROUTES
 3:  * ============================
 4:  * API routes for model state management and synchronization
 5:  */
 6: const express = require('express');
 7: const router = express.Router();
 8: const modelSynchronizationController = require('../controller/modelSynchronizationController');
 9: // Synchronize pack list model with current data
10: router.post('/synchronize-pack-list', modelSynchronizationController.synchronizePackListModel);
11: // Update model state after packing operations
12: router.post('/update-after-packing', modelSynchronizationController.updateModelAfterPacking);
13: // Calculate model totals and statistics
14: router.post('/calculate-totals', modelSynchronizationController.calculateModelTotals);
15: // Merge model data from multiple sources
16: router.post('/merge-data', modelSynchronizationController.mergeModelData);
17: // Validate model consistency and data integrity
18: router.post('/validate-consistency', modelSynchronizationController.validateModelConsistency);
19: // Update dialog quantities after operations
20: router.post('/update-dialog-quantities-after-operation', modelSynchronizationController.updateDialogQuantitiesAfterOperation);
21: // Synchronize models after serial operations
22: router.post('/synchronize-models-after-serial-operation', modelSynchronizationController.synchronizeModelsAfterSerialOperation);
23: // Comprehensive model synchronization for all models and dialogs
24: router.post('/synchronize-all-models', (req, res, next) => {
25:     console.info('=== ROUTE HIT: /modelSync/synchronize-all-models ===');
26:     console.info('Route received POST request at:', new Date().toISOString());
27:     console.info('Request body size:', req.body ? JSON.stringify(req.body).length : 0, 'characters');
28:     console.info('Request body keys:', req.body ? Object.keys(req.body) : 'no body');
29:     console.info('Request headers keys:', Object.keys(req.headers));
30:     console.info('Request content-type:', req.headers['content-type']);
31:     console.info('Request method:', req.method);
32:     console.info('Request URL:', req.url);
33:     console.info('Request originalUrl:', req.originalUrl);
34:     console.info('Forwarding to modelSynchronizationController.synchronizeAllModelsAndDialogsEndpoint...');
35:     next();
36: }, modelSynchronizationController.synchronizeAllModelsAndDialogsEndpoint);
37: module.exports = router;
</file>

