  7: /*
  8:  * prepares Transfer for Post
  9:  * @param {json} Transfer Model with DocumentLines
 10:  */
 11: function prepareDetailForFrontend(orders, WarehouseCode, BaseType) {
 12:   return new Promise((resolve, reject) => {
 13:     try {
 14:       const newOrder = {
 15:         DocEntry: orders.DocEntry,
 16:         DocNum: orders.DocNum,
 17:         BaseType: BaseType,
 18:         CardCode: orders.CardCode,
 19:         CardName: orders.CardName,
