<file path="WarehouseApp/nAG.Warehouse.App.AdminPanel/webapp/controller/syncService.controller.js">
 1: sap.ui.define(
 2:   ["nAG/WarehouseApp/AdminPanel/BaseController", "sap/ui/core/EventBus", "sap/m/MessageToast", "sap/m/MessageBox"],
 3:   function (BaseController, EventBus, MessageToast, MessageBox) {
 4:     "use strict";
 5:     return BaseController.extend("nAG.WarehouseApp.AdminPanel.controller.syncService", {
 6:       onInit: function () {
 7:         this.oEventBus = sap.ui.getCore().getEventBus();
 8:         this._setupRoute();
 9:       },
10:       _setupRoute: function () {
11:         this.getRouter().getRoute("syncService").attachPatternMatched(this._onSyncMatched, this);
12:       },
13:       _onSyncMatched: function (oEvent) {
14:         const tenant = oEvent.getParameter("arguments").Tenant;
15:         const that = this;
16:         this.getView().byId("title").setText(
17:           `${sap.ui.getCore().getModel("i18n").getResourceBundle().getText("commonTitle")} ${tenant}`
18:         );
19:         this.setModel(new sap.ui.model.json.JSONModel(), "SessionModel");
20:         this.setViewModel(this.getModel("SessionModel"), "SessionModel");
21:         this.getModel("SessionModel").setData({ Tenant: tenant });
22:         this.getModel("SessionModel").refresh();
23:         this.makeAjaxRequest(
24:           "GET",
25:           `worker/getWorkerData/${that.getModel("SessionModel").getData().Tenant}`,
26:           null,
27:           "workerPostError",
28:           function (response) {
29:             if (response === false) {
30:               MessageBox.error(sap.ui.getCore().getModel("i18n").getResourceBundle().getText("errorReadingSyncConfig"))
31:             }else{
32:               try {
33:                 const responseConfig = JSON.parse(response.body);
34:                 const configDetail = JSON.parse(responseConfig.config)
35:                 that.getView().byId("inpPurchaseOrders").setValue(configDetail.PurchaseDeliveryNote.interval / 60, null)
36:                 that.getView().byId("inpSyncItems").setValue(configDetail.Items.interval / 3600, null)
37:                 that.getView().byId("inpPickLists").setValue(configDetail.PickLists.interval / 60, null)
38:                 that.getView().byId("inpPackLists").setValue(configDetail.PackLists.interval / 60, null)
39:                 that.getView().byId("inputSyncWarehouses").setValue(configDetail.Warehouses.interval / 3600, null)
40:                 MessageToast.show(sap.ui.getCore().getModel("i18n").getResourceBundle().getText("successReadingSyncConfig"))
41:               } catch (error) {
42:                 console.error(error);
43:                 MessageBox.error(sap.ui.getCore().getModel("i18n").getResourceBundle().getText("errorReadingSyncConfig"))
44:               }
45:             }
46:           });
47:       },
48:       saveSyncConfig: function () {
49:         const that = this,
50:           syncValue = {
51:             PurchaseDeliveryNote: {
52:               interval: this.getView().byId("inpPurchaseOrders").getValue() * 60,
53:               sync: true,
54:             },
55:             Items: {
56:               interval: this.getView().byId("inpSyncItems").getValue() * 3600,
57:               sync: true,
58:             },
59:             PickLists: {
60:               interval: this.getView().byId("inpPickLists").getValue() * 60,
61:               sync: true,
62:             },
63:             PackLists: {
64:               interval: this.getView().byId("inpPackLists").getValue() * 60,
65:               sync: true,
66:             },
67:             Warehouses: {
68:               interval: this.getView().byId("inputSyncWarehouses").getValue() * 3600,
69:               sync: true,
70:             },
71:           };
72:         this.oEventBus.publish("nAG", "showBusyDialog");
73:         that.makeAjaxRequest(
74:           "PATCH",
75:           `worker/postWorkerData/${that.getModel("SessionModel").getData().Tenant}`,
76:           { workerConfiguration: syncValue },
77:           "workerPostError",
78:           function (response) {
79:             that.oEventBus.publish("nAG", "hideBusyDialog");
80:             if (response) {
81:               MessageBox.success(sap.ui.getCore().getModel("i18n").getResourceBundle().getText("saveWorker"), {
82:                 onClose: function () {
83:                   that.onCloseSyncService();
84:                   that.oEventBus.publish("nAG", "hideBusyDialog");
85:                 },
86:               });
87:             } else {
88:               MessageBox.error(sap.ui.getCore().getModel("i18n").getResourceBundle().getText("saveWorkerError"));
89:             }
90:           }
91:         );
92:       },
93:       onCloseSyncService: function () {
94:         this.getRouter().navTo("Modules");
95:       }
96:     });
97:   }
98: );
