 303:     // get Data of picklist
 304:     getPickListData: function (orderId, absEntry, multiPickList) {
 305:       const sessionData = this.getModel("SessionModel").getData();
 306:       const tenantId = sessionData.tenantId;
 307:       const i18n = sap.ui.getCore().getModel("i18n").getResourceBundle();
 308:       // Ensure required models are initialized
 309:       if (!this.getModel("PickListDetailModel")) {
 310:         const pickListDetailModel = new sap.ui.model.json.JSONModel();
 311:         this.setModel(pickListDetailModel, "PickListDetailModel");
 312:         this.setViewModel(pickListDetailModel, "PickListDetailModel");
 313:       }
 314:       if (!this.getModel("TimeModel")) {
 315:         const timeModel = new sap.ui.model.json.JSONModel();
 316:         this.setModel(timeModel, "TimeModel");
 317:         this.setViewModel(timeModel, "TimeModel");
 318:       }
 319:       try {
 320:         this.makeAjaxRequest(
 321:           "GET",
 322:           `documentLock/checkdocumentLock/${absEntry}/Pick/${tenantId}`,
 323:           null,
 324:           (documentLock) => {
 325:             this.makeAjaxRequest("GET", "user/getUser", null, (currentUser) => {
 326:               if (documentLock && documentLock !== false) {
 327:                 this.makeAjaxRequest("GET", "user/Users", null, (allUsers) => {
 328:                   const updateUser = allUsers.find((user) => user.id === documentLock.createUserLock);
 329:                   this.makeAjaxRequest(
 330:                     "GET",
 331:                     `user/compareCurrentUser/${documentLock.createUserLock}`,
 332:                     null,
 333:                     (isCurrentUser) => {
 334:                       if (isCurrentUser) {
 335:                         this.callCache(absEntry, tenantId, orderId, multiPickList);
 336:                       } else {
 337:                         const lockExpiration = new Date(
 338:                           Date.parse(documentLock.latestChangeDate)
 339:                         ).getTime() + 30 * 60000;
 340:                         const now = Date.now();
 341:                         if (lockExpiration >= now) {
 342:                           sap.m.MessageBox.warning(
 343:                             i18n
 344:                               .getText("fileLockTimerNotExpired")
 345:                               .replace("@user", updateUser.SLUsername.replace("\\", "")),
 346:                             {
 347:                               actions: [sap.m.MessageBox.Action.OK],
 348:                               onClose: () => this.onCloseDetailPress(),
 349:                             }
 350:                           );
 351:                         } else {
 352:                           sap.m.MessageBox.warning(
 353:                             i18n
 354:                               .getText("documentLockMsgBox")
 355:                               .replace("@user", updateUser.SLUsername.replace("\\", ""))
 356:                               .replace(
 357:                                 "@date",
 358:                                 new Date(
 359:                                   Date.parse(documentLock.latestChangeDate)
 360:                                 ).toLocaleDateString("de-DE", {
 361:                                   year: "numeric",
 362:                                   month: "2-digit",
 363:                                   day: "2-digit",
 364:                                 })
 365:                               )
 366:                               .replace(
 367:                                 "@time",
 368:                                 new Date(
 369:                                   Date.parse(documentLock.latestChangeDate)
 370:                                 ).toLocaleTimeString("de-DE", {
 371:                                   hour: "2-digit",
 372:                                   minute: "2-digit",
 373:                                   second: "2-digit",
 374:                                 })
 375:                               ),
 376:                             {
 377:                               actions: [sap.m.MessageBox.Action.YES, sap.m.MessageBox.Action.NO],
 378:                               onClose: (sAction) => {
 379:                                 if (sAction === sap.m.MessageBox.Action.YES) {
 380:                                   this.makeAjaxRequest(
 381:                                     "DELETE",
 382:                                     `documentLock/deleteDocumentLock/${documentLock.id}`,
 383:                                     null,
 384:                                     () => {
 385:                                       this.makeAjaxRequest(
 386:                                         "POST",
 387:                                         "documentLock/saveDocumentLock",
 388:                                         JSON.stringify({
 389:                                           documentNumber: absEntry,
 390:                                           module: "Pick",
 391:                                           tenantId,
 392:                                           latestChangeDate: new Date().toISOString(),
 393:                                           createUserLock: currentUser.id,
 394:                                         }),
 395:                                         () => {
 396:                                           this.oEventBus.publish("nAG", "hideBusyDialog");
 397:                                           this.callCache(absEntry, tenantId, orderId, multiPickList);
 398:                                         }
 399:                                       );
 400:                                     }
 401:                                   );
 402:                                 } else if (sAction === sap.m.MessageBox.Action.NO) {
 403:                                   this.onCloseDetailPress();
 404:                                 }
 405:                               },
 406:                             }
 407:                           );
 408:                         }
 409:                       }
 410:                     }
 411:                   );
 412:                 });
 413:               } else {
 414:                 // Save new document lock if none exists
 415:                 this.makeAjaxRequest(
 416:                   "POST",
 417:                   "documentLock/saveDocumentLock",
 418:                   JSON.stringify({
 419:                     documentNumber: absEntry,
 420:                     module: "Pick",
 421:                     tenantId,
 422:                     latestChangeDate: new Date().toISOString(),
 423:                     createUserLock: currentUser.id,
 424:                   }),
 425:                   () => this.callCache(absEntry, tenantId, orderId, multiPickList)
 426:                 );
 427:               }
 428:             });
 429:           }
 430:         );
 431:       } catch (error) {
 432:         sap.m.MessageBox.error(error.message || "An error occurred");
 433:       }
 434:     },
 435:     callCache: function (absEntry, tenantId, orderId, multiPickList) {
 436:       const slPickListsURL = `pickListDetail/PickList/${orderId}/${absEntry}/${multiPickList}/${tenantId}`;
 437:       const appViewModel = this.getViewModel("appView");
 438:       const i18n = sap.ui.getCore().getModel("i18n").getResourceBundle();
 439:       this.makeAjaxRequest("GET", `cache/checkCache/${absEntry}/Pick/${tenantId}`, null, (response) => {
 440:         if (!response || response === "null") {
 441:           // Fetch data if cache is empty
 442:           $.ajax({
 443:             url: slPickListsURL,
 444:             async: false,
 445:             crossDomain: true,
 446:             tryCount: 0,
 447:             retryLimit: 3,
 448:             type: "GET",
 449:             success: (data) => {
 450:               this.bindPickListData(data);
 451:               this.hidePickListButton();
 452:               this.oEventBus.publish("nAG", "hideBusyDialog");
 453:             },
 454:             error: function (jqXHR, textStatus) {
 455:               if (textStatus === "timeout") {
 456:                 this.tryCount++;
 457:                 if (this.tryCount <= this.retryLimit) {
 458:                   $.ajax(this); // Retry request
 459:                   return;
 460:                 } else {
 461:                   this.showError("NetworkError", "9000");
 462:                 }
 463:               } else {
 464:                 const errorMessage = jqXHR.responseText || "Unknown error";
 465:                 const errorCode = jqXHR.status || 400;
 466:                 this.showError(i18n, errorMessage, errorCode);
 467:               }
 468:             }.bind(this),
 469:           });
 470:         } else {
 471:           try {
 472:             const cacheResponseContent = JSON.parse(response.content);
 473:             const pickListDetailModel = cacheResponseContent.PickListDetailModel;
 474:             this.bindPickListData(pickListDetailModel);
 475:             this._checkButtonState();
 476:           } catch (error) {
 477:             console.error("Cache parsing error:", error);
 478:             MessageToast.show(i18n.getText("Get_Cache_Error"));
 479:           }
 480:         }
 481:         // Add listener for auto-save if the view model indicates deletion
 482:         if (appViewModel.getProperty("/isDeleted")) {
 483:           sap.ui.getCore().syncIntervall.addListener(() => {
 484:             this.saveDataToDatabase().catch(() =>
 485:               MessageToast.show(i18n.getText("Save_Cache_Error"))
 486:             );
 487:           });
 488:         }
 489:       });
 490:     },
