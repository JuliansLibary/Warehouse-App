  1: sap.ui.define(
  2:   [
  3:     "nAG/WarehouseApp/AdminPanel/BaseController",
  4:     "sap/ui/core/EventBus",
  5:     "sap/m/MessageBox",
  6:     "sap/ui/core/Fragment",
  7:     'sap/m/Token',
  8:     "sap/m/MessageToast"
  9:   ],
 10:   function (BaseController,
 11:     EventBus,
 12:     MessageBox,
 13:     Fragment,
 14:     Token,
 15:     MessageToast) {
 16:     "use strict";
 17:     return BaseController.extend(
 18:       "nAG.WarehouseApp.AdminPanel.controller.VerifyConfig",
 19:       {
 20:         _setupRoute: function () {
 21:           this.getRouter().getRoute("VerifyConfig").attachPatternMatched(this._onMasterMatched, this);
 22:         },
 23:         _onMasterMatched: function (oEvent) {
 24:           const that = this,
 25:             tenant = oEvent.getParameter("arguments").Tenant;
 26:           // Set Tenant value in the input field
 27:           this.getView().byId("inpServiceLayerDatabase").setValue(tenant);
 28:           // Initialize models if not already set
 29:           if (!this.getModel("sqlQueries")) {
 30:             this.setModel(new sap.ui.model.json.JSONModel(), "sqlQueries");
 31:             this.setViewModel(this.getModel("sqlQueries"), "sqlQueries");
 32:           }
 33:           if (!this.getModel("udfNames")) {
 34:             this.setModel(new sap.ui.model.json.JSONModel(), "udfNames");
 35:             this.setViewModel(this.getModel("udfNames"), "udfNames");
 36:           }
 37:           // Make AJAX request to get instance data
 38:           this.makeAjaxRequest(
 39:             "GET",
 40:             "instance/getInstance",
 41:             { database: tenant },
 42:             "loginError",
 43:             function (responseInstance) {
 44:               const instanceData = JSON.parse(responseInstance)[0];
 45:               // Set instance values in the input fields
 46:               that.getView().byId("inpServiceLayerURL").setValue(instanceData.SLURL);
 47:               that.getView().byId("inpServiceLayerPort").setValue(instanceData.SLPort);
 48:               // Make AJAX request to get UDF and SQL query config
 49:               that.makeAjaxRequest(
 50:                 "GET",
 51:                 "internalConfig/getInitConfig",
 52:                 null,
 53:                 "loginError",
 54:                 function (response) {
 55:                   that.getModel("udfNames").setData(response.udfs);
 56:                   that.getModel("sqlQueries").setData(response.sqlQueries);
 57:                 }
 58:               );
 59:             }
 60:           );
 61:         },
 62:         onInit: function () {
 63:           this._setupRoute();
 64:           this.oEventBus = sap.ui.getCore().getEventBus();
 65:         },
 66:         onStartInstallation: async function (oEvent) {
 67:           const that = this,
 68:             database = this.getView().byId("inpServiceLayerDatabase").getValue(),
 69:             availableModulesAsTokens = this.getView().byId("selectedModulesInput").getTokens(),
 70:             availableModules = availableModulesAsTokens.map(token => token.getProperty("text"));
 71:           if (availableModules.length !== 0) {
 72:             this.getView().byId("validator").setEnabled(false);
 73:             this.getView().byId("UDFswitch").setEnabled(false);
 74:             this.getView().byId("selectedModulesButton").setEnabled(false);
 75:             this.getView().byId("inpServiceLayerUsername").setValueState("None");
 76:             this.getView().byId("inpServiceLayerPassword").setValueState("None");
 77:             if (database && database.trim() !== "") {
 78:               this.oEventBus.publish("nAG", "showBusyDialog");
 79:               if (await this.onValidSLCred(null)) {
 80:                 this.oEventBus.publish("nAG", "hideBusyDialog");
 81:                 let sqlQueryList = {},
 82:                   udfList = {},
 83:                   error = false;
 84:                 const SQLQueries = this.getModel("sqlQueries").getData();
 85:                 for (const query of SQLQueries) {
 86:                   if (availableModules.includes(query.module)) {
 87:                     let binding = this.getModel("sqlQueries").getData();
 88:                     binding = binding.map(value => {
 89:                       if (value.name === query.name) {
 90:                         value.busy = true;
 91:                       }
 92:                       return value;
 93:                     });
 94:                     this.getModel("sqlQueries").setData(binding);
 95:                     sqlQueryList = await this.onCheckSQLQueries(query.name);
 96:                     binding = binding.map(value => {
 97:                       if (value.name === sqlQueryList[0].name) {
 98:                         value.message = sqlQueryList[0].message;
 99:                         value.state = sqlQueryList[0].state;
100:                         value.busy = false;
101:                       }
102:                       return value;
103:                     });
104:                     this.getModel("sqlQueries").setData(binding);
105:                   }
106:                 }
107:                 // Enable UDFs if the switch is off
108:                 if (!this.getView().byId("UDFswitch").getProperty("state")) {
109:                   const UDFs = this.getModel("udfNames").getData();
110:                   for (const udf of UDFs) {
111:                     if (availableModules.includes(udf.module)) {
112:                       let bindingUDF = this.getModel("udfNames").getData();
113:                       bindingUDF = bindingUDF.map(value => {
114:                         if (value.name === udf.name) {
115:                           value.busy = true;
116:                         }
117:                         return value;
118:                       });
119:                       this.getModel("udfNames").setData(bindingUDF);
120:                       udfList = await this.onCheckUDFS(udf.name);
121:                       bindingUDF = bindingUDF.map(value => {
122:                         if (value.name === udfList[0].name) {
123:                           value.message = udfList[0].message;
124:                           value.state = udfList[0].state;
125:                           value.busy = false;
126:                         }
127:                         return value;
128:                       });
129:                       this.getModel("udfNames").setData(bindingUDF);
130:                     }
131:                   }
132:                 }
133:                 const isValid = !this.getModel("sqlQueries").getData().some(element => element.state === "Error") &&
134:                   !this.getModel("udfNames").getData().some(element => element.state === "Error");
135:                 this.getView().byId("redirect").setEnabled(isValid);
136:                 if (isValid) {
137:                   this.makeAjaxRequest(
138:                     "POST",
139:                     `company/patchTenantValidation/${database}`,
140:                     null,
141:                     "loginError",
142:                     function () {
143:                       that.makeAjaxRequest(
144:                         "POST",
145:                         "module/updateModuleValidation",
146:                         {
147:                           modules: availableModules,
148:                           tenant: database
149:                         },
150:                         "loginError",
151:                         function () { }
152:                       );
153:                     }
154:                   );
155:                 }
156:               } else {
157:                 this.oEventBus.publish("nAG", "hideBusyDialog");
158:                 this.getView().byId("inpServiceLayerUsername").setValueState("Error");
159:                 this.getView().byId("inpServiceLayerPassword").setValueState("Error");
160:                 MessageBox.error(sap.ui.getCore().getModel("i18n").getResourceBundle().getText("FailedLogin"));
161:               }
162:               this.getView().byId("validator").setEnabled(true);
163:               this.getView().byId("UDFswitch").setEnabled(true);
164:               this.getView().byId("selectedModulesButton").setEnabled(true);
165:             }
166:           } else {
167:             MessageToast.show(sap.ui.getCore().getModel("i18n").getResourceBundle().getText("selectModules"));
168:           }
169:         },
170:         continue: function (oEvent) {
171:           this.getRouter().navTo("Modules");
172:         },
173:         onValidSLCred: async function (response) {
174:           return new Promise((resolve, reject) => {
175:             const that = this,
176:               dataModel = this.createServiceLayerCredentials();
177:             this.makeAjaxRequest(
178:               "GET",
179:               "availability/checkServiceLayerCredentials",
180:               dataModel,
181:               "loginError",
182:               function (responseInstance) {
183:                 if (responseInstance !== null) {
184:                   resolve(responseInstance);
185:                 } else {
186:                   reject(responseInstance);
187:                 }
188:               }
189:             );
190:           });
191:         },
192:         // Check SQL Queries for a  or Prod Database
193:         onCheckSQLQueries: async function (response) {
194:           return new Promise((resolve, reject) => {
195:             const dataModel = this.createServiceLayerCredentials(response);
196:             if (dataModel) {
197:               this.makeAjaxRequest(
198:                 "GET",
199:                 `sql/checkSQLQueries/${response}`,
200:                 dataModel,
201:                 "loginError",
202:                 function (response_Query) {
203:                   if (response_Query !== null) {
204:                     resolve(response_Query);
205:                   } else {
206:                     reject(response_Query);
207:                   }
208:                 }
209:               );
210:             }
211:           });
212:         },
213:         createServiceLayerCredentials: function () {
214:           return {
215:             B1ServiceLayerUsername: this.getView().byId("inpServiceLayerUsername").getValue(),
216:             B1ServiceLayerPassword: this.getView().byId("inpServiceLayerPassword").getValue(),
217:             database: this.getView().byId("inpServiceLayerDatabase").getValue(),
218:           };
219:         },
220:         onCheckUDFS: async function (response_Module) {
221:           return new Promise((resolve, reject) => {
222:             const dataModel = this.createServiceLayerCredentials(response_Module);
223:             if (dataModel) {
224:               this.makeAjaxRequest(
225:                 "GET",
226:                 `udf/checkUDFS/${response_Module}`,
227:                 dataModel,
228:                 "loginError",
229:                 function (response) {
230:                   if (response !== null) {
231:                     resolve(response);
232:                   } else {
233:                     reject(response);
234:                   }
235:                 }
236:               );
237:             }
