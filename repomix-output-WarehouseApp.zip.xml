39:   SL.GET(
40:     "SQLQueries('GetCountedOrders')/List",
41:     null,
42:     await generateBasicAuth(req.headers, req.params.tenant),
43:     {
44:       retryTimes: 5,
45:       retryDelay: 750,
46:       SLURL: instance.SLURL,
47:       SLPort: instance.SLPort,
48:     },
49:     async function (error, resp) {
50:       if (error) {
51:         res.status(error.httpStatusCode || 500).send(await getError(error));
52:       } else {
53:         const content = [];
