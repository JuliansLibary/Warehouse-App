<file path="WarehouseApp/nAG.Warehouse.App.Pack/controller/i18nController.js">
  1: /**
  2:  * I18N CONTROLLER
  3:  * ===============
  4:  * Backend controller for internationalization handling
  5:  * Provides centralized translation services for all backend business logic
  6:  */
  7: const fs = require('fs');
  8: const path = require('path');
  9: // Cache for loaded translations
 10: const translationCache = new Map();
 11: /**
 12:  * Load translation file for a specific language
 13:  * @param {string} language - Language code (e.g., 'de_DE', 'en')
 14:  * @returns {Object} Translation object
 15:  */
 16: function loadTranslations(language = 'de_DE') {
 17:     // Check cache first
 18:     if (translationCache.has(language)) {
 19:         return translationCache.get(language);
 20:     }
 21:     const translations = {};
 22:     try {
 23:         // Try to load from webapp i18n folder
 24:         const i18nPath = path.join(__dirname, '..', 'webapp', 'i18n');
 25:         const fileName = language === 'de_DE' ? 'i18n_de_DE.properties' : 'i18n.properties';
 26:         const filePath = path.join(i18nPath, fileName);
 27:         if (fs.existsSync(filePath)) {
 28:             const content = fs.readFileSync(filePath, 'utf8');
 29:             // Parse .properties file
 30:             content.split('\n').forEach(line => {
 31:                 line = line.trim();
 32:                 if (line && !line.startsWith('#') && line.includes('=')) {
 33:                     const [key, ...valueParts] = line.split('=');
 34:                     const value = valueParts.join('=').trim();
 35:                     translations[key.trim()] = value;
 36:                 }
 37:             });
 38:         }
 39:         // Add backend-specific translations
 40:         addBackendTranslations(translations, language);
 41:         // Cache the translations
 42:         translationCache.set(language, translations);
 43:     } catch (error) {
 44:         console.error(`Error loading translations for ${language}:`, error);
 45:         // Return fallback translations
 46:         addBackendTranslations(translations, language);
 47:     }
 48:     return translations;
 49: }
 50: /**
 51:  * Add backend-specific translations
 52:  * @param {Object} translations - Translation object to extend
 53:  * @param {string} language - Language code
 54:  */
 55: function addBackendTranslations(translations, language) {
 56:     const backendTranslations = {
 57:         'de_DE': {
