304:       return res.send({
305:         deliveryData,
306:         cleaned: false,
307:         message: "No cleanup needed - package not found"
308:       });
309:     }
310:     const pkg = deliveryData.Package[packageNumber];
311:     if (!pkg.DeliveryLines || !Array.isArray(pkg.DeliveryLines)) {
312:       return res.send({
313:         deliveryData,
314:         cleaned: false,
315:         message: "No delivery lines to clean"
316:       });
317:     }
318:     const originalCount = pkg.DeliveryLines.length;
319:     pkg.DeliveryLines = pkg.DeliveryLines.filter(line => {
320:       const hasCompleteItemInfo = line.ItemCode && line.ItemDescription;
321:       const hasQuantityOrSerials = (line.PackedQuantity > 0) || 
322:                                   (line.SerialNumbers && line.SerialNumbers.length > 0);
323:       return hasCompleteItemInfo && hasQuantityOrSerials;
324:     });
325:     const newCount = pkg.DeliveryLines.length;
326:     const removed = originalCount - newCount;
327:     res.send({
328:       deliveryData,
329:       cleaned: removed > 0,
330:       removedCount: removed,
331:       message: removed > 0 ? `Removed ${removed} empty delivery lines` : "No empty lines found"
332:     });
333:   } catch (error) {
