 1: //worker.js
 2: var content,
 3:     xmlHttp = new XMLHttpRequest(),
 4:     tenantId,
 5:     AbsoluteEntry,
 6:     userId;
 7: onmessage = function (event) {
 8:   content = event.data;
 9:   this.tenantId = event.data.tenantId;
10:   this.userId = event.data.userId;
11:   this.AbsoluteEntry = event.data.OrderModelData;
12:     checkSaveState()
13:     .then((responseCheck) => {
14:       return patchContent(responseCheck);
15:     })
16:     .catch((err) => {
17:       return postContent();
18:     });
19: };
20: async function checkSaveState() {
21:   const response = await _checkSaveState();
22:   return response;
23: }
24: async function _checkSaveState() {
25:   return new Promise(function (resolve, reject) {
26:     xmlHttp.open("GET", "cachelogic/checkCache/" + AbsoluteEntry + "/PurchaseDeliveryNote/" + tenantId);
27:     xmlHttp.withCredentials = true;
28:     xmlHttp.onreadystatechange = function () {
29:       if (xmlHttp.readyState == 4 && xmlHttp.status == 209) {
30:         reject("No Data found for patch");
31:       } else if (xmlHttp.readyState == 4 && xmlHttp.status == 200 && xmlHttp.response) {
32:         resolve(xmlHttp.response);
33:       } else if (xmlHttp.readyState == 4 && xmlHttp.status == 204) {
34:         resolve(xmlHttp.status);
35:       }
36:     };
37:     xmlHttp.onerror = function () {
38:       reject(Error("Network Error"));
39:     };
40:     xmlHttp.send();
41:   });
42: }
43: async function postContent() {
44:   // Do the usual XHR stuff
45:   xmlHttp.open("POST", "cachelogic/saveCache", false);
46:   xmlHttp.setRequestHeader("Content-type", "application/json");
47:   xmlHttp.onreadystatechange = function () {
48:     if (xmlHttp.readyState == 4 && xmlHttp.status == 200) {
49:       postMessage("true");
50:     }
51:   };
52:   // Handle network errors
53:   xmlHttp.onerror = function () {
54:     throw new Error("Network Error");
55:   };
56:   // Make the request
57:   xmlHttp.send(
58:     JSON.stringify({
59:       documentNumber: AbsoluteEntry,
60:       module: "PurchaseDeliveryNote",
61:       documentType: "Kundenauftrag",
62:       content: JSON.stringify(content),
63:       tenantId: tenantId,
64:       createDate: new Date(Date.now()).toISOString(),
65:       updateDate: new Date(Date.now()).toISOString(),
66:       updatedByUser: userId,
67:       createdByUser: userId,
68:       // For now set the Remark to empty string
69:       remark: "",
70:       isDeleted: false,
71:     })
72:   );
73: }
74: async function patchContent(responseCheck) {
75:   xmlHttp.open("POST", "cachelogic/patchCache/" + JSON.parse(responseCheck).id, false);
76:   xmlHttp.setRequestHeader("Content-type", "application/json");
77:   xmlHttp.onreadystatechange = function () {
78:     if (xmlHttp.readyState == 4 && xmlHttp.status == 200) {
79:       postMessage("true");
80:     } else if (xmlHttp.readyState == 4 && xmlHttp.status == 209) {
81:       postMessage("true");
82:     } else if (xmlHttp.readyState == 4 && xmlHttp.status !== 209 && xmlHttp.status !== 200) {
83:       postMessage("false");
84:     }
85:   };
86:   xmlHttp.send(
87:     JSON.stringify(
88:       {
89:         content: JSON.stringify(content),
90:         updateDate: new Date(Date.now()).toISOString(),
91:         updatedByUser: userId,
92:         // For now set the Remark to empty string
93:         remark: "",
94:       }));
95: }
