 3:  */
 4: const errorHandler = (err, req, res) => {
 5:   // Handle JSON parsing errors
 6:   if (err instanceof SyntaxError && err.status === 400 && 'body' in err) {
 7:     console.error('JSON Parse Error:', {
 8:       message: err.message,
 9:       type: err.type,
10:       body: err.body,
11:       url: req.url,
12:       method: req.method,
13:       contentType: req.get('Content-Type'),
14:       contentLength: req.get('Content-Length')
15:     });
16:     return res.status(400).json({
17:       error: 'Invalid JSON format',
18:       message: 'The request body contains invalid JSON',
19:       details: {
20:         parseError: err.message,
21:         contentType: req.get('Content-Type'),
22:         contentLength: req.get('Content-Length'),
23:         expectedFormat: 'application/json'
24:       }
25:     });
26:   }
27:   // Handle other errors
28:   console.error('Unhandled Error:', err);
29:   return res.status(500).json({
30:     error: 'Internal Server Error',
31:     message: process.env.NODE_ENV === 'development' ? err.message : 'Something went wrong'
32:   });
33: };
34: module.exports = errorHandler;
