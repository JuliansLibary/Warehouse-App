 21: async function fetchDockerLogs(dockerName) {
 22:   try {
 23:     // Berechnung des Unix-Timestamps für die letzten 10 Tage
 24:     const now = Math.floor(Date.now() / 1000); // Aktuelle Zeit in Sekunden
 25:     const tenDaysAgo = now - 10 * 24 * 60 * 60; // Zeit vor 10 Tagen in Sekunden
 26:     // Docker API URLs - Container -> Host Kommunikation (Reihenfolge wichtig!)
 27:     const DOCKER_URLS = [
 28:       "http://172.17.0.1:2375",              // Docker Bridge Gateway (Linux Standard)
 29:       "http://host.docker.internal:2375",    // Docker Desktop / Windows
 30:       "http://gateway.docker.internal:2375", // Alternative für Docker Desktop
 31:     ];
 32:     // Versuche alle URLs der Reihe nach
 33:     for (let i = 0; i < DOCKER_URLS.length; i++) {
 34:       const dockerUrl = process.env.DOCKER_HOST || DOCKER_URLS[i];
 35:       try {
 36:         console.log(`Versuch ${i + 1}: Verbinde zu Docker API unter: ${dockerUrl}`);
 37:         const response = await axios.get(
 38:           `${dockerUrl}/containers/${dockerName}/logs`,
 39:           {
 40:             params: {
 41:               stdout: true,
 42:               stderr: true,
 43:               since: tenDaysAgo,
 44:             },
 45:             timeout: 5000, // 5 Sekunden Timeout pro Versuch
 46:           }
 47:         );
 48:         // HTTP-Fehlerbehandlung
 49:         if (response.status < 200 || response.status >= 300) {
 50:           throw new Error(`HTTP Error: ${response.status} ${response.statusText}`);
 51:         }
 52:         console.log(`✅ Erfolgreich verbunden mit Docker API unter: ${dockerUrl}`);
 53:         return response.data; // Erfolg - gebe Daten zurück
 54:       } catch (urlError) {
 55:         console.log(`❌ Fehler bei ${dockerUrl}: ${urlError.message}`);
 56:         // Falls es der letzte Versuch war, werfe den Fehler
 57:         if (i === DOCKER_URLS.length - 1 && !process.env.DOCKER_HOST) {
 58:           throw urlError;
 59:         }
 60:         // Sonst versuche nächste URL (außer bei expliziter DOCKER_HOST Env-Variable)
 61:         if (process.env.DOCKER_HOST) {
 62:           throw urlError; // Bei expliziter Env-Variable nicht weiterversuchen
 63:         }
 64:         continue;
 65:       }
 66:     }
 67:   } catch (error) {
 68:     // Erweiterte Fehlerbehandlung
 69:     if (error.code === 'ECONNREFUSED') {
 70:       console.error(`Docker API connection refused. Mögliche Ursachen:`);
 71:       console.error(`- Docker Daemon läuft nicht auf dem Host`);
 72:       console.error(`- Docker Daemon hört nicht auf Port 2375`);
 73:       console.error(`- Container kann Host nicht erreichen (Netzwerk-Problem)`);
 74:     } else if (error.code === 'ETIMEDOUT') {
 75:       console.error(`Docker API request timed out. Network oder Performance Problem.`);
 76:     } else if (error.code === 'ENOTFOUND') {
 77:       console.error(`Docker Host nicht gefunden. Host-Auflösung fehlgeschlagen.`);
 78:     } else if (error.response) {
 79:       console.error(`Docker API HTTP Error: ${error.response.status} ${error.response.statusText}`);
 80:       if (error.response.status === 404) {
 81:         console.error(`Container '${dockerName}' nicht gefunden. Prüfen Sie den Container-Namen.`);
 82:       }
 83:     } else {
 84:       console.error(`Error fetching logs for container ${dockerName}:`, error.message);
 85:     }
 86:     return null;
 87:   }
 88: }
 89: /**
 90:  * Beispiel:
 91:  * Eingabe: '\x1b[31mThis is red text\x1b[0m and normal text'
 92:  * Ausgabe: 'This is red text and normal text'
 93:  *
 94:  * @param {string} logs - Der Log-String, aus dem ANSI-Escape-Sequenzen entfernt werden sollen.
 95:  * @returns {string} - Der bereinigte Log-String ohne ANSI-Escape-Sequenzen.
 96:  */
 97: function removeAnsiEscapeSequences(logs) {
 98:   // Regex zur Erkennung von ANSI-Escape-Sequenzen
 99:   // aus "\x1b[31mFehler:\x1b[0m Ein unerwarteter Fehler ist aufgetreten.\n\x1b[32mInfo:\x1b[0m Alles läuft wie erwartet.";
100:   // wird Fehler: Ein unerwarteter Fehler ist aufgetreten.
101:   //      Info: Alles läuft wie erwartet.
102:   const ansiRegex = new RegExp(
103:     '[\\x00-\\x08\\x0B\\x0C\\x0E-\\x1F\\x7F\\x80-\\x9F]|\\x1b\\[[0-9;]*[mGKH]',
104:     'g'
105:   );
106:   return logs.replace(ansiRegex, '');
107: }
108: module.exports = {
109:   getDockerLogs
110: };
