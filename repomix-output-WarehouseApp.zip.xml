  1: /**
  2:  * SerialModelService - Backend service for serial number model operations
  3:  * Handles complex model manipulations that should not be in the frontend
  4:  */
  5: const { normalizeSerialNumber } = require('./serialNumberController');
  6: /**
  7:  * Extracts all serial numbers from DetailModel for duplicate checking
  8:  * @param {Object} detailModel - The DetailModel data
  9:  * @param {string} excludeItemCode - Item code to exclude from check
 10:  * @returns {Array} Array of normalized serial numbers with context
 11:  */
 12: function extractSerialsFromDetailModel(detailModel, excludeItemCode = null) {
 13:   const serials = [];
 14:   if (detailModel && detailModel.PackListLines) {
 15:     for (const item of detailModel.PackListLines) {
 16:       if (excludeItemCode && item.ItemCode === excludeItemCode) {
 17:         continue; // Skip current item
 18:       }
 19:       if (item.SerialNumbers) {
 20:         for (const serial of item.SerialNumbers) {
 21:           serials.push({
 22:             normalizedSerial: normalizeSerialNumber(serial.SerialNumber),
 23:             originalSerial: serial.SerialNumber,
 24:             itemCode: item.ItemCode,
 25:             package: serial.Package || 0,
 26:             context: 'detailModel'
 27:           });
 28:         }
 29:       }
 30:     }
 31:   }
 32:   return serials;
 33: }
 34: /**
 35:  * Extracts all serial numbers from DeliveryModel for duplicate checking
 36:  * @param {Object} deliveryModel - The DeliveryModel data
 37:  * @param {string} excludeItemCode - Item code to exclude from check
 38:  * @param {number} excludePackage - Package index to exclude from check
 39:  * @returns {Array} Array of normalized serial numbers with context
 40:  */
 41: function extractSerialsFromDeliveryModel(deliveryModel, excludeItemCode = null, excludePackage = null) {
 42:   const serials = [];
 43:   if (deliveryModel && deliveryModel.Package) {
 44:     for (let pkgIndex = 0; pkgIndex < deliveryModel.Package.length; pkgIndex++) {
 45:       if (excludePackage !== null && pkgIndex === excludePackage) {
 46:         continue; // Skip current package for some checks
 47:       }
 48:       const packageData = deliveryModel.Package[pkgIndex];
 49:       if (packageData.DeliveryLines) {
 50:         for (const line of packageData.DeliveryLines) {
 51:           if (excludeItemCode && line.ItemCode === excludeItemCode && pkgIndex === excludePackage) {
 52:             continue; // Skip current item in current package
 53:           }
 54:           if (line.SerialNumbers) {
 55:             for (const serial of line.SerialNumbers) {
 56:               serials.push({
 57:                 normalizedSerial: normalizeSerialNumber(serial.SerialNumber),
 58:                 originalSerial: serial.SerialNumber,
 59:                 itemCode: line.ItemCode,
 60:                 package: pkgIndex,
 61:                 context: 'deliveryModel'
 62:               });
 63:             }
 64:           }
 65:         }
 66:       }
 67:     }
 68:   }
 69:   return serials;
 70: }
 71: /**
 72:  * Comprehensive cross-model duplicate check
 73:  * @param {string} serialNumber - Serial number to check
 74:  * @param {Object} models - Object containing all models
 75:  * @param {Object} context - Current context (itemCode, package, etc.)
 76:  * @returns {Object} Duplicate check result
 77:  */
 78: function comprehensiveDuplicateCheck(serialNumber, models, context) {
 79:   const normalizedSerial = normalizeSerialNumber(serialNumber);
 80:   const { frontendModel, deliveryModel, detailModel } = models;
 81:   const { itemCode, packageIndex } = context;
 82:   // 1. Check current frontend model (current session)
 83:   if (frontendModel && frontendModel.SerialNumbers) {
 84:     for (const serial of frontendModel.SerialNumbers) {
 85:       if (normalizeSerialNumber(serial.SerialNumber) === normalizedSerial) {
 86:         return {
 87:           isDuplicate: true,
 88:           context: "currentSession",
 89:           package: serial.Package,
 90:           itemCode: frontendModel.ItemCode,
 91:           message: `Serial number "${serialNumber}" is already selected in this session.`
 92:         };
 93:       }
 94:     }
 95:   }
 96:   // 2. Check DetailModel (other items)
 97:   const detailSerials = extractSerialsFromDetailModel(detailModel, itemCode);
 98:   for (const serial of detailSerials) {
 99:     if (serial.normalizedSerial === normalizedSerial) {
100:       return {
101:         isDuplicate: true,
102:         context: "otherItem",
103:         package: serial.package,
104:         itemCode: serial.itemCode,
105:         message: `Serial number "${serialNumber}" is already assigned to item ${serial.itemCode}.`
106:       };
107:     }
108:   }
109:   // 3. Check DeliveryModel (all packages)
110:   const deliverySerials = extractSerialsFromDeliveryModel(deliveryModel);
111:   for (const serial of deliverySerials) {
112:     if (serial.normalizedSerial === normalizedSerial) {
113:       if (serial.package === packageIndex && serial.itemCode === itemCode) {
114:         return {
115:           isDuplicate: true,
116:           context: "currentPackage",
117:           package: serial.package,
118:           itemCode: serial.itemCode,
119:           message: `Serial number "${serialNumber}" is already assigned to this package.`
120:         };
121:       } else if (serial.itemCode === itemCode) {
122:         return {
123:           isDuplicate: true,
124:           context: "otherPackage",
125:           package: serial.package,
126:           itemCode: serial.itemCode,
127:           message: `Serial number "${serialNumber}" is already assigned to another package for this item.`
128:         };
129:       } else {
130:         return {
131:           isDuplicate: true,
132:           context: "crossItem",
133:           package: serial.package,
134:           itemCode: serial.itemCode,
135:           message: `Serial number "${serialNumber}" is already assigned to a different item (${serial.itemCode}).`
136:         };
137:       }
138:     }
139:   }
140:   return { isDuplicate: false };
141: }
142: /**
143:  * Validates model integrity after serial number operations
144:  * @param {Object} models - Object containing all models
145:  * @returns {Object} Validation result
146:  */
147: function validateModelIntegrity(models) {
148:   const { frontendModel, deliveryModel, detailModel } = models;
149:   const errors = [];
150:   const warnings = [];
151:   // Check for orphaned serials
152:   if (frontendModel && frontendModel.SerialNumbers) {
153:     const frontendSerials = frontendModel.SerialNumbers.map(s => normalizeSerialNumber(s.SerialNumber));
154:     // Check if all frontend serials are in delivery model
155:     if (deliveryModel && deliveryModel.Package) {
156:       const deliverySerials = [];
157:       deliveryModel.Package.forEach((pkg, pkgIndex) => {
158:         if (pkg.DeliveryLines) {
159:           pkg.DeliveryLines.forEach(line => {
160:             if (line.ItemCode === frontendModel.ItemCode && line.SerialNumbers) {
161:               line.SerialNumbers.forEach(serial => {
162:                 deliverySerials.push(normalizeSerialNumber(serial.SerialNumber));
163:               });
164:             }
165:           });
166:         }
167:       });
168:       // Find missing serials
169:       const missingInDelivery = frontendSerials.filter(serial => !deliverySerials.includes(serial));
170:       if (missingInDelivery.length > 0) {
171:         warnings.push({
172:           type: 'missingInDelivery',
173:           message: `${missingInDelivery.length} serials are in frontend but missing in delivery model`,
174:           serials: missingInDelivery
175:         });
176:       }
177:     }
178:   }
179:   return {
180:     isValid: errors.length === 0,
181:     errors,
182:     warnings,
183:     summary: {
184:       errorCount: errors.length,
185:       warningCount: warnings.length
186:     }
187:   };
188: }
189: /**
190:  * Calculates statistics for serial number operations
191:  * @param {Object} models - Object containing all models
192:  * @param {string} itemCode - Current item code
193:  * @returns {Object} Statistics object
194:  */
195: function calculateSerialStatistics(models, itemCode) {
196:   const { frontendModel, deliveryModel, detailModel } = models;
197:   const stats = {
198:     currentItem: {
199:       totalSerials: 0,
200:       packedQuantity: 0,
201:       remainingQuantity: 0,
202:       packages: {}
203:     },
204:     allItems: {
205:       totalSerials: 0,
206:       totalPackages: 0,
207:       itemCount: 0
208:     },
209:     duplicateRisk: {
210:       potentialDuplicates: 0,
211:       riskLevel: 'low'
212:     }
213:   };
214:   // Calculate current item stats
215:   if (frontendModel) {
216:     stats.currentItem.packedQuantity = frontendModel.PackedQuantity || 0;
217:     stats.currentItem.totalSerials = frontendModel.SerialNumbers ? frontendModel.SerialNumbers.length : 0;
218:     stats.currentItem.remainingQuantity = (frontendModel.PickedQuantity || 0) - (frontendModel.PreviouslyPackedQuantity || 0);
219:   }
220:   // Calculate delivery model stats
221:   if (deliveryModel && deliveryModel.Package) {
222:     stats.allItems.totalPackages = deliveryModel.Package.length;
223:     deliveryModel.Package.forEach((pkg, pkgIndex) => {
224:       if (pkg.DeliveryLines) {
225:         pkg.DeliveryLines.forEach(line => {
226:           if (line.ItemCode === itemCode) {
227:             const serialCount = line.SerialNumbers ? line.SerialNumbers.length : 0;
228:             stats.currentItem.packages[pkgIndex] = serialCount;
229:           }
230:           stats.allItems.totalSerials += line.SerialNumbers ? line.SerialNumbers.length : 0;
231:         });
232:       }
233:     });
234:   }
235:   // Calculate detail model stats
236:   if (detailModel && detailModel.PackListLines) {
237:     stats.allItems.itemCount = detailModel.PackListLines.length;
238:   }
239:   return stats;
240: }
241: module.exports = {
242:   extractSerialsFromDetailModel,
243:   extractSerialsFromDeliveryModel,
244:   comprehensiveDuplicateCheck,
245:   validateModelIntegrity,
246:   calculateSerialStatistics
247: };
