<file path="WarehouseApp/nAG.Warehouse.App.Launchpad/webapp/model/formatter.js">
  1: sap.ui.define(["sap/ui/model/type/Currency", "sap/ui/Device"], function (Currency) {
  2:   "use strict";
  3:   return {
  4:     /**
  5:      * Rounds the currency value to 2 digits
  6:      *
  7:      * @public
  8:      * @param {string} sValue value to be formatted
  9:      * @returns {string} formatted currency value with 2 digits
 10:      */
 11:     currencyValue: function (sValue) {
 12:       if (!sValue) {
 13:         return "";
 14:       }
 15:       return parseFloat(sValue).toFixed(2);
 16:     },
 17:     /**
 18:      * Rounds the currency value to 2 digits
 19:      *
 20:      * @public
 21:      * @param {number} iQuantity product quantity
 22:      * @param {number} fPrice product price
 23:      * @param {string} sCurrencyCode currency code for the price
 24:      * @returns {string} formatted currency value with 2 digits
 25:      */
 26:     calculateItemTotal: function (iQuantity, fPrice, sCurrencyCode) {
 27:       var oCurrency = new Currency({
 28:           showMeasure: false,
 29:         }),
 30:         fTotal = iQuantity * fPrice;
 31:       return oCurrency.formatValue([fTotal.toFixed(2), sCurrencyCode], "string");
 32:     },
 33:     /**
 34:      * Converts a binary string into an image format suitable for the src attribute
 35:      *
 36:      * @public
 37:      * @param {string} vData a binary string representing the image data
 38:      * @returns {string} formatted string with image metadata based on the input or a default image when the input is empty
 39:      */
 40:     handleBinaryContent: function (vData) {
 41:       if (vData) {
 42:         var sMetaData1 = "data:image/jpeg;base64,",
 43:           sMetaData2 = vData.substr(104); // stripping the first 104 bytes from the binary data when using base64 encoding.
 44:         return sMetaData1 + sMetaData2;
 45:       } else {
 46:         return "../images/Employee.png";
 47:       }
 48:     },
 49:     localDate: function (date) {
 50:       var options = {
 51:           day: "2-digit",
 52:           month: "2-digit",
 53:           year: "numeric",
 54:         },
 55:         parts,
 56:         datestring;
 57:       if (date !== null && typeof date === "string" && date.includes(".")) {
 58:         parts = date.split(".");
 59:         datestring = new Date(parseInt(parts[2], 10), parseInt(parts[1], 10) - 1, parseInt(parts[0], 10));
 60:         return datestring.toLocaleDateString(navigator.language, options);
 61:       }
 62:       if (date !== null && typeof date === "string" && date.includes("-")) {
 63:         parts = date.split("-");
 64:         datestring = new Date(parseInt(parts[0], 10), parseInt(parts[1], 10) - 1, parseInt(parts[2], 10));
 65:         return datestring.toLocaleDateString(navigator.language, options);
 66:       } else if (date !== null && typeof date === "number") {
 67:         var datenumber = new Date(date);
 68:         return datenumber.toLocaleDateString(navigator.language, options);
 69:       } else {
 70:         return date;
 71:       }
 72:     },
 73:     pickStatus: function (status) {
 74:       switch (status) {
 75:         case "P":
 76:           return sap.ui.getCore().getModel("i18n").getResourceBundle().getText("partlyPicked");
 77:         case "R":
 78:           return sap.ui.getCore().getModel("i18n").getResourceBundle().getText("released");
 79:         case "Y":
 80:           return sap.ui.getCore().getModel("i18n").getResourceBundle().getText("picked");
 81:         case "D":
 82:           return sap.ui.getCore().getModel("i18n").getResourceBundle().getText("partlyDelivered");
 83:         case "ps_Picked":
 84:           return sap.ui.getCore().getModel("i18n").getResourceBundle().getText("partlyPicked");
 85:         case "ps_Released":
 86:           return sap.ui.getCore().getModel("i18n").getResourceBundle().getText("released");
 87:         case "ps_PartiallyDelivered":
 88:           return sap.ui.getCore().getModel("i18n").getResourceBundle().getText("partlyDelivered");
 89:         default:
 90:           return sap.ui.getCore().getModel("i18n").getResourceBundle().getText("picked");
 91:       }
 92:     },
 93:     pickState: function (status) {
 94:       switch (status) {
 95:         case "P":
 96:           return sap.ui.core.ValueState.Warning;
 97:         case "R":
 98:           return sap.ui.core.ValueState.Error;
 99:         case "Y":
100:           return sap.ui.core.ValueState.Success;
101:         case "D":
102:           return sap.ui.core.ValueState.Warning;
103:         case "ps_Picked":
104:           return sap.ui.core.ValueState.Warning;
105:         case "ps_Released":
106:           return sap.ui.core.ValueState.Error;
107:         case "ps_PartiallyDelivered":
108:           return sap.ui.core.ValueState.Warning;
109:         default:
110:           return sap.ui.core.ValueState.Success;
111:       }
112:     },
113:     serialNumText: function (statusSerial, statusBatch) {
114:       if (statusSerial === "Y") {
115:         return sap.ui.getCore().getModel("i18n").getResourceBundle().getText("serialNumberRequired");
116:       } else if (statusBatch === "Y") {
117:         return sap.ui.getCore().getModel("i18n").getResourceBundle().getText("batchNumberRequired");
118:       } else {
119:         return "";
120:         //return sap.ui.getCore().getModel("i18n").getResourceBundle().getText("noNumberRequired");
121:       }
122:     },
123:     serialNumState: function (statusSerial, statusBatch) {
124:       if (statusSerial === "Y") {
125:         return "Error";
126:       } else if (statusBatch === "Y") {
127:         return "Warning";
128:       } else {
129:         return "Success";
130:       }
131:     },
132:     selectQuantity: function (onHandQty, Quantity, CommitQty) {
133:       if (onHandQty !== null) {
134:         return onHandQty;
135:       } else {
136:         return Quantity - CommitQty;
137:       }
138:     },
139:   };
140: });
