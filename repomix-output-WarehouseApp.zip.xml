<file path="WarehouseApp/nAG.Warehouse.App.Pick/controller/batchNumberController.js">
 1: const SL = require("@nag/servicelayerconnector");
 2: const { getInstance } = require("../utils/instanceUtils.js");
 3: const { generateBasicAuth } = require("../utils/authUtils.js");
 4: const { getError } = require("../utils/errorUtils.js");
 5: async function availableBatchNumbers(req, res) {
 6:   try {
 7:     const { ItemCode, WarehouseCode, BatchNumber, DefaultBin } = req.body;
 8:     const tenant = req.params.tenant;
 9:     if (!ItemCode || !WarehouseCode) {
10:       return res.status(400).send({ error: "ItemCode and WarehouseCode are required." });
11:     }
12:     let url = `SQLQueries('BatchDetails')/List?ItemCode='${ItemCode}'&WhsCode='${WarehouseCode}'`;
13:     if (BatchNumber) {
14:       url += `&$filter=DistNumber eq '${BatchNumber}'`;
15:     }
16:     const instance = await getInstance();
17:     const authHeaders = await generateBasicAuth(req.headers, tenant);
18:     SL.GET(
19:       url,
20:       null,
21:       authHeaders,
22:       {
23:         retryTimes: 2,
24:         retryDelay: 750,
25:         SLURL: instance.SLURL,
26:         SLPort: instance.SLPort,
27:       },
28:       async (error, resp) => {
29:         if (error) {
30:           return res.status(error.httpStatusCode).send(await getError(error));
31:         }
32:         let response = resp.value.filter((batch) => batch.AvailableQuantity > 0);
33:         if (DefaultBin) {
34:           response = response.filter((batch) => batch.BinAbs.toString() === DefaultBin.toString());
35:         }
36:         res.send(response);
37:       }
38:     );
39:   } catch (err) {
40:     res.status(500).send({ error: "Internal server error.", details: err.message });
41:   }
42: }
43: module.exports = {
44:   availableBatchNumbers,
45: };
</file>

