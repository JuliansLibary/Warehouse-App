 18:   async one(request: Request, response: Response) {
 19:     try {
 20:       const item = await this.itemDataRepository.findOneBy({
 21:         itemCode: request.params.itemCode,
 22:         tenantId: request.params.tenantId,
 23:       });
 24:       if (!item) {
 25:         return response.status(404).json({ error: "Item not found" });
 26:       }
 27:       response.status(200).json(item);
 28:     } catch (error) {
 29:       response
 30:         .status(500)
 31:         .json({ message: "Internal Server Error", error: error.message });
 32:     }
 33:   }
 34:   // Get all items for a specific tenant
 35:   async getAllForTenant(request: Request, response: Response) {
 36:     try {
 37:       const items = await this.itemDataRepository.find({
 38:         where: { tenantId: request.params.tenantId },
 39:         select: [
 40:           "itemCode",
 41:           "itemName",
 42:           "barcode",
 43:           "manageSerialNumbers",
 44:           "manageBatchNumbers",
 45:         ],
 46:       });
 47:       response.status(200).json(items);
 48:     } catch (error) {
 49:       response
 50:         .status(500)
 51:         .json({ message: "Internal Server Error", error: error.message });
 52:     }
 53:   }
 54:   // Save a new item or update existing items
 55:   async save(request: Request, response: Response) {
 56:     try {
 57:       // Handle both single and batch save requests
 58:       const items = Array.isArray(request.body) ? request.body : [request.body];
 59:       const savePromises = items.map(async (item: Item) => {
 60:         try {
 61:           // Try to save the item
 62:           return await this.itemDataRepository.save(item);
 63:         } catch (saveError) {
 64:           // If save fails, try to update
 65:           await this.itemDataRepository.update(
 66:             { itemCode: item.itemCode, tenantId: item.tenantId },
 67:             item
 68:           );
 69:           // Fetch and return the updated item
 70:           return this.itemDataRepository.findOneBy({
 71:             itemCode: item.itemCode,
 72:             tenantId: item.tenantId,
 73:           });
 74:         }
 75:       });
 76:       const results = await Promise.all(savePromises);
 77:       response.status(201).json(results);
 78:     } catch (error) {
 79:       response
 80:         .status(500)
 81:         .json({ message: "Internal Server Error", error: error.message });
 82:     }
 83:   }
