323:             if (json[i][prop] === val) {
324:               count++;
325:             }
326:           }
327:           return count;
328:         },
329:         /**
330:          * Erstellt einen Log eintrag in der SAP Log DB
331:          * Folgende Log Level gibt es:
332:          * error: Fehler
333:          * warning: nicht erwünschte aber vorausgesehene Situation
334:          * fatal: Programm funktioniert nicht mehr
335:          * trace: Programmfluss verfolgen
336:          * debug: Information ist fürs debugging wichtig
337:          **/
338:         createLog: function (loglevel, bezeichnung, additionalinfo) {
339:           additionalinfo = additionalinfo || "";
340:           if (loglevel === "error") {
341:             jQuery.sap.log.error(bezeichnung, additionalinfo);
342:           } else if (loglevel === "warning") {
343:             jQuery.sap.log.warning(bezeichnung, additionalinfo);
344:           } else if (loglevel === "fatal") {
345:             jQuery.sap.log.fatal(bezeichnung, additionalinfo);
346:           } else if (loglevel === "trace") {
347:             jQuery.sap.log.trace(bezeichnung, additionalinfo);
348:           } else if (loglevel === "debug") {
349:             jQuery.sap.log.debug(bezeichnung, additionalinfo);
350:           }
351:         },
352:         /**
353:          * Standard Error-Call improved by Maciej
354:          * 21.08.2019 Improved the Messagebox and added SAP Error Messages
355:          * showError(i18nFehlermeldung, zusätzlicheInformation, Fehlercode)
356:          */
357:         showError: function (extraInfo, errorCode) {
358:           var that = this;
359:           this.oEventBus.publish("nAG", "hideBusyDialog");
360:             var dialog = new Dialog({
361:                 title: errorCode,
362:                 type: "Message",
363:                 state: ValueState.Error,
