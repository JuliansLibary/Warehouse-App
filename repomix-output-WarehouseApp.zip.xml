2471:         // Check in all packages of delivery model (actually booked serials)
2472:         const deliveryData = this.getModel("deliveryModel").getData();
2473:         if (deliveryData && deliveryData.Package && Array.isArray(deliveryData.Package)) {
2474:           for (let pkgIndex = 0; pkgIndex < deliveryData.Package.length; pkgIndex++) {
2475:             const pkg = deliveryData.Package[pkgIndex];
2476:             if (pkg.DeliveryLines && Array.isArray(pkg.DeliveryLines)) {
2477:               for (let lineIndex = 0; lineIndex < pkg.DeliveryLines.length; lineIndex++) {
2478:                 const line = pkg.DeliveryLines[lineIndex];
2479:                 if (line.SerialNumbers && Array.isArray(line.SerialNumbers)) {
2480:                   for (let serialIndex = 0; serialIndex < line.SerialNumbers.length; serialIndex++) {
2481:                     const serial = line.SerialNumbers[serialIndex];
2482:                     const serialNumber = serial.SerialNumber || serial.DistNumber || serial.InternalSerialNumber;
2483:                     const manufacturerSerialNumber = serial.ManufacturerSerialNumber || serial.InternalSerialNumber;
2484:                     // Check both serial number and manufacturer serial number
2485:                     if (serialNumber === sSerialNumber || manufacturerSerialNumber === sSerialNumber) {
2486:                       return {
2487:                         isDuplicate: true,
2488:                         location: `Paket ${pkgIndex + 1}`,
2489:                         code: 409,
2490:                         isDuplicateError: true,
2491:                         duplicateContext: "deliveryModel",
2492:                         duplicatePackage: pkgIndex
2493:                       };
2494:                     }
2495:                   }
2496:                 }
2497:               }
2498:             }
2499:           }
2500:         }
2501:         // Check in detail model for cross-package validation
2502:         const detailData = this.getModel("DetailModel").getData();
2503:         if (detailData && detailData.PackListLines && Array.isArray(detailData.PackListLines)) {
2504:           for (let lineIndex = 0; lineIndex < detailData.PackListLines.length; lineIndex++) {
2505:             const line = detailData.PackListLines[lineIndex];
2506:             if (line.SerialNumbers && Array.isArray(line.SerialNumbers)) {
2507:               for (let serialIndex = 0; serialIndex < line.SerialNumbers.length; serialIndex++) {
2508:                 const serial = line.SerialNumbers[serialIndex];
2509:                 const serialNumber = serial.SerialNumber || serial.DistNumber || serial.InternalSerialNumber;
2510:                 const manufacturerSerialNumber = serial.ManufacturerSerialNumber || serial.InternalSerialNumber;
2511:                 // Only flag as duplicate if it's already assigned to a package
2512:                 if ((serialNumber === sSerialNumber || manufacturerSerialNumber === sSerialNumber) && serial.Package) {
2513:                   return {
2514:                     isDuplicate: true,
2515:                     location: `bereits gebucht`,
2516:                     code: 409,
2517:                     isDuplicateError: true,
2518:                     duplicateContext: "detailModel",
2519:                     duplicatePackage: null
2520:                   };
2521:                 }
2522:               }
2523:             }
2524:           }
2525:         }
2526:         return {
2527:           isDuplicate: false,
2528:           location: null
2529:         };
2530:       } catch {
