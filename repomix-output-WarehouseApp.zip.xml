128: async function calculateModelTotals(req, res) {
129:   try {
130:     const language = getLanguageFromRequest(req);
131:     const { modelData } = req.body;
132:     if (!modelData) {
133:       return res.status(400).send(createI18nErrorResponse('modelDataRequired', language, [], 400));
134:     }
135:     let totals = {
136:       totalItems: 0,
137:       totalPicked: 0,
138:       totalPacked: 0,
139:       totalRemaining: 0,
140:       packagesCount: 0,
141:       deliveryLinesCount: 0,
142:       serialItemsCount: 0,
143:       batchItemsCount: 0
144:     };
145:     // Calculate pack list totals
146:     if (modelData.packList && Array.isArray(modelData.packList)) {
147:       totals.totalItems = modelData.packList.length;
148:       modelData.packList.forEach(item => {
149:         totals.totalPicked += (item.PickedQuantity || 0);
150:         totals.totalPacked += (item.PackedQuantity || 0);
151:         totals.totalRemaining += (item.RemainingToPack || 0);
152:         if (item.ManageSerialNumbers === "Y") {
153:           totals.serialItemsCount++;
154:         }
155:         if (item.ManageBatchNumbers === "Y") {
156:           totals.batchItemsCount++;
157:         }
158:       });
159:     }
160:     // Calculate delivery totals
161:     if (modelData.delivery && modelData.delivery.Package) {
162:       totals.packagesCount = modelData.delivery.Package.length;
163:       modelData.delivery.Package.forEach(pkg => {
164:         if (pkg.DeliveryLines) {
165:           totals.deliveryLinesCount += pkg.DeliveryLines.length;
166:         }
167:       });
168:     }
169:     // Calculate completion percentages
170:     totals.completionPercentage = totals.totalPicked > 0 ? 
171:       Math.round((totals.totalPacked / totals.totalPicked) * 100) : 0;
172:     res.send({
173:       totals,
174:       isComplete: totals.totalRemaining === 0,
175:       hasUnpackedItems: totals.totalRemaining > 0,
176:       efficiency: totals.totalPicked > 0 ? totals.totalPacked / totals.totalPicked : 0
177:     });
178:   } catch (error) {
179:     const language = getLanguageFromRequest(req);
180:     res.status(500).send(createI18nErrorResponse('errorCalculatingModelTotals', language, [], 500, error.message));
181:   }
182: }
183: /**
184:  * Merge model data from multiple sources
185:  * @param {Object} req - Express request object
186:  * @param {Object} res - Express response object
187:  */
188: async function mergeModelData(req, res) {
189:   try {
190:     const language = getLanguageFromRequest(req);
191:     const { sourceModels, mergeStrategy = 'latest_wins' } = req.body;
192:     if (!sourceModels || !Array.isArray(sourceModels) || sourceModels.length === 0) {
193:       return res.status(400).send(createI18nErrorResponse('sourceModelsRequired', language, [], 400));
194:     }
195:     let mergedModel = {
196:       packList: [],
197:       delivery: { Package: [] },
198:       metadata: {
199:         mergedAt: new Date().toISOString(),
200:         sourceCount: sourceModels.length,
201:         strategy: mergeStrategy
202:       }
203:     };
204:     // Merge pack lists
205:     const allPackListItems = [];
206:     sourceModels.forEach(model => {
207:       if (model.packList && Array.isArray(model.packList)) {
208:         allPackListItems.push(...model.packList);
209:       }
210:     });
211:     // Deduplicate pack list items
212:     const uniquePackItems = [];
213:     allPackListItems.forEach(item => {
214:       const existingIndex = uniquePackItems.findIndex(existing => isMatchingItem(existing, item));
215:       if (existingIndex >= 0) {
216:         if (mergeStrategy === 'latest_wins') {
217:           uniquePackItems[existingIndex] = item;
218:         } else if (mergeStrategy === 'sum_quantities') {
219:           uniquePackItems[existingIndex].PackedQuantity = 
220:             (uniquePackItems[existingIndex].PackedQuantity || 0) + (item.PackedQuantity || 0);
221:         }
222:       } else {
223:         uniquePackItems.push(item);
224:       }
225:     });
226:     mergedModel.packList = uniquePackItems;
227:     // Merge delivery packages
228:     sourceModels.forEach(model => {
229:       if (model.delivery && model.delivery.Package && Array.isArray(model.delivery.Package)) {
230:         model.delivery.Package.forEach((pkg, index) => {
231:           if (!mergedModel.delivery.Package[index]) {
232:             mergedModel.delivery.Package[index] = {
233:               PackageNumber: index,
234:               DeliveryLines: []
235:             };
236:           }
237:           if (pkg.DeliveryLines && Array.isArray(pkg.DeliveryLines)) {
238:             mergedModel.delivery.Package[index].DeliveryLines.push(...pkg.DeliveryLines);
239:           }
240:         });
241:       }
242:     });
243:     res.send({
244:       mergedModel,
245:       originalSourceCount: sourceModels.length,
246:       mergeStrategy,
247:       conflicts: [] // Could be enhanced to track merge conflicts
248:     });
249:   } catch (error) {
250:     const language = getLanguageFromRequest(req);
251:     res.status(500).send(createI18nErrorResponse('errorMergingModelData', language, [], 500, error.message));
252:   }
253: }
254: /**
255:  * Validate model consistency and data integrity
256:  * @param {Object} req - Express request object
257:  * @param {Object} res - Express response object
258:  */
259: async function validateModelConsistency(req, res) {
260:   try {
261:     const language = getLanguageFromRequest(req);
262:     const { modelData } = req.body;
263:     if (!modelData) {
264:       return res.status(400).send(createI18nErrorResponse('modelDataRequired', language, [], 400));
265:     }
266:     const validationResults = {
267:       isValid: true,
268:       errors: [],
269:       warnings: [],
270:       summary: {
271:         packListValid: true,
272:         deliveryValid: true,
273:         quantitiesConsistent: true
274:       }
275:     };
276:     // Validate pack list structure
277:     if (!modelData.packList || !Array.isArray(modelData.packList)) {
278:       validationResults.errors.push("Pack list must be an array");
279:       validationResults.summary.packListValid = false;
280:     } else {
281:       modelData.packList.forEach((item, index) => {
282:         if (!item.ItemCode) {
283:           validationResults.errors.push(`Pack list item ${index}: ItemCode is required`);
284:         }
285:         if (typeof item.PackedQuantity !== 'number' || item.PackedQuantity < 0) {
286:           validationResults.errors.push(`Pack list item ${index}: Invalid PackedQuantity`);
287:         }
288:         if (typeof item.PickedQuantity !== 'number' || item.PickedQuantity < 0) {
289:           validationResults.errors.push(`Pack list item ${index}: Invalid PickedQuantity`);
290:         }
291:       });
292:     }
293:     // Validate delivery structure
294:     if (modelData.delivery) {
295:       if (!modelData.delivery.Package || !Array.isArray(modelData.delivery.Package)) {
296:         validationResults.errors.push("Delivery Package must be an array");
297:         validationResults.summary.deliveryValid = false;
298:       } else {
299:         modelData.delivery.Package.forEach((pkg, pkgIndex) => {
300:           if (pkg.DeliveryLines && Array.isArray(pkg.DeliveryLines)) {
301:             pkg.DeliveryLines.forEach((line, lineIndex) => {
302:               if (!line.ItemCode) {
303:                 validationResults.errors.push(`Package ${pkgIndex}, Line ${lineIndex}: ItemCode is required`);
304:               }
305:               if (typeof line.PackedQuantity !== 'number' || line.PackedQuantity < 0) {
306:                 validationResults.errors.push(`Package ${pkgIndex}, Line ${lineIndex}: Invalid PackedQuantity`);
307:               }
308:             });
309:           }
310:         });
311:       }
312:     }
313:     // Check quantity consistency between pack list and delivery
314:     if (modelData.packList && modelData.delivery && modelData.delivery.Package) {
315:       modelData.packList.forEach(packItem => {
316:         let totalDeliveryQuantity = 0;
317:         modelData.delivery.Package.forEach(pkg => {
318:           if (pkg.DeliveryLines) {
319:             pkg.DeliveryLines.forEach(line => {
320:               if (isMatchingItem(line, packItem)) {
321:                 if (packItem.ManageSerialNumbers === "Y") {
322:                   totalDeliveryQuantity += (line.SerialNumbers?.length || 0);
323:                 } else {
324:                   totalDeliveryQuantity += (line.PackedQuantity || 0);
325:                 }
326:               }
327:             });
328:           }
329:         });
330:         if (Math.abs(totalDeliveryQuantity - (packItem.PackedQuantity || 0)) > 0.001) {
331:           validationResults.warnings.push(
332:             `Quantity mismatch for ${packItem.ItemCode}: PackList=${packItem.PackedQuantity}, Delivery=${totalDeliveryQuantity}`
333:           );
334:         }
335:       });
336:     }
337:     // Set overall validity
338:     validationResults.isValid = validationResults.errors.length === 0;
339:     validationResults.summary.quantitiesConsistent = validationResults.warnings.length === 0;
340:     res.send(validationResults);
341:   } catch (error) {
342:     const language = getLanguageFromRequest(req);
343:     res.status(500).send(createI18nErrorResponse('errorValidatingModelConsistency', language, [], 500, error.message));
344:   }
345: }
346: /**
347:  * Update delivery model and clean up empty/incomplete lines
348:  * Migrated from: _updateDeliveryModel in Detail.controller.js
349:  * @param {Object} deliveryData - Complete delivery model data
350:  * @returns {Object} Processed delivery data with cleanup results
351:  */
352: async function updateDeliveryModel(deliveryData) {
353:     try {
354:         console.info("Updating delivery model and cleaning up incomplete lines");
355:         const markForDeletion = [];
356:         const cleanupStats = {
357:             linesRemoved: 0,
358:             packagesProcessed: 0,
359:             cleanupReasons: []
360:         };
361:         // Process each package and its delivery lines
362:         if (deliveryData.Package && Array.isArray(deliveryData.Package)) {
363:             deliveryData.Package.forEach((pkg, packageIndex) => {
364:                 cleanupStats.packagesProcessed++;
365:                 if (pkg.DeliveryLines && Array.isArray(pkg.DeliveryLines)) {
366:                     pkg.DeliveryLines.forEach((line, lineIndex) => {
367:                         const cleanupReasons = [];
368:                         // Check for no quantity
369:                         const hasNoQuantity = line.PackedQuantity === 0;
370:                         if (hasNoQuantity) {
371:                             cleanupReasons.push("no_quantity");
372:                         }
373:                         // Check for missing serials when required
374:                         const hasNoSerials = line.ManageSerialNumbers === "Y" && 
375:                             (!line.SerialNumbers || line.SerialNumbers.length === 0);
376:                         if (hasNoSerials) {
377:                             cleanupReasons.push("missing_serials");
378:                         }
379:                         // Check for incomplete item information
380:                         const hasIncompleteItemInfo = !line.ItemCode || !line.ItemDescription;
381:                         if (hasIncompleteItemInfo) {
382:                             cleanupReasons.push("incomplete_item_info");
383:                         }
384:                         // Mark for deletion if any cleanup reason exists
385:                         if (cleanupReasons.length > 0) {
386:                             markForDeletion.push({ 
387:                                 packageIndex: packageIndex, 
388:                                 lineIndex: lineIndex,
389:                                 reasons: cleanupReasons,
390:                                 itemCode: line.ItemCode || "unknown"
391:                             });
392:                             cleanupStats.cleanupReasons.push(...cleanupReasons);
393:                         }
394:                     });
395:                 }
396:             });
397:         }
398:         // Remove marked lines in reverse order to maintain indices
399:         markForDeletion.reverse().forEach(({ packageIndex, lineIndex, reasons, itemCode }) => {
400:             console.info(`Removing incomplete delivery line: Package ${packageIndex}, Line ${lineIndex}, Item ${itemCode}, Reasons: ${reasons.join(", ")}`);
401:             deliveryData.Package[packageIndex].DeliveryLines.splice(lineIndex, 1);
402:             cleanupStats.linesRemoved++;
403:         });
404:         return {
405:             success: true,
406:             data: deliveryData,
407:             cleanup: cleanupStats,
408:             message: `Delivery model updated successfully. Removed ${cleanupStats.linesRemoved} incomplete lines.`
409:         };
410:     } catch (error) {
411:         console.error("Error updating delivery model:", error);
412:         throw new Error(`Failed to update delivery model: ${error.message}`);
413:     }
414: }
