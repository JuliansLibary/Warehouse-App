308:       getUrlVars: function () {
309:         const params = {};
310:         const url = window.location.href;
311:         const pairs = (url + "?").split("?")[1].split("&");
312:         for (const pairString of pairs) {
313:           const pair = (pairString + "=").split("=").map(decodeURIComponent);
314:           if (pair[0].length) {
315:             params[pair[0]] = pair[1];
316:           }
317:         }
318:         return params;
319:       },
320:       setViewModel: function (oModel, sName) {
321:         return this.getView().setModel(oModel, sName);
322:       },
323:       getViewModel: function (sName) {
324:         return this.getView().getModel(sName);
