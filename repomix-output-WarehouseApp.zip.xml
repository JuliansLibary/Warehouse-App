428:         port = Fragment.byId("dialogModuleRegistration", "inpPort").getValue(),
429:         multiTenant = Fragment.byId("dialogModuleRegistration", "rbgGlobal").getSelectedIndex() === 1,
430:         Tenant = multiTenant ? null : that.byId("cbbTenants").getSelectedKey(),
431:         DisplayName = Fragment.byId("dialogModuleRegistration", "inpDisplayName").getValue();
432:       // Prüfen auf Fehlerzustand der Eingabefelder
433:       const isPortValid = Fragment.byId("dialogModuleRegistration", "inpPort").getValueState() !== sap.ui.core.ValueState.Error,
434:         isModuleNameValid = Fragment.byId("dialogModuleRegistration", "inpModuleName").getValueState() !== sap.ui.core.ValueState.Error;
435:       if (isPortValid && isModuleNameValid) {
436:         const encodedModuleName = encodeURIComponent(module_name);
437:         const encodedPort = encodeURIComponent(port);
438:         const encodedTenant = encodeURIComponent(Tenant);
439:         const encodedDisplayName = encodeURIComponent(DisplayName);
440:         // Optional: Validierung auf verbotene Zeichen oder ungültige Eingaben
441:         if ([module_name, port, Tenant, DisplayName].some(val => typeof val !== 'string' || val.trim() === "")) {
442:           MessageBox.error(sap.ui.getCore().getModel("i18n").getResourceBundle().getText("AddConfigFail"));
443:           return;
444:         }
445:         this.makeAjaxRequest(
446:           "GET",
447:           `databaseConfiguration/saveNewConfiguration/${encodedModuleName}/${encodedPort}/${encodedTenant}/${encodedDisplayName}`,
448:           null,
449:           "warehouseError",
450:           function (response) {
451:             const errorCode = [];
452:             Object.entries(response).forEach(([key, value]) => {
453:               if (!value) {
454:                 errorCode.push(key);
455:               }
456:             });
457:             if (errorCode.length > 0) {
458:               let combinedErrorCode = sap.ui.getCore().getModel("i18n").getResourceBundle().getText("AddConfigFail");
459:               errorCode.forEach(element => {
460:                 combinedErrorCode += `${element}\n`;
461:               });
462:               MessageToast.show(combinedErrorCode);
463:             } else {
464:               Fragment.byId("dialogModuleRegistration", "inpModuleName").setValue("");
465:               Fragment.byId("dialogModuleRegistration", "inpPort").setValue("");
466:               Fragment.byId("dialogModuleRegistration", "inpDisplayName").setValue("");
467:               MessageToast.show(sap.ui.getCore().getModel("i18n").getResourceBundle().getText("AddConfigSuccess"));
468:               that.onCloseModuleConfiguration();
469:             }
470:           }
471:         );
472:       }else{
473:         MessageBox.error(sap.ui.getCore().getModel("i18n").getResourceBundle().getText("AddConfigValidationFail"));
474:       }
