<file path="WarehouseApp/nAG.Warehouse.App.InfoPoint/server.js">
 1: require("tls").DEFAULT_MIN_VERSION = "TLSv1";
 2: /* eslint-disable no-unused-vars */
 3: var express = require("express");
 4: var app = express();
 5: var modulelogic = require("./routes/modulelogic.js");
 6: var http = require("http");
 7: const bodyParser = require("body-parser");
 8: app.use("/", express.static("./webapp"));
 9: // Initialise UI5 App
10: app.use(express.static("./webapp"));
11: // configure the app to use bodyParser()
12: app.use(
13:   bodyParser.urlencoded({
14:     extended: true,
15:   })
16: );
17: app.use(bodyParser.json({}));
18: // Uncomment line below for Self Signed Service Layer
19: process.env["NODE_TLS_REJECT_UNAUTHORIZED"] = 0;
20: // For every businesslogic call we read the configuration
21: // Only businesslogic as its the router logic
22: app.all("/businesslogic/*", async function (req, res, next) {
23:   var result = await modulelogic.getConfiguration("InfoPoint", req.headers.referer);
24:   if (result === 200 || result === "undefined") {
25:     next();
26:   } else if (result === 403 || result === 404) {
27:     res.status(result).send();
28:   }
29: });
30: // Starts Node JS Instance and read Configuration
31: // After the configuration is loaded from the App we set global Variable and create a "Link" to the businesslogic
32: app.listen(8129, function () {
33:   http.get("http://Module-AdminPanel.warehouseapp:8005/businesslogic/initConfigForStart/InfoPoint", function (response) {
34:     let rawData = "";
35:     response.on("data", (chunk) => {
36:       rawData += chunk;
37:     });
38:     response.on("end", () => {
39:       global.gConfig = JSON.parse(rawData);
40:       console.info("this is the Init config", JSON.stringify(global.gConfig));
41:       // Use the Businesslogic after the variable is set
42:       app.use("/businesslogic", require("./routes/businesslogic.js"));
43:       app.use("/itemlogic", require("./routes/itemlogic.js"));
44:     });
45:   });
46: });
</file>

