<file path="WarehouseApp/nAG.Warehouse.App.Pack/webapp/workers.js">
  1: //worker.js
  2: let content,
  3:   xmlHttp = new XMLHttpRequest();
  4: let tenantId;
  5: let userId;
  6: onmessage = function (event) {
  7:   content = event.data;
  8:   tenantId = event.data.tenantId;
  9:   userId = event.data.userId;
 10:   return new Promise((resolve) => {
 11:     checkSaveState().then((responseCheck) => {
 12:       if (responseCheck === 202) {
 13:         resolve(postMessage(responseCheck));
 14:       }
 15:       else if (responseCheck === 209) {
 16:         resolve(postContent());
 17:       }else{
 18:         resolve(patchContent(responseCheck));
 19:       }
 20:     })
 21:     .catch((err) => {
 22:       console.error(err);
 23:       resolve(postContent());
 24:     });
 25:   })
 26: };
 27: async function checkSaveState() {
 28:   return await _checkSaveState();
 29: }
 30: async function _checkSaveState() {
 31:   return new Promise(function (resolve, reject) {
 32:     xmlHttp.open("GET", "cache/checkCache/" + content.DetailModel.AbsoluteEntry +"/"+ content.DetailModel.DocEntry + "/Pack/" + tenantId);
 33:     xmlHttp.withCredentials = true;
 34:     xmlHttp.onreadystatechange = function () {
 35:       if (xmlHttp.readyState == 4 && xmlHttp.status == 209) {
 36:         reject("No Data found for patch");
 37:       } else if (xmlHttp.readyState == 4 && xmlHttp.status == 200 && xmlHttp.response) {
 38:         resolve(xmlHttp.response);
 39:       }else if(xmlHttp.readyState == 4 && xmlHttp.status == 202){
 40:         resolve(xmlHttp.status);
 41:       }
 42:     };
 43:     xmlHttp.onerror = function () {
 44:       reject(Error("Network Error"));
 45:     };
 46:     xmlHttp.send();
 47:   });
 48: }
 49: async function postContent() {
 50:   // Do the usual XHR stuff
 51:   xmlHttp.open("POST", "cache/saveCache", false);
 52:   xmlHttp.setRequestHeader("Content-type", "application/json");
 53:   xmlHttp.onreadystatechange = function () {
 54:     if (xmlHttp.readyState == 4 && xmlHttp.status == 201) {
 55:       postMessage("true");
 56:     }
 57:   };
 58:   // Handle network errors
 59:   xmlHttp.onerror = function () {
 60:     reject(Error("Network Error"));
 61:   };
 62:   // Make the request
 63:   xmlHttp.send(
 64:     JSON.stringify({
 65:       documentNumber: content.DetailModel.AbsoluteEntry,
 66:       module: "Pack",
 67:       documentType: "Kundenauftrag",
 68:       content: JSON.stringify(content),
 69:       tenantId: tenantId,
 70:       createDate: new Date(Date.now()).toISOString(),
 71:       updateDate: new Date(Date.now()).toISOString(),
 72:       updatedByUser: userId,
 73:       createdByUser: userId,
 74:       remark: "Test",
 75:       isDeleted:false,
 76:       childElementDocumentNumber: content.DetailModel.DocEntry
 77:     })
 78:   );
 79: }
 80: async function patchContent(responseCheck) {
 81:   try {
 82:     xmlHttp.open("POST", "cache/patchCache/" + JSON.parse(responseCheck).id, false);
 83:     xmlHttp.setRequestHeader("Content-type", "application/json");
 84:     xmlHttp.onreadystatechange = function () {
 85:       if (xmlHttp.readyState == 4 && xmlHttp.status == 200) {
 86:         postMessage("true");
 87:       } else if (xmlHttp.readyState == 4 && xmlHttp.status == 209) {
 88:         postMessage("true");
 89:       }else if (xmlHttp.readyState == 4 && xmlHttp.status !== 209 && xmlHttp.status !== 200) {
 90:         postMessage("false");
 91:       }
 92:     };
 93:     xmlHttp.send(JSON.stringify(
 94:       {
 95:       content: JSON.stringify(content),
 96:       updateDate: new Date(Date.now()).toISOString(),
 97:       updatedByUser: userId,
 98:       // For now set the Remark to empty string
 99:       remark: "",
100:     }));
101:   } catch (error) {
102:     console.error(error);
103:     postMessage("false");
104:   }
105: }
