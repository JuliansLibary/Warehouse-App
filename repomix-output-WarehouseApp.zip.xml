249:       } else {
250:         // Show error message for warehouse not found
251:         MessageBox.error(
252:           this.getOwnerComponent().getModel("i18n").getResourceBundle().getText("warehouseNotFound", [sQuery]),
253:           {
254:             title: this.getOwnerComponent().getModel("i18n").getResourceBundle().getText("errorTitle")
255:           }
256:         );
257:         oList.removeSelections();
258:       }
259:     },
260:     onCloseDialog: function (oEvent) {
261:       this._warehouseDialog.then(function (oDialog) {
262:         oDialog.close();
263:       });
264:     },
265:   });
266: });
