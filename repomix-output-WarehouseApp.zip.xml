<file path="WarehouseApp/nAG.Warehouse.App.Pack/webapp/BaseController.js">
  1: sap.ui.define([
  2:   "sap/ui/core/mvc/Controller", 
  3:   "sap/ui/core/routing/History",
  4:   "nAG/WarehouseApp_Pack/services/BackendApiService"
  5: ], function (Controller, History, BackendApiService) {
  6:   "use strict";
  7:   return Controller.extend("nAG.WarehouseApp_Pack.BaseController", {
  8:     // #region Initialization & Event Bus
  9:     /**
 10:      * Convenience method for saving the BaseController in a global variable and creating fields that need to be accessed
 11:      * @public
 12:      */
 13:     register: function () {
 14:       this.oEventBus = sap.ui.getCore().getEventBus();
 15:       $.sap.control = this;
 16:       this.oEventBus.subscribe("nAG", "showBusyDialog", this.showBusyDialog, this);
 17:       this.oEventBus.subscribe("nAG", "hideBusyDialog", this.hideBusyDialog, this);
 18:       this.oEventBus.subscribe("nAG", "changeAppView", this.changeAppViewLayout, this);
 19:       this.oEventBus.subscribe("nAG", "getAppView", this.getViewElement, this);
 20:     },
 21:     // #endregion
 22:     // #region AJAX & Communication
 23:     /**
 24:      * Get backend API service instance
 25:      * @public
 26:      * @returns {Object} BackendApiService instance
 27:      */
 28:     getBackendApiService: function() {
 29:       if (!this._backendApiService) {
 30:         this._backendApiService = new BackendApiService();
 31:         this._backendApiService._controller = this; // Pass controller reference
 32:         this._backendApiService.init();
 33:       }
 34:       return this._backendApiService;
 35:     },
 36:     /**
 37:      *
 38:      * @param {String} method: Can be at nAG: POST,PATCH,GET
 39:      * @param {String} url:  url for the ajax Call
 40:      * @param {JSON} postContent : JSON Body for a patch/post
 41:      * @param {String} i18n : String for a call of the error dialogue via i18n
 42:      * @param {JSON} callback :  Returns a JSON after a successful Ajax call. Can be further used in the frontend
 43:      * NOTE: No IF is needed to build the postContent dynamically for the AJAX. With a GET, the postContent is not transferred to the backend.
 44:      */
 45:     makeAjaxRequest: function (method, url, postContent, callback, errorCallback) {
 46:       const that = this;
 47:       console.info('=== BaseController makeAjaxRequest START ===');
 48:       console.info('Method:', method);
 49:       console.info('URL:', url);
 50:       console.info('PostContent type:', typeof postContent);
 51:       console.info('PostContent keys:', postContent ? Object.keys(postContent) : 'no content');
 52:       console.info('Callback provided:', typeof callback === 'function');
 53:       console.info('ErrorCallback provided:', typeof errorCallback === 'function');
 54:       // For POST requests with postContent, ensure correct Content-Type and data format
 55:       let requestData = postContent;
 56:       let contentType = undefined; // Let jQuery set the default
 57:       if (method === "POST" && postContent && typeof postContent === "object") {
 58:         // For POST requests with object data, send as form data (which is expected by the backend)
 59:         // The backend uses bodyParser.urlencoded, so we need form-encoded data
 60:         contentType = "application/x-www-form-urlencoded; charset=UTF-8";
 61:         console.info('Set content-type to form-urlencoded for POST with object data');
 62:       }
 63:       console.info('Final requestData:', requestData);
 64:       console.info('Final contentType:', contentType);
 65:       console.info('Making jQuery AJAX call...');
 66:       $.ajax({
 67:         url: url,
 68:         xhrFields: {
 69:           withCredentials: true,
 70:         },
 71:         data: requestData,
 72:         crossDomain: true,
 73:         type: method,
 74:         tryCount: 0,
 75:         retryLimit: 3,
 76:         contentType: contentType,
 77:         headers: {
 78:           prefer: "odata.maxpagesize=0",
 79:         },
 80:         success: function (response, status, xhr) {
 81:           console.info('=== BaseController AJAX SUCCESS ===');
 82:           console.info('Response type:', typeof response);
 83:           console.info('Response status:', status);
 84:           console.info('XHR status:', xhr.status);
 85:           console.info('Response preview:', typeof response === 'string' ? response.substring(0, 200) + '...' : response);
 86:           callback(response);
 87:         },
 88:         error: function (jqXHR, textStatus) {
 89:           console.error('=== BaseController AJAX ERROR ===');
 90:           console.error('jqXHR status:', jqXHR.status);
 91:           console.error('jqXHR statusText:', jqXHR.statusText);
 92:           console.error('jqXHR responseText:', jqXHR.responseText);
 93:           console.error('jqXHR responseJSON:', jqXHR.responseJSON);
 94:           console.error('textStatus:', textStatus);
 95:           console.error('URL that failed:', url);
 96:           console.error('Method that failed:', method);
 97:           // If there's a custom error callback, call it instead of the default error handling
 98:           if (typeof errorCallback === "function") {
 99:             console.info('Calling custom errorCallback...');
100:             errorCallback(jqXHR, textStatus);
101:             return;
102:           }
103:           console.info('Using default error handling...');
104:           const Language = that.getUrlVars().Language;
105:           if (textStatus === "timeout") {
106:             this.tryCount++;
107:             if (this.tryCount <= this.retryLimit) {
108:               $.ajax(this);
109:               return;
110:             } else {
111:               that.showError({ message: "NetworkError", helpUrl: null }, "9000");
112:             }
113:           }
114:           if (typeof jqXHR.responseText !== "undefined" && jqXHR.status !== "undefined") {
115:             if (typeof jqXHR.responseJSON !== "undefined") {
116:               that.showError(that.findTranslation(jqXHR.responseJSON, Language), jqXHR.status);
117:             } else {
118:               let errorMessage;
119:               if (jqXHR.status === 423) {
120:                 errorMessage = {
121:                   message: that.getModel("i18n").getResourceBundle().getText("invalidTenant"),
122:                   helpUrl: null,
123:                 };
124:               } else {
125:                 errorMessage = {
126:                   message: jqXHR.responseText,
127:                   helpUrl: null,
128:                 };
129:               }
130:               that.showError(errorMessage, jqXHR.status);
131:             }
132:           } else {
133:             that.showError(that.findTranslation(jqXHR.responseJSON, Language), 400);
134:           }
135:         },
136:       });
137:     },
138:     findTranslation: function (json, languageCode) {
139:       let response;
140:       // Check if json and json.body exist to prevent TypeError
141:       if (!json || !json.body) {
142:         return {
143:           message: "Unknown error occurred",
144:           helpUrl: null,
145:         };
146:       }
147:       // Safely check for helpUrl property
148:       if (json.body && json.body.helpUrl) {
149:         response = {
150:           message: "",
151:           helpUrl: json.body.helpUrl || null,
152:         };
153:       } else {
154:         response = {
155:           message: "",
156:           helpUrl: null,
157:         };
158:       }
159:       if (json.body && json.body.translations && json.body.translations.length > 0) {
160:         const translation = json.body.translations.find((translationSearch) => translationSearch.language === languageCode);
161:         if (translation) {
162:           response.message = translation.text;
163:         }
164:       }
165:       if (!response.message && json.body && json.body.message) {
166:         response.message = json.body.message;
167:       }
168:       return response;
169:     },
170:     // #endregion
171:     // #region Router & Model Helpers
172:     /**
173:      * Convenience method for accessing the router in every controller of the application.
174:      * @public
175:      * @returns {sap.ui.core.routing.Router} the router for this component
176:      */
177:     getRouter: function () {
178:       this.getDebugMode();
179:       return sap.ui.core.UIComponent.getRouterFor(this);
180:     },
181:     /**
182:      * Convenience method for getting the view model by name in every controller of the application.
183:      * @public
184:      * @param {string} sName the model name
185:      * @returns {sap.ui.model.Model} the model instance
186:      */
187:     getModel: function (sName) {
188:       this.getDebugMode();
189:       return sap.ui.getCore().getModel(sName);
190:     },
191:     /**
192:      * Convenience method for setting the view model in every controller of the application.
193:      * @public
194:      * @param {sap.ui.model.Model} oModel the model instance
195:      * @param {string} sName the model name
196:      * @returns {sap.ui.mvc.View} the view instance
197:      */
198:     setModel: function (oModel, sName) {
199:       this.getDebugMode();
200:       return sap.ui.getCore().setModel(oModel, sName);
201:     },
202:     /**
203:      * Convenience method for getting the resource bundle.
204:      * @public
205:      * @returns {sap.ui.model.resource.ResourceModel} the resourceModel of the component
206:      */
207:     getResourceBundle: function () {
208:       return this.getOwnerComponent().getModel("i18n").getResourceBundle();
209:     },
210:     /**
211:      * Event handler for navigating back.
212:      * It there is a history entry we go one step back in the browser history
213:      * If not, it will replace the current entry of the browser history with the master route.
214:      * @public
215:      */
216:     onNavBack: function () {
217:       this.getDebugMode();
218:       const sPreviousHash = History.getInstance().getPreviousHash();
219:       if (sPreviousHash !== undefined) {
220:         history.go(-1);
