 42:     makeAjaxRequest: function (method, url, postContent, i18n, callback) {
 43:       var that = this;
 44:       $.ajax({
 45:         url: url,
 46:         xhrFields: {
 47:           withCredentials: true
 48:         },
 49:         data: postContent,
 50:         crossDomain: true,
 51:         type: method,
 52:         tryCount: 0,
 53:         retryLimit: 3,
 54:         headers: {
 55:           "prefer": "odata.maxpagesize=0"
 56:         },
 57:         success: function (response, status, xhr) {
 58:           if (typeof response !== "undefined" && xhr.responseText !== "") {
 59:             callback(response);
 60:           }else{
 61:             callback({statusCode: xhr.status, data: null});
 62:           }
 63:         },
 64:         error: function (jqXHR, textStatus) {
 65:           var Language = that.getUrlVars().Language
