 14: function _checkSQLQuery(query, queryContent, cookie, tenant, callback) {
 15:   return new Promise(async function (resolve, reject) {
 16:     let instance = await getInstance();
 17:     SL.GET(
 18:       "SQLQueries('" + query + "')",
 19:       null,
 20:       await generateBasicAuth(cookie, tenant),
 21:       {
 22:         retryTimes: 2,
 23:         retryDelay: 750,
 24:         SLURL: instance.SLURL,
 25:         SLPort: instance.SLPort,
 26:       },
 27:       async function (error, resp) {
 28:         if (error) {
 29:           if (error.httpStatusCode === 404) {
 30:             SL.POST(
 31:               "SQLQueries",
 32:               { SqlCode: query, SqlName: query, SqlText: queryContent },
 33:               null,
 34:               await generateBasicAuth(cookie, tenant),
 35:               {
 36:                 retryTimes: 2,
 37:                 retryDelay: 750,
 38:                 SLURL: instance.SLURL,
 39:                 SLPort: instance.SLPort,
 40:               },
 41:               async function (error, resp) {
 42:                 if (error) {
 43:                   callback(await getError(error));
 44:                 } else {
 45:                   callback(null, resp.ParamList);
 46:                 }
 47:               }
 48:             );
 49:           }
 50:         } else {
 51:           if ((resp.SqlText.replace(/\"|}/g, "").toLowerCase() === queryContent.toLowerCase()) === false) {
 52:             SL.PATCH(
 53:               "SQLQueries('" + query + "')",
 54:               { SqlText: queryContent },
 55:               null,
 56:               await generateBasicAuth(cookie, tenant),
 57:               {
 58:                 retryTimes: 2,
 59:                 retryDelay: 750,
 60:                 SLURL: instance.SLURL,
 61:                 SLPort: instance.SLPort,
 62:               },
 63:               async function (error, resp) {
 64:                 if (error) {
 65:                   callback(await getError(error));
 66:                 } else {
 67:                   callback(null, resp.ParamList);
 68:                 }
 69:               }
 70:             );
 71:           }
 72:           callback(null, resp.ParamList);
 73:         }
 74:       }
 75:     );
 76:   });
 77: }
 78: /* Dynamic Method to get Custom Label Information
 79:  * The select must be set in the Config on Entity "LabelQuery"
 80:  */
 81: async function getSQLQueryContent(url, cookie, tenant) {
 82:   try {
 83:     const instance = await getInstance();
 84:     const auth = await generateBasicAuth(cookie, tenant);
 85:     const response = await SL.GET(
 86:       url,
 87:       null,
 88:       auth,
 89:       {
 90:         retryTimes: 2,
 91:         retryDelay: 750,
 92:         SLURL: instance.SLURL,
 93:         SLPort: instance.SLPort,
 94:       }
 95:     );
 96:     return Object.keys(response.value).length === 1 ? response.value[0] : response.value;
 97:   } catch (error) {
 98:     throw await getError(error);
 99:   }
100: }
101: function getInformationFromSQLQuery(itemObject, querys, cookie, tenant) {
102:   return new Promise((resolve, reject) => {
103:     // woher kommt der tenant?
104:     _getInformationFromSQLQuery(itemObject, querys, cookie, tenant, async function (error, resp) {
105:       if (error) {
106:         reject(error);
107:       } else {
108:         resolve(resp);
109:       }
110:     });
111:   });
112: }
113: /* Dynamic Method to get Custom Label Information from SQL Query
114:  * At the Layout the SQL Query Name, Parameters and the Print Mode is stored
115:   Example:
116:     <h3  sqlQuery="GetPackageFromSerialNumber" attributes="ItemCode,SerialNumber" mode="QR">{CustomLabelContent}</h3>
117:  */
118: async function _getInformationFromSQLQuery(itemObject, queries, cookie, tenant) {
119:   const returnModel = [];
120:   for (const queryLine of queries) {
121:     if (queryLine.SQLQuery) {
122:       let queryURL = `SQLQueries('${queryLine.SQLQuery}')/List?`;
123:       const parameterList = queryLine.atributes.split(",");
124:       parameterList.forEach((parameter, index) => {
125:         if (itemObject.hasOwnProperty(parameter) && itemObject[parameter] !== null) {
126:           if (index >= 1) {
127:             queryURL += "&";
128:           }
129:           queryURL += `${parameter}='${itemObject[parameter]}'`;
130:         }
131:       });
132:       const valueFromServiceLayer = await getSQLQueryContent(queryURL, cookie, tenant);
133:       returnModel.push({
134:         Value: valueFromServiceLayer,
135:         Mode: queryLine.Mode,
136:         SQLQuery: queryLine.SQLQuery,
137:       });
138:     }
139:   }
140:   return returnModel;
141: }
142: module.exports = {
143:   checkSQLQuery,
144:   getSQLQueryContent,
145:   getInformationFromSQLQuery
146: };
</file>

