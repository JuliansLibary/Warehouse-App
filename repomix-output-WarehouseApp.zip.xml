  1: const { getInstance, generateBasicAuth, getData, postData, patchData } = require("../controller/utilsController.js");
  2: const { getItemInformation } = require("../controller/itemController.js");
  3: async function postTransfer(req, res) {
  4:   try {
  5:     const orderModel = JSON.parse(req.body.orderModel);
  6:     const postContent = await prepareTransferForPost(orderModel);
  7:     const instance = await getInstance();
  8:     const authHeader = await generateBasicAuth(req.headers, req.params.tenant);
  9:     const options = { retryTimes: 2, retryDelay: 750, SLURL: instance.SLURL, SLPort: instance.SLPort };
 10:     const stockTransfers = await postData("StockTransfers", postContent, authHeader, options);
 11:     if (req.params.patchOrder && orderModel.DocumentReferences.length > 0) {
 12:       await handleDocumentReferences(orderModel, postContent, stockTransfers, authHeader, options, res);
 13:     } else {
 14:       res.send({ stockTransfer: stockTransfers });
 15:     }
 16:   } catch (error) {
 17:     console.error("Error in postTransfer:", error);
 18:     res.status(error.errorCode || 500).send(error);
 19:   }
 20: }
 21: async function handleDocumentReferences(orderModel, postContent, stockTransfers, authHeader, options, res) {
 22:   for (const reference of orderModel.DocumentReferences) {
 23:     if (reference.RefObjType === "rot_SalesOrder") {
 24:       try {
 25:         const order = await getData(`Orders(${reference.RefDocEntr})`, authHeader, options);
 26:         const hasUpdate = updateOrderLines(order, postContent);
 27:         if (hasUpdate) {
 28:           await patchOrder(order, reference.RefDocEntr, stockTransfers, authHeader, options, res);
 29:         }
 30:       } catch (error) {
 31:         res.send({ stockTransfer: stockTransfers, getError: error.message });
 32:       }
 33:     }
 34:   }
 35: }
 36: function updateOrderLines(order, postContent) {
 37:   let hasUpdate = false;
 38:   order.DocumentLines.forEach((docLine) => {
 39:     const matchingLine = postContent.StockTransferLines.find(
 40:       (line) => line.ItemCode === docLine.ItemCode && line.SerialNumbers.length > 0
 41:     );
 42:     if (matchingLine) {
 43:       docLine.SerialNumbers = matchingLine.SerialNumbers;
 44:       docLine.WarehouseCode = postContent.ToWarehouse;
 45:       hasUpdate = true;
 46:     }
 47:   });
 48:   return hasUpdate;
 49: }
 50: async function patchOrder(order, refDocEntr, stockTransfers, authHeader, options, res) {
 51:   const docNum = order.DocNum;
 52:   ["DocNum", "DocDate", "DocDueDate", "Printed", "@odata.context", "@odata.etag"].forEach((prop) => delete order[prop]);
 53:   try {
