 41: /**
 42:  * Prepares the Data for ServiceLayer Post updateReleasedAllocation which set the BinAllocations in the PickLists
 43:  * @param {json} picklist
 44:  */
 45: function updateReleasedAllocation(picklist) {
 46:   return new Promise((resolve, reject) => {
 47:     try {
 48:       const pickListSet = new Set(picklist.PickListsLines.map((line) => line.AbsoluteEntry));
 49:       const pickListsLines = picklist.PickListsLines.map((picklistLine) => {
 50:         const newBinAllocations = [
 51:           ...(Array.isArray(picklistLine.DocumentLinesBinAllocations)
 52:             ? picklistLine.DocumentLinesBinAllocations.map((binLocationLine) => ({
 53:                 BinAbsEntry: binLocationLine.BinAbsEntry,
 54:                 Quantity: binLocationLine.Quantity,
 55:                 BaseLineNumber: picklistLine.LineNumber,
 56:               }))
 57:             : []),
 58:           ...picklistLine.TempSplitQuantityAndBinModel.filter((tempBinLocationLine) => !Array.isArray(picklistLine.DocumentLinesBinAllocations) || !picklistLine.DocumentLinesBinAllocations.some((pickline) => pickline.BinAbsEntry === tempBinLocationLine.BinAbs))
 59:             .filter((tempBinLocationLine) => tempBinLocationLine.BinAbs !== null)
 60:             .map((tempBinLocationLine) => ({
 61:               BinAbsEntry: tempBinLocationLine.BinAbs,
 62:               Quantity: tempBinLocationLine.Quantity,
 63:               BaseLineNumber: picklistLine.LineNumber,
 64:             })),
 65:         ];
 66:         return {
 67:           AbsoluteEntry: picklistLine.AbsoluteEntry,
 68:           BatchNumbers: picklistLine.BatchNumbers,
 69:           LineNumber: picklistLine.LineNumber,
 70:           OrderEntry: picklistLine.OrderEntry,
 71:           OrderRowID: picklistLine.OrderRowID,
 72:           SerialNumbers: picklistLine.SerialNumber,
 73:           ReleasedQuantity: picklistLine.ReleasedQuantity,
 74:           DocumentLinesBinAllocations: newBinAllocations,
 75:           BaseObjectType: picklistLine.BaseObjectType,
 76:           PickedQuantity: picklistLine.ReleasedQuantity,
 77:         };
 78:       });
 79:       const responseMergePickList = Array.from(pickListSet).map((absoluteEntry) => ({
 80:         PickList: {
 81:           Absoluteentry: absoluteEntry,
 82:           PickListsLines: pickListsLines.filter((picklistLines) => picklistLines.AbsoluteEntry === absoluteEntry),
 83:         },
 84:       }));
 85:       resolve(responseMergePickList);
 86:     } catch (error) {
 87:       reject(error);
 88:     }
 89:   });
 90: }
 91: /**
