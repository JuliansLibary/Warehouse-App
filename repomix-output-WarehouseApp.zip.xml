2801:                 ManageSerialNumbers: deliveryLine.ManageSerialNumbers,
2802:                 WarehouseCode: deliveryLine.WarehouseCode,
2803:               })),
2804:             })),
2805:           }),
2806:           package: packageContextValue,
2807:         };
2808:         that.makeAjaxRequest(
2809:           "POST",
2810:           "serialNumber/pushSerialNumber",
2811:           requestPayload,
2812:           (response) => {
