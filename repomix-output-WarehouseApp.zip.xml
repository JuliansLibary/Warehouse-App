366:     },
367:     setViewModel: function (oModel, sName) {
368:       return this.getView().setModel(oModel, sName);
369:     },
370:     getViewModel: function (sName) {
371:       return this.getView().getModel(sName);
372:     },
373:     getAppConfig: function () {
374:       const that = this;
375:       let packBy = null;
376:       $.ajax({
377:         url: "company/getAppConfig",
378:         crossDomain: true,
379:         type: "GET",
380:         dataType: "json",
381:         success: function (data) {
382:           if (data.packBy === "Order") {
383:             packBy = "Order";
384:           } else if (data.packBy === "ShipTo") {
385:             packBy = "ShipTo";
386:           }
387:           that.getViewModel("appView").setProperty("/packMode", packBy);
388:           // Check if Launchpad is a Parameter at Configuration
389:           if (typeof data.launchpad !== "undefined") {
390:             that.getViewModel("appView").setProperty("/launchpad", data.launchpad);
391:           }
392:           // Check if shippingType is a Parameter at Configuration
393:           if (typeof data.shippingType !== "undefined") {
394:             that.getViewModel("appView").setProperty("/shippingType", data.shippingType);
395:           }
396:           if (typeof data.additionalPackageInformation !== "undefined") {
397:             that.getViewModel("appView").setProperty("/additionalPackageInformation", data.additionalPackageInformation);
398:           }
399:           if (typeof data.showWarningDialogDeliveryNote !== "undefined") {
400:             that.getViewModel("appView").setProperty("/showWarningDialogDeliveryNote", data.showWarningDialogDeliveryNote);
401:           }
402:           if (typeof data.saveInterval !== "undefined") {
403:             that.getViewModel("appView").setProperty("/saveInterval", data.saveInterval);
404:           }
405:           if (typeof data.remarks !== "undefined") {
406:             that.getViewModel("appView").setProperty("/remarks", data.remarks);
407:           }
408:           if (typeof data.remarksNotification !== "undefined") {
409:             that.getViewModel("appView").setProperty("/remarksNotification", data.remarksNotification);
410:           }
411:           if (typeof data.copyOpenLines !== "undefined") {
412:             that.getViewModel("appView").setProperty("/copyOpenLines", data.copyOpenLines);
413:           }
414:           if (typeof data.isDeleted !== "undefined") {
