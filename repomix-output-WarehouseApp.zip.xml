313: /**
314:  * Validate dialog form input data
315:  * @param {Object} req - Express request object
316:  * @param {Object} res - Express response object
317:  */
318: async function validateDialogFormData(req, res) {
319:   try {
320:     const { formData, dialogType, itemData } = req.body;
321:     if (!formData || !dialogType) {
322:       return res.status(400).send({
323:         isValid: false,
324:         message: "Form data and dialog type are required",
325:         error: "MISSING_REQUIRED_DATA"
326:       });
327:     }
328:     const validationResults = {
329:       isValid: true,
330:       errors: [],
331:       warnings: [],
332:       validatedData: { ...formData }
333:     };
334:     switch (dialogType) {
335:       case 'serialNumber':
336:         if (!formData.selectedSerials || !Array.isArray(formData.selectedSerials) || formData.selectedSerials.length === 0) {
337:           validationResults.errors.push("Mindestens eine Seriennummer muss ausgewählt werden");
338:         }
339:         break;
340:       case 'batchNumber':
341:         if (!formData.selectedBatches || !Array.isArray(formData.selectedBatches) || formData.selectedBatches.length === 0) {
342:           validationResults.errors.push("Mindestens eine Charge muss ausgewählt werden");
343:         }
344:         const totalBatchQuantity = formData.selectedBatches?.reduce((sum, batch) => sum + (batch.selectedQuantity || 0), 0) || 0;
345:         if (formData.requestedQuantity && totalBatchQuantity !== formData.requestedQuantity) {
346:           validationResults.errors.push(`Gesamtmenge ${totalBatchQuantity} stimmt nicht mit gewünschter Menge ${formData.requestedQuantity} überein`);
347:         }
348:         break;
349:       case 'additionalItemInfo':
350:         if (formData.packedQuantity !== undefined) {
351:           if (typeof formData.packedQuantity !== 'number' || formData.packedQuantity < 0) {
352:             validationResults.errors.push("Gepackte Menge muss eine positive Zahl sein");
353:           }
354:           if (itemData && formData.packedQuantity > (itemData.PickedQuantity || 0)) {
355:             validationResults.errors.push("Gepackte Menge kann nicht größer als die gepickte Menge sein");
356:           }
357:         }
358:         break;
359:       default:
360:         validationResults.warnings.push(`Unbekannter Dialog-Typ: ${dialogType}`);
361:     }
362:     validationResults.isValid = validationResults.errors.length === 0;
363:     res.send(validationResults);
364:   } catch (error) {
365:     res.status(500).send({
366:       message: "Error validating dialog form data",
367:       code: 500,
368:       error: error.message
369:     });
370:   }
371: }
372: // Helper function to check if items match
373: function isMatchingItem(item1, item2) {
374:   return item1.ItemCode === item2.ItemCode &&
375:          item1.WarehouseCode === item2.WarehouseCode &&
376:          item1.AbsoluteEntry === item2.AbsoluteEntry &&
377:          item1.DocNum === item2.DocNum &&
378:          item1.OrderEntry === item2.OrderEntry &&
379:          item1.OrderRowID === item2.OrderRowID;
380: }
381: module.exports = {
