 4:     restart: always  # The Postgres service always restarts in case of failure.
 5:     image: postgres:16  # Uses the latest Postgres image.
 6:     container_name: 'System-Postgres'  # Name of the Docker container.
 7:     volumes:
 8:       - /data/postgresql/data:/var/lib/postgresql/data/:rw  # Mounts a volume for database data.
 9:     ports:
10:       - "5432:5432"  # Maps port 5432 on the host to port 5432 in the container.
11:     networks:
12:       - warehouseapp  # Connects the container to the "warehouseapp" network.
13:     environment:
14:       POSTGRES_USER: postgres  # Sets the username for the Postgres database.
15:       POSTGRES_PASSWORD: postgres  # Sets the password for the Postgres database.
16:       PGDATA: /var/lib/postgresql/data/  # Specifies the data directory path for Postgres.
17:   databaseconnector:
18:     container_name: "System-DatabaseConnector"  # Name of the Docker container.
19:     restart: always  # The DatabaseConnector service always restarts in case of failure.
20:     build: .  # Uses the current directory as the build context.
21:     ports:
22:       - "3000:3000"  # Maps port 3000 on the host to port 3000 in the container.
23:     networks:
