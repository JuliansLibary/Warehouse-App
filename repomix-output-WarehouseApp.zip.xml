 89:     getResourceBundle: function () {
 90:       return this.getOwnerComponent().getModel("i18n").getResourceBundle();
 91:     },
 92:     /**
 93:      * Event handler for navigating back.
 94:      * It there is a history entry we go one step back in the browser history
 95:      * If not, it will replace the current entry of the browser history with the master route.
 96:      * @public
 97:      */
 98:     onNavBack: function () {
 99:       this.getDebugMode() && console.log("onNavBack");
100:       var sPreviousHash = History.getInstance().getPreviousHash();
101:       if (sPreviousHash !== undefined) {
102:         history.go(-1);
103:       } else {
104:         this.getRouter().navTo("Orders", {}, false);
105:       }
106:     },
107:     /**
108:      * Convenience method for setting Debugmode
109:      */
110:     setDebugMode: function (boolean) {
111:       var debugMode = boolean;
112:       $.sap.debugMode = debugMode;
113:     },
114:     /**
115:      * Convenience method for  getting Debugmode
116:      */
117:     getDebugMode: function () {
118:       return $.sap.debugMode;
119:     },
120:     /**
121:      * Convenience method for saving the BusyDialog in a global variable
122:      * @public
123:      */
124:     getBusyDialog: function () {
125:       var busyDialog = sap.ui.xmlfragment("busyDialog", "nag.WarehouseApp.StockTransferRequest.view.BusyDialog", this);
126:       this.getView().addDependent(busyDialog);
127:       this.busyDialog = busyDialog;
128:     },
129:     /**
