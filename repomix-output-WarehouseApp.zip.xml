117:     out += `anfragen_gesamt ${metrics.totals.requests}\n\n`;
118:     out += `# HILFE fehler_gesamt Gesamtanzahl Proxy-Fehler (5xx)\n`;
119:     out += `# TYP fehler_gesamt counter\n`;
120:     out += `fehler_gesamt ${metrics.totals.errors}\n\n`;
121:     for (const t of metrics.targets.values()) {
122:       const label = `ziel="${t.target.replace(/"/g, '\\"')}"`;
123:       out += `ziel_anfragen_gesamt{${label}} ${t.requests}\n`;
124:       out += `ziel_fehler_gesamt{${label}} ${t.errors}\n`;
125:       out += `ziel_inflight{${label}} ${t.inflight}\n`;
126:       out += `ziel_durchschnitt_ms_1m{${label}} ${t.rolling.avgMs1m.toFixed(
127:         0
128:       )}\n`;
129:       out += `ziel_durchschnitt_ms_5m{${label}} ${t.rolling.avgMs5m.toFixed(
130:         0
131:       )}\n`;
132:     }
133:     res.setHeader("content-type", "text/plain; version=0.0.4; charset=utf-8");
134:     res.end(out);
135:   });
136: }
