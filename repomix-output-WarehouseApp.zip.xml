  1: //worker.js
  2: let content,
  3:   tenantId,
  4:   userId,
  5:   AbsEntry,
  6:   xmlHttp = new XMLHttpRequest();
  7: onmessage = function (event) {
  8:   content = event.data;
  9:   tenantId = event.data.tenantId;
 10:   userId = event.data.userId;
 11:   AbsEntry = event.data.AbsEntry;
 12:   return new Promise(function (resolve, reject) {
 13:     resolve(checkSaveState());
 14:   })
 15:     .then((responseCheck) => {
 16:       if (responseCheck === 202) {
 17:         postMessage(responseCheck);
 18:       }else if (responseCheck === 209) {
 19:         return postContent();
 20:       }
 21:       else{
 22:         return patchContent(responseCheck);
 23:       }
 24:     }).catch(
 25:     )
 26: };
 27: async function checkSaveState() {
 28:   return await _checkSaveState();
 29: }
 30: async function _checkSaveState() {
 31:   return new Promise(function (resolve, reject) {
 32:     xmlHttp.open("GET", "cache/checkCache/" + AbsEntry + "/Pick/" + tenantId);
 33:     xmlHttp.withCredentials = true;
 34:     xmlHttp.onreadystatechange = function () {
 35:       if (xmlHttp.readyState == 4 && xmlHttp.status == 209) {
 36:         resolve(xmlHttp.status);
 37:       } else if (xmlHttp.readyState == 4 && xmlHttp.status == 200 && xmlHttp.response) {
 38:         resolve(xmlHttp.response);
 39:       }else if(xmlHttp.readyState == 4 && xmlHttp.status == 202){
 40:         resolve(xmlHttp.status);
 41:       }else if (xmlHttp.readyState === 4 && xmlHttp.status !== 209 && xmlHttp.status !== 200 && xmlHttp.status !== 202) {
 42:         reject(xmlHttp.status);
 43:       }
 44:     };
 45:     xmlHttp.onerror = function () {
 46:       reject(Error("Network Error"));
 47:     };
 48:     xmlHttp.send();
 49:   });
 50: }
 51: async function postContent() {
 52:   // Do the usual XHR stuff
 53:   xmlHttp.open("POST", "cache/saveCache", false);
 54:   xmlHttp.setRequestHeader("Content-type", "application/json");
 55:   xmlHttp.onreadystatechange = function () {
 56:     if (xmlHttp.readyState == 4 && xmlHttp.status == 201) {
 57:       postMessage("true");
 58:     }
 59:   };
 60:   // Handle network errors
 61:   xmlHttp.onerror = function () {
 62:     reject(Error("Network Error"));
 63:   };
 64:   // Make the request
 65:   xmlHttp.send(
 66:     JSON.stringify({
 67:       documentNumber: AbsEntry,
 68:       module: "Pick",
 69:       documentType: "156",
 70:       content: JSON.stringify(content),
 71:       tenantId: tenantId,
 72:       createDate: new Date(Date.now()).toISOString(),
 73:       updateDate: new Date(Date.now()).toISOString(),
 74:       updatedByUser: userId,
 75:       createdByUser: userId,
 76:       remark: "Test",
 77:       isDeleted:false,
 78:     })
 79:   );
 80: }
 81: async function patchContent(responseCheck) {
 82:   try {
