<file path="WarehouseApp/nAG.Warehouse.App.AdminPanel/fix-docker-tcp.sh">
 1: #!/bin/bash
 2: echo "=== Docker Daemon TCP Konfiguration (Fix) ==="
 3: # Schritt 1: Docker stoppen
 4: echo "Stoppe Docker Service..."
 5: sudo systemctl stop docker
 6: # Schritt 2: Systemd Override erstellen
 7: echo "Erstelle Systemd Override..."
 8: sudo mkdir -p /etc/systemd/system/docker.service.d
 9: # Diese Konfiguration überschreibt die Standard ExecStart Zeile
10: sudo tee /etc/systemd/system/docker.service.d/override.conf > /dev/null <<EOF
11: [Service]
12: ExecStart=
13: ExecStart=/usr/bin/dockerd -H tcp://0.0.0.0:2375 -H unix:///var/run/docker.sock
14: EOF
15: echo "Override Konfiguration erstellt:"
16: cat /etc/systemd/system/docker.service.d/override.conf
17: # Schritt 3: daemon.json entfernen/umbenennen (um Konflikte zu vermeiden)
18: if [ -f /etc/docker/daemon.json ]; then
19:     echo "Sichere bestehende daemon.json..."
20:     sudo mv /etc/docker/daemon.json /etc/docker/daemon.json.backup.$(date +%Y%m%d_%H%M%S)
21: fi
22: # Schritt 4: Systemd neu laden und Docker starten
23: echo "Lade Systemd Konfiguration neu..."
24: sudo systemctl daemon-reload
25: echo "Starte Docker Service..."
26: sudo systemctl start docker
27: # Schritt 5: Status prüfen
28: echo -e "\nPrüfe Docker Status..."
29: sudo systemctl status docker --no-pager -l
30: echo -e "\nPrüfe Port 2375..."
31: sleep 3
32: sudo netstat -tlnp | grep :2375 || echo "❌ Port 2375 ist immer noch nicht verfügbar!"
33: echo -e "\nTeste Docker API..."
34: if curl -s http://localhost:2375/version > /dev/null 2>&1; then
35:     echo "✅ Docker API funktioniert!"
36:     curl -s http://localhost:2375/version | head -5
37: else
38:     echo "❌ Docker API Test fehlgeschlagen!"
39:     echo "Docker Logs:"
40:     sudo journalctl -u docker.service --no-pager -n 10
41: fi
</file>

