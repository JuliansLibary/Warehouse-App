666: /**
667:  *
668:  * @param {int} index
669:  * @param {json} originalLine
670:  * @param {json} newArray
671:  */
672: function findIndexForAllocation(index, originalLine, newArray) {
673:   if (Array.isArray(originalLine.BatchNumbers) && originalLine.BatchNumbers.length > 0) {
674:     const batchToFind = originalLine.BatchNumbers[index]?.BatchNumber;
675:     return newArray.findIndex((batch) => batch.BatchNumber === batchToFind);
676:   } else if (Array.isArray(originalLine.SerialNumbers) && originalLine.SerialNumbers.length > 0) {
677:     const serialToFind = originalLine.SerialNumbers[index]?.InternalSerialNumber;
678:     return newArray.findIndex((serial) => serial.InternalSerialNumber === serialToFind);
679:   }
680:   return -1; // Return -1 if no match is found or if the arrays are empty
681: }
682: /**
683:  * Sorts the picklistlines according to a global configuraration.
684:  * The configuration is set globally at config.json Parameter sortBy
685:  * @param {json} picklist
686:  * @param {string} sortBy
687:  */
688: function sortForResponse(picklist, sortBy) {
689:   return new Promise((resolve, reject) => {
690:     try {
691:       switch (sortBy) {
692:         case "AlternativeSortCodeAndBinLocation":
693:           picklist.PickListsLines.sort((a, b) => {
694:             if (a.AltSortCode && b.AltSortCode && a.BinLocation && b.BinLocation) {
695:               if (a.AltSortCode === b.AltSortCode) {
696:                 return a.BinLocation.localeCompare(b.BinLocation);
697:               }
698:               return a.AltSortCode.localeCompare(b.AltSortCode);
699:             }
700:             return 0;
701:           });
702:           break;
703:         case "AlternativeSortCode":
704:           picklist.PickListsLines.sort((a, b) => {
705:             if (a.AltSortCode && b.AltSortCode) {
706:               return parseInt(a.AltSortCode) - parseInt(b.AltSortCode);
707:             }
708:             return 0;
709:           });
710:           break;
711:         case "Orders":
712:           picklist.PickListsLines.sort((a, b) => {
713:             if (a.OrderEntry && b.OrderEntry) {
714:               return a.OrderEntry.localeCompare(b.OrderEntry);
715:             }
716:             return 0;
717:           });
718:           break;
719:         case "BinLocation":
720:           picklist.PickListsLines.sort((a, b) => {
721:             if (a.BinLocation && b.BinLocation) {
722:               return a.BinLocation.localeCompare(b.BinLocation);
723:             }
724:             return 0;
725:           });
726:           break;
727:         case "ShipDate":
728:           picklist.PickListsLines.sort((a, b) => {
729:             if (a.ShipDate && b.ShipDate) {
730:               return new Date(a.ShipDate) - new Date(b.ShipDate);
731:             }
732:             return 0;
733:           });
734:           break;
735:         default:
736:           // Fallback case: No sorting applied
737:           break;
738:       }
739:       resolve(picklist);
740:     } catch (error) {
741:       reject(error);
742:     }
743:   });
744: }
