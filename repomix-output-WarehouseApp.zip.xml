 1: //worker.js
 2: var content,
 3:   tenantId,
 4:   userId,
 5:   AbsEntry,
 6:   xmlHttp = new XMLHttpRequest();
 7: const result = "";
 8: onmessage = function (event) {
 9:   content = event.data;
10:   tenantId = event.data.tenantId;
11:   userId = event.data.userId;
12:   AbsEntry = event.data.AbsEntry;
13:   return new Promise(function (resolve, reject) {
14:     resolve(checkSaveState());
15:   })
16:     .then((responseCheck) => {
17:       if (responseCheck === 202) {
18:         postMessage(responseCheck);
19:       }else if (responseCheck === 209) {
20:         return postContent();
21:       }
22:       else{
23:         return patchContent(responseCheck);
24:       }
25:     }).catch()
26: };
27: async function checkSaveState() {
28:   return await _checkSaveState();
29: }
30: async function _checkSaveState() {
31:   return new Promise(function (resolve, reject) {
32:     xmlHttp.open("GET", "cachelogic/checkCache/" + AbsEntry + "/InventoryTransfer/" + tenantId);
33:     xmlHttp.withCredentials = true;
34:     xmlHttp.onreadystatechange = function () {
35:       if (xmlHttp.readyState == 4 && xmlHttp.status == 209) {
36:         resolve(xmlHttp.status);
37:       } else if (xmlHttp.readyState == 4 && xmlHttp.status == 200 && xmlHttp.response) {
38:         resolve(xmlHttp.response);
39:       }else if(xmlHttp.readyState == 4 && xmlHttp.status == 202){
40:         resolve(xmlHttp.status);
41:       }else if (xmlHttp.readyState === 4 && xmlHttp.status !== 209 && xmlHttp.status !== 200 && xmlHttp.status !== 202) {
42:         reject(xmlHttp.status);
43:       }
44:     };
45:     xmlHttp.onerror = function () {
46:       reject(Error("Network Error"));
47:     };
48:     xmlHttp.send();
49:   });
50: }
51: async function postContent() {
52:   // Do the usual XHR stuff
53:   xmlHttp.open("POST", "cachelogic/saveCache", false);
54:   xmlHttp.setRequestHeader("Content-type", "application/json");
55:   xmlHttp.onreadystatechange = function () {
56:     if (xmlHttp.readyState == 4 && xmlHttp.status == 200) {
57:       postMessage("true");
58:     }
59:   };
60:   // Handle network errors
61:   xmlHttp.onerror = function () {
62:     reject(Error("Network Error"));
63:   };
64:   // Make the request
65:   xmlHttp.send(
66:     JSON.stringify({
67:       documentNumber: AbsEntry,
68:       module: "InventoryTransfer",
69:       documentType: "Kundenauftrag",
70:       content: JSON.stringify(content),
71:       tenantId: tenantId,
72:       isDeleted: false,
73:       createDate: new Date(Date.now()).toISOString(),
74:       updateDate: new Date(Date.now()).toISOString(),
75:       updatedByUser: userId,
76:       createdByUser: userId,
77:       remark: "",
78:     })
79:   );
80: }
81: async function patchContent(responseCheck) {
82:   try {
83:     xmlHttp.open("POST", "cachelogic/patchCache/" + JSON.parse(responseCheck).id, false);
84:     xmlHttp.setRequestHeader("Content-type", "application/json");
85:     xmlHttp.onreadystatechange = function () {
86:       if (xmlHttp.readyState == 4 && xmlHttp.status == 200) {
87:         postMessage("true");
88:       } else if (xmlHttp.readyState == 4 && xmlHttp.status == 209) {
89:         postMessage("true");
90:       }else if (xmlHttp.readyState == 4 && xmlHttp.status !== 209 && xmlHttp.status !== 200) {
91:         postMessage("false");
92:       }
93:     };
94:     xmlHttp.send(JSON.stringify({ content: JSON.stringify(content), updateDate: new Date(Date.now()).toISOString(), updatedByUser: userId, remark: ""}));
95:   } catch (error) {
96:     postMessage("false");
97:   }
98: }
