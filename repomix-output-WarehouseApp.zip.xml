<file path="WarehouseApp/nAG.Warehouse.App.Pack/webapp/view/serialNumberFinderDialog.fragment.xml">
  1: <core:FragmentDefinition
  2:     xmlns="sap.m"
  3:     xmlns:core="sap.ui.core"
  4: >
  5:     <Dialog
  6:         id="idSerialNumberFinderDialog"
  7:         stretch="true"
  8:         contentWidth="100%"
  9:         contentHeight="100%"
 10:         draggable="false"
 11:         resizable="false"
 12:         class="refactoredDialog"
 13:         escapeHandler=".onEscape"
 14:     >
 15:         <customHeader>
 16:             <Bar class="refactoredDialogHeader">
 17:                 <contentLeft>
 18:                     <Title
 19:                         text="{finderModel>/itemDescription}"
 20:                         class="refactoredDetailTitle"
 21:                     />
 22:                 </contentLeft>
 23:             </Bar>
 24:         </customHeader>
 25:         <content>
 26:             <Page
 27:                 showHeader="false"
 28:                 class="refactoredPage"
 29:             >
 30:                 <!-- Sticky Search -->
 31:                 <Panel class="refactoredSearchPanel">
 32:                     <content>
 33:                         <VBox>
 34:                             <SearchField
 35:                                 id="idSearchValueSearchField"
 36:                                 value="{finderModel>/searchValue}"
 37:                                 search="onSearchValueSearchFieldSearch"
 38:                                 liveChange="onSearchValueLiveChange"
 39:                                 width="100%"
 40:                                 placeholder="{i18n>scanOrEnterSerialNumber}"
 41:                                 showSearchButton="true"
 42:                                 class="refactoredSearchField"
 43:                             />
 44:                             <ProgressIndicator
 45:                                 percentValue="{= ${finderModel>/targetQuantity} > 0 ? (${finderModel>/selectedCount} / ${finderModel>/targetQuantity}) * 100 : 0}"
 46:                                 displayValue="{finderModel>/selectedCount} / {finderModel>/targetQuantity}"
 47:                                 width="100%"
 48:                                 class="sapUiTinyMarginTop"
 49:                                 showValue="true"
 50:                                 state="{= ${finderModel>/selectedCount} >= ${finderModel>/targetQuantity} ? 'Success' : 'None'}"
 51:                             />
 52:                         </VBox>
 53:                     </content>
 54:                 </Panel>
 55:                 <Panel class="refactoredPanel">
 56:                     <headerToolbar>
 57:                         <Toolbar class="refactoredTableToolbar">
 58:                             <Title
 59:                                 text="{i18n>availableSerialNumbers} ({= ${finderModel>/availableSerials}.length})"
 60:                                 class="smallMarginLeft"
 61:                             />
 62:                             <ToolbarSpacer />
 63:                         </Toolbar>
 64:                     </headerToolbar>
 65:                     <content>
 66:                         <Table
 67:                             id="idAvailableSerialsTable"
 68:                             mode="MultiSelect"
