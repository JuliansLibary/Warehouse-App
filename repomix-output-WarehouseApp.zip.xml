 773:           MessageBox.error(errorText, {
 774:             actions: [MessageBox.Action.OK],
 775:             emphasizedAction: MessageBox.Action.OK,
 776:             onClose: () => {
 777:               switch (error) {
 778:                 case 400: // Invalid content or other error
 779:                 case 401: // Current user and database user don't match
 780:                 case 404: // No document lock found
 781:                 case 522: // Lock timeout
 782:                 default:
