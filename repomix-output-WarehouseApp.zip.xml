151:  * @param {Array} params - Parameters for placeholder replacement
152:  * @returns {string} Translated text
153:  */
154: function getText(key, language = 'de_DE', params = []) {
155:     const translations = loadTranslations(language);
156:     let text = translations[key] || key;
157:     // Replace parameters {0}, {1}, etc.
158:     if (params && params.length > 0) {
159:         params.forEach((param, index) => {
160:             text = text.replace(new RegExp(`\\{${index}\\}`, 'g'), param);
161:         });
162:     }
163:     return text;
164: }
