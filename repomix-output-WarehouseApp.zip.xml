<file path="WarehouseApp/nAG.Warehouse.App.LabelGenerator/middleware/configCheck.js">
 1: let http = require("http");
 2: async function configCheck(req, res, next) {
 3:   try {
 4:     const result = await getConfiguration("LabelGenerator", req.headers.referer);
 5:     if (result === 200) {
 6:       next(); // Proceed to the route handler
 7:     } else if (result === 403 || result === 404 || result === 423) {
 8:       res.sendStatus(result); // Send the appropriate status if configuration fails
 9:     }
10:   } catch (error) {
11:     // Handle any unexpected errors (e.g., if getConfiguration throws an error)
12:     console.error(error);
13:     res.sendStatus(500);
14:   }
15: }
16: function getConfiguration(module, headers) {
17:   return new Promise((resolve, reject) => {
18:     // Extract tenant from headers
19:     const tenant = new URLSearchParams(headers.split("?")[1]).get("Tenant"),
20:           url = `http://Module-AdminPanel.warehouseapp:8005/databaseConfiguration/configurationForModule/${module}/${tenant}`;
21:     if (!tenant) {
22:       return reject(new Error("Tenant not found in headers"));
23:     }
24:     // Construct the URL for fetching configuration
25:     // Make HTTP GET request to fetch configuration
26:     http
27:       .get(url, (response) => {
28:         let rawData = "";
29:         // Collect data chunks
30:         response.on("data", (chunk) => {
31:           rawData += chunk;
32:         });
33:         // Process data after the end of the response
34:         response.on("end", () => {
35:           try {
36:             if (response.statusCode === 423) {
37:               return resolve(response.statusCode);
38:             }
39:             // Parse JSON response
40:             const parsedData = JSON.parse(rawData);
41:             // Update global configuration if available
42:             if (parsedData.conf_config && parsedData.conf_config !== "{}") {
43:               const config = JSON.parse(parsedData.conf_config.replace(/\\/g, ""));
44:               Object.entries(config).forEach(([key, value]) => {
45:                 global.gConfig[key] = value;
46:               });
47:             }
48:             resolve(response.statusCode);
49:           } catch (e) {
50:             reject(new Error(`Failed to parse configuration data: ${e.message}`));
51:           }
52:         });
53:       })
54:       .on("error", (e) => {
55:         reject(new Error(`Request error: ${e.message}`));
56:       });
57:   });
58: }
59: module.exports = configCheck;
</file>

