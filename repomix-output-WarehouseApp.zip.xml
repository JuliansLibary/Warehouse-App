1095:     _interpretCode: function (scannedObject) {
1096:       let found = false,
1097:         checkGs1Visibility = false;
1098:       // Verarbeitung von QR-Code
1099:       if (scannedObject.Type === "nAG QR-Code") {
1100:         this._interpretQRCode(scannedObject);
1101:         return;
1102:       }
1103:       // Verarbeitung von GS1, wenn der Batch-Dialog bereits geöffnet ist
1104:       if (scannedObject.Type === "GS1" && this._oBatchDialog && Fragment.byId("batchDialog", "inpBatchNumber").getVisible()) {
1105:         Fragment.byId("batchDialog", "inpBatchDate").setDateValue(new Date(scannedObject.MHD));
1106:         Fragment.byId("batchDialog", "PickedQuantity").setValue(scannedObject.Quantity);
1107:         Fragment.byId("batchDialog", "inpBatchNumber").setValue(scannedObject.BatchNumbers);
1108:         checkGs1Visibility = true;
1109:       }
1110:       // Verarbeitung von ItemCode oder GS1, wenn nicht sichtbar
1111:       if (scannedObject.Type === "ItemCode" || !checkGs1Visibility) {
1112:         const documentLines = this.getModel("purchaseOrderModel").getData().DocumentLines;
1113:         for (let i = 0; i < documentLines.length; i++) {
1114:           const itemBarcodes = documentLines[i].ItemBarCodeCollection;
1115:           for (let k = 0; k < itemBarcodes.length; k++) {
1116:             if (itemBarcodes[k].Barcode === scannedObject.ItemCode && parseInt(documentLines[i].RemainingOpenQuantity) > 0) {
1117:               const context = new sap.ui.model.Context(this.getModel("purchaseOrderModel"), `/DocumentLines/${i}`),
1118:                 object = context.getObject();
1119:               if (object.ManageSerialNumbers === "tYES") {
1120:                 this._getSerialNumbers(context);
1121:                 found = true;
1122:               } else if (object.ManageBatchNumbers === "tYES" && !checkGs1Visibility) {
1123:                 this._getBatchNumbers(context, i);
1124:                 found = true;
1125:               } else {
1126:                 object.Quantity >= 1 ? this._openQuantityDialog(context) : this._upByOne(context);
1127:                 found = true;
1128:               }
1129:               break;
1130:             }
1131:           }
1132:           if (found) {
1133:             this._playAudio("Audio/Beep.wav");
1134:             this._focusPickedLine();
1135:             break;
1136:           }
1137:         }
1138:         if (!found) {
1139:           this._playAudio("Audio/Error.wav");
1140:           this.showError("scanItemError", this.getMessage("itemNotFoundDetail"), "418");
1141:         }
1142:       }
1143:     },
