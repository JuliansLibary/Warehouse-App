<file path="WarehouseApp/nAG.Warehouse.App.AdminPanel/webapp/model/formatter.js">
  1: sap.ui.define([
  2: 	"sap/ui/model/type/Currency",
  3: 	"sap/ui/Device"
  4: ], function (Currency, Device) {
  5: 	"use strict";
  6: 	return {
  7: 		/**
  8: 		 * Rounds the currency value to 2 digits
  9: 		 *
 10: 		 * @public
 11: 		 * @param {string} sValue value to be formatted
 12: 		 * @returns {string} formatted currency value with 2 digits
 13: 		 */
 14: 		currencyValue: function (sValue) {
 15: 			if (!sValue) {
 16: 				return "";
 17: 			}
 18: 			return parseFloat(sValue).toFixed(2);
 19: 		},
 20: 		/**
 21: 		 * Rounds the currency value to 2 digits
 22: 		 *
 23: 		 * @public
 24: 		 * @param {number} iQuantity product quantity
 25: 		 * @param {number} fPrice product price
 26: 		 * @param {string} sCurrencyCode currency code for the price
 27: 		 * @returns {string} formatted currency value with 2 digits
 28: 		 */
 29: 		calculateItemTotal: function (iQuantity, fPrice, sCurrencyCode) {
 30: 			var oCurrency = new Currency({
 31: 					showMeasure: false
 32: 				}),
 33: 				fTotal = iQuantity * fPrice;
 34: 			return oCurrency.formatValue([fTotal.toFixed(2), sCurrencyCode], "string");
 35: 		},
 36: 		/**
 37: 		 * Converts a binary string into an image format suitable for the src attribute
 38: 		 *
 39: 		 * @public
 40: 		 * @param {string} vData a binary string representing the image data
 41: 		 * @returns {string} formatted string with image metadata based on the input or a default image when the input is empty
 42: 		 */
 43: 		handleBinaryContent: function (vData) {
 44: 			if (vData) {
 45: 				var sMetaData1 = "data:image/jpeg;base64,",
 46: 					sMetaData2 = vData.substr(104); // stripping the first 104 bytes from the binary data when using base64 encoding.
 47: 				return sMetaData1 + sMetaData2;
 48: 			} else {
 49: 				return "../images/Employee.png";
 50: 			}
 51: 		},
 52: 		localDate: function (date) {
 53: 			var options = {
 54: 					day: "2-digit",
 55: 					month: "2-digit",
 56: 					year: "numeric"
 57: 				},
 58: 				parts,
 59: 				datestring;
 60: 			if (date !== null && typeof date === "string" && date.includes(".")) {
 61: 				parts = date.split(".");
 62: 				datestring = new Date(parseInt(parts[2], 10),
 63: 					parseInt(parts[1], 10) - 1,
 64: 					parseInt(parts[0], 10));
 65: 				return datestring.toLocaleDateString(navigator.language, options);
 66: 			}
 67: 			if (date !== null && typeof date === "string" && date.includes("-")) {
 68: 				parts = date.split("-");
 69: 				datestring = new Date(parseInt(parts[0], 10),
 70: 					parseInt(parts[1], 10) - 1,
 71: 					parseInt(parts[2], 10));
 72: 				return datestring.toLocaleDateString(navigator.language, options);
 73: 			} else
 74: 			if (date !== null && typeof date === "number") {
 75: 				var datenumber = new Date(date);
 76: 				return datenumber.toLocaleDateString(navigator.language, options);
 77: 			} else {
 78: 				return date;
 79: 			}
 80: 		},
 81: 		pickStatus: function (status) {
 82: 			switch (status) {
 83: 			case "P":
 84: 				return sap.ui.getCore().getModel("i18n").getResourceBundle().getText("partlyPicked");
 85: 			case "R":
 86: 				return sap.ui.getCore().getModel("i18n").getResourceBundle().getText("released");
 87: 			case "Y":
 88: 				return sap.ui.getCore().getModel("i18n").getResourceBundle().getText("picked");
 89: 			case "D":
 90: 				return sap.ui.getCore().getModel("i18n").getResourceBundle().getText("partlyDelivered");
 91: 			case "ps_Picked":
 92: 				return sap.ui.getCore().getModel("i18n").getResourceBundle().getText("partlyPicked");
 93: 			case "ps_Released":
 94: 				return sap.ui.getCore().getModel("i18n").getResourceBundle().getText("released");
 95: 			case "ps_PartiallyDelivered":
 96: 				return sap.ui.getCore().getModel("i18n").getResourceBundle().getText("partlyDelivered");
 97: 			default:
 98: 				return sap.ui.getCore().getModel("i18n").getResourceBundle().getText("picked");
 99: 			}
100: 		},
101: 		pickState: function (status) {
102: 			switch (status) {
103: 			case "P":
104: 				return sap.ui.core.ValueState.Warning;
105: 			case "R":
106: 				return sap.ui.core.ValueState.Error;
107: 			case "Y":
108: 				return sap.ui.core.ValueState.Success;
109: 			case "D":
110: 				return sap.ui.core.ValueState.Warning;
111: 			case "ps_Picked":
112: 				return sap.ui.core.ValueState.Warning;
113: 			case "ps_Released":
114: 				return sap.ui.core.ValueState.Error;
115: 			case "ps_PartiallyDelivered":
116: 				return sap.ui.core.ValueState.Warning;
117: 			default:
118: 				return sap.ui.core.ValueState.Success;
119: 			}
120: 		},
121: 		serialNumText: function (statusSerial, statusBatch) {
122: 			if (statusSerial === 'Y') {
123: 				return sap.ui.getCore().getModel("i18n").getResourceBundle().getText("serialNumberRequired");
124: 			} else if (statusBatch === 'Y') {
125: 				return sap.ui.getCore().getModel("i18n").getResourceBundle().getText("batchNumberRequired");
126: 			} else {
127: 				return "";
128: 				//return sap.ui.getCore().getModel("i18n").getResourceBundle().getText("noNumberRequired");
129: 			}
130: 		},
131: 		serialNumState: function (statusSerial, statusBatch) {
132: 			if (statusSerial === 'Y') {
133: 				return "Error";
134: 			} else if (statusBatch === 'Y') {
135: 				return "Warning";
136: 			} else {
137: 				return "Success";
138: 			}
139: 		},
140: 		selectQuantity: function (onHandQty, Quantity, CommitQty) {
141: 			if (onHandQty !== null) {
142: 				return onHandQty;
143: 			} else {
144: 				return Quantity - CommitQty;
145: 			}
146: 		},
147: 		// Check which Module is clicked
148: 		checkVisibleState: function (oInput) {
149: 			if (oInput === "Kommissionieren") {
150: 			  return false;
151: 			} else {
152: 			  return true;
153: 			}
154: 		  },
155: 	};
156: });
