 86:       return res.status(400).send({
 87:         isValid: false,
 88:         message: "Mindestens eine Seriennummer muss ausgewählt werden",
 89:         error: "NO_SERIALS_SELECTED"
 90:       });
 91:     }
 92:     if (selectedSerials.length === 0) {
 93:       return res.status(400).send({
 94:         isValid: false,
 95:         message: "Mindestens eine Seriennummer muss ausgewählt werden",
 96:         error: "NO_SERIALS_SELECTED"
 97:       });
 98:     }
 99:     // Validate that selected serials are available
100:     const availableSerialNumbers = dialogData.availableSerials.map(s => s.InternalSerialNumber);
101:     const invalidSerials = selectedSerials.filter(serial => !availableSerialNumbers.includes(serial));
102:     if (invalidSerials.length > 0) {
103:       return res.status(400).send({
104:         isValid: false,
105:         message: `Ungültige Seriennummern: ${invalidSerials.join(', ')}`,
106:         error: "INVALID_SERIALS",
107:         invalidSerials
108:       });
109:     }
110:     // Check for duplicates in selection
111:     const duplicates = selectedSerials.filter((serial, index) => selectedSerials.indexOf(serial) !== index);
112:     if (duplicates.length > 0) {
113:       return res.status(400).send({
114:         isValid: false,
115:         message: `Doppelte Seriennummern: ${duplicates.join(', ')}`,
116:         error: "DUPLICATE_SERIALS",
117:         duplicates
118:       });
119:     }
120:     res.send({
121:       isValid: true,
122:       selectedCount: selectedSerials.length,
123:       validatedSerials: selectedSerials,
124:       message: `${selectedSerials.length} Seriennummer(n) ausgewählt`
125:     });
126:   } catch (error) {
127:     res.status(500).send({
128:       message: "Error validating serial number selection",
129:       code: 500,
130:       error: error.message
131:     });
132:   }
133: }
134: /**
135:  * Prepare data for batch number dialog
136:  * @param {Object} req - Express request object
137:  * @param {Object} res - Express response object
138:  */
139: async function prepareBatchNumberDialog(req, res) {
140:   try {
141:     const { itemData, requestedQuantity } = req.body;
142:     if (!itemData || !itemData.ItemCode) {
143:       return res.status(400).send({
144:         message: "Item data with ItemCode is required",
145:         code: 400
146:       });
147:     }
148:     let availableBatches = [];
149:     // Extract available batches from DocumentLinesBinAllocations
150:     if (itemData.DocumentLinesBinAllocations && Array.isArray(itemData.DocumentLinesBinAllocations)) {
151:       itemData.DocumentLinesBinAllocations.forEach(allocation => {
152:         if (allocation.SerialAndBatchNumbersBaseLine && Array.isArray(allocation.SerialAndBatchNumbersBaseLine)) {
153:           allocation.SerialAndBatchNumbersBaseLine.forEach(batch => {
154:             if (batch.BatchNumber && batch.Quantity > 0) {
155:               const existingBatch = availableBatches.find(b => b.BatchNumber === batch.BatchNumber);
156:               if (existingBatch) {
157:                 existingBatch.Quantity += batch.Quantity;
158:               } else {
159:                 availableBatches.push({
160:                   BatchNumber: batch.BatchNumber,
161:                   Quantity: batch.Quantity,
162:                   ExpiryDate: batch.ExpiryDate,
163:                   ManufacturingDate: batch.ManufacturingDate,
164:                   AdmissionDate: batch.AdmissionDate,
165:                   Location: batch.Location,
166:                   BaseLineID: allocation.BaseLineID,
167:                   BinAbsEntry: allocation.BinAbsEntry
168:                 });
169:               }
170:             }
171:           });
172:         }
173:       });
174:     }
175:     const dialogData = {
176:       itemData,
177:       availableBatches,
178:       requestedQuantity: requestedQuantity || 1,
179:       itemDescription: itemData.ItemDescription,
180:       itemCode: itemData.ItemCode,
181:       totalAvailableQuantity: availableBatches.reduce((sum, batch) => sum + batch.Quantity, 0)
182:     };
183:     res.send({
184:       dialogData,
185:       isValid: availableBatches.length > 0,
186:       message: availableBatches.length === 0 ? "Keine verfügbaren Chargennummern" : `${availableBatches.length} Charge(n) verfügbar`
187:     });
188:   } catch (error) {
