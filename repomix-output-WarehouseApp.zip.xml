2788:             SysNumber: serial.SysNumber,
2789:             // FIXED: Include InternalSerialNumber for backend processing
2790:             InternalSerialNumber: serial.InternalSerialNumber || serial.ManufacturerSerialNumber || "",
2791:             ManufacturerSerialNumber: serial.ManufacturerSerialNumber || "",
2792:           },
2793:           detailModel: JSON.stringify({
2794:             Package: (that.getModel("deliveryModel").getData().Package || []).map((pkg) => ({
2795:               PackageType: pkg.PackageType,
