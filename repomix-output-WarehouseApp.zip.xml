 910:           requestOptions = {};
 911:     this.getModel("SessionModel")
 912:         .getData()
 913:         .customBatchOperations.forEach((option) => {
 914:             requestOptions[option] = object[option];
 915:         });
 916:     this.makeAjaxRequest("POST", "generateBatchNumber/GenerateBatchNumber/" + this.getUrlVars().Tenant, requestOptions, "generateBatchNumberError", function (response) {
 917:         Fragment.byId("batchDialog", "inpBatchNumber").setValue(object.ItemCode + response.Result);
 918:     });
 919: },
 920: _interpretCode: function (scannedObject) {
 921:   let found = false,
 922:       checkGs1Visibility = false;
 923:   if (scannedObject.Type === "nAG QR-Code") {
 924:       this._interpretQRCode(scannedObject);
 925:       return;
 926:   }
 927:   if (scannedObject.Type === "GS1" && this._oBatchDialog && Fragment.byId("batchDialog", "inpBatchNumber").getVisible() === true) {
 928:       Fragment.byId("batchDialog", "inpBatchDate").setDateValue(new Date(scannedObject.MHD));
 929:       Fragment.byId("batchDialog", "PickedQuantity").setValue(scannedObject.Quantity);
 930:       Fragment.byId("batchDialog", "inpBatchNumber").setValue(scannedObject.BatchNumbers);
 931:       checkGs1Visibility = true;
 932:   }
 933:   if (scannedObject.Type === "ItemCode" || !checkGs1Visibility) {
 934:       const documentLines = this.getModel("purchaseOrderModel").getData().DocumentLines;
 935:       for (let i = 0; i < documentLines.length; i++) {
 936:           for (let k = 0; k < documentLines[i].ItemBarCodeCollection.length; k++) {
 937:               if (documentLines[i].ItemBarCodeCollection[k].Barcode === scannedObject.ItemCode && parseInt(documentLines[i].RemainingOpenQuantity) > 0) {
 938:                   const context = new sap.ui.model.Context(this.getModel("purchaseOrderModel"), "/DocumentLines/" + i);
 939:                   if (context.getObject().ManageSerialNumbers === "tYES") {
 940:                       this._getSerialNumbers(context);
 941:                       found = true;
 942:                       break;
 943:                   } else if (context.getObject().ManageBatchNumbers === "tYES" && !checkGs1Visibility) {
 944:                       this._getBatchNumbers(context, i);
 945:                       found = true;
 946:                       break;
 947:                   } else {
 948:                       if (context.getObject().Quantity >= 1) {
 949:                           this._openQuantityDialog(context);
 950:                       } else {
 951:                           this._upByOne(context);
 952:                       }
 953:                       found = true;
 954:                       break;
 955:                   }
 956:               }
 957:           }
 958:           if (found) {
 959:               const audio = new Audio("Audio/Beep.wav");
 960:               audio.oncanplaythrough = function () {
 961:                   audio.play();
 962:               };
 963:               this._focusPickedLine();
 964:               break;
 965:           }
 966:       }
 967:       if (!found) {
 968:           const audio = new Audio("Audio/Error.wav");
 969:           audio.oncanplaythrough = function () {
 970:               audio.play();
 971:           };
 972:           this.showError("scanItemError", this.getMessage("itemNotFoundDetail"), "418");
 973:       }
 974:   }
 975: },
 976: _focusPickedLine: function () {
 977:   let columnState = false;
 978:   Fragment.byId("ScanDialog", "packItems").getItems().forEach(function (item) {
 979:       const context = item.getBindingContext("purchaseOrderModel").getObject();
 980:       if (context.openQuantity === context.RemainingOpenQuantity && context.openQuantity > 0) {
 981:           columnState = true;
 982:       } else if (context.openQuantity !== context.RemainingOpenQuantity && context.openQuantity > 0) {
 983:           columnState = false;
 984:       } else {
 985:           columnState = null;
 986:       }
 987:       item.removeStyleClass("fullyPacked");
 988:       item.removeStyleClass("partlyPacked");
 989:       if (columnState) {
