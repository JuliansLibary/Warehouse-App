1373:       const inpBinFrom = Fragment.byId("itemDetailsDialog", "inpBinFrom");
1374:       const inpBinTo = Fragment.byId("itemDetailsDialog", "inpBinTo");
1375:       const inpBatchNumber = Fragment.byId("itemDetailsDialog", "inpBatchNumber");
1376:       const inpQuantity = Fragment.byId("itemDetailsDialog", "PickedQuantity");
1377:       // === Validation ===
1378:       if (inpBinFrom.getVisible() && inpBinFrom.getValueState() !== "Success") return MessageBox.error(this.getModel("i18n").getResourceBundle().getText("inputBinFromValidationFailed"));
1379:       if (inpBinTo.getVisible() && inpBinTo.getValueState() !== "Success") return MessageBox.error(this.getModel("i18n").getResourceBundle().getText("inputBinToValidationFailed"));
1380:       if (inpBatchNumber.getVisible() && inpBatchNumber.getValueState() !== "Success") return MessageBox.error(this.getModel("i18n").getResourceBundle().getText("inputBatchOrSerialValidationFailed"));
1381:       if (parseInt(inpQuantity.getValue()) < 1) return MessageBox.error(this.getModel("i18n").getResourceBundle().getText("inputQuantityValidationFailed"));
1382:       const sPickedQuantity = parseInt(inpQuantity.getValue());
1383:       const sBatchValue = inpBatchNumber.getValue();
1384:       const sBinFrom = this.getModel("SessionModel").getData().inpBinFrom;
1385:       const sBinTo = this.getModel("SessionModel").getData().inpBinTo;
1386:       const isSerial = oObject.ManageSerialNumbers === "tYES";
1387:       const isBatch = oObject.ManageBatchNumbers === "tYES";
1388:       const fromBin = inpBinFrom.getVisible();
1389:       const toBin = inpBinTo.getVisible();
1390:       let iCheckId = oObject.SerialOrBatchModel.length + 1;
1391:       let iIndex = isSerial ? oObject.SerialNumbers.length : isBatch ? oObject.BatchNumbers.length : 0;
1392:       // === Batch handling
1393:       if (isBatch) {
1394:         oObject.BatchNumbers.push({
1395:           Quantity: sPickedQuantity,
1396:           BatchNumber: sBatchValue,
1397:           BaseLineNumber: oObject.LineNum,
1398:           id: iCheckId,
1399:         });
1400:       }
1401:       // === Serial handling
1402:       if (isSerial) {
1403:         oObject.SerialNumbers.push({
1404:           Quantity: 1,
1405:           InternalSerialNumber: sBatchValue,
1406:           id: iCheckId,
1407:           systemSerialNumber: this.getModel("SessionModel").getData().systemSerialNumber,
1408:         });
1409:       }
1410:       // === Always push to SerialOrBatchModel (for UI display)
1411:       oObject.SerialOrBatchModel.push({
1412:         SerialOrBatch: sBatchValue ?? "",
1413:         Quantity: isSerial ? 1 : sPickedQuantity,
1414:         LineIdentifierQuantity: isSerial ? 1 : sPickedQuantity,
1415:         BinEntry: inpBinTo.getValue(),
1416:         BinEntryFrom: inpBinFrom.getValue(),
1417:         id: iCheckId,
1418:         Check: isSerial ? "Serial" : isBatch ? "Batch" : "Bin",
1419:       });
1420:       // === Bin Allocation Logic ===
1421:       const allocationCommon = {
1422:         Quantity: sPickedQuantity,
1423:         BaseLineNumber: oObject.LineNum,
1424:         id: iCheckId,
1425:         SerialAndBatchNumbersBaseLine: iIndex,
1426:         BinLocationTo: inpBinTo.getValue(),
1427:       };
1428:       // 1. Ohne ➜ Mit
1429:       if (!fromBin && toBin) {
1430:         oObject.StockTransferLinesBinAllocations.push({
1431:           BinAbsEntry: sBinTo,
1432:           BinActionType: "batToWarehouse",
1433:           ...allocationCommon,
1434:         });
1435:       }
1436:       // 2. Mit ➜ Ohne
1437:       if (fromBin && !toBin) {
1438:         oObject.StockTransferLinesBinAllocations.push({
1439:           BinAbsEntry: sBinFrom,
1440:           BinActionType: "batFromWarehouse",
1441:           ...allocationCommon,
1442:         });
1443:       }
1444:       // 3. Mit ➜ Mit
1445:       if (fromBin && toBin) {
1446:         oObject.StockTransferLinesBinAllocations.push({
1447:           BinAbsEntry: sBinFrom,
1448:           BinActionType: "batFromWarehouse",
1449:           ...allocationCommon,
1450:         });
1451:         oObject.StockTransferLinesBinAllocations.push({
1452:           BinAbsEntry: sBinTo,
1453:           BinActionType: "batToWarehouse",
1454:           ...allocationCommon,
1455:         });
1456:       }
1457:       // 4. Ohne ➜ Ohne → keine BinAllocations notwendig
1458:       // === Backend Calculation
1459:       this.makeAjaxRequest("POST", "businesslogic/CalculateQuantity", { Quantity: oObject }, function (response) {
1460:         oObject.Quantity = response.Quantity;
1461:         oObject.LineIdentifierQuantity = response.Quantity;
1462:       });
1463:       // === UI
1464:       inpQuantity.setValue(1);
1465:       Fragment.byId("itemDetailsDialog", "btnAddLine").setEnabled(true);
1466:       this._refreshDialog();
1467:       this._updateTotalBookedQuantity();
1468:       Fragment.byId("itemDetailsDialog", "tableFrontend").getBinding("items").refresh();
1469:     },
