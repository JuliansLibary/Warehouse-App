282:           const that = this;
283:           $.ajax({
284:             url: "company/getAppConfig",
285:             crossDomain: true,
286:             type: "GET",
287:             dataType: "json",
288:             success: function (data) {
289:               const pickMode = data.singlePick ? "Single" : "Multi";
290:               const listMode = data.onlyScan ? "Inactive" : "Active";
291:               that.getViewModel("appView").setProperty("/pickMode", pickMode);
292:               that.getViewModel("appView").setProperty("/listMode", listMode);
293:               if (data.launchpad) {
294:                 that.getViewModel("appView").setProperty("/launchpad", data.launchpad);
295:               }
296:               if (typeof data.packlist !== "undefined") {
297:                 that.getViewModel("appView").setProperty("/packlist", data.packlist);
298:               }
299:               if (typeof data.isDeleted !== "undefined") {
300:                 that.getViewModel("appView").setProperty("/isDeleted", data.isDeleted);
301:               }
302:               if (typeof data.saveInterval !== "undefined") {
303:                 that.getViewModel("appView").setProperty("/saveInterval", data.saveInterval);
304:               }
305:               if (typeof data.documentLockTimer !== "undefined") {
306:                 that.getViewModel("appView").setProperty("/documentLockTimer", data.documentLockTimer);
307:               }
308:             },
309:             error: function (jqXHR) {
310:               that.showError(
311:                 "appConfigError",
312:                 jqXHR.responseJSON.error.message.value,
313:                 jqXHR.responseJSON.error.code
314:               );
315:             }
316:           });
317:         }
318:       }
319:     );
320:   }
321: );
