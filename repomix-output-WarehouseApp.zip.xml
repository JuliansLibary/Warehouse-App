341: /**
342:  * Calculate item quantities from delivery data - migrated from Detail.controller.js
343:  * @param {Object} req - Express request object
344:  * @param {Object} res - Express response object
345:  */
346: async function calculateItemQuantities(req, res) {
347:   try {
348:     const { item, deliveryData } = req.body;
349:     const language = getLanguageFromRequest(req);
350:     if (!item || !deliveryData) {
351:       return res.status(400).send(createI18nErrorResponse('itemDataAndDeliveryDataRequired', language, [], 400));
352:     }
353:     let totalPacked = 0;
354:     let totalRequired = parseInt(item.Quantity) || 0;
355:     // Calculate packed quantities from delivery data
356:     if (deliveryData.Package && Array.isArray(deliveryData.Package)) {
357:       deliveryData.Package.forEach((pkg) => {
358:         if (pkg.DeliveryLines && Array.isArray(pkg.DeliveryLines)) {
359:           pkg.DeliveryLines.forEach((deliveryLine) => {
360:             if (isMatchingItem(deliveryLine, item)) {
361:               totalPacked += parseInt(deliveryLine.Quantity) || 0;
362:             }
363:           });
364:         }
365:       });
366:     }
367:     const remaining = Math.max(0, totalRequired - totalPacked);
368:     const progress = totalRequired > 0 ? (totalPacked / totalRequired) * 100 : 0;
369:     res.send({
370:       success: true,
371:       quantities: {
372:         totalPacked: totalPacked,
373:         totalRequired: totalRequired,
374:         remaining: remaining,
375:         progress: Math.round(progress * 100) / 100,
376:         isFullyPacked: remaining === 0,
377:         canPackMore: remaining > 0
378:       },
379:       item: item,
380:       calculatedAt: new Date().toISOString()
381:     });
382:   } catch (error) {
383:     const language = getLanguageFromRequest(req);
384:     res.status(500).send(createI18nErrorResponse('errorCalculatingItemQuantities', language, [], 500, error.message));
385:   }
386: }
387: /**
388:  * Process batch data for items
389:  * @param {Object} req - Express request object
390:  * @param {Object} res - Express response object
391:  */
392: async function processBatchData(req, res) {
393:   try {
394:     const { itemData, batchLine, packageNum } = req.body;
395:     if (batchLine !== null && batchLine !== undefined) {
396:       if (itemData.BatchNumbers && itemData.BatchNumbers[batchLine]) {
397:         const quantityDifference = (itemData.PackedQuantity || 0) - (itemData.PreviouslyPackedQuantity || 0);
398:         itemData.BatchNumbers[batchLine].Quantity = quantityDifference;
399:       }
400:     }
401:     res.send({
402:       updatedItemData: itemData,
403:       batchProcessed: batchLine !== null && batchLine !== undefined,
404:       packageNumber: packageNum
405:     });
406:   } catch (error) {
407:     res.status(500).send({
408:       message: "Error processing batch data",
409:       code: 500,
410:       error: error.message
411:     });
412:   }
413: }
414: // Helper function to check if items match
415: function isMatchingItem(item1, item2) {
416:   return item1.ItemCode === item2.ItemCode &&
417:          item1.WarehouseCode === item2.WarehouseCode &&
418:          item1.AbsoluteEntry === item2.AbsoluteEntry &&
419:          item1.DocNum === item2.DocNum &&
420:          item1.OrderEntry === item2.OrderEntry &&
421:          item1.OrderRowID === item2.OrderRowID;
422: }
423: module.exports = {
424:   calculateRemainingToPack,
425:   validatePackingInput,
426:   processQuantityChange,
427:   createCleanItemClone,
428:   updatePackListLineVisibility,
429:   cleanupEmptyDeliveryLines,
430:   processBatchData,
431:   updatePackListLines,
432:   calculateItemQuantities
433: };
