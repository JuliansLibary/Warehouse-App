 1: module.exports = { getConfiguration };
 2: var http = require("http");
 3: // set Configuration dynamic for each businesslogic Call
 4: async function getConfiguration(module, headers) {
 5:   var tenant;
 6:   return new Promise((resolve, reject) => {
 7:     (headers + "?")
 8:       .split("?")[1]
 9:       .split("&")
10:       .forEach(function (pair) {
11:         pair = (pair + "=").split("=").map(decodeURIComponent);
12:         if (pair[0].length) {
13:           if (pair[0] === "Tenant") {
14:             tenant = pair[1];
15:           }
16:         }
17:       });
18:     http.get(`http://Module-AdminPanel.warehouseapp:8005/databaseConfiguration/configurationForModule/${module}/${tenant}`, function (response) {
19:       let rawData = "";
20:       response.on("data", (chunk) => {
21:         rawData += chunk;
22:       });
23:       response.on("end", () => {
24:         try {
25:           if (response.statusCode === 423) {
26:             resolve(response.statusCode)
27:           }else{
28:           rawData = JSON.parse(rawData);
29:           if (JSON.stringify(rawData.conf_config) !== "{}") {
30:             // TypeOrm is sending a JSON coded with "\"
31:             Object.entries(JSON.parse(rawData.conf_config.replaceAll("\\", ""))).forEach(([key, value]) => {
32:               global.gConfig[key] = value;
33:             });
34:           }
35:           resolve(response.statusCode);
36:         }
37:         } catch (e) {
38:           reject(e);
39:         }
40:       });
41:     });
42:   });
43: }
</file>

