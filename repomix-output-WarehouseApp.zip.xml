112: /**
113:  * Process increase/decrease operations with validation
114:  * @param {Object} req - Express request object
115:  * @param {Object} res - Express response object
116:  */
117: async function processQuantityChange(req, res) {
118:   try {
119:     const { itemData, operation, deliveryData } = req.body; // operation: 'increase' | 'decrease' | 'fill'
120:     let newQuantity = itemData.PackedQuantity || 0;
121:     switch (operation) {
122:       case 'increase':
123:         newQuantity += 1;
124:         break;
125:       case 'decrease':
126:         newQuantity = Math.max(0, newQuantity - 1);
127:         break;
128:       case 'fill':
129:         // Calculate remaining that can be packed
130:         let currentlyPacked = 0;
131:         if (deliveryData && deliveryData.Package) {
132:           deliveryData.Package.forEach(pkg => {
133:             if (pkg.DeliveryLines) {
134:               pkg.DeliveryLines.forEach(line => {
135:                 if (isMatchingItem(line, itemData)) {
136:                   if (itemData.ManageSerialNumbers === "Y") {
137:                     currentlyPacked += (line.SerialNumbers?.length || 0);
138:                   } else {
139:                     currentlyPacked += (line.PackedQuantity || 0);
140:                   }
141:                 }
142:               });
143:             }
144:           });
145:         }
146:         newQuantity = Math.max(0, (itemData.PickedQuantity || 0) - currentlyPacked);
147:         break;
148:       default:
149:         return res.status(400).send({
150:           isValid: false,
151:           error: "INVALID_OPERATION",
152:           message: "Operation must be 'increase', 'decrease', or 'fill'"
153:         });
154:     }
155:     // Validate the new quantity
156:     const validation = await validatePackingInput({
157:       body: { itemData, requestedQuantity: newQuantity, deliveryData }
158:     }, {
159:       send: (data) => data
160:     });
161:     if (!validation.isValid) {
162:       return res.send({
163:         isValid: false,
164:         originalQuantity: itemData.PackedQuantity,
165:         error: validation.error,
166:         message: validation.message
167:       });
168:     }
169:     res.send({
170:       isValid: true,
171:       newQuantity,
172:       operation,
173:       message: `Quantity ${operation} successful`
174:     });
175:   } catch (error) {
176:     res.status(500).send({
177:       message: "Error processing quantity change",
178:       code: 500,
179:       error: error.message
180:     });
181:   }
182: }
