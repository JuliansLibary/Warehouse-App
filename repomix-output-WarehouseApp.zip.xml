 625:     _singlePick: function (object, fromBatch) {
 626:       const inputItem = this.getModel("itemCodeCheck");
 627:       // Wenn ein gültiges Input-Item mit Quantity vorhanden ist
 628:       if (inputItem?.Quantity) {
 629:         const manageBatchNumbers = object.ManageBatchNumbers === "tYES";
 630:         const manageSerialNumbers = object.ManageSerialNumbers === "tNO";
 631:         const calc = parseFloat(object.PickedQuantity) + parseFloat(inputItem.Quantity);
 632:         if (
 633:           (!manageBatchNumbers && manageSerialNumbers && inputItem.Quantity) ||
 634:           (manageBatchNumbers && inputItem.Quantity)
 635:         ) {
 636:           if (object.PickedQuantity < object.PicklistQuantity && calc <= object.PicklistQuantity) {
 637:             object.PickedQuantity = calc;
 638:             this.switchFocus();
 639:           } else {
 640:             this.showError(
 641:               "offene Menge wird überschritten!",
 642:               "Die Menge des gescannten GS1 Codes übersteigt die offene Menge! Bitte einzelnen scannen",
 643:               5002
 644:             );
 645:             return;
 646:           }
 647:           if (fromBatch) {
 648:             // Logik für Batch-Handling (auskommentiert, falls benötigt)
 649:             /*
 650:             object.BatchNumbers.forEach((batchNumber) => {
 651:               if (batchNumber.checkQuantity && batchNumber.maxQuantity >= parseFloat(inputItem.Quantity)) {
 652:                 batchNumber.Quantity = parseFloat(inputItem.Quantity);
 653:                 batchNumber.checkQuantity = false;
 654:               }
 655:             });
 656:             */
 657:           } else {
 658:             object.DocumentLinesBinAllocations?.forEach((allocation) => {
 659:               if (allocation.checkQuantity) {
 660:                 allocation.Quantity = parseFloat(inputItem.Quantity);
 661:                 allocation.checkQuantity = false;
 662:               }
 663:             });
 664:           }
 665:         }
 666:       } else {
 667:         if (object.PickedQuantity < object.PicklistQuantity) {
 668:           const remainingQuantity = object.PicklistQuantity - object.PickedQuantity;
 669:           object.PickedQuantity += remainingQuantity >= 1 ? 1 : remainingQuantity;
 670:           this.switchFocus();
 671:         }
 672:         // Logik für Batch-Handling (auskommentiert, falls benötigt)
 673:         /*
 674:         object.BatchNumbers?.forEach((batchNumber) => {
 675:           if (batchNumber.checkQuantity) {
 676:             batchNumber.Quantity = 1;
 677:             batchNumber.checkQuantity = false;
 678:           }
 679:         });
 680:         */
 681:         object.DocumentLinesBinAllocations?.forEach((allocation) => {
 682:           if (allocation.checkQuantity) {
 683:             allocation.Quantity = 1;
 684:             allocation.checkQuantity = false;
 685:           }
 686:         });
 687:       }
 688:       // Aktualisierung und weitere Aktionen
 689:       sap.ui.getCore().getModel("PickListDetailModel").refresh(true);
 690:       this._focusPickedLine(object);
 691:       this._checkButtonState();
 692:       this.oEventBus.publish("nAG", "hideBusyDialog");
 693:     },
