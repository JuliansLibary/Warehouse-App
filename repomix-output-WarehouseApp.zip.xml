211: // Create a QR code with nAG Content
212: async function getQR(content, callback) {
213:   console.log("Generating QR code for content:", JSON.stringify(content, null, 2));
214:   bwipjs.toBuffer(
215:     {
216:       bcid: "qrcode",
217:       text: JSON.stringify(content),
218:       scale: 3,  // Reduce scale for better compatibility
219:       includetext: false,
220:       backgroundcolor: "ffffff", // White background
221:       color: "000000" // Black foreground
222:     },
223:     (error, buffer) => {
224:       if (error) {
225:         console.error("QR generation error:", error);
226:         callback(error);
227:       } else {
228:         const base64Data = `data:image/png;base64,${buffer.toString("base64")}`;
229:         console.log("QR code generated successfully, base64 length:", base64Data.length);
230:         callback(null, base64Data);
231:       }
232:     }
233:   );
234: }
235: /* Dynamic Method to get Custom Label Information
236:  * The select must be set in the Config on Entity "LabelQuery"
237:  */
238: function getInformationLabel(itemcode, url, cookie, tenant) {
239:   return new Promise((resolve, reject) => {
240:     getInstance()
241:       .then(async (instance) => {
242:         return SL.GET(
243:           `Items('${itemcode}')?$select=${url}`,
244:           null,
245:           await generateBasicAuth(cookie, tenant),
246:           {
247:             retryTimes: 2,
248:             retryDelay: 750,
249:             SLURL: instance.SLURL,
250:             SLPort: instance.SLPort,
251:           },
252:           (error, resp) => {
253:             if (error) {
254:               getError(error).then(reject);
255:             } else {
256:               resolve(resp);
257:             }
258:           }
259:         );
260:       })
261:       .catch(reject);
262:   });
263: }
264: function getInformationFromSQLQuery(itemObject, querys, cookie, tenant) {
265:   return new Promise((resolve, reject) => {
266:     // woher kommt der tenant?
267:     _getInformationFromSQLQuery(itemObject, querys, cookie, tenant, async function (error, resp) {
268:       if (error) {
269:         reject(error);
270:       } else {
271:         resolve(resp);
272:       }
273:     });
274:   });
275: }
276: /* Dynamic Method to get Custom Label Information from SQL Query
277:  * At the Layout the SQL Query Name, Parameters and the Print Mode is stored
278:   Example:
279:     <h3  sqlQuery="GetPackageFromSerialNumber" attributes="ItemCode,SerialNumber" mode="QR">{CustomLabelContent}</h3>
280:  */ async function _getInformationFromSQLQuery(itemObject, queries, cookie, tenant, callback) {
281:   const returnModel = [];
282:   try {
283:     for (const queryLine of queries) {
284:       if (typeof queryLine.SQLQuery !== "undefined") {
285:         let queryURL = `SQLQueries('${queryLine.SQLQuery}')/List?`;
286:         const parameterList = queryLine.atributes.split(",");
287:         parameterList.forEach((parameter, index) => {
288:           if (itemObject.hasOwnProperty(parameter) && itemObject[parameter] !== null) {
289:             if (index >= 1) {
290:               queryURL += "&";
291:             }
292:             queryURL += `${parameter}='${itemObject[parameter]}'`;
293:           }
294:         });
295:         const valueFromServiceLayer = await getSQLQueryContent(queryURL, cookie, tenant);
296:         returnModel.push({
297:           Value: valueFromServiceLayer,
298:           Mode: queryLine.Mode,
299:           SQLQuery: queryLine.SQLQuery,
300:         });
301:       }
302:     }
303:     callback(null, returnModel);
304:   } catch (error) {
305:     callback(error);
306:   }
307: }
308: module.exports = {
309:   _createLabelfrominput,
310: };
</file>

