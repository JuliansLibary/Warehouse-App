  1: sap.ui.define(["sap/ui/core/mvc/Controller"], function (Controller) {
  2:   "use strict";
  3:   return Controller.extend("nAG.PurchaseDeliveryNote.BaseController", {
  4:     /**
  5:      * Convenience method for saving the BaseController in a global variable and creating fields that need to be accessed
  6:      * @public
  7:      */
  8:     register: function () {
  9:       this.oEventBus = sap.ui.getCore().getEventBus();
 10:       sap.ui.getCore().control = this; // Avoiding global jQuery
 11:       // Subscribe to events
 12:       this.oEventBus.subscribe(
 13:         "nAG",
 14:         "showBusyDialog",
 15:         this.showBusyDialog,
 16:         this
 17:       );
 18:       this.oEventBus.subscribe(
 19:         "nAG",
 20:         "hideBusyDialog",
 21:         this.hideBusyDialog,
 22:         this
 23:       );
 24:       this.oEventBus.subscribe(
 25:         "nAG",
 26:         "changeAppView",
 27:         this.changeAppViewLayout,
 28:         this
 29:       );
 30:       this.oEventBus.subscribe("nAG", "getAppView", this.getViewElement, this);
 31:     },
 32:     /**
 33:      *
 34:      * @param {String} method: Can be at nAG: POST,PATCH,GET
 35:      * @param {String} url:  url for the ajax Call
 36:      * @param {JSON} postContent : JSON Body for a patch/post
 37:      * @param {String} i18n : String for a call of the error dialogue via i18n
 38:      * @param {JSON} callback :  Returns a JSON after a successful Ajax call. Can be further used in the frontend
 39:      * NOTE: No IF is needed to build the postContent dynamically for the AJAX. With a GET, the postContent is not transferred to the backend.
 40:      */
 41:     makeAjaxRequest: function (method, url, postContent, i18n, callback) {
 42:       const that = this;
 43:       $.ajax({
 44:         url: url,
 45:         xhrFields: {
 46:           withCredentials: true,
 47:         },
 48:         data: postContent,
 49:         crossDomain: true,
 50:         type: method,
 51:         tryCount: 0,
 52:         retryLimit: 3,
 53:         headers: {
 54:           prefer: "odata.maxpagesize=0",
 55:         },
 56:         success: function (response) {
 57:           callback(response);
 58:         },
 59:         error: function (jqXHR, textStatus) {
 60:           const Language = that.getUrlVars().Language;
 61:           if (textStatus === "timeout") {
 62:             this.tryCount++;
 63:             if (this.tryCount <= this.retryLimit) {
 64:               $.ajax(this);
 65:               return;
 66:             } else {
 67:               that.showError(
 68:                 { message: "NetworkError", helpUrl: null },
 69:                 "9000"
 70:               );
 71:             }
 72:           }
 73:           if (jqXHR.responseText && jqXHR.status) {
 74:             const errorMessage = that.getErrorMessage(jqXHR, Language);
 75:             that.showError(errorMessage, jqXHR.status);
 76:           } else {
 77:             that.showError(
 78:               that.findTranslation(jqXHR.responseJSON, Language),
 79:               400
 80:             );
 81:           }
 82:         },
 83:       });
 84:     },
 85:     getErrorMessage: function (jqXHR, Language) {
 86:       if (jqXHR.responseJSON) {
 87:         return this.findTranslation(jqXHR.responseJSON, Language);
 88:       }
 89:       if (jqXHR.status === 423) {
 90:         return {
 91:           message: this.getModel("i18n")
 92:             .getResourceBundle()
 93:             .getText("invalidTenant"),
 94:           helpUrl: null,
 95:         };
 96:       } else {
 97:         return {
 98:           message: jqXHR.responseText,
 99:           helpUrl: null,
100:         };
101:       }
102:     },
103:     findTranslation: function (json, languageCode) {
104:       const translation = (json.body?.translations ?? json.body?.errorMessage?.translations ?? []).find(t => t.language === languageCode);
105:       return {
106:         message: translation?.text ??  json.body?.errorMessage?.message ?? "Unknown error occured",
107:         helpUrl: json.body?.helpUrl ?? json.body?.errorMessage?.helpUrl ?? "",
108:       };
109:     },
110:     /**
111:      * Convenience method for accessing the router in every controller of the application.
112:      * @public
113:      * @returns {sap.ui.core.routing.Router} the router for this component
114:      */
115:     getRouter: function () {
116:       this.getDebugMode();
117:       return sap.ui.core.UIComponent.getRouterFor(this);
118:     },
119:     /**
120:      * Convenience method for getting the view model by name in every controller of the application.
121:      * @public
122:      * @param {string} sName the model name
123:      * @returns {sap.ui.model.Model} the model instance
124:      */
125:     getModel: function (sName) {
126:       this.getDebugMode();
127:       return sap.ui.getCore().getModel(sName);
128:     },
129:     /**
130:      * Convenience method for setting the view model in every controller of the application.
131:      * @public
132:      * @param {sap.ui.model.Model} oModel the model instance
133:      * @param {string} sName the model name
134:      * @returns {sap.ui.mvc.View} the view instance
135:      */
136:     setModel: function (oModel, sName) {
137:       this.getDebugMode();
138:       return sap.ui.getCore().setModel(oModel, sName);
139:     },
140:     /**
141:      * Convenience method for getting the resource bundle.
142:      * @public
143:      * @returns {sap.ui.model.resource.ResourceModel} the resourceModel of the component
144:      */
145:     getResourceBundle: function () {
146:       return this.getOwnerComponent().getModel("i18n").getResourceBundle();
147:     },
148:     /**
149:      * Event handler for navigating back.
150:      * It there is a history entry we go one step back in the browser history
151:      * If not, it will replace the current entry of the browser history with the master route.
152:      * @public
153:      */
154:     setDebugMode: function (boolean) {
155:       if (boolean) {
156:         sap.ui
157:           .getCore()
158:           .getEventBus()
159:           .subscribe(
160:             "nAG",
161:             "getDebugMode",
162:             function () {
163:               return true;
164:             },
165:             this
166:           );
167:       } else {
168:         sap.ui
169:           .getCore()
170:           .getEventBus()
171:           .subscribe(
172:             "nAG",
173:             "getDebugMode",
174:             function () {
175:               return false;
176:             },
177:             this
178:           );
179:       }
180:     },
181:     /**
182:      * Convenience method for  getting Debugmode
183:      */
184:     getDebugMode: function () {
185:       sap.ui.getCore().getEventBus().publish("nAG", "getDebugMode");
186:     },
187:     /**
188:      * Convenience method for saving the BusyDialog in a global variable
189:      * @public
190:      */
191:     getBusyDialog: function () {
192:       const busyDialog = sap.ui.xmlfragment(
193:         "busyDialog",
194:         "nAG.PurchaseDeliveryNote.view.BusyDialog",
195:         this
196:       );
197:       this.getView().addDependent(busyDialog);
198:       this.busyDialog = busyDialog;
199:     },
200:     /**
201:      * Convenience method for opening the BusyDialog
202:      * @public
203:      */
204:     showBusyDialog: function () {
205:       const busyDialog = this.busyDialog;
206:       busyDialog.open();
207:     },
208:     /**
209:      * Convenience method for closing the BusyDialog
210:      * @public
211:      */
212:     hideBusyDialog: function () {
213:       const busyDialog = this.busyDialog;
214:       busyDialog.close();
215:     },
216:     /**
217:      * Convenience method for getting the count of a value 'val' inside a jsons property 'prop'
218:      * @public
219:      * @returns int
220:      */
221:     /**
222:      * Standard Error-Call improved by Maciej
223:      * 21.08.2019 Improved the Messagebox and added SAP Error Messages
224:      * showError(i18nFehlermeldung, zusätzlicheInformation, Fehlercode)
225:      */
226:     showError: function (extraInfo, errorCode) {
227:       const that = this;
228:       this.oEventBus.publish("nAG", "hideBusyDialog");
229:       // Create dialog content
230:       const contentItems = [new sap.m.Text({ text: extraInfo.message })];
231:       // Add help link if available
232:       if (extraInfo.helpUrl) {
233:         contentItems.push(
234:           new sap.m.Link({
235:             text: extraInfo.helpUrl,
236:             href: extraInfo.helpUrl,
237:             target: "_blank",
238:           })
239:         );
240:       }
241:       // Create and configure dialog
242:       const dialog = new sap.m.Dialog({
243:         title: errorCode,
244:         type: "Message",
245:         state: sap.ui.core.ValueState.Error,
246:         content: new sap.m.VBox({ items: contentItems }),
247:         beginButton: new sap.m.Button({
248:           text: "Close",
249:           press: function () {
250:             dialog.close();
251:           },
252:         }),
253:         afterClose: function () {
254:           dialog.destroy();
255:           if (errorCode === 423) {
256:             that.goToTenantChoose();
257:           }
258:         },
259:       });
260:       dialog.open();
261:     },
262:     getMessage: function (i18nInfo) {
263:       return this.getViewModel("i18n").getResourceBundle().getText(i18nInfo);
264:     },
265:     /**
266:      * Convenience method for getting Variable from URL
267:      */
268:     goToTenantChoose: function () {
269:       window.open("/launchpad/", "_top");
270:     },
271:     getUrlVars: function () {
272:       let vars = {},
273:         parts = window.location.href.replace(
274:           /[?&]+([^=&]+)=([^&#]*)/gi,
275:           function (m, key, value) {
276:             vars[key] = value;
277:           }
278:         );
279:       return vars;
280:     },
281:     setViewModel: function (oModel, sName) {
282:       return this.getView().setModel(oModel, sName);
283:     },
284:     getViewModel: function (sName) {
285:       return this.getView().getModel(sName);
286:     },
287:     getAppConfig: function () {
288:       const that = this;
289:       $.ajax({
290:         url: "company/AppConfig",
291:         crossDomain: true,
292:         type: "GET",
293:         dataType: "json",
294:         success: function (data) {
295:           // Check if bookQSWarehouse is a Parameter at Configuration
296:           if (typeof data.bookQSWarehouse !== "undefined") {
297:             that
298:               .getViewModel("appView")
299:               .setProperty("/bookQSWarehouse", data.bookQSWarehouse);
300:           }
301:           if (typeof data.useCustomBatchGenerator !== "undefined") {
302:             that
303:               .getViewModel("appView")
304:               .setProperty(
305:                 "/useCustomBatchGenerator",
306:                 data.useCustomBatchGenerator
307:               );
308:           }
309:           if (typeof data.customBatchOperations !== "undefined") {
310:             that
311:               .getViewModel("appView")
312:               .setProperty(
313:                 "/customBatchOperations",
314:                 data.customBatchOperations
315:               );
316:           }
317:           if (typeof data.saveInterval !== "undefined") {
318:             that
319:               .getViewModel("appView")
320:               .setProperty("/saveInterval", data.saveInterval);
321:           }
322:           if (typeof data.isDeleted !== "undefined") {
323:             that
324:               .getViewModel("appView")
325:               .setProperty("/isDeleted", data.isDeleted);
326:           }
327:           if (typeof data.documentLockTimer !== "undefined") {
328:             that
329:               .getViewModel("appView")
330:               .setProperty("/documentLockTimer", data.documentLockTimer);
331:           }
332:           if (typeof data.continuePosting !== "undefined") {
333:             that
334:               .getViewModel("appView")
335:               .setProperty("/continuePosting", data.continuePosting);
336:           }
337:         },
338:         error: function (jqXHR) {
339:           that.showError(
340:             { message: jqXHR.responseJSON.error.message.value, helpUrl: null },
341:             jqXHR.responseJSON.error.code
342:           );
343:         },
344:       });
345:     },
346:   });
347: });
