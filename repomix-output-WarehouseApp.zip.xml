196: /**
197:  * Validate batch number selection and quantities
198:  * @param {Object} req - Express request object
199:  * @param {Object} res - Express response object
200:  */
201: async function validateBatchNumberSelection(req, res) {
202:   try {
203:     const { selectedBatches, requestedQuantity, dialogData } = req.body;
204:     if (!selectedBatches || !Array.isArray(selectedBatches)) {
205:       return res.status(400).send({
206:         isValid: false,
207:         message: "Mindestens eine Charge muss ausgewählt werden",
208:         error: "NO_BATCHES_SELECTED"
209:       });
210:     }
211:     if (selectedBatches.length === 0) {
212:       return res.status(400).send({
213:         isValid: false,
214:         message: "Mindestens eine Charge muss ausgewählt werden",
215:         error: "NO_BATCHES_SELECTED"
216:       });
217:     }
218:     // Validate total quantity
219:     const totalSelectedQuantity = selectedBatches.reduce((sum, batch) => sum + (batch.selectedQuantity || 0), 0);
220:     if (totalSelectedQuantity !== requestedQuantity) {
221:       return res.status(400).send({
222:         isValid: false,
223:         message: `Gesamtmenge ${totalSelectedQuantity} stimmt nicht mit gewünschter Menge ${requestedQuantity} überein`,
224:         error: "QUANTITY_MISMATCH",
225:         totalSelected: totalSelectedQuantity,
226:         requested: requestedQuantity
227:       });
228:     }
229:     // Validate each batch selection
230:     const availableBatchNumbers = dialogData.availableBatches.map(b => b.BatchNumber);
231:     for (const selectedBatch of selectedBatches) {
232:       if (!availableBatchNumbers.includes(selectedBatch.BatchNumber)) {
233:         return res.status(400).send({
234:           isValid: false,
235:           message: `Ungültige Charge: ${selectedBatch.BatchNumber}`,
236:           error: "INVALID_BATCH",
237:           invalidBatch: selectedBatch.BatchNumber
238:         });
239:       }
240:       const availableBatch = dialogData.availableBatches.find(b => b.BatchNumber === selectedBatch.BatchNumber);
241:       if (selectedBatch.selectedQuantity > availableBatch.Quantity) {
242:         return res.status(400).send({
243:           isValid: false,
244:           message: `Menge ${selectedBatch.selectedQuantity} überschreitet verfügbare Menge ${availableBatch.Quantity} für Charge ${selectedBatch.BatchNumber}`,
245:           error: "QUANTITY_EXCEEDS_AVAILABLE",
246:           batch: selectedBatch.BatchNumber,
247:           selected: selectedBatch.selectedQuantity,
248:           available: availableBatch.Quantity
249:         });
250:       }
251:     }
252:     res.send({
253:       isValid: true,
254:       selectedBatches,
255:       totalQuantity: totalSelectedQuantity,
256:       batchCount: selectedBatches.length,
257:       message: `${selectedBatches.length} Charge(n) mit insgesamt ${totalSelectedQuantity} Einheiten ausgewählt`
258:     });
259:   } catch (error) {
260:     res.status(500).send({
261:       message: "Error validating batch number selection",
262:       code: 500,
263:       error: error.message
264:     });
265:   }
266: }
