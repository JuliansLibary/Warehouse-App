116:     // Find matching item in detail data with exact frontend logic
117:     const detailItem = detailData.PackListLines?.find((line) => 
118:       line.ItemCode === itemData.ItemCode && 
119:       line.WarehouseCode === itemData.WarehouseCode && 
120:       line.AbsoluteEntry === itemData.AbsoluteEntry && 
121:       line.DocNum === itemData.DocNum && 
122:       line.OrderEntry === itemData.OrderEntry && 
