  1: const { formatForResponse } = require('./orderController')
  2: const { getProductTree } = require("../controller/udtController.js");
  3: const axios = require("axios");
  4: const BASE_URL = "http://System-DatabaseConnector.warehouseapp:3000";
  5: const { getInstance, generateBasicAuth, getError } = require("../controller/utilsController.js");
  6: const SL = require("@nag/servicelayerconnector");
  7: async function masterData(req, res) {
  8:   try {
  9:     const tenantResponse = await axios.get(`${BASE_URL}/Tenant/${req.params.tenantId}`);
 10:     if (tenantResponse.status === 200 && tenantResponse.data !== "null") {
 11:       const tenant = tenantResponse.data.tenant;
 12:       const instance = await getInstance();
 13:       const authHeaders = await generateBasicAuth(req.headers, tenant);
 14:       const maindata = await getMainData(
 15:         req.params.AbsEntry,
 16:         req.params.OrderEntry,
 17:         req.params.BaseObjectType,
 18:         req.params.isMultiPickList,
 19:         authHeaders,
 20:         req.params.tenantId,
 21:         instance
 22:       );
 23:       if (maindata.value.length === 0) {
 24:         return res.send(maindata.value);
 25:       }
 26:       const cachePack = await axios.get(`${BASE_URL}/Cache/Pack/${req.params.tenantId}`);
 27:       if (cachePack.status !== 200) throw new Error('Cache Pack request failed');
 28:       const documentLock = await axios.get(`${BASE_URL}/DocumentLock/Pack/${req.params.tenantId}`);
 29:       if (documentLock.status !== 200) throw new Error('Document Lock request failed');
 30:       const order = await formatForResponse(
 31:         maindata,
 32:         req.params.BaseObjectType,
 33:         authHeaders,
 34:         req.params.tenantId,
 35:         documentLock.data,
 36:         cachePack.data
 37:       );
 38:       const orderFrontend = await getProductTree(order.picklist, authHeaders, req.params.tenantId);
 39:       res.send({
 40:         PickLists: orderFrontend.pickList,
 41:         ProductTree: orderFrontend.frontendSalesModel,
 42:         picklistIncomplete: order.picklistIncomplete,
 43:         isMultiPickList: req.params.isMultiPickList,
 44:       });
 45:     } else {
 46:       res.status(404).send("Tenant not found");
 47:     }
 48:   } catch (error) {
 49:     res.status(error.response?.status || 500).send(error.message);
 50:   }
 51: }
 52: const getMainData = async (absEntry, orderEntry, baseObjectType, isMultiPickList, auth, tenantId, instance) => {
 53:   const pickListsWithoutMerge = "PickLists/Absoluteentry eq " + absEntry;
 54:   const pickListsWithMerge = "PickLists/PickListsLines/OrderEntry eq " + orderEntry;
 55:   try {
 56:     if (global.gConfig.mergePickLists === "true" && isMultiPickList === "false") {
 57:       const responseStatus = await axios.get(`${BASE_URL}/documentDetail/Pack/${tenantId}/getPackListByAbsoluteentry/${absEntry}`);
 58:       return responseStatus.data.content;
 59:     } else {
 60:       const responseStatus = await axios.get(`${BASE_URL}/documentDetail/Pack/${tenantId}/getPackListByOrderEntry/${absEntry}`);
 61:       return responseStatus.data.content;
 62:     }
 63:   } catch (error) {
 64:     // If the database returns a 404 status (resource not found),
 65:     // the following code triggers a fallback mechanism to fetch real-time data
 66:     // from the SAP system via the service layer.
 67:     if (error.response && error.response.status === 404) {
 68:       let join = (global.gConfig.mergePickLists === "true" && isMultiPickList === "false")
 69:         ? pickListsWithMerge
 70:         : pickListsWithoutMerge;
 71:       const crossjoin = buildCrossJoin(baseObjectType, join);
 72:       return new Promise((resolve, reject) => {
 73:         SL.GET(
 74:           crossjoin,
 75:           null,
 76:           auth,
 77:           {
 78:             retryTimes: 2,
 79:             retryDelay: 750,
 80:             SLURL: instance.SLURL,
 81:             SLPort: instance.SLPort,
 82:           },
 83:           async (errorCrossJoin, resp) => {
 84:             if (errorCrossJoin) {
 85:               reject(await getError(errorCrossJoin));
 86:             } else {
 87:               resolve(resp);
 88:             }
 89:           }
 90:         );
 91:       });
 92:     } else {
 93:       throw error;
 94:     }
 95:   }
 96: };
 97: // Hilfsfunktion zum Bauen des CrossJoin-Strings
 98: const buildCrossJoin = (baseObjectTypeCrossJoin, join) => {
 99:   const baseType = parseInt(baseObjectTypeCrossJoin);
100:   if (baseType === 13) {
101:     return "$crossjoin(PickLists,Invoices,PickLists/PickListsLines,Invoices/DocumentLines,Items)?$expand=" +
102:       "PickLists($select=Absoluteentry,Status,Remarks)," +
103:       "PickLists/PickListsLines($select=AbsoluteEntry,PickStatus,OrderEntry,PickedQuantity,OrderEntry,OrderRowID,ReleasedQuantity,PreviouslyReleasedQuantity,BaseObjectType)," +
104:       "Invoices($select=DocEntry,DocNum,DocDueDate,CardCode,CardName,VatSum,TransportationCode)," +
105:       "Invoices/DocumentLines($select=ItemCode,ItemDescription,RemainingOpenQuantity,ShipToCode,ShipToDescription,TreeType,WarehouseCode,LineNum)," +
106:       "Items($select=ItemCode,ManageSerialNumbers,ManageBatchNumbers)&$filter=" +
107:       "PickLists/PickListsLines/BaseObjectType eq 13 and " +
108:       "Invoices/DocEntry eq Invoices/DocumentLines/DocEntry and " +
109:       "PickLists/PickListsLines/OrderEntry eq Invoices/DocEntry and " +
110:       "PickLists/PickListsLines/OrderRowID eq Invoices/DocumentLines/LineNum and " +
111:       "PickLists/Absoluteentry eq PickLists/PickListsLines/AbsoluteEntry and " +
112:       "Items/ItemCode eq Invoices/DocumentLines/ItemCode and " +
113:       "PickLists/PickListsLines/PickStatus ne 'C' and PickLists/Status ne 'C' and " + join;
114:   } else if (baseType === 17) {
115:     return "$crossjoin(PickLists,Orders,PickLists/PickListsLines,Orders/DocumentLines,Items)?$expand=" +
116:       "PickLists($select=Absoluteentry,Status,Remarks)," +
117:       "PickLists/PickListsLines($select=AbsoluteEntry,PickStatus,OrderEntry,PickedQuantity,LineNumber,OrderEntry,OrderRowID,ReleasedQuantity,PreviouslyReleasedQuantity,BaseObjectType)," +
118:       "Orders($select=DocEntry,DocNum,DocDueDate,CardCode,CardName,VatSum,TransportationCode)," +
119:       "Orders/DocumentLines($select=ItemCode,ItemDescription,RemainingOpenQuantity,ShipToCode,ShipToDescription,LineNum,TreeType,WarehouseCode)," +
120:       "Items($select=ItemCode,ManageSerialNumbers,ManageBatchNumbers)&$filter=" +
121:       "PickLists/PickListsLines/BaseObjectType eq 17 and " +
122:       "Orders/DocEntry eq Orders/DocumentLines/DocEntry and " +
123:       "PickLists/PickListsLines/OrderEntry eq Orders/DocEntry and " +
124:       "PickLists/PickListsLines/OrderRowID eq Orders/DocumentLines/LineNum and " +
125:       "PickLists/Absoluteentry eq PickLists/PickListsLines/AbsoluteEntry and " +
126:       "Items/ItemCode eq Orders/DocumentLines/ItemCode and " +
127:       "PickLists/PickListsLines/PickStatus ne 'C' and PickLists/Status ne 'C' and " + join;
128:   } else if (baseType === 1250000001) {
129:     return "$crossjoin(PickLists,InventoryTransferRequests,PickLists/PickListsLines,InventoryTransferRequests/StockTransferLines,Items)?$expand=" +
130:       "PickLists($select=Absoluteentry,Status,Remarks)," +
131:       "PickLists/PickListsLines($select=AbsoluteEntry,PickStatus,OrderEntry,PickedQuantity,LineNumber,OrderEntry,OrderRowID,ReleasedQuantity,PreviouslyReleasedQuantity,BaseObjectType)," +
132:       "InventoryTransferRequests($select=DocEntry,DocNum,DueDate,CardCode,CardName,Comments,FromWarehouse,ToWarehouse,CreationDate,UpdateDate)," +
133:       "InventoryTransferRequests/StockTransferLines($select=ItemCode,ItemDescription,Quantity,WarehouseCode,FromWarehouseCode,LineNum,InventoryQuantity,RemainingOpenQuantity)," +
134:       "Items($select=ItemCode,ManageSerialNumbers,ManageBatchNumbers)&$filter=" +
135:       "PickLists/PickListsLines/BaseObjectType eq 1250000001 and " +
136:       "InventoryTransferRequests/DocEntry eq InventoryTransferRequests/StockTransferLines/DocEntry and " +
137:       "PickLists/PickListsLines/OrderEntry eq InventoryTransferRequests/DocEntry and " +
138:       "PickLists/PickListsLines/OrderRowID eq InventoryTransferRequests/StockTransferLines/LineNum and " +
139:       "PickLists/Absoluteentry eq PickLists/PickListsLines/AbsoluteEntry and " +
140:       "Items/ItemCode eq InventoryTransferRequests/StockTransferLines/ItemCode and " +
141:       "PickLists/PickListsLines/PickStatus ne 'C' and PickLists/Status ne 'C' and " + join;
142:   } else {
143:     throw new Error("Unsupported BaseObjectType: " + baseType);
144:   }
145: };
146: module.exports = {
147:   masterData,
148: };
