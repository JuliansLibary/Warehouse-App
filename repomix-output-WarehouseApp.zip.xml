<file path="WarehouseApp/nAG.Warehouse.App.InventoryTransfer/routes/stocktransferlogic.js">
 1: require("express");
 2: module.exports = {
 3:   prepareTransferForPost,
 4: };
 5: /*
 6:  * prepares Transfer for Post
 7:  * @param {json} Transfer Model with StockTransferLines
 8:  */
 9: function prepareTransferForPost(transfers) {
10:   return new Promise(function (resolve, reject) {
11:     var newTransfer = {
12:       ToWarehouse: transfers.StockTransferLines[0].WarehouseCode,
13:       FromWarehouse: transfers.StockTransferLines[0].FromWarehouseCode,
14:       StockTransferLines: [],
15:     };
16:     transfers.StockTransferLines.forEach((transferLine, index) => {
17:       // for each DocumentLine the LineNum, ItemCode, Quantity, BatchNumber, SerialNumber and Bin Allocation gets added
18:       // BaseType  is InventoryTransferRequest. BaseType is not required if you use a simple InventoryTransfer.
19:       newTransfer.StockTransferLines.push({
20:         LineNum: index,
21:         ItemCode: transferLine.ItemCode,
22:         Quantity: transferLine.Quantity,
23:         BatchNumbers: [],
24:         StockTransferLinesBinAllocations: [],
25:         SerialNumbers: [],
26:         WarehouseCode: transferLine.WarehouseCode,
27:         FromWarehouseCode: transferLine.FromWarehouseCode,
28:       });
29:       // If BatchNumber exists it gets added
30:       if ((transferLine.BatchNumbers ??[]).length > 0) {
31:         transferLine.BatchNumbers.forEach((batch, index) => {
32:           newTransfer.StockTransferLines[newTransfer.StockTransferLines.length - 1].BatchNumbers.push({
33:             BaseLineNumber: newTransfer.StockTransferLines.length - 1,
34:             BatchNumber: batch.BatchNumber,
35:             Quantity: parseInt(batch.Quantity),
36:           });
37:         });
38:       }
39:       // If SerialNumber exists it gets added
40:       if ((transferLine.SerialNumbers ?? []).length > 0) {
41:         transferLine.SerialNumbers.forEach((serial, index) => {
42:           newTransfer.StockTransferLines[newTransfer.StockTransferLines.length - 1].SerialNumbers.push({
43:             BaseLineNumber: newTransfer.StockTransferLines.length - 1,
44:             ManufacturerSerialNumber: serial.InternalSerialNumber,
45:             Quantity: parseInt(serial.Quantity),
46:             SystemSerialNumber: serial.systemSerialNumber,
47:           });
48:         });
49:       }
50:       // If BinAllocation exists it gets added and set the BinActionType correct
51:       if (transferLine.StockTransferLinesBinAllocations.length > 0) {
52:         transferLine.StockTransferLinesBinAllocations.forEach((allocation, index) => {
53:           // Search if a Bin Location is already set
54:           // If yes add the Quantity to support multi booking Actions
55:           var findBinLocationIndex = newTransfer.StockTransferLines[newTransfer.StockTransferLines.length - 1].StockTransferLinesBinAllocations.findIndex((bin) => bin.BinAbsEntry === allocation.BinAbsEntry && bin.BinActionType === allocation.BinActionType && bin.SerialAndBatchNumbersBaseLine === allocation.SerialAndBatchNumbersBaseLine);
56:           if (findBinLocationIndex !== -1 && transferLine.SerialNumbers.length === 0) {
57:             newTransfer.StockTransferLines[newTransfer.StockTransferLines.length - 1].StockTransferLinesBinAllocations[findBinLocationIndex].Quantity += parseInt(allocation.Quantity);
58:           } else {
59:             newTransfer.StockTransferLines[newTransfer.StockTransferLines.length - 1].StockTransferLinesBinAllocations.push({
60:               BaseLineNumber: newTransfer.StockTransferLines.length - 1,
61:               BinAbsEntry: allocation.BinAbsEntry,
62:               Quantity: parseInt(allocation.Quantity),
63:               BinActionType: allocation.BinActionType,
64:               SerialAndBatchNumbersBaseLine: allocation.SerialAndBatchNumbersBaseLine,
65:             });
66:           }
67:         });
68:       }
69:     });
70:     resolve(newTransfer);
71:   });
72: }
</file>

<file path="WarehouseApp/nAG.Warehouse.App.InventoryTransfer/utils/errorUtils.js">
 1: // Transforms Node.js and SAP Business One Service Layer errors into a frontend-friendly format. 
 2: // Handles SAP technical errors and Transaction Notification errors.
 3: async function getError(err) {
 4:   const httpStatusCode = err?.httpStatusCode || err?.response?.status || 500;
 5:   const message =
 6:     (typeof err === "string" ? err : null) ||
 7:     err?.error?.message ||
 8:     err?.message ||
 9:     err?.response?.data?.error?.message?.value ||
10:     err?.response?.data?.error?.message ||
11:     "Unknown error";
12:   return { httpStatusCode, message };
13: }
14: module.exports = {
15:   getError
16: };
