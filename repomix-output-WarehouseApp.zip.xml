 2: async function itemCode(req, res) {
 3:   try {
 4:     // Validate and sanitize input
 5:     let codeString = req.body.codeString;
 6:     // Handle different input types
 7:     if (typeof codeString !== 'string') {
 8:       if (codeString === null || codeString === undefined) {
 9:         return res.status(400).send({
10:           error: "Invalid barcode input",
11:           message: "codeString cannot be null or undefined"
12:         });
13:       }
14:       // Convert to string if it's a number or other type
15:       codeString = String(codeString);
16:     }
17:     // Trim whitespace
18:     codeString = codeString.trim();
19:     // Check if empty
20:     if (codeString.length === 0) {
21:       return res.status(400).send({
22:         error: "Invalid barcode input",
23:         message: "codeString cannot be empty"
24:       });
25:     }
26:     // Process the barcode
27:     const result = nagbark(codeString);
28:     res.send(result);
29:   } catch (error) {
30:     console.error("Error processing barcode:", error);
31:     res.status(500).send({
32:       error: "Failed to process barcode",
