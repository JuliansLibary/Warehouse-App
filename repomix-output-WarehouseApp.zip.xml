 472:     checkItemInformation: function (oEvent) {
 473:       this.oEventBus.publish("nAG", "showBusyDialog");
 474:       const oSource = oEvent.getSource();
 475:       const oBindingContext = oSource.getBindingContext("tempDialogModel");
 476:       if (!oBindingContext) {
 477:         this.oEventBus.publish("nAG", "hideBusyDialog");
 478:         return;
 479:       }
 480:       const oRowData = oBindingContext.getObject();
 481:       let aFilteredData = [];
 482:       let sDialogType = "";
 483:       const currentItem = this.getModel("binLocationForTransfer")
 484:         .getData()
 485:         .value.find((item) => item.ItemCode === oRowData.ItemCode);
 486:       if (!currentItem) {
 487:         console.error("Item nicht gefunden!");
 488:         this.oEventBus.publish("nAG", "hideBusyDialog");
 489:         return;
 490:       }
 491:       if (oRowData.ManageSerialNumbers === "tYES") {
 492:         sDialogType = "serial";
 493:         let aSessionSerialNumbers = this.getModel("SessionModel")
 494:           .getData()
 495:           .serialNumbers.filter((serial) => serial.ItemCode === oRowData.ItemCode);
 496:         let aCurrentSerialNumbers = currentItem.SerialNumbers || [];
 497:         let existingSerialNumbers = new Set(aCurrentSerialNumbers.map((s) => s.DistNumber));
 498:         aFilteredData = aSessionSerialNumbers.filter((serial) => !existingSerialNumbers.has(serial.DistNumber));
 499:       } else if (oRowData.ManageBatchNumbers === "tYES") {
 500:         sDialogType = "batch";
 501:         aFilteredData = this.getModel("SessionModel")
 502:           .getData()
 503:           .batchNumbers.filter((batch) => batch.ItemCode === oRowData.ItemCode);
 504:       }
 505:       if (aFilteredData.length > 0) {
 506:         if (sDialogType === "serial") {
 507:           this._showSerialDialog(aFilteredData, oSource.getId(), sDialogType);
 508:         } else {
 509:           this._showBatchDialog(aFilteredData, oSource.getId(), sDialogType);
 510:         }
 511:       } else {
 512:         sap.m.MessageBox.information(this.getModel("i18n").getResourceBundle().getText("noDataFound"), {
 513:           title: this.getModel("i18n").getResourceBundle().getText("info"),
 514:         });
 515:         this.oEventBus.publish("nAG", "hideBusyDialog");
 516:       }
