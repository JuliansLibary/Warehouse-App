300:               return query;
301:             });
302:             this.getModel("sqlQueries").setData(updatedSQLQueries);
303:             // Update UDFNames model
304:             const updatedUDFs = UDFs.map(udf => {
305:               if (moduleName === udf.module) {
306:                 udf.currentlySelected = true;
307:               }
308:               return udf;
309:             });
310:             this.getModel("udfNames").setData(updatedUDFs);
311:           });
312:         },
