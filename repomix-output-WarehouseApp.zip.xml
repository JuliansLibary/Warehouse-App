  1: const axios = require("axios");
  2: const SL = require("@nag/servicelayerconnector");
  3: const { getInstance } = require("../utils/instanceUtils.js");
  4: const { generateBasicAuth } = require("../utils/authUtils.js");
  5: const { getError } = require("../utils/errorUtils.js");
  6: const BASE_URL = "http://System-DatabaseConnector.warehouseapp:3000";
  7: // Gets open or partly picked PickLists by Warehouse
  8: async function pickLists(req, res) {
  9:   try {
 10:     const responseDocumentDetails = await axios.get(`${BASE_URL}/documentDetail/Pack/${req.params.tenantId}/getOrders/${req.params.orderEntry}`);
 11:     try {
 12:       const responseSingleMasterData = await axios.get(`${BASE_URL}/singleMasterData/Pick/${req.params.tenantId}/PickListsRemarks`);
 13:       const responseCache = await axios.get(`${BASE_URL}/Cache/Pick/${req.params.tenantId}`);
 14:       if (responseCache.status !== 200) {
 15:         throw new Error("Cache Pick request failed");
 16:       }
 17:       const responseDocumentLock = await axios.get(`${BASE_URL}/DocumentLock/Pick/${req.params.tenantId}`);
 18:       if (responseDocumentLock.status !== 200) {
 19:         throw new Error("Document Lock request failed");
 20:       }
 21:       const formattedPicklist = await formatPickListsForResponse(responseDocumentDetails.data.content.value, responseCache.data, responseSingleMasterData.data.content, responseDocumentLock.data);
 22:       res.send(formattedPicklist);
 23:     } catch (error) {
 24:       console.error(error);
 25:       // When no Cached data is found, the data is being loaded via live SL call
 26:       await getPicklist(req, res);
 27:     }
 28:   } catch (errorDetail) {
 29:     console.error(errorDetail);
 30:     // When no Cached data is found, the data is being loaded via live SL call
 31:     await getPicklist(req, res);
 32:   }
 33: }
 34: async function getPicklist(req, res) {
 35:   const url = `SQLQueries('GETPickLists')/List?WhsCode='${req.params.WhsCode}'`;
 36:   try {
 37:     const responseTenant = await axios.get(`${BASE_URL}/Tenant/${req.params.tenantId}`);
 38:     const tenant = responseTenant.data.tenant;
 39:     const instance = await getInstance();
 40:     const authHeaders = await generateBasicAuth(req.headers, tenant);
 41:     SL.GET(
 42:       url,
 43:       null,
 44:       authHeaders,
 45:       {
 46:         retryTimes: 2,
 47:         retryDelay: 750,
 48:         SLURL: instance.SLURL,
 49:         SLPort: instance.SLPort,
 50:       },
 51:       async (error, pickLists) => {
 52:         if (error) {
 53:           return res.status(error.httpStatusCode).send(await getError(error));
 54:         }
 55:         SL.GET(
 56:           "SQLQueries('GetRemarks')/List",
 57:           null,
 58:           authHeaders,
 59:           {
 60:             retryTimes: 2,
 61:             retryDelay: 750,
 62:             SLURL: instance.SLURL,
 63:             SLPort: instance.SLPort,
 64:           },
 65:           async (errorRemarks, remarkToPickList) => {
 66:             if (errorRemarks) {
 67:               return res.status(errorRemarks.httpStatusCode).send(await getError(errorRemarks));
 68:             }
 69:             try {
 70:               const responseCache = await axios.get(`${BASE_URL}/Cache/Pick/${req.params.tenantId}`);
 71:               if (responseCache.status !== 200) {
 72:                 throw new Error("Cache Pick request failed");
 73:               }
 74:               const documentLock = await axios.get(`${BASE_URL}/DocumentLock/Pick/${req.params.tenantId}`);
 75:               if (documentLock.status !== 200) {
 76:                 throw new Error("Document Lock request failed");
 77:               }
 78:               const formattedPicklist = await formatPickListsForResponse(pickLists.value, responseCache.data, remarkToPickList.value, documentLock.data);
 79:               res.send(formattedPicklist);
 80:             } catch (formattingError) {
 81:               res.status(500).send({ error: "Error formatting picklist", details: formattingError.message });
 82:             }
 83:           }
 84:         );
 85:       }
 86:     );
 87:   } catch (error) {
 88:     res.status(404).send({ error: "Request failed", details: error.message });
 89:   }
 90: }
 91: /**
 92:  * formats the Response from ServiceLayer for Frontend
 93:  * Gets called if the PickListView does not exist
 94:  * @param {json} picklist
 95:  * @param {json} picklistsCache
 96:  * @param {json} remarkList
 97:  */
 98: function formatPickListsForResponse(pickList, pickListCacheString, remarkList, documentLockString) {
 99:   return new Promise((resolve, reject) => {
100:     try {
101:       const response = [];
102:       const orderEntrySet = new Set();
103:       const absEntrySet = new Set();
104:       pickList.forEach((picklist) => {
105:         if (!orderEntrySet.has(picklist.OrderEntry) && !absEntrySet.has(picklist.Absoluteentry)) {
106:           let hasEntry = false;
107:           try {
108:             hasEntry = pickListCacheString.some((element) => element.documentNumber === picklist.Absoluteentry && element.isDeleted === false);
109:           } catch {
110:             hasEntry = false;
111:           }
112:           const remarkElement = remarkList.find((element) => element.AbsEntry === picklist.Absoluteentry);
113:           const remark = remarkElement ? remarkElement.Remarks : "";
114:           let isLocked = false;
115:           try {
116:             const currentDate = new Date();
117:             isLocked = documentLockString.some((element) => element.documentNumber === picklist.Absoluteentry && new Date(Date.parse(element.latestChangeDate)).getTime() + parseInt(global.gConfig.documentLockTimer) * 60000 >= currentDate.getTime());
118:           } catch {
119:             isLocked = false;
120:           }
121:           response.push({
122:             AbsoluteEntry: picklist.Absoluteentry,
123:             Status: picklist.Status,
124:             Name: picklist.Name,
125:             PickDate: picklist.PickDate,
126:             Remarks: remark,
127:             OrderEntry: picklist.OrderEntry,
128:             WarehouseCode: picklist.WhsCode,
129:             BaseObjectType: picklist.BaseObject,
130:             PickListsFromOrder: [picklist.Absoluteentry],
131:             isMultiPickList: "false",
132:             isCached: hasEntry,
133:             isLocked: isLocked,
134:           });
135:           orderEntrySet.add(picklist.OrderEntry);
136:           absEntrySet.add(picklist.Absoluteentry);
137:         } else {
138:           const orderEntry = response.find((entry) => entry.OrderEntry === picklist.OrderEntry);
139:           if (orderEntry) {
140:             orderEntry.PickListsFromOrder.push(picklist.Absoluteentry);
141:           }
142:           const absoluteEntry = response.find((entry) => entry.AbsoluteEntry === picklist.Absoluteentry);
143:           if (absoluteEntry) {
144:             absoluteEntry.isMultiPickList = "true";
145:           }
146:         }
147:       });
148:       response.sort((a, b) => parseInt(b.AbsoluteEntry) - parseInt(a.AbsoluteEntry));
149:       resolve(response);
150:     } catch (error) {
151:       reject(error);
152:     }
153:   });
154: }
155: module.exports = {
156:   pickLists,
157: };
</file>

