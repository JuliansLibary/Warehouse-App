 13: function checkForDuplicates(serialNumber, frontendModel, deliveryModel, currentPackage, currentItemCode) {
 14:   const normalizedSerial = normalizeSerialNumber(serialNumber);
 15:   // Check current frontend model
 16:   if (frontendModel && frontendModel.SerialNumbers) {
 17:     for (const serial of frontendModel.SerialNumbers) {
 18:       const normalizedExisting = normalizeSerialNumber(serial.SerialNumber);
 19:       const normalizedManufacturer = normalizeSerialNumber(serial.ManufacturerSerialNumber || serial.InternalSerialNumber);
 20:       if (normalizedExisting === normalizedSerial || normalizedManufacturer === normalizedSerial) {
 21:         return {
 22:           isDuplicate: true,
 23:           context: "currentSession",
 24:           package: serial.Package,
 25:           message: `Serial number "${serialNumber}" is already selected in this session.`,
 26:         };
 27:       }
 28:     }
 29:   }
 30:   // Check delivery model
 31:   if (deliveryModel && deliveryModel.Package) {
 32:     for (let pkgIndex = 0; pkgIndex < deliveryModel.Package.length; pkgIndex++) {
 33:       const packageData = deliveryModel.Package[pkgIndex];
 34:       if (packageData.DeliveryLines) {
 35:         for (const line of packageData.DeliveryLines) {
 36:           if (line.SerialNumbers) {
 37:             for (const serial of line.SerialNumbers) {
 38:               const normalizedExisting = normalizeSerialNumber(serial.SerialNumber);
 39:               const normalizedManufacturer = normalizeSerialNumber(serial.ManufacturerSerialNumber || serial.InternalSerialNumber);
 40:               if (normalizedExisting === normalizedSerial || normalizedManufacturer === normalizedSerial) {
 41:                 if (pkgIndex === currentPackage && line.ItemCode === currentItemCode) {
 42:                   return {
 43:                     isDuplicate: true,
 44:                     context: "currentPackage",
 45:                     package: pkgIndex,
 46:                     message: `Serial number "${serialNumber}" is already assigned to this package.`,
 47:                   };
 48:                 } else if (line.ItemCode === currentItemCode) {
 49:                   return {
