 54:           this.oEventBus.subscribe(
 55:             "nAG",
 56:             "getAppView",
 57:             this.getViewElement,
 58:             this
 59:           );
 60:         },
 61:         // Returns the Namespace for use
 62:         _getNamespace: function () {
 63:           var oViewName = this.getOwnerComponent()
 64:             .getMetadata()
 65:             .getRootView().viewName;
 66:           return oViewName.split(".App")[0];
 67:         },
 68:         /**
 69:          * @param {Controller} activeController: current controller where t he dialog should be rendered
 70:          * @param {String} nameOfDialog:  name of the fragment to be called
 71:          * @param {String} idOfDialog : id of the Dialog
 72:          */
 73:         getDialog: async function (activeController, nameOfDialog, idOfDialog) {
 74:           var that = this;
 75:           return new Promise((resolve, reject) => {
 76:             if (!activeController[nameOfDialog]) {
 77:               Fragment.load({
 78:                 name: that._getNamespace() + "." + nameOfDialog,
 79:                 id: idOfDialog,
 80:                 controller: activeController,
 81:               }).then(function (oDialog) {
 82:                 activeController[nameOfDialog] = oDialog;
 83:                 resolve(activeController[nameOfDialog]);
 84:               });
 85:             } else {
 86:               resolve(activeController[nameOfDialog]);
 87:             }
 88:           });
 89:         },
 90:         /**
 91:          * @param {String} method: Can be at nAG: POST,PATCH,GET
 92:          * @param {String} url:  url for the ajax Call
 93:          * @param {JSON} postContent : JSON Body for a patch/post
 94:          * @param {String} i18n : String for a call of the error dialogue via i18n
 95:          * @param {JSON} callback :  Returns a JSON after a successful Ajax call. Can be further used in the frontend
 96:          * NOTE: No IF is needed to build the postContent dynamically for the AJAX. With a GET, the postContent is not transferred to the backend.
 97:          */
 98:         makeAjaxRequest: function (method, url, postContent, i18n, callback) {
 99:           var that = this;
100:           $.ajax({
101:             url: url,
102:             xhrFields: {
103:               withCredentials: true,
104:             },
105:             data: postContent,
106:             crossDomain: true,
107:             type: method,
108:             tryCount: 0,
109:             retryLimit: 3,
110:             headers: {
111:               prefer: "odata.maxpagesize=0",
112:             },
113:             success: function (response, status, xhr) {
114:               callback(response);
115:             },
116:             error: function (jqXHR, textStatus) {
117:               var Language = that.getUrlVars().Language
118:               if (textStatus === "timeout") {
119:                 this.tryCount++;
120:                 if (this.tryCount <= this.retryLimit) {
121:                   $.ajax(this);
122:                   return;
123:                 } else {
124:                   that.showError({message: "NetworkError", helpUrl: null}, "9000");
125:                 }
126:               }
127:               if (
128:                 typeof jqXHR.responseText !== "undefined" &&
129:                 jqXHR.status !== "undefined"
130:                 ) {
131:                   if (typeof jqXHR.responseJSON !== "undefined") {
132:                     that.showError(that.findTranslation(jqXHR.responseJSON, Language), jqXHR.status);
133:                   }else{
134:                     let errorMessage;
135:                     if (jqXHR.status === 423) {
136:                        errorMessage = {
137:                         message: that.getModel("i18n").getResourceBundle().getText("invalidTenant"),
138:                         helpUrl: null
139:                       }
140:                     }else{
141:                        errorMessage = {
142:                         message: jqXHR.responseText,
143:                         helpUrl: null
144:                       }
145:                     }
146:                     that.showError(errorMessage, jqXHR.status);
147:                   }
148:                 } else {
149:                   that.showError(that.findTranslation(jqXHR.responseJSON, Language), 400);
150:                 }
151:             },
152:           });
153:         },
154:         findTranslation: function(json, languageCode){
155:           var response;
156:           if (json.body.helpUrl) {
157:             response = {
158:               message: "",
159:               helpUrl: json.body.helpUrl || null
160:           };
161:           }else{
162:             response = {
163:               message: "",
164:             }
165:           }
166:           if (json.body.translations && json.body.translations.length > 0) {
167:               let translation = json.body.translations.find(translation => translation.language === languageCode);
168:               if (translation) {
169:                   response.message = translation.text;
170:               }
171:           }
172:           if (!response.message && json.body.message) {
173:               response.message = json.body.message;
174:           }
175:           return response;
176:       },
177:         /**
178:          * Convenience method for accessing the router in every controller of the application.
179:          * @public
180:          * @returns {sap.ui.core.routing.Router} the router for this component
181:          */
182:         getRouter: function () {
183:           this.getDebugMode() && console.log("BASE GET ROUTER");
184:           return sap.ui.core.UIComponent.getRouterFor(this);
185:         },
186:         /**
187:          * Convenience method for getting the view model by name in every controller of the application.
188:          * @public
189:          * @param {string} sName the model name
190:          * @returns {sap.ui.model.Model} the model instance
191:          */
192:         getModel: function (sName) {
193:           this.getDebugMode() && console.log("BASE GET MODEL: " + sName);
194:           return sap.ui.getCore().getModel(sName);
195:         },
196:         /**
197:          * Convenience method for setting the view model in every controller of the application.
198:          * @public
199:          * @param {sap.ui.model.Model} oModel the model instance
200:          * @param {string} sName the model name
201:          * @returns {sap.ui.mvc.View} the view instance
202:          */
203:         setModel: function (oModel, sName) {
204:           return sap.ui.getCore().setModel(oModel, sName);
205:         },
206:         /**
207:          * Convenience method for getting the resource bundle.
208:          * @public
209:          * @returns {sap.ui.model.resource.ResourceModel} the resourceModel of the component
210:          */
211:         getResourceBundle: function () {
212:           return this.getOwnerComponent().getModel("i18n").getResourceBundle();
213:         },
214:         getSession: function (view) {
215:           var cookie = this.getCookie("ServiceLayer");
216:           if (cookie !== null) {
217:             return cookie;
218:           } else {
219:             return null;
220:           }
221:         },
222:         saveSession: function (Username, Password, CompanyDB) {
223:           var User = JSON.stringify({
224:             UserName: Username,
225:             CompanyDB: CompanyDB,
226:           });
227:           this.setCookie(
228:             "ServiceLayer",
229:             "Basic " + btoa(User + ":" + Password, 360)
230:           );
231:         },
232:         setCookie: function (cname, cvalue, exminutes) {
233:           var d = new Date();
234:           d.setTime(d.getTime() + exminutes * 60 * 1000);
235:           var expires = "expires=" + d.toUTCString();
236:           document.cookie = cname + "=" + cvalue + ";" + expires;
237:         },
238:         removeCookie: function (Username, Password, CompanyDB) {
239:           document.cookie =
240:             "ServiceLayer=;expires=Thu, 01 Jan 1970 00:00:00 GMT";
241:         },
242:         getCookie: function (cname) {
243:           var name = cname + "=";
244:           var ca = document.cookie.split(";");
245:           for (var i = 0; i < ca.length; i++) {
246:             var c = ca[i];
247:             while (c.charAt(0) == " ") {
248:               c = c.substring(1);
249:             }
250:             if (c.indexOf(name) == 0) {
251:               return c.substring(name.length, c.length);
252:             }
253:           }
254:           return null;
255:         },
256:         /**
257:          * Event handler for navigating back.
258:          * It there is a history entry we go one step back in the browser history
259:          * If not, it will replace the current entry of the browser history with the master route.
260:          * @public
261:          */
262:         onNavBack: function () {
263:           this.getDebugMode() && console.log("onNavBack");
264:           var sPreviousHash = History.getInstance().getPreviousHash();
265:           if (sPreviousHash !== undefined) {
266:             history.go(-1);
