<file path="WarehouseApp/nAG.Warehouse.App.Pick/server.js">
 1: require("tls").DEFAULT_MIN_VERSION = "TLSv1";
 2: const express = require("express"),
 3:       app = express(),
 4:       axios = require('axios'),
 5:       bodyParser = require("body-parser"),
 6:       logRouteDetails = require("./middleware/logMiddleware"),
 7:       configCheck = require("./middleware/configCheck");
 8: // Middleware configurations
 9: process.env["NODE_TLS_REJECT_UNAUTHORIZED"] = 0; // Uncomment for Self-Signed Service Layer
10: // Serve nAG Warehouse App frontend
11: app.use(express.static("./webapp"));
12: // Body Parser middleware
13: app.use(
14:   bodyParser.urlencoded({
15:     limit: "100mb",
16:     extended: true,
17:   })
18: );
19: app.use(
20:   bodyParser.json({
21:     limit: "100mb",
22:     extended: true,
23:     parameterLimit: 1000000
24:   })
25: );
26: app.use(express.json({ limit: "100mb", parameterLimit: 1000000 }));
27: app.use(express.urlencoded({ limit: "100mb", extended: true }));
28: // Log every request
29: app.use(logRouteDetails);
30: // Check config on everyRequest
31: app.use(configCheck);
32: // Function to initialize configuration and start the server
33: const initConfigAndStartServer = async () => {
34:   const configUrl = `http://Module-AdminPanel.warehouseapp:8005/internalConfig/initConfigForStart/Pick`;
35:   try {
36:     const response = await axios.get(configUrl);
37:     const rawData = response.data;
38:     try {
39:       global.gConfig = rawData; // Axios gibt die JSON-Daten direkt zurück, kein manuelles Parsen nötig
40:       // Register routes once config is loaded
41:       registerRoutes();
42:     } catch (error) {
43:       console.error("Error processing configuration:", error);
44:     }
45:   } catch (error) {
46:     console.error("Error fetching configuration:", error);
47:   }
48: };
49: // Register routes
50: const registerRoutes = () => {
51:   app.use("/user", require("./routes/userRoutes.js"));
52:   app.use("/warehouse", require("./routes/warehouseRoutes.js"));
53:   app.use("/tenant", require("./routes/tenantRoutes.js"));
54:   app.use("/cache", require("./routes/cacheRoutes.js"));
55:   app.use("/documentLock", require("./routes/documentLockRoutes.js"));
56:   app.use("/pickLists", require("./routes/pickListsRoutes.js"));
57:   app.use("/binLocation", require("./routes/binLocationRoutes.js"));
58:   app.use("/batchNumber", require("./routes/batchNumberRoutes.js"));
59:   app.use("/item", require("./routes/itemRoutes.js"));
60:   app.use("/pickListDetail", require("./routes/pickListDetailRoutes.js"));
61:   app.use("/serialNumber", require("./routes/serialNumberRoutes.js"));
62: };
63: // Start the server and initialize configuration
64: app.listen(8115, () => {
65:   console.info("Server listening on port 8115");
66:   initConfigAndStartServer();
67: });
