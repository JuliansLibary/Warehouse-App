  1: const axios = require("axios");
  2: const SL = require("@nag/servicelayerconnector");
  3: const { getInstance } = require("../utils/instanceUtils.js");
  4: const { generateBasicAuth } = require("../utils/authUtils.js");
  5: const { getError } = require("../utils/errorUtils.js");
  6: const BASE_URL = "http://System-DatabaseConnector.warehouseapp:3000";
  7: // POST: Aktualisiert nur die OpenRequests für übergebene Warehouses
  8: async function warehouseCountedPickLists(req, res) {
  9:   try {
 10:     // Tenant-Daten holen, genau wie bei warehousePick
 11:     const tenantResponse = await axios.get(`${BASE_URL}/Tenant/${req.params.tenantId}`);
 12:     if (tenantResponse.status === 200 && tenantResponse.data !== "null") {
 13:       req.tenant = tenantResponse.data.tenant;
 14:     } else {
 15:       throw new Error("Tenant data not found");
 16:     }
 17:     // Warehouses aus Body holen
 18:     const warehouses = req.body;
 19:     warehousePickOpenRequestsInternal(req, res, warehouses);
 20:   } catch (error) {
 21:     res.status(500).send({ error: "Internal server error", details: error.message });
 22:   }
 23: }
 24: // Interne Funktion: counted Pick Lists für gegebene Warehouses aktualisieren
 25: async function warehousePickOpenRequestsInternal(req, res, warehouses, instanceParam) {
 26:   try {
 27:     const instance = instanceParam || (await getInstance());
 28:     if (!instance) {
 29:       return res.status(500).send({ body: { message: "Failed to get Instance", helpUrl: null } });
 30:     }
 31:     SL.GET(
 32:       "SQLQueries('GetCountedPickLists')/List",
 33:       null,
 34:       await generateBasicAuth(req.headers, req.tenant),
 35:       {
 36:         retryTimes: 2,
 37:         retryDelay: 750,
 38:         SLURL: instance.SLURL,
 39:         SLPort: instance.SLPort,
 40:       },
 41:       async (error, resp) => {
 42:         if (error) {
 43:           return res.status(error.httpStatusCode).send(await getError(error));
 44:         }
 45:         const content = warehouses.map((warehouse) => {
 46:           const openRequests = resp.value.find((openRequestsSearch) => openRequestsSearch.WhsCode === warehouse.WarehouseCode);
 47:           return {
 48:             ...warehouse,
 49:             BinLocations: warehouse.EnableBinLocations === "tYES",
 50:             OpenRequests: openRequests ? openRequests.CountedPickLists : 0,
 51:           };
 52:         });
 53:         res.send(content);
 54:       }
 55:     );
 56:   } catch (error) {
 57:     res.status(500).send({ error: "Internal server error", details: error.message });
 58:   }
 59: }
 60: async function warehousePick(req, res) {
 61:   try {
 62:     const tenantResponse = await axios.get(`${BASE_URL}/Tenant/${req.params.tenantId}`);
 63:     if (tenantResponse.status === 200 && tenantResponse.data !== "null") {
 64:       req.tenant = tenantResponse.data.tenant;
 65:     } else {
 66:       throw new Error("Tenant data not found");
 67:     }
 68:     try {
 69:       const responseStatus = await axios.get(`${BASE_URL}/singleMasterData/WarehouseLocations/${req.params.tenantId}/Warehouses`);
 70:       if (responseStatus.data && responseStatus.data.content) {
 71:         req.warehouseContent = responseStatus.data.content;
 72:         warehousePickOpenRequestsInternal(req, res, req.warehouseContent);
 73:       } else {
 74:         throw new Error("Invalid warehouse content received");
 75:       }
 76:     } catch (error) {
 77:       if (error.response && error.response.status === 404) {
 78:         const instance = await getInstance();
 79:         const authHeaders = await generateBasicAuth(req.headers, req.tenant);
 80:         SL.GET(
 81:           "Warehouses?$select=WarehouseCode,WarehouseName,EnableBinLocations",
 82:           null,
 83:           authHeaders,
 84:           {
 85:             retryTimes: 2,
 86:             retryDelay: 750,
 87:             SLURL: instance.SLURL,
 88:             SLPort: instance.SLPort,
 89:           },
 90:           async (errorWarehouse, warehousesResponse) => {
 91:             if (errorWarehouse) {
 92:               res.status(errorWarehouse.httpStatusCode).send(await getError(errorWarehouse));
 93:             } else {
 94:               req.warehouseContent = warehousesResponse.value;
 95:               warehousePickOpenRequestsInternal(req, res, req.warehouseContent);
 96:             }
 97:           }
 98:         );
 99:       } else {
100:         throw error;
101:       }
102:     }
103:   } catch (error) {
104:     res.status(error.response?.status || 500).send({
105:       error: "Error processing warehouse pick request",
106:       details: error.message,
107:     });
108:   }
109: }
110: module.exports = {
111:   warehousePick,
112:   warehouseCountedPickLists,
113: };
