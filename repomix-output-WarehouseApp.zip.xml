  6: async function _createLabelfrominput(req, label, cookie, tenant) {
  7:   try {
  8:     const result = await createLabelfromInput(req, label, cookie, tenant);
  9:     return result;
 10:   } catch (error) {
 11:     throw error;
 12:   }
 13: }
 14: async function createLabelfromInput(req, bodyLabel, cookie, tenant) {
 15:   const dom = new jsdom.JSDOM(bodyLabel, "text/html");
 16:   const SQLQueries = [];
 17:   let content = { Type: "nAG QR-Code" };
 18:   let variables = "";
 19:   content = { ...content, ...req };
 20:   delete content["CreateCode"];
 21:   if (req.CreateCode === "GS1") {
 22:     bodyLabel = bodyLabel.replace("{QR}", `<img src="${await _createGS1(req)}"></img>`);
 23:   }
 24:   if (req.CreateCode === "Barcode") {
 25:     bodyLabel = bodyLabel.replace("{QR}", `<img src="${await _createBarcode(req)}"></img>`);
 26:   }
 27:   if (req.CreateCode === "QR") {
 28:     bodyLabel = bodyLabel.replace("{QR}", `<img class="qr-img" src="${await _createQR(content)}" style="width: 250px !important; height: 250px !important; max-width: 250px !important; max-height: 250px !important; display: block !important; object-fit: contain !important; border: none !important; background: white !important;" alt="QR Code"></img>`);
 29:   }
 30:   bodyLabel = await _createLabel(req, bodyLabel);
 31:   dom.window.document.querySelectorAll(".Item").forEach((link) => {
 32:     link.textContent = link.textContent.slice(1, -1);
 33:     variables += `${link.textContent},`;
 34:   });
 35:   if (variables && cookie) {
 36:     const result = await getInformationLabel(req.ItemCode, variables, cookie, tenant).catch(() => null);
 37:     if (result) {
 38:       bodyLabel = await _createLabel(result, bodyLabel);
 39:     }
 40:   }
 41:   for (const value of Array.from(dom.window.document.getElementsByTagName("SqlQuery"))) {
 42:     const attributes = await checkSQLQuery(value.getAttribute("name"), value.getAttribute("query"), cookie, tenant);
 43:     SQLQueries.push({ SQLQuery: value.getAttribute("name"), attributes });
 44:   }
 45:   if (SQLQueries.length && cookie) {
 46:     const resultFromSQLQuery = await getInformationFromSQLQuery(req, SQLQueries, cookie, tenant).catch(() => null);
 47:     if (resultFromSQLQuery) {
 48:       bodyLabel = await _createLabelFromSQLQuery(resultFromSQLQuery, bodyLabel, dom.window.document);
 49:     }
 50:   }
 51:   return bodyLabel;
 52: }
 53: function _createLabel(req, label) {
 54:   return new Promise((resolve, reject) => {
 55:     createLabel(req, label, async function (error, resp) {
 56:       if (error) {
 57:         reject(error);
 58:       } else {
 59:         resolve(resp);
 60:       }
 61:     });
 62:   });
 63: }
 64: async function createLabel(content, label, callback) {
 65:   for (const [key, value] of Object.entries(content)) {
 66:     const regEx = new RegExp(`{${key}}`);
 67:     if (label.match(regEx)) {
 68:       label = label.replace(label.match(regEx)[0], value);
 69:     }
 70:     if (key === "SerialNumber" && value) {
 71:       label = label.replace("{SERIAL}", `<img src="${await _createBarcode(value)}"></img>`);
 72:     }
 73:     if (key === "BinLocation" && value) {
 74:       label = label.replace("{BIN}", `<img src="${await _createBarcode(value)}"></img>`);
 75:     }
 76:   }
 77:   callback(null, label);
 78: }
 79: function _createLabelFromSQLQuery(req, label, htmlContent) {
 80:   return new Promise((resolve, reject) => {
 81:     createLabelFromSQLQuery(req, label, htmlContent, async function (error, resp) {
 82:       if (error) {
 83:         reject(error);
 84:       } else {
 85:         resolve(resp);
 86:       }
 87:     });
 88:   });
 89: }
 90: /* Loop at all Results from SQL Queries
 91:   If a QR Code or Barcode is defined at the Label Layout it will create the code
 92:   Otherwise it will replace the Placeholder with the Value from the Result
 93:  */
 94: async function createLabelFromSQLQuery(content, label, htmlContent, callback) {
 95:   for (const [key, valueModel] of Object.entries(content)) {
 96:     for (const value of Array.from(htmlContent.getElementsByTagName("SqlQuery"))) {
 97:       for (const element of value.childNodes) {
 98:         if (element.nodeType === 1) {
 99:           const regEx = new RegExp(element.textContent);
100:           if (label.match(regEx)) {
101:             const mode = element.getAttribute("mode");
102:             if (mode && mode !== "Text") {
103:               label = label.replace(element.textContent, `<img src="${mode === "QR" ? await _createQR(JSON.stringify(valueModel.Value)) : await _createBarcode(JSON.stringify(valueModel.Value))}"></img>`);
104:             } else if (mode === "Text" && valueModel.Value[element.textContent.replace(/{|}/g, "")]) {
105:               label = label.replace(element.textContent, valueModel.Value[element.textContent.replace(/{|}/g, "")]);
106:             }
107:           }
108:         }
109:       }
110:     }
111:   }
112:   callback(null, label);
113: }
114: function _createGS1(req) {
115:   return new Promise((resolve, reject) => {
116:     getGS1(req, async function (error, resp) {
117:       if (error) {
118:         reject(error);
119:       } else {
