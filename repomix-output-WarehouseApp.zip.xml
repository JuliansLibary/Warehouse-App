 29:         });
 30:       });
 31:       const responseMergePickList = Array.from(pickListSet).map((absoluteEntry) => ({
 32:         Absoluteentry: absoluteEntry,
 33:         PickListsLines: response.PickListsLines.filter((picklistLines) => picklistLines.AbsoluteEntry === absoluteEntry),
 34:       }));
 35:       resolve(responseMergePickList);
