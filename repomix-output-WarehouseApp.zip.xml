21:           "warehouse/Warehouse/" +
22:           this.getModel("SessionModel").getData().OrderEntry +
23:           "/" +
24:           this.getModel("SessionModel").getData().BaseType +
25:           "/" +
26:           that.getModel("SessionModel").getData().tenantId;
27:       if (this.getModel("SessionModel") === undefined) {
28:         that.getViewModel("appView").setProperty("/layout", "OneColumn");
29:       }
30:       // Filter Warehouse per location
31:       const location = decodeURIComponent(this.getUrlVars().location);
32:       if (location !== "undefined") {
33:         warehouseURL += "/" + location;
34:       }
35:       this.makeAjaxRequest(
36:         "GET",
37:         "company/getTenantByName/" + this.getUrlVars().Tenant,
38:         {},
39:         "tenantByNameError",
40:         function (response_Tenant) {
41:           that.getModel("SessionModel").getData().tenantId = JSON.parse(response_Tenant).id;
42:           that.makeAjaxRequest("GET", "company/getUser", {}, "getUserError", function (response) {
43:             that.getModel("SessionModel").getData().userId = response.id;
44:           });
45:         }
46:       );
47:       this.setModel(new sap.ui.model.json.JSONModel(), "WarehouseModel");
48:       this.setViewModel(this.getModel("WarehouseModel"), "WarehouseModel");
49:       this.makeAjaxRequest("GET", warehouseURL, null, "warehouseError", function (response) {
50:         that.getModel("WarehouseModel").setData(response);
51:         that.getModel("WarehouseModel").refresh();
52:         if (response.length === 1) {
53:           that.getViewModel("appView").setProperty("/layout", "TwoColumnsMidExpanded");
54:           that.getModel("SessionModel").getData().WarehouseCode = response[0].WarehouseCode;
55:           that.getModel("SessionModel").getData().EnableBinLocations = response[0].EnableBinLocations;
56:           that.getModel("SessionModel").refresh();
57:           that.getRouter().navTo("PurchaseDeliveryNote");
58:           that.oEventBus.publish("nAG", "hideBusyDialog");
59:         } else {
60:           if (that.getModel("WarehouseModel").getData().length === 1) {
61:             that.getModel("SessionModel").getData().WarehouseCode = that.getModel("WarehouseModel").getData()[0].WarehouseCode;
62:             that.getRouter().navTo("PurchaseDeliveryNote");
63:           }
64:           that.oEventBus.publish("nAG", "hideBusyDialog");
65:         }
66:       });
67:     },
68:     onItemPressed: function (oEvent) {
69:       this.oEventBus.publish("nAG", "showBusyDialog");
70:       const warehouse = oEvent.getSource().getSelectedItem().getBindingContext("WarehouseModel").getObject(),
71:             sessionModel = this.getModel("SessionModel").getData(),
72:             appViewModel = this.getViewModel("appView");
73:       this.getViewModel("appView").setProperty("/layout", "TwoColumnsMidExpanded");
74:       sessionModel.WarehouseCode = warehouse.WarehouseCode;
75:       sessionModel.EnableBinLocations = warehouse.EnableBinLocations === "tYES";
76:       sessionModel.WarehouseName = warehouse.WarehouseName;
77:       sessionModel.bookQSWarehouse = appViewModel.getProperty("/bookQSWarehouse");
78:       sessionModel.OrderPurchaseView = appViewModel.getProperty("/OrderPurchaseView");
79:       sessionModel.useCustomBatchGenerator = appViewModel.getProperty("/useCustomBatchGenerator");
80:       sessionModel.customBatchOperations = appViewModel.getProperty("/customBatchOperations");
81:       this.getModel("SessionModel").refresh();
82:       this.getRouter().navTo("PurchaseDeliveryNote");
83:     },
84:   });
85: });
