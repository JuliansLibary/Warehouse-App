131:      * @public
132:      */
133:     showBusyDialog: function () {
134:       this.getDebugMode() && console.log("busy dialog opened");
135:       var busyDialog = this.busyDialog;
136:       busyDialog.open();
137:     },
138:     /**
139:      * Convenience method for closing the BusyDialog
140:      * @public
141:      */
142:     hideBusyDialog: function () {
143:       this.getDebugMode() && console.log("busy dialog closed");
144:       var busyDialog = this.busyDialog;
145:       busyDialog.close();
146:     },
147:     /**
148:      * Convenience method for getting the count of a value 'val' inside a jsons property 'prop'
149:      * @public
150:      * @returns int
151:      */
152:     getCount: function (json, prop, val) {
153:       var count = 0;
154:       for (var i = 0; i < json.length; i++) {
155:         if (json[i][prop] === val) {
156:           count++;
157:         }
158:       }
159:       return count;
160:     },
161:     /**
162:      * showError(i18nFehlermeldung, zusätzlicheInformation, Fehlercode)
163:      */
164:     showError: function (extraInfo, errorCode) {
165:       var that = this;
166:       this.oEventBus.publish("nAG", "hideBusyDialog");
167:       var dialog = new Dialog({
168:         title: errorCode,
169:         type: "Message",
