2745:         // FIXED: Safer package context handling for backend call
2746:         let packageContextValue = null;
2747:         try {
2748:           if (packageContext) {
2749:             if (typeof packageContext === "string") {
2750:               // If it's already a string path, extract the package number
2751:               packageContextValue = packageContext.includes("/Package/") ? 
2752:                 packageContext.split("/Package/")[1] : packageContext;
2753:             } else if (typeof packageContext.getPath === "function") {
