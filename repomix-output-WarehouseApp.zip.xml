<file path="WarehouseApp/nAG.Warehouse.App.Pack/controller/modelSynchronizationController.js">
  1: /**
  2:  * MODEL SYNCHRONIZATION CONTROLLER
  3:  * ================================
  4:  * Handles all model state management and synchronization migrated from Detail.controller.js
  5:  * Responsible for data model updates, state synchronization, and model binding operations
  6:  */
  7: const { getLanguageFromRequest, createI18nResponse, createI18nErrorResponse } = require('../utils/i18nHelper');
  8: /**
  9:  * Synchronize pack list model with current data
 10:  * @param {Object} req - Express request object
 11:  * @param {Object} res - Express response object
 12:  */
 13: async function synchronizePackListModel(req, res) {
 14:   try {
 15:     const language = getLanguageFromRequest(req);
 16:     const { packListData, deliveryData } = req.body;
 17:     if (!packListData || !Array.isArray(packListData)) {
 18:       return res.status(400).send(createI18nErrorResponse('packListDataRequired', language, [], 400));
 19:     }
 20:     // Update pack list with current packed quantities from delivery
 21:     const synchronizedData = packListData.map(item => {
 22:       let currentlyPacked = 0;
 23:       if (deliveryData && deliveryData.Package) {
 24:         deliveryData.Package.forEach(pkg => {
 25:           if (pkg.DeliveryLines) {
 26:             pkg.DeliveryLines.forEach(line => {
 27:               if (isMatchingItem(line, item)) {
 28:                 if (item.ManageSerialNumbers === "Y") {
 29:                   currentlyPacked += (line.SerialNumbers?.length || 0);
 30:                 } else {
 31:                   currentlyPacked += (line.PackedQuantity || 0);
 32:                 }
 33:               }
 34:             });
 35:           }
 36:         });
 37:       }
 38:       return {
 39:         ...item,
 40:         PackedQuantity: currentlyPacked,
 41:         RemainingToPack: Math.max(0, (item.PickedQuantity || 0) - currentlyPacked),
 42:         visible: currentlyPacked !== (item.PickedQuantity || 0)
 43:       };
 44:     });
 45:     res.send({
 46:       synchronizedData,
 47:       totalItems: synchronizedData.length,
 48:       visibleItems: synchronizedData.filter(item => item.visible).length,
 49:       lastSync: new Date().toISOString()
 50:     });
 51:   } catch (error) {
 52:     const language = getLanguageFromRequest(req);
 53:     res.status(500).send(createI18nErrorResponse('errorSynchronizingPackList', language, [], 500, error.message));
 54:   }
 55: }
 56: /**
 57:  * Update model state after packing operations
 58:  * @param {Object} req - Express request object
 59:  * @param {Object} res - Express response object
 60:  */
 61: async function updateModelAfterPacking(req, res) {
 62:   try {
 63:     const language = getLanguageFromRequest(req);
 64:     const { modelData, packedItemData, packageNumber } = req.body;
 65:     if (!modelData || !packedItemData) {
 66:       return res.status(400).send(createI18nErrorResponse('modelDataAndPackedItemRequired', language, [], 400));
 67:     }
 68:     // Update pack list quantities
 69:     if (modelData.packList && Array.isArray(modelData.packList)) {
 70:       modelData.packList = modelData.packList.map(item => {
 71:         if (isMatchingItem(item, packedItemData)) {
 72:           const newPackedQuantity = (item.PackedQuantity || 0) + (packedItemData.PackedQuantity || 0);
 73:           return {
 74:             ...item,
 75:             PackedQuantity: newPackedQuantity,
 76:             RemainingToPack: Math.max(0, (item.PickedQuantity || 0) - newPackedQuantity),
 77:             PreviouslyPackedQuantity: item.PackedQuantity || 0
 78:           };
 79:         }
 80:         return item;
 81:       });
 82:     }
 83:     // Update delivery model
 84:     if (!modelData.delivery) {
 85:       modelData.delivery = { Package: [] };
 86:     }
 87:     // Ensure package exists
 88:     if (!modelData.delivery.Package[packageNumber]) {
 89:       modelData.delivery.Package[packageNumber] = {
 90:         PackageNumber: packageNumber,
 91:         DeliveryLines: []
 92:       };
 93:     }
 94:     // Find or create delivery line
 95:     const pkg = modelData.delivery.Package[packageNumber];
 96:     let existingLineIndex = pkg.DeliveryLines.findIndex(line => isMatchingItem(line, packedItemData));
 97:     if (existingLineIndex >= 0) {
 98:       // Update existing line
 99:       const existingLine = pkg.DeliveryLines[existingLineIndex];
100:       existingLine.PackedQuantity = (existingLine.PackedQuantity || 0) + (packedItemData.PackedQuantity || 0);
101:       if (packedItemData.SerialNumbers && packedItemData.SerialNumbers.length > 0) {
102:         if (!existingLine.SerialNumbers) existingLine.SerialNumbers = [];
103:         existingLine.SerialNumbers.push(...packedItemData.SerialNumbers);
104:       }
105:     } else {
106:       // Add new delivery line
107:       pkg.DeliveryLines.push({
108:         ...packedItemData,
109:         PackageNumber: packageNumber
110:       });
111:     }
112:     res.send({
113:       updatedModel: modelData,
