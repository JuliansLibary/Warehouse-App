  3:  * Handles all business logic that was previously in frontend Detail.controller.js
  4:  */
  5: /**
  6:  * Calculate comprehensive item quantities for packing operations (business logic)
  7:  * @param {Object} item - Item data
  8:  * @param {Object} deliveryData - Delivery data
  9:  * @returns {Object} Calculated quantities and status
 10:  */
 11: function calculateItemQuantitiesLogic(item, deliveryData) {
 12:   if (!item || !deliveryData) {
 13:     throw new Error("Item and delivery data are required");
 14:   }
 15:   const totalPickedQuantity = item.PickedQuantity || 0;
 16:   let actuallyPackedQuantity = 0;
 17:   // MIGRATED FROM FRONTEND: _calculateItemQuantities logic
 18:   if (deliveryData && deliveryData.Package && Array.isArray(deliveryData.Package)) {
 19:     deliveryData.Package.forEach((pkg) => {
 20:       if (pkg.DeliveryLines && Array.isArray(pkg.DeliveryLines)) {
 21:         pkg.DeliveryLines.forEach((line) => {
 22:           if (isMatchingItem(line, item)) {
 23:             if (item.ManageSerialNumbers === "Y") {
 24:               // For serial-managed items, count serial numbers
 25:               actuallyPackedQuantity += (line.SerialNumbers?.length || 0);
 26:             } else {
 27:               // For non-serial items, use PackedQuantity
 28:               actuallyPackedQuantity += (line.PackedQuantity || 0);
 29:             }
 30:           }
 31:         });
 32:       }
 33:     });
 34:   }
 35:   const remainingToPackQuantity = Math.max(0, totalPickedQuantity - actuallyPackedQuantity);
 36:   return {
 37:     success: true,
 38:     data: {
 39:       totalPickedQuantity,
 40:       actuallyPackedQuantity,
 41:       remainingToPackQuantity,
 42:       canPackMore: remainingToPackQuantity > 0,
 43:       isFullyPacked: actuallyPackedQuantity >= totalPickedQuantity,
 44:       // Additional data for frontend compatibility
 45:       visible: actuallyPackedQuantity !== totalPickedQuantity
 46:     }
 47:   };
 48: }
 49: /**
 50:  * Calculate comprehensive item quantities for packing operations (Express route handler)
 51:  * @param {Object} req - Express request object
 52:  * @param {Object} res - Express response object
 53:  */
 54: async function calculateItemQuantities(req, res) {
 55:   try {
 56:     const { item, deliveryData } = req.body;
 57:     const result = calculateItemQuantitiesLogic(item, deliveryData);
 58:     res.send(result.data);
 59:   } catch (error) {
 60:     res.status(500).send({
 61:       message: "Error calculating item quantities",
 62:       code: 500,
 63:       error: error.message
 64:     });
 65:   }
 66: }
 67: /**
 68:  * Validate packing operation to prevent overpacking
 69:  * @param {Object} req - Express request object
 70:  * @param {Object} res - Express response object
 71:  */
 72: async function validatePackingOperation(req, res) {
 73:   try {
 74:     const { itemData, requestedQuantity, deliveryData } = req.body;
 75:     // Calculate current quantities
 76:     const quantitiesResponse = await calculateItemQuantities({
 77:       body: { item: itemData, deliveryData }
 78:     }, {
 79:       send: (data) => data
 80:     });
 81:     if (requestedQuantity > quantitiesResponse.remainingToPackQuantity) {
 82:       return res.status(400).send({
 83:         isValid: false,
 84:         error: "OVERPACK_ATTEMPT",
 85:         message: `Only ${quantitiesResponse.remainingToPackQuantity} of ${quantitiesResponse.totalPickedQuantity} can be packed`,
 86:         allowedQuantity: quantitiesResponse.remainingToPackQuantity
 87:       });
 88:     }
 89:     res.send({
 90:       isValid: true,
 91:       allowedQuantity: requestedQuantity
 92:     });
 93:   } catch (error) {
 94:     res.status(500).send({
 95:       message: "Error validating packing operation",
 96:       code: 500,
 97:       error: error.message
 98:     });
 99:   }
100: }
101: /**
