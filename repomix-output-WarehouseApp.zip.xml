<file path="WarehouseApp/nAG.Warehouse.App.Pack/controller/cacheController.js">
 1: const axios = require("axios");
 2: const BASE_URL = "http://System-DatabaseConnector.warehouseapp:3000";
 3: async function checkCache(req, res) {
 4:   try {
 5:     const responseCache = await axios.get(`${BASE_URL}/Cache/${req.params.documentNumber}/${req.params.childElementDocumentNumber}/${req.params.module}/${req.params.tenantId}`);
 6:     if (responseCache.data.isDeleted) {
 7:       res.status(202).send(false);
 8:     } else {
 9:       res.send(responseCache.data);
10:     }
11:   } catch (missingCache) {
12:     if (missingCache.response && missingCache.response.status === 404) {
13:       res.status(209).send(false);
14:     } else {
15:       res.status(500).send(false);
16:     }
17:   }
18: }
19: async function saveCache(req, res) {
20:   try {
21:     const response = await axios.post(`${BASE_URL}/postCache`, {
22:       documentNumber: req.body.documentNumber,
23:       module: req.body.module,
24:       documentType: req.body.documentType,
25:       content: req.body.content,
26:       tenantId: req.body.tenantId,
27:       createDate: req.body.createDate,
28:       updateDate: req.body.updateDate,
29:       createdByUser: req.body.createdByUser,
30:       updatedByUser: req.body.updatedByUser,
31:       remark: req.body.remark,
32:       isDeleted: req.body.isDeleted,
33:       childElementDocumentNumber: req.body.childElementDocumentNumber
34:     });
35:     if (response.status === 201) {
36:       return res.status(201).send(true);
37:     }
38:   } catch (error) {
39:     return res.status(500).send(error);
40:   }
41: }
42: async function deleteCache(req, res) {
43:   try {
44:     const response = await axios.delete(`${BASE_URL}/deleteCache/${req.params.id}`, {
45:       data: {
46:         content: req.body.content,
47:       },
48:     });
49:     if (response.status === 204) {
50:       return res.status(201).send(true);
51:     }
52:   } catch (error) {
53:     return res.status(500).send(error);
54:   }
55: }
56: async function patchCache(req, res) {
57:   try {
58:     const response = await axios.patch(`${BASE_URL}/patchCache/${req.params.id}`, {
59:       content: req.body.content,
60:       updateDate: req.body.updateDate,
61:       updatedByUser: req.body.updatedByUser
62:     });
63:     if (response.status === 200 && response.data.length > 0) {
64:       return res.send(true);
65:     } else {
66:       return res.status(209).send(false);
67:     }
68:   } catch (error) {
69:     return res.status(500).send(error);
70:   }
71: }
72: module.exports = {
73:   checkCache,
74:   deleteCache,
75:   saveCache,
76:   patchCache,
77: };
</file>

<file path="WarehouseApp/nAG.Warehouse.App.Pack/controller/calculateController.js">
 1: async function calculateQuantitys(req, res) {
 2:   try {
 3:     const deliveryModel = JSON.parse(req.body.DeliveryModel);
 4:     const detailModel = JSON.parse(req.body.DetailModel);
 5:     let packageContext = req.body.PackageContext;
 6:     const parts = packageContext.split("/Package/");
 7:     packageContext = parts[1];
 8:     // Calculate packed quantities for detail model
 9:     detailModel.PackListLines.forEach((deliveryLine) => {
10:       if (Array.isArray(deliveryLine.SerialNumbers) && deliveryLine.SerialNumbers.length > 0) {
11:         deliveryLine.PackedQuantity = deliveryLine.SerialNumbers.length;
12:       }
13:     });
14:     // Update delivery model quantities
15:     detailModel.PackListLines.forEach((detailLine) => {
16:       deliveryModel.Package[packageContext].DeliveryLines.forEach((deliveryLine) => {
17:         if (
18:           detailLine.ItemCode === deliveryLine.ItemCode &&
19:           detailLine.ManageSerialNumbers === "Y" &&
20:           deliveryLine.ManageSerialNumbers === "Y"
21:         ) {
22:           if (Array.isArray(deliveryLine.SerialNumbers) && deliveryLine.SerialNumbers.length > 0) {
23:             deliveryLine.PackedQuantity = deliveryLine.SerialNumbers.length;
24:             deliveryLine.PreviouslyPackedQuantity = 0;
25:           }
26:         }
27:       });
28:     });
29:     // Filter out lines with zero packed quantity
30:     deliveryModel.Package[packageContext].DeliveryLines =
31:       deliveryModel.Package[packageContext].DeliveryLines.filter((deliveryLine) => {
32:         return parseInt(deliveryLine.PackedQuantity, 10) !== 0;
33:       });
34:     res.send({
35:       deliveryModel: JSON.stringify(deliveryModel),
36:       detailModel: JSON.stringify(detailModel),
37:     });
