284: async function cleanNote(purchaseDeliveryNote, callback) {
285:   let newLines = purchaseDeliveryNote.DocumentLines.filter((filtered) => {
286:     return filtered.Quantity > 0;
287:   });
288:   newLines.forEach((deliveryNoteLine, lineIndex) => {
289:     if (deliveryNoteLine.BatchNumbers) {
290:       deliveryNoteLine.BatchNumbers.forEach((batch) => {
291:         batch.BaseLineNumber = lineIndex;
292:       });
293:     }
294:     if (deliveryNoteLine.SerialNumbers) {
295:       deliveryNoteLine.SerialNumbers.forEach((serial) => {
296:         serial.BaseLineNumber = lineIndex;
297:       });
298:     }
299:     if (deliveryNoteLine.DocumentLinesBinAllocations) {
300:       let deliveryNoteBinLocation = [];
301:       deliveryNoteLine.DocumentLinesBinAllocations.forEach((allocation) => {
302:         allocation.BaseLineNumber = lineIndex;
303:         deliveryNoteBinLocation.push({
304:           SerialAndBatchNumbersBaseLine: allocation.SerialAndBatchNumbersBaseLine,
305:           BaseLineNumber: lineIndex,
306:           Quantity: allocation.Quantity,
307:           BinAbsEntry: allocation.BinAbsEntry,
308:         });
309:       });
310:       deliveryNoteLine.DocumentLinesBinAllocations = deliveryNoteBinLocation;
311:     }
312:   });
313:   purchaseDeliveryNote.DocumentLines = newLines;
314:   purchaseDeliveryNote.DocumentLines = purchaseDeliveryNote.DocumentLines.filter(function (line) {
315:     return !((line.TreeType === "N" || line.TreeType === "iNotATree" || line.TreeType === "iProductionTree" || line.TreeType === "iIngredient" || line.TreeType === "P") && line.Quantity === 0);
316:   });
317:   let lineNumbers = [];
318:   purchaseDeliveryNote.DocumentLines.forEach((line, idx) => {
319:     line.VisualOrder = idx;
320:     lineNumbers.push(line.BaseVisualOrder);
321:   });
322:   if (purchaseDeliveryNote.DocumentSpecialLines.length > 0) {
323:     for (let i = purchaseDeliveryNote.DocumentSpecialLines.length - 1; i >= 0; i--) {
324:       if (!lineNumbers.includes(purchaseDeliveryNote.DocumentSpecialLines[i].AfterLineNumber)) {
325:         if (purchaseDeliveryNote.DocumentSpecialLines[i].LineType === "dslt_Text") {
326:           let j = 0;
327:           while (lineNumbers[++j] < purchaseDeliveryNote.DocumentSpecialLines[i].AfterLineNumber);
328:           let closest = lineNumbers[--j];
329:           purchaseDeliveryNote.DocumentSpecialLines[i].AfterLineNumber = purchaseDeliveryNote.DocumentSpecialLines[i].AfterLineNumber < lineNumbers[0] ? -1 : lineNumbers.indexOf(closest);
330:         } else {
331:           purchaseDeliveryNote.DocumentSpecialLines.splice(i, 1);
332:         }
333:       } else {
334:         purchaseDeliveryNote.DocumentSpecialLines[i].AfterLineNumber = lineNumbers.indexOf(purchaseDeliveryNote.DocumentSpecialLines[i].AfterLineNumber);
335:       }
336:     }
337:     purchaseDeliveryNote.DocumentLines.forEach((line) => {
338:       delete line["BaseVisualOrder"];
339:     });
340:   }
341:   callback(null, purchaseDeliveryNote);
342: }
