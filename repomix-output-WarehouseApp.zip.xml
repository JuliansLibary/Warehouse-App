  1: sap.ui.define(["sap/ui/core/mvc/Controller", "sap/ui/core/EventBus", "sap/ui/core/routing/History", "sap/ui/model/json/JSONModel", "sap/ui/Device", "sap/m/MessageBox", "sap/m/Dialog", "sap/m/Text", "sap/m/Link", "sap/m/Button", "sap/ui/core/ValueState", "sap/m/VBox"], function (Controller, EventBus, History, JSONModel, Device, MessageBox, Dialog, Text, Link, Button, ValueState, VBox) {
  2:   return Controller.extend("nag.WarehouseApp.StockTransferRequest.BaseController", {
  3:     /**
  4:      * Convenience method for saving the BaseController in a global variable and creating fields that need to be accessed
  5:      * @public
  6:      */
  7:     register: function () {
  8:       this.oEventBus = sap.ui.getCore().getEventBus();
  9:       $.sap.control = this;
 10:       this.oEventBus.subscribe("nAG", "showBusyDialog", this.showBusyDialog, this);
 11:       this.oEventBus.subscribe("nAG", "hideBusyDialog", this.hideBusyDialog, this);
 12:     },
 13:     /**
 14:      *
 15:      * @param {String} method: Can be at nAG: POST,PATCH,GET
 16:      * @param {String} url:  url for the ajax Call
 17:      * @param {JSON} postContent : JSON Body for a patch/post
 18:      * @param {String} i18n : String for a call of the error dialogue via i18n
 19:      * @param {JSON} callback :  Returns a JSON after a successful Ajax call. Can be further used in the frontend
 20:      * NOTE: No IF is needed to build the postContent dynamically for the AJAX. With a GET, the postContent is not transferred to the backend.
 21:      */
 22:     makeAjaxRequest: function (method, url, postContent, callback) {
 23:       var that = this;
 24:       $.ajax({
 25:         url: url,
 26:         xhrFields: {
 27:           withCredentials: true,
 28:         },
 29:         data: postContent,
 30:         crossDomain: true,
 31:         type: method,
 32:         tryCount: 0,
 33:         retryLimit: 3,
 34:         headers: {
 35:           prefer: "odata.maxpagesize=0",
 36:         },
 37:         success: function (response, status, xhr) {
 38:           callback(response);
 39:         },
 40:         error: function (jqXHR, textStatus) {
 41:           if (textStatus === "timeout") {
 42:             this.tryCount++;
 43:             if (this.tryCount <= this.retryLimit) {
 44:               $.ajax(this);
 45:               return;
 46:             } else {
 47:               that.showError({ message: "NetworkError" }, "9000");
 48:             }
 49:           }
 50:           const { httpStatusCode, message } = jqXHR.responseJSON;
 51:           that.showError({ message }, httpStatusCode);
 52:         },
 53:       });
 54:     },
 55:     /**
 56:      * Convenience method for accessing the router in every controller of the application.
 57:      * @public
 58:      * @returns {sap.ui.core.routing.Router} the router for this component
 59:      */
 60:     getRouter: function () {
 61:       this.getDebugMode() && console.log("BASE GET ROUTER");
 62:       return sap.ui.core.UIComponent.getRouterFor(this);
 63:     },
 64:     /**
 65:      * Convenience method for getting the view model by name in every controller of the application.
 66:      * @public
 67:      * @param {string} sName the model name
 68:      * @returns {sap.ui.model.Model} the model instance
 69:      */
 70:     getModel: function (sName) {
 71:       this.getDebugMode() && console.log("BASE GET MODEL: " + sName);
 72:       return sap.ui.getCore().getModel(sName);
 73:     },
 74:     /**
 75:      * Convenience method for setting the view model in every controller of the application.
 76:      * @public
 77:      * @param {sap.ui.model.Model} oModel the model instance
