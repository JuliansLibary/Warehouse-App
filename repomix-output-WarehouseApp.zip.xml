 1: require("express");
 2: module.exports = {
 3:   prepareTransferForPost,
 4: };
 5: /*
 6:  * prepares Transfer for Post
 7:  * @param {json} Transfer Model with DocumentLines
 8:  */
 9: function prepareTransferForPost(transfers) {
10:   return new Promise(function (resolve, reject) {
11:     var newTransfer = {
12:       CardCode: transfers.CardCode,
13:       DocumentLines: [],
14:     };
15:     transfers.DocumentLines.forEach((transferLine, index) => {
16:       // for each DocumentLine the LineNum, ItemCode, Quantity, BatchNumber, SerialNumber and Bin Allocation gets added
17:       // BaseType  is InventoryTransferRequest. BaseType is not required if you use a simple InventoryTransfer.
18:       newTransfer.DocumentLines.push({
19:         LineNum: index,
20:         ItemCode: transferLine.ItemCode,
21:         Quantity: transferLine.Quantity,
22:         BatchNumbers: [],
23:         DocumentLinesBinAllocations: [],
24:         SerialNumbers: [],
25:         WarehouseCode: transferLine.WarehouseCode,
26:       });
27:       // If BatchNumber exists it gets added
28:       if (transferLine.BatchNumbers.length > 0) {
29:         transferLine.BatchNumbers.forEach((batch) => {
30:           newTransfer.DocumentLines[
31:             newTransfer.DocumentLines.length - 1
32:           ].BatchNumbers.push({
33:             BaseLineNumber: newTransfer.DocumentLines.length - 1,
34:             BatchNumber: batch.BatchNumber,
35:             Quantity: batch.Quantity,
36:           });
37:         });
38:       }
39:       // If SerialNumber exists it gets added
40:       if (transferLine.SerialNumbers.length > 0) {
41:         transferLine.SerialNumbers.forEach((serial) => {
42:           newTransfer.DocumentLines[
43:             newTransfer.DocumentLines.length - 1
44:           ].SerialNumbers.push({
45:             BaseLineNumber: serial.BaseLineNumber,
46:             InternalSerialNumber: serial.InternalSerialNumber,
47:             Quantity: serial.Quantity,
48:           });
49:         });
50:       }
51:       // If BinAllocation exists it gets added and set the BinActionType correct
52:       if (transferLine.DocumentLinesBinAllocations.length > 0) {
53:         transferLine.DocumentLinesBinAllocations.forEach((allocation) => {
54:           newTransfer.DocumentLines[
55:             newTransfer.DocumentLines.length - 1
56:           ].DocumentLinesBinAllocations.push({
57:             BaseLineNumber: newTransfer.DocumentLines.length - 1,
58:             BinAbsEntry: allocation.BinAbsEntry,
59:             Quantity: allocation.Quantity,
60:             SerialAndBatchNumbersBaseLine:
61:               allocation.SerialandBatchNumberBaseLine,
62:           });
63:         });
64:       }
65:     });
66:     resolve(newTransfer);
67:   });
68: }
</file>

