  7: /**
  8:  * Prepare data for serial number dialog
  9:  * @param {Object} req - Express request object
 10:  * @param {Object} res - Express response object
 11:  */
 12: async function prepareSerialNumberDialog(req, res) {
 13:   try {
 14:     const { itemData, deliveryData, packageNumber } = req.body;
 15:     if (!itemData || !itemData.ItemCode) {
 16:       return res.status(400).send({
 17:         message: "Item data with ItemCode is required",
 18:         code: 400
 19:       });
 20:     }
 21:     // Calculate available serial numbers
 22:     let availableSerials = [];
 23:     let alreadyPackedSerials = [];
 24:     // Get already packed serial numbers for this item
 25:     if (deliveryData && deliveryData.Package) {
 26:       deliveryData.Package.forEach(pkg => {
 27:         if (pkg.DeliveryLines) {
 28:           pkg.DeliveryLines.forEach(line => {
 29:             if (isMatchingItem(line, itemData) && line.SerialNumbers) {
 30:               alreadyPackedSerials.push(...line.SerialNumbers);
 31:             }
 32:           });
 33:         }
 34:       });
 35:     }
 36:     // Get available serial numbers from item's DocumentLinesBinAllocations
 37:     if (itemData.DocumentLinesBinAllocations && Array.isArray(itemData.DocumentLinesBinAllocations)) {
 38:       itemData.DocumentLinesBinAllocations.forEach(allocation => {
 39:         if (allocation.SerialAndBatchNumbersBaseLine && Array.isArray(allocation.SerialAndBatchNumbersBaseLine)) {
 40:           allocation.SerialAndBatchNumbersBaseLine.forEach(serial => {
 41:             if (serial.InternalSerialNumber && !alreadyPackedSerials.includes(serial.InternalSerialNumber)) {
 42:               availableSerials.push({
 43:                 InternalSerialNumber: serial.InternalSerialNumber,
 44:                 ManufacturerSerialNumber: serial.ManufacturerSerialNumber || serial.InternalSerialNumber,
 45:                 SystemSerialNumber: serial.SystemSerialNumber,
 46:                 BaseLineID: allocation.BaseLineID,
 47:                 BinAbsEntry: allocation.BinAbsEntry
 48:               });
 49:             }
 50:           });
 51:         }
 52:       });
 53:     }
 54:     const dialogData = {
 55:       itemData,
 56:       availableSerials,
 57:       alreadyPackedSerials,
 58:       packageNumber,
 59:       canSelectMultiple: true,
 60:       maxSelectableCount: availableSerials.length,
 61:       itemDescription: itemData.ItemDescription,
 62:       itemCode: itemData.ItemCode
 63:     };
 64:     res.send({
 65:       dialogData,
 66:       isValid: availableSerials.length > 0,
 67:       message: availableSerials.length === 0 ? "Keine verfügbaren Seriennummern" : `${availableSerials.length} Seriennummern verfügbar`
 68:     });
 69:   } catch (error) {
 70:     res.status(500).send({
 71:       message: "Error preparing serial number dialog",
 72:       code: 500,
 73:       error: error.message
 74:     });
 75:   }
 76: }
 77: /**
 78:  * Validate serial number selection
 79:  * @param {Object} req - Express request object
 80:  * @param {Object} res - Express response object
 81:  */
 82: async function validateSerialNumberSelection(req, res) {
 83:   try {
 84:     const { selectedSerials, dialogData } = req.body;
