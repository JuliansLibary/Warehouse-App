281:     },
282:     // #endregion
283:     // #region Utility Functions
284:     /**
285:      * Convenience method for getting the count of a value 'val' inside a jsons property 'prop'
286:      * @public
287:      * @returns int
288:      */
289:     getCount: function (json, prop, val) {
