<file path="WarehouseApp/nAG.Warehouse.App.SalesOrderDelivery/webapp/view/OpenOrders.view.xml">
 1: <mvc:View xmlns:mvc="sap.ui.core.mvc"
 2:   xmlns="sap.m"
 3:   xmlns:core="sap.ui.core"
 4:   xmlns:s="sap.f.semantic" controllerName="nag.WarehouseApp.SalesOrderDelivery.controller.openOrders"
 5:   xmlns:customData="http://schemas.sap.com/sapui5/extension/sap.ui.core.CustomData/1">
 6:   <s:SemanticPage id="pageOpenOrders">
 7:     <s:titleHeading>
 8:       <HBox alignItems="Center" justifyContent="SpaceBetween" width="100%">
 9:         <HBox alignItems="Center" justifyContent="Center" width="60%">
10:           <Text text="{i18n>selectedWarehouse}:" class="sapUiLargeText sapUiMediumMarginBegin" />
11:           <Button text="{SessionModel>/WarehouseName} / {SessionModel>/WarehouseCode} " class="sapUiLargeText sapUiMediumMarginBegin" />
12:         </HBox>
13:         <Text text="" width="120px"/>
14:       </HBox>
15:       <VBox>
16:         <Title xmlns="sap.m" text="{i18n>titleOpenOrders}" id="ttlBusinessPartners" />
17:         <HBox alignItems="Center" >
18:           <core:Icon src="sap-icon://factory" class="smallMarginRight"/>
19:           <Text text="{= ${SessionModel>/WarehouseName} + ' / ' + ${SessionModel>/WarehouseCode} }"/>
20:           <Button
21:           icon="sap-icon://collections-management"
22:           press="openWarehouseSelection"
23:           class="Default-Button-Padding"
24:           >
25:           </Button>
26:         </HBox>
27:       </VBox>
28:     </s:titleHeading>
29:     <s:titleCustomTextActions>
30:       <Button icon="sap-icon://home" press="onLogout" type="Transparent" class="myGhostButton"/>
31:     </s:titleCustomTextActions>
32:     <s:content>
33:       <List noDataText="{i18n>nDT}" id="lstopenOrders" itemPress="onItemPressed" mode="SingleSelectMaster" items="{
34: 					path: 'openOrdersModel>/',
35: 					groupHeaderFactory: '.createGroupHeader'
36: 				}">
37:         <items>
38:           <ObjectListItem icon="{=${openOrdersModel>BaseType} === 13 ? 'sap-icon://expense-report' : 'sap-icon://timesheet'}" type="Active" title="{=${openOrdersModel>BaseType} === 13 ? ${i18n>titlePurchaseInvoices} : ${i18n>titlePurchaseOrders}} {openOrdersModel>DocNum} " id="itmMaster" intro="{openOrdersModel>Comments}" number="{
39: 							path: 'openOrdersModel>DocDueDate'
40: 						}">
41:             <secondStatus>
42:               <ObjectStatus text="{openOrdersModel>NumAtCard}"/>
43:             </secondStatus>
44:             <attributes>
45:               <ObjectAttribute text="{openOrdersModel>CardName}"/>
46:             </attributes>
47:             <firstStatus>
48:               <ObjectStatus class="sapUiSmallMarginBottom" text="{i18n>deleteIntermediateState}" active="true" visible="{openOrdersModel>isCached}" state="Information" customData:AbsoluteEntry="{openOrdersModel>DocNum}" press="handleStatusPressed" icon="sap-icon://delete" />
49:             </firstStatus>
50:             <secondStatus>
51:               <ObjectStatus state="{
52: 									parts: [{
53: 										path: 'openOrdersModel>completeDelivery'
54: 									}],
55: 									formatter: '.formatter.pickState'
56: 								}" text="{
57: 									parts: [{
58: 										path: 'openOrdersModel>completeDelivery'
59: 									}],
60: 									formatter: '.formatter.pickStatus'
61: 								}" />
62:             </secondStatus>
63:             <markers>
64:               <ObjectMarker visibility="IconOnly" type="Locked" visible="{openOrdersModel>isLocked}" />
65:             </markers>
66:           </ObjectListItem>
67:         </items>
68:         <headerToolbar>
69:           <OverflowToolbar width="100%" id="tlb3">
70:             <SearchField id="sfd" tooltip="{i18n>WarehouseSearchTooltip}" width="100%" search="onSearch">
71:               <layoutData>
72:                 <OverflowToolbarLayoutData minWidth="150px" maxWidth="2000px" shrinkable="true" priority="NeverOverflow" />
73:               </layoutData>
74:             </SearchField>
75:             <ToolbarSpacer/>
76:             <Button id="filterButton" press="onOpenViewSettings" icon="sap-icon://settings" type="Transparent" tooltip="{i18n>sort}" />
77:             <Button id="refreshButton" icon="sap-icon://refresh" type="Transparent" tooltip="{i18n>refresh}" press="_getData" />
78:           </OverflowToolbar>
79:         </headerToolbar>
80:       </List>
81:     </s:content>
82:     <s:titleMainAction>
83:     </s:titleMainAction>
84:   </s:SemanticPage>
85: </mvc:View>
</file>

<file path="WarehouseApp/nAG.Warehouse.App.SalesOrderDelivery/webapp/view/orderDetail.view.xml">
 1: <mvc:View xmlns:core="sap.ui.core"
 2:   xmlns:mvc="sap.ui.core.mvc"
 3:   xmlns="sap.m"
 4:   xmlns:s="sap.f.semantic"
 5:   xmlns:t="sap.ui.table"
 6:   xmlns:html="http://www.w3.org/1999/xhtml" controllerName="nag.WarehouseApp.SalesOrderDelivery.controller.orderDetail">
 7:   <App>
 8:     <s:SemanticPage showFooter="true">
 9:       <s:titleHeading>
10:         <Title xmlns="sap.m" text="{i18n>TitleInfo} {openOrdersFrontend>/DocNum}" id="title0" wrapping="true" />
11:       </s:titleHeading>
12:       <s:closeAction>
13:         <s:CloseAction tooltip="{i18n>closeAction}" id="claDetail" press="onPressClose" />
14:       </s:closeAction>
15:       <s:footerCustomActions>
16:         <Button press="openSignature" icon="sap-icon://customer-order-entry" />
17:       </s:footerCustomActions>
18:       <s:footerCustomActions>
19:         <Button icon="sap-icon://camera" press="OpenFragment" />
20:       </s:footerCustomActions>
21:       <s:positiveAction>
22:         <s:PositiveAction text="{i18n>CreateDelivery}" id="action0" press="onCreateDelivery" />
23:       </s:positiveAction>
24:       <s:content>
25:         <VBox width="100%" direction="Column" id="vbox0">
26:           <items>
27:             <t:TreeTable id="treeTable" visibleRowCountMode="Fixed" visibleRowCount="20" cellClick="onDeleteRow" selectionMode="None" selectionBehavior="RowOnly" width="100%" rows="{
28: 								path: 'openOrdersFrontend>/DocumentLines',
29: 								sorter: {
30: 									path: 'ItemCode'
31: 								},
32: 								parameters: {
33: 									countMode: 'Inline',
34: 									treeAnnotationProperties: {
35: 										hierarchyLevelFor: 'HierarchyLevel',
36: 										hierarchyNodeFor: 'NodeID',
37: 										hierarchyParentNodeFor: 'ParentNodeId',
38: 										hierarchyDrillStateFor: 'DrillState'
39: 									}
40: 								}
41: 							}">
42:               <t:extension>
43:                 <OverflowToolbar style="Clear">
44:                   <Button class="Button_packScan" type="Emphasized" press="packScan" id="btnPackScan" icon="sap-icon://bar-code" text="{i18n>packScan}" enabled="{buttonModel>/buttonsEnabled}" />
45:                 </OverflowToolbar>
46:               </t:extension>
47:               <t:columns>
48:                 <t:Column label="{i18n>ItemCode}" autoResizable="true">
49:                   <t:template>
50:                     <VBox alignItems="Start">
51:                       <items>
52:                         <HBox id="Clickable_Hbox">
53:                           <core:Icon class="IconTreeTable" src="sap-icon://sap-box" visible="{=${openOrdersFrontend>_id} >= 1 ? true : false}" />
54:                           <core:Icon class="IconTreeTableSerialNumbers" src="sap-icon://tags" visible="{=${openOrdersFrontend>ManageSerialNumbers} >= tYES ? true : false}" />
55:                           <Text class="textTreeTable" text="{openOrdersFrontend>ItemCode}" wrapping="true" textAlign="Begin" />
56:                         </HBox>
57:                         <Text text="{openOrdersFrontend>ItemDescription}" wrapping="true" textAlign="Begin" visible="{=${openOrdersFrontend>_id} >= 1 ? false : true}" />
58:                       </items>
59:                     </VBox>
60:                   </t:template>
61:                 </t:Column>
62:                 <t:Column label="{i18n>RequiredQuantity}" width="9%">
63:                   <t:template>
64:                     <Text text="{openOrdersFrontend>Quantity}  / {openOrdersFrontend>RemainingOpenQuantity}" wrapping="false" />
65:                   </t:template>
66:                 </t:Column>
67:               </t:columns>
68:             </t:TreeTable>
69:             <VBox/>
70:           </items>
71:         </VBox>
72:       </s:content>
73:     </s:SemanticPage>
74:   </App>
75: </mvc:View>
</file>

