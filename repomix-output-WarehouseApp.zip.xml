2461:         if (foundInSession) {
2462:           return {
2463:             isDuplicate: true,
2464:             location: "aktuellem Dialog",
2465:             code: 409,
2466:             isDuplicateError: true,
2467:             duplicateContext: "currentSession",
2468:             duplicatePackage: 0
