  1: const request = require("request");
  2: // Check cache
  3: async function checkCache(req, res) {
  4:   request.get(`http://System-DatabaseConnector.warehouseapp:3000/Cache/${req.params.documentNumber}/${req.params.module}/${req.params.tenantId}`, {}, (error, response) => {
  5:     if (!error && response.statusCode === 200 && response.body.length > 0 && response.body !== "null") {
  6:       const cacheData = JSON.parse(response.body);
  7:       if (cacheData.isDeleted) {
  8:         res.status(204).send(false); // No access due to deletion
  9:       } else {
 10:         res.send(cacheData);
 11:       }
 12:     } else {
 13:       res.status(209).send(false); // Cache not found or error
 14:     }
 15:   });
 16: }
 17: // Save cache
 18: async function saveCache(req, res) {
 19:   request.post(
 20:     "http://System-DatabaseConnector.warehouseapp:3000/postCache",
 21:     {
 22:       json: {
 23:         documentNumber: req.body.documentNumber,
 24:         module: req.body.module,
 25:         documentType: req.body.documentType,
 26:         content: req.body.content,
 27:         tenantId: req.body.tenantId,
 28:         createDate: req.body.createDate,
 29:         updateDate: req.body.updateDate,
 30:         createdByUser: req.body.createdByUser,
 31:         updatedByUser: req.body.updatedByUser,
 32:         remark: req.body.remark,
 33:         isDeleted: req.body.isDeleted,
 34:       },
 35:     },
 36:     (error, response) => {
 37:       if (!error && response.statusCode === 201) {
 38:         return res.send(true);
 39:       } else {
 40:         return res.status(500).send(false); // Error saving cache
 41:       }
 42:     }
 43:   );
 44: }
 45: // Delete cache
 46: async function deleteCache(req, res) {
 47:   request.delete(
 48:     `http://System-DatabaseConnector.warehouseapp:3000/deleteCache/${req.params.id}`,
 49:     {
 50:       json: {
 51:         content: req.body.content,
 52:       },
 53:     },
 54:     (error, response) => {
 55:       if (!error && response.statusCode === 204) {
 56:         return res.send(true);
 57:       } else {
 58:         return res.status(500).send(false); // Error deleting cache
 59:       }
 60:     }
 61:   );
 62: }
 63: // Patch cache
 64: async function patchCache(req, res) {
 65:   request.patch(
 66:     `http://System-DatabaseConnector.warehouseapp:3000/patchCache/${req.params.id}`,
 67:     {
 68:       json: {
 69:         content: req.body.content,
 70:         updateDate: req.body.updateDate,
 71:         updatedByUser: req.body.updatedByUser,
 72:       },
 73:     },
 74:     (error, response) => {
 75:       if (!error && response.statusCode === 200 && response.body.length > 0) {
 76:         return res.send(true);
 77:       } else {
 78:         return res.status(209).send(false); // Error patching cache
 79:       }
 80:     }
 81:   );
 82: }
 83: // Patch cache with content
 84: async function patchCacheWithContent(req, res) {
 85:   request.patch(
 86:     `http://System-DatabaseConnector.warehouseapp:3000/patchCache/${req.params.id}`,
 87:     {
 88:       json: {
 89:         content: req.body.content,
 90:       },
 91:     },
 92:     (error, response) => {
 93:       if (!error && response.statusCode === 200) {
 94:         return res.send(true);
 95:       } else {
 96:         return res.send(false);
 97:       }
 98:     }
