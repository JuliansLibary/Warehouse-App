125: // Create a GS1 Code with seperator Code shown under the GS1 Code
126: async function getGS1(req, callback) {
127:   let seperatorCode = "";
128:   // AI (01) - GTIN, muss 14-stellig sein
129:   if (req.ItemCode && req.BarCode) {
130:     let paddedBarCode = req.BarCode.padStart(14, "0"); // Füllt mit führenden Nullen auf, falls kürzer als 14
131:     seperatorCode = "(01)" + paddedBarCode;
132:   }
133:   // AI (10) - Batch/Lot Number (frei definierbare Länge)
134:   if (req.BatchNumber) {
135:     seperatorCode = seperatorCode + "(10)" + req.BatchNumber;
136:   }
137:   // AI (11) - Produktionsdatum (YYMMDD)
138:   if (req.ManufacturingDate) {
139:     seperatorCode = seperatorCode + "(11)" + req.ManufacturingDate;
140:   }
141:   // AI (15) - Verfallsdatum (YYMMDD)
142:   if (req.ExpirationDate) {
143:     seperatorCode = seperatorCode + "(15)" + req.ExpirationDate;
144:   }
145:   // AI (30) - Menge (frei definierbar)
146:   if (req.Quantity) {
147:     seperatorCode = seperatorCode + "(30)" + req.Quantity;
148:   }
149:   bwipjs.toBuffer(
150:     {
151:       bcid: "gs1-128",
152:       text: seperatorCode,
153:       includetext: true,
154:       textxalign: "center",
155:       textfont: "INCONS", // Use the custom font
156:       textsize: 4, // Adjust as necessary
157:     },
158:     function (error, buffer) {
159:       if (error) {
160:         // kann nicht funktionieren. Gibt kein res //goback
161:         callback(error);
162:       } else {
163:         callback(null, `data:image/jpg;base64,${buffer.toString("base64")}`);
164:       }
165:     }
166:   );
167: }
168: function _createBarcode(req) {
169:   return new Promise((resolve, reject) => {
170:     getBarcode(req, async function (error, resp) {
171:       if (error) {
172:         reject(error);
173:       } else {
174:         resolve(resp);
175:       }
176:     });
177:   });
178: }
179: // Create a Code128 with Barcode from SAP oder the ItemCode
180: async function getBarcode(req, callback) {
181:   const text = req.ItemCode || req.BarCode || req;
182:   bwipjs.toBuffer(
183:     {
184:       bcid: "code128",
185:       text: text,
186:       scale: 3,
187:       height: 10,
188:       includetext: true,
189:       textxalign: "center",
190:     },
191:     (error, buffer) => {
192:       if (error) {
193:         callback(error);
194:       } else {
195:         callback(null, `data:image/png;base64,${buffer.toString("base64")}`);
196:       }
197:     }
198:   );
199: }
