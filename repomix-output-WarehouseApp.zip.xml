135:                         console.error("XHR statusText:", xhr.statusText);
136:                         console.error("XHR responseText:", xhr.responseText);
137:                         console.error("Status:", status);
138:                         const errorMessage = xhr.responseJSON?.message || xhr.responseText || "Unknown error";
139:                         console.error("Final error message:", errorMessage);
140:                         reject(new Error(errorMessage));
141:                     }
142:                 );
143:             });
144:         },
145:         // ===============================
146:         // WAREHOUSE OPERATIONS API CALLS
147:         // ===============================
148:         /**
