151: async function addPackLine(req, res) {
152:   const object = JSON.parse(req.body.object);
153:   const quantity = parseInt(req.body.quantity);
154:   const binLocation = req.body.binLocation;
155:   const itemCode = req.body.itemCode;
156:   object.DocumentLinesBinAllocations = object.DocumentLinesBinAllocations || [];
157:   object.BatchNumbers = object.BatchNumbers || [];
158:   object.SerialNumbers = object.SerialNumbers || [];
159:   if (typeof object.DocumentLinesBinAllocations !== "undefined") {
160:     const findLocation = object.DocumentLinesBinAllocations.find((binAlloc) => binAlloc.BinAbsEntry === binLocation);
161:     if (findLocation) {
162:       // Location found, increase quantity
163:       object.DocumentLinesBinAllocations.forEach((binLocationLine) => {
164:         if (parseInt(binLocationLine.BinAbsEntry) === parseInt(findLocation.BinAbsEntry)) {
