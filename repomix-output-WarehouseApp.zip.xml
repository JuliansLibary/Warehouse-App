3090:           const { AbsoluteEntry, DocEntry } = detailModelData;
3091:           const tenantId = that.getModel("SessionModel").getData().tenantId;
3092:           that.makeAjaxRequest("GET", `documentLock/checkdocumentLock/${AbsoluteEntry}/${DocEntry}/Pack/${tenantId}`, null, (response_getDocumentLock) => {
3093:             const documentLock = response_getDocumentLock;
3094:             if (documentLock) {
3095:               const currentDate = new Date();
3096:               if (checkFromWorker && new Date(Date.parse(documentLock.latestChangeDate)).getTime() + parseInt(that.getViewModel("appView").getProperty("/documentLockTimer")) * 60000 < currentDate.getTime()) {
3097:                 return reject(522);
3098:               }
3099:               that.makeAjaxRequest("GET", `user/compareCurrentUser/${documentLock.createUserLock}`, null, (response_getCurrentUser) => {
3100:                 if (response_getCurrentUser === true) {
3101:                   resolve(200);
3102:                 } else {
3103:                   reject(401);
3104:                 }
3105:               });
3106:             } else {
3107:               resolve(200);
3108:             }
3109:           });
3110:         } catch (error) {
3111:           // Error handled
3112:           reject(500);
3113:         }
3114:       });
3115:     },
