<file path="WarehouseApp/nAG.Warehouse.App.AdminPanel/setup-docker-tcp.sh">
 1: #!/bin/bash
 2: # Docker Daemon TCP Setup Script
 3: # Dieses Script konfiguriert Docker für TCP Zugriff auf Port 2375
 4: echo "=== Docker Daemon TCP Konfiguration ==="
 5: # Schritt 1: Backup der bestehenden Konfiguration
 6: if [ -f /etc/docker/daemon.json ]; then
 7:     echo "Erstelle Backup der bestehenden daemon.json..."
 8:     sudo cp /etc/docker/daemon.json /etc/docker/daemon.json.backup.$(date +%Y%m%d_%H%M%S)
 9: fi
10: # Schritt 2: Docker Daemon Konfiguration erstellen
11: echo "Erstelle neue Docker Daemon Konfiguration..."
12: sudo tee /etc/docker/daemon.json > /dev/null <<EOF
13: {
14:   "hosts": [
15:     "tcp://0.0.0.0:2375",
16:     "unix:///var/run/docker.sock"
17:   ]
18: }
19: EOF
20: # Schritt 3: Systemd Service überschreiben (falls nötig)
21: echo "Prüfe Docker Service Konfiguration..."
22: if systemctl cat docker.service | grep -q "\-H"; then
23:     echo "Docker Service hat -H Parameter, überschreibe diese..."
24:     sudo mkdir -p /etc/systemd/system/docker.service.d
25:     sudo tee /etc/systemd/system/docker.service.d/override.conf > /dev/null <<EOF
26: [Service]
27: ExecStart=
28: ExecStart=/usr/bin/dockerd
29: EOF
30: fi
31: # Schritt 4: Docker neu starten
32: echo "Starte Docker neu..."
33: sudo systemctl daemon-reload
34: sudo systemctl restart docker
35: # Schritt 5: Status prüfen
36: echo "Prüfe Docker Status..."
37: if systemctl is-active --quiet docker; then
38:     echo "✅ Docker läuft erfolgreich"
39: else
40:     echo "❌ Docker konnte nicht gestartet werden"
41:     echo "Logs:"
42:     sudo journalctl -u docker.service --no-pager -n 10
43:     exit 1
44: fi
45: # Schritt 6: Port 2375 prüfen
46: echo "Prüfe ob Port 2375 verfügbar ist..."
47: if netstat -tlnp 2>/dev/null | grep -q ":2375" || ss -tlnp 2>/dev/null | grep -q ":2375"; then
48:     echo "✅ Docker API ist auf Port 2375 erreichbar"
49: else
50:     echo "❌ Port 2375 ist nicht erreichbar"
51:     echo "Prüfe Docker Logs für Details:"
52:     sudo journalctl -u docker.service --no-pager -n 10
53:     exit 1
54: fi
55: # Schritt 7: API Test
56: echo "Teste Docker API..."
57: if curl -s http://localhost:2375/version > /dev/null; then
58:     echo "✅ Docker API funktioniert korrekt"
59:     echo "Docker Version:"
60:     curl -s http://localhost:2375/version | python3 -m json.tool 2>/dev/null || curl -s http://localhost:2375/version
61: else
62:     echo "❌ Docker API Test fehlgeschlagen"
63: fi
64: echo ""
65: echo "=== Konfiguration abgeschlossen ==="
66: echo "Docker API ist jetzt unter http://127.17.0.1:2375 erreichbar"
67: echo ""
68: echo "⚠️  SICHERHEITSHINWEIS:"
69: echo "   Port 2375 ist unverschlüsselt und sollte nur in vertrauenswürdigen Netzwerken verwendet werden!"
70: echo "   Für Produktionsumgebungen verwenden Sie TLS (Port 2376) oder Docker Socket Volume Mounts."
71: echo ""
72: echo "Nächste Schritte:"
73: echo "1. AdminPanel Container neu starten: docker-compose restart"
74: echo "2. Logs des AdminPanel prüfen: docker-compose logs adminpanel"
</file>

<file path="WarehouseApp/nAG.Warehouse.App.AdminPanel/test-container-network.sh">
 1: #!/bin/bash
 2: echo "=== Container -> Host Netzwerk Test ==="
 3: echo "Teste Verbindung vom Container zum Host..."
 4: # Test verschiedene Host-Adressen
 5: HOSTS=(
 6:   "172.17.0.1"
 7:   "host.docker.internal"
 8:   "gateway.docker.internal"
 9:   "127.17.0.1"
10: )
11: for host in "${HOSTS[@]}"; do
12:   echo -e "\n--- Testing $host ---"
13:   # Ping Test
14:   if ping -c 1 -W 2 "$host" > /dev/null 2>&1; then
15:     echo "✅ Ping zu $host erfolgreich"
16:   else
17:     echo "❌ Ping zu $host fehlgeschlagen"
18:   fi
19:   # Port 2375 Test mit nc (netcat)
20:   if command -v nc >/dev/null 2>&1; then
21:     if nc -z -w2 "$host" 2375 2>/dev/null; then
22:       echo "✅ Port 2375 auf $host ist erreichbar"
23:     else
24:       echo "❌ Port 2375 auf $host ist NICHT erreichbar"
25:     fi
26:   fi
27:   # Curl Test zur Docker API
28:   if curl -s --connect-timeout 3 "http://$host:2375/version" > /dev/null 2>&1; then
29:     echo "✅ Docker API auf $host:2375 funktioniert"
30:     echo "Docker Version:"
31:     curl -s "http://$host:2375/version" | head -3 2>/dev/null || echo "Konnte Version nicht abrufen"
32:   else
33:     echo "❌ Docker API auf $host:2375 nicht erreichbar"
34:   fi
35: done
36: echo -e "\n=== Netzwerk-Informationen ==="
37: echo "Container IP Adressen:"
38: hostname -I 2>/dev/null || ip addr show
39: echo -e "\nRouting Tabelle:"
40: route -n 2>/dev/null || ip route show
41: echo -e "\nDNS Auflösung:"
42: nslookup host.docker.internal 2>/dev/null || echo "host.docker.internal kann nicht aufgelöst werden"
43: echo -e "\n=== Installation von Tools (falls benötigt) ==="
44: if ! command -v nc >/dev/null 2>&1; then
45:   echo "netcat ist nicht installiert. Installiere..."
46:   apt-get update && apt-get install -y netcat 2>/dev/null || echo "Konnte netcat nicht installieren"
47: fi
48: if ! command -v curl >/dev/null 2>&1; then
49:   echo "curl ist nicht installiert. Installiere..."
50:   apt-get update && apt-get install -y curl 2>/dev/null || echo "Konnte curl nicht installieren"
51: fi
</file>

