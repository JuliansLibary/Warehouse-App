  1: "use strict";
  2: const fs = require("fs");
  3: const https = require("https");
  4: const http = require("http");
  5: const express = require("express");
  6: const { createProxyMiddleware } = require("http-proxy-middleware");
  7: const { requiresAuth } = require("express-openid-connect");
  8: const jose = require("jose");
  9: const { routes } = require("./routes");
 10: const { generateAuthentification } = require("./proxy");
 11: const {
 12:   metrics,
 13:   requestTapMiddleware,
 14:   markProxyRequest,
 15:   markProxyResponse,
 16:   markProxyError,
 17: } = require("./metrics");
 18: const { mountManagerRoutes } = require("./managerRoutes");
 19: /* ================================
 20:  * KONFIGURATION
 21:  * ================================ */
 22: const HTTPS_PORT = 3001;
 23: const TLS_OPTIONS = {
 24:   key: fs.readFileSync("./cert/localhost/key.pem"),
 25:   cert: fs.readFileSync("./cert/localhost/certificate.pem"),
 26: };
 27: const IDENTITY_ENDPOINTS = [
 28:   "http://Module-AdminPanel.warehouseapp:8005/businesslogic/getIdentity/",
 29:   "http://Module-AdminPanel.warehouseapp:8005/identity/getIdentity",
 30: ];
 31: const SERVICE_LAYER_CACHE_TTL_MS = 60_000;
 32: const READY_RECHECK_INTERVAL_MS = 10_000;
 33: const REQUEST_TIMEOUT_MS = 30_000;
 34: const LAUNCHPAD_PREFIX = "/launchpad";
 35: const LAUNCHPAD_PATHS = ["/launchpad", "/launchpad/"];
 36: /* ================================
 37:  * APP & LAUFZEIT-STATUS
 38:  * ================================ */
 39: const app = express();
 40: app.set("trust proxy", 1);
 41: const runtimeState = {
 42:   phase: "pending",
 43:   identity: { clientId: null, baseUrl: null, secret: null },
 44:   authInitialized: false,
 45:   routesMounted: false,
 46:   mountedTargets: [],
 47:   lastIdentityFetch: {
 48:     ok: false,
 49:     url: null,
 50:     status: null,
 51:     raw: null,
 52:     error: null,
 53:   },
 54:   startedAt: new Date().toISOString(),
 55: };
 56: const serviceLayerCache = new Map();
 57: /* ================================
 58:  * HELPERS
 59:  * ================================ */
 60: function isLaunchpadPath(pathname) {
 61:   const lowercased = pathname.toLowerCase();
 62:   return lowercased === "/launchpad" || lowercased === "/launchpad/";
 63: }
 64: function decodeJwtSafely(token) {
 65:   try {
 66:     return token ? jose.decodeJwt(String(token)) : null;
 67:   } catch {
 68:     return null;
 69:   }
 70: }
 71: function httpGetRaw(url) {
 72:   return new Promise((resolve, reject) => {
 73:     const httpModule = url.startsWith("https") ? https : http;
 74:     const req = httpModule.get(url, (res) => {
 75:       let body = "";
 76:       res.on("data", (chunk) => {
 77:         body += chunk;
 78:       });
 79:       res.on("end", () => resolve({ status: res.statusCode, raw: body }));
 80:     });
 81:     req.on("error", reject);
 82:     req.end();
 83:   });
 84: }
 85: function parseJsonSafely(raw) {
 86:   try {
 87:     return JSON.parse(raw);
 88:   } catch {
 89:     return null;
 90:   }
 91: }
 92: function normalizeIdentity(parsed) {
 93:   if (!parsed) return null;
 94:   const row = Array.isArray(parsed) ? parsed[0] : parsed;
 95:   if (!row) return null;
 96:   const clientId =
 97:     row.clientID ?? row.clientId ?? row.ClientID ?? row.ClientId ?? null;
 98:   const baseUrl =
 99:     row.baseURL ??
100:     row.baseUrl ??
101:     row.BaseURL ??
102:     row.BaseUrl ??
103:     row.issuerBaseURL ??
104:     null;
105:   const secret = row.secret ?? row.Secret ?? row.SECRET ?? null;
106:   return clientId && baseUrl && secret ? { clientId, baseUrl, secret } : null;
107: }
108: function redirectSafelyToLaunchpad(req, res, next) {
109:   if (req.method !== "GET") return res.status(403).send("Forbidden");
110:   if (isLaunchpadPath(req.path)) return next();
111:   return res.redirect("/launchpad/");
112: }
113: async function getWithTimeout(
114:   url,
115:   options = {},
116:   timeoutMs = REQUEST_TIMEOUT_MS
117: ) {
118:   const controller = new AbortController();
119:   const timer = setTimeout(() => controller.abort(), timeoutMs);
120:   try {
121:     const response = await fetch(url, {
122:       ...options,
123:       signal: controller.signal,
124:     });
125:     const text = await response.text();
126:     let json = null;
127:     try {
128:       json = JSON.parse(text);
129:     } catch {}
130:     return { ok: response.ok, status: response.status, json, text };
131:   } finally {
132:     clearTimeout(timer);
133:   }
134: }
135: app.use((req, res, next) => {
136:   req.setTimeout(REQUEST_TIMEOUT_MS, () => {
137:     if (!res.headersSent) res.status(504).send("Gateway Timeout");
138:   });
139:   next();
140: });
141: app.use(requestTapMiddleware);
142: /* ================================
143:  * Health
144:  * ================================ */
145: app.get("/health", (_req, res) =>
146:   res.json({
147:     phase: runtimeState.phase,
148:     authInitialized: runtimeState.authInitialized,
149:     routesMounted: runtimeState.routesMounted,
150:     mountedTargets: runtimeState.mountedTargets,
151:     startedAt: runtimeState.startedAt,
152:   })
153: );
154: app.get("/health_identity", (_req, res) =>
155:   res.json(runtimeState.lastIdentityFetch)
156: );
157: /* ================================
158:  * nAG Interner Stuff: Balancer-Manager,Metrics
159:  * ================================ */
160: mountManagerRoutes(app, metrics);
161: /* ================================
162:  * ADMIN-PANEL
163:  * ================================ */
164: const adminPanelRoute = routes.find(
165:   (routeDef) => routeDef.url.toLowerCase() === "/adminpanelidentity"
166: );
167: if (!adminPanelRoute)
168:   throw new Error("Route '/AdminPanelIdentity' fehlt in routes.js");
169: const adminPanelProxy = createProxyMiddleware({
170:   target: adminPanelRoute.proxy.target,
171:   changeOrigin: adminPanelRoute.proxy.changeOrigin,
172:   pathRewrite: adminPanelRoute.proxy.pathRewrite,
173:   autoRewrite: true,
174:   logLevel: "silent",
175:   onProxyReq: (proxyReq, req) => {
176:     const bearerHeader = req.headers.authorization;
177:     if (bearerHeader) proxyReq.setHeader("Authorization", bearerHeader);
178:     proxyReq.setHeader("ServiceLayerCredentials", "false");
179:   },
180:   onError: (_error, _req, res) => {
181:     if (!res.headersSent) res.status(502).send("Bad Gateway");
182:   },
183: });
184: app.use("/AdminPanelIdentity", adminPanelProxy);
185: /* ================================
186:  * ROOT-REDIRECT
187:  * ================================ */
188: app.get("/", (_req, res) => {
189:   const targetPath =
190:     runtimeState.phase === "ready" ? "/launchpad/" : "/AdminPanelIdentity/";
191:   res.redirect(targetPath);
192: });
193: /* ================================
194:  * IDENTITY -> READY
195:  * ================================ */
196: async function fetchIdentity() {
197:   for (const identityUrl of IDENTITY_ENDPOINTS) {
198:     try {
199:       const { status, raw } = await httpGetRaw(identityUrl);
200:       const identityCandidate = normalizeIdentity(parseJsonSafely(raw));
201:       runtimeState.lastIdentityFetch = {
202:         ok: !!identityCandidate,
203:         url: identityUrl,
204:         status,
205:         raw: identityCandidate ? undefined : raw,
206:         error: identityCandidate ? null : "invalid-identity",
207:       };
208:       if (identityCandidate) return identityCandidate;
209:     } catch (error) {
210:       runtimeState.lastIdentityFetch = {
211:         ok: false,
212:         url: identityUrl,
213:         status: null,
214:         raw: null,
215:         error: String(error?.message || error),
216:       };
217:     }
218:   }
219:   return null;
220: }
221: async function activateReady() {
222:   const identityConfig = await fetchIdentity();
223:   if (!identityConfig) return false;
224:   runtimeState.identity = identityConfig;
225:   if (!runtimeState.authInitialized) {
226:     generateAuthentification(app, runtimeState.identity);
227:     runtimeState.authInitialized = true;
228:     console.info("[proxy] OIDC ready");
229:   }
230:   if (!runtimeState.routesMounted) {
231:     mountRoutesOnce();
232:     runtimeState.routesMounted = true;
233:     console.info("[proxy] routes mounted");
234:   }
235:   runtimeState.phase = "ready";
236:   console.info("[proxy] phase=ready");
237:   return true;
238: }
239: app.use(async (req, res, next) => {
240:   if (runtimeState.phase === "ready") return next();
241:   const lowerPath = req.path.toLowerCase();
242:   const isHealthOrAdmin =
243:     lowerPath.startsWith("/_health") ||
244:     lowerPath.startsWith("/adminpanelidentity");
245:   if (isHealthOrAdmin) return next();
246:   const becameReady = await activateReady();
247:   if (becameReady) return next();
248:   return adminPanelProxy(req, res, next);
249: });
250: /* ================================
251:  * API (wie Produktion)
252:  * ================================ */
253: app.all("/api/Info", (req, res) => {
254:   const tokenClaims = decodeJwtSafely(req.headers.authorization);
255:   const roleNames =
256:     tokenClaims?.WarehouseAppRoles?.map(
257:       (roleEntry) => roleEntry.split("_")[1]
258:     ) ?? [];
259:   const services = routes.map((routeDef) => ({
260:     name: routeDef.name,
261:     path: routeDef.route,
262:     hasLicense: roleNames.includes(routeDef.name),
263:     nameConfig: routeDef.nameConfig,
264:   }));
265:   res.json({ services });
266: });
267: app.all("/api/AdminpanelModules", (_req, res) => {
268:   const services = routes
269:     .filter((routeDef) => routeDef.configurable)
270:     .map((routeDef) => ({
271:       name: routeDef.name,
272:       path: routeDef.route,
273:       hasLicense: true,
274:       nameConfig: routeDef.nameConfig,
275:     }));
276:   res.json({ services });
277: });
278: /* ================================
279:  * SERVICE-LAYER Credentials
280:  * ================================ */
281: async function lookupServiceLayerUser(username) {
282:   const url = `http://System-DatabaseConnector.warehouseapp:3000/User/${encodeURIComponent(
283:     username
284:   )}`;
285:   const { ok, status, json } = await getWithTimeout(url, { method: "GET" });
286:   if (!ok || status !== 200 || !json) return null;
287:   if (!json.SLUsername || !json.SLPassword) return null;
288:   return { user: json.SLUsername, pass: json.SLPassword };
289: }
290: async function getInstanceId() {
291:   const url = "http://System-DatabaseConnector.warehouseapp:3000/Instances";
292:   const { ok, status, json } = await getWithTimeout(url, { method: "GET" });
293:   if (!ok || status !== 200 || !Array.isArray(json)) return null;
294:   let lastId = null;
295:   for (const row of json) lastId = row.id ?? lastId;
296:   return lastId;
297: }
298: async function handleServiceLayerUser(username, tokenUser, tokenPass) {
299:   const instanceId = await getInstanceId();
300:   if (!instanceId) return null;
301:   const url = "http://System-DatabaseConnector.warehouseapp:3000/PostUser";
302:   const body = {
303:     SLUsername: tokenUser,
304:     SLPassword: tokenPass,
305:     instanceId,
306:     identityID: username,
307:   };
308:   const { ok } = await getWithTimeout(url, {
309:     method: "POST",
310:     headers: { "content-type": "application/json" },
311:     body: JSON.stringify(body),
312:   });
313:   return ok ? { user: tokenUser, pass: tokenPass } : null;
314: }
315: async function serviceLayerMiddleware(req, res, next) {
316:   try {
317:     const accessToken = req.oidc?.accessToken?.access_token;
318:     const tokenClaims = accessToken ? decodeJwtSafely(accessToken) : null;
319:     if (!tokenClaims) {
320:       req.serviceLayerCheck = false;
321:       return next();
322:     }
323:     const username = tokenClaims.preferred_username;
324:     const nowTimestamp = Date.now();
325:     const cachedEntry = serviceLayerCache.get(username);
326:     if (cachedEntry && cachedEntry.expiresAt > nowTimestamp) {
327:       req.serviceLayerCredentials = cachedEntry.credentials;
328:       req.serviceLayerCheck = true;
329:       return next();
330:     }
331:     const dbCreds = await lookupServiceLayerUser(username);
332:     if (dbCreds) {
333:       const credentials = {
334:         B1ServiceLayerUsername: dbCreds.user,
335:         B1ServiceLayerPassword: dbCreds.pass,
336:       };
337:       serviceLayerCache.set(username, {
338:         credentials,
339:         expiresAt: nowTimestamp + SERVICE_LAYER_CACHE_TTL_MS,
340:       });
341:       req.serviceLayerCredentials = credentials;
342:       req.serviceLayerCheck = true;
343:       return next();
344:     }
345:     const claimUsername = tokenClaims.B1ServiceLayerUsername?.[0];
346:     const claimPassword = tokenClaims.B1ServiceLayerPassword?.[0];
347:     if (!(claimUsername && claimPassword)) {
348:       req.serviceLayerCheck = false;
349:       return next();
350:     }
351:     const bootCreds = await handleServiceLayerUser(
352:       username,
353:       claimUsername,
354:       claimPassword
355:     );
356:     if (bootCreds) {
357:       const credentials = {
358:         B1ServiceLayerUsername: bootCreds.user,
359:         B1ServiceLayerPassword: bootCreds.pass,
360:       };
361:       serviceLayerCache.set(username, {
362:         credentials,
363:         expiresAt: nowTimestamp + SERVICE_LAYER_CACHE_TTL_MS,
364:       });
365:       req.serviceLayerCredentials = credentials;
366:       req.serviceLayerCheck = true;
367:       return next();
368:     }
369:     req.serviceLayerCheck = false;
370:     return next();
371:   } catch {
372:     req.serviceLayerCheck = false;
373:     return next();
374:   }
375: }
376: /* ================================
377:  * PROXY & ROUTING MOUNTING
378:  * ================================ */
379: function buildRouteProxy(routeDef) {
380:   return createProxyMiddleware({
381:     target: routeDef.proxy.target,
382:     changeOrigin: routeDef.proxy.changeOrigin,
383:     pathRewrite: routeDef.proxy.pathRewrite,
384:     logLevel: "silent",
385:     onProxyReq: (proxyReq, req, res) => {
386:       markProxyRequest(res, routeDef.proxy.target);
387:       const accessToken = req?.oidc?.accessToken?.access_token;
388:       if (accessToken) proxyReq.setHeader("Authorization", accessToken);
389:       if (req.serviceLayerCredentials)
390:         proxyReq.setHeader(
391:           "SLCredentials",
392:           JSON.stringify(req.serviceLayerCredentials)
393:         );
394:       proxyReq.setHeader(
395:         "ServiceLayerCredentials",
396:         req.serviceLayerCheck ? "true" : "false"
397:       );
398:     },
399:     onProxyRes: (_proxyRes, _req, res) => {
400:       markProxyResponse(res);
401:     },
402:     onError: (_error, _req, res) => {
403:       markProxyError(res);
404:       if (!res.headersSent) res.status(502).send("Bad Gateway");
405:     },
406:   });
407: }
408: function mountRoutesOnce() {
409:   if (runtimeState.routesMounted) return;
410:   routes.forEach((routeDef) => {
411:     const isLaunchpadRoute = routeDef.url.toLowerCase() === LAUNCHPAD_PREFIX;
412:     if (isLaunchpadRoute) {
413:       app.use(LAUNCHPAD_PATHS, requiresAuth(), buildRouteProxy(routeDef));
414:       runtimeState.mountedTargets.push({
415:         url: routeDef.url,
416:         target: routeDef.proxy.target,
417:         mode: "auth-gate",
418:       });
419:       console.info(
420:         `[proxy] mounted (launchpad + auth): ${routeDef.url} -> ${routeDef.proxy.target}`
421:       );
422:       return;
423:     }
424:     const middlewareChain = [];
425:     if (routeDef.auth) middlewareChain.push(requiresAuth());
426:     middlewareChain.push(serviceLayerMiddleware);
427:     middlewareChain.push((req, res, next) => {
428:       const claims = decodeJwtSafely(req?.oidc?.accessToken?.access_token);
429:       if (req.path.includes("Logout") && res.oidc?.logout) {
430:         return res.oidc.logout({ returnTo: "/LogoutUser" });
431:       }
432:       if (!req.serviceLayerCheck) {
433:         return redirectSafelyToLaunchpad(req, res, next);
434:       }
435:       if (claims?.WarehouseAppRoles) {
436:         const requiredRole = routeDef.url.split("/")[1].toLowerCase();
437:         const hasRole = !!claims.WarehouseAppRoles.find(
438:           (roleValue) => roleValue.split("_")[1].toLowerCase() === requiredRole
439:         );
440:         if (!hasRole) {
441:           return redirectSafelyToLaunchpad(req, res, next);
442:         }
443:       }
444:       return next();
445:     });
446:     middlewareChain.push(buildRouteProxy(routeDef));
447:     app.use(routeDef.url, ...middlewareChain);
448:     runtimeState.mountedTargets.push({
449:       url: routeDef.url,
450:       target: routeDef.proxy.target,
451:       mode: "auth+sl+roles",
452:     });
453:     console.info(
454:       `[proxy] mounted: ${routeDef.url} -> ${routeDef.proxy.target}`
455:     );
456:   });
457:   runtimeState.routesMounted = true;
458: }
459: (async () => {
460:   try {
461:     await activateReady();
462:   } catch {}
463: })();
464: https.createServer(TLS_OPTIONS, app).listen(HTTPS_PORT, () => {
465:   console.info(`nAG Warehouse App läuft auf:${HTTPS_PORT}`);
466: });
