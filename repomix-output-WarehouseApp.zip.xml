 1: const axios = require("axios");
 2: const BASE_URL = "http://System-DatabaseConnector.warehouseapp:3000";
 3: async function checkCache(req, res) {
 4:   try {
 5:     const responseCache = await axios.get(`${BASE_URL}/Cache/${req.params.documentNumber}/${req.params.module}/${req.params.tenantId}`);
 6:     if (responseCache.data.isDeleted) {
 7:       res.status(202).send(false);
 8:     } else {
 9:       res.send(responseCache.data);
10:     }
11:   } catch (missingCache) {
12:     if (missingCache.response && missingCache.response.status === 404) {
13:       res.status(209).send(false);
14:     } else {
15:       res.status(500).send(false);
16:     }
17:   }
18: }
19: async function saveCache(req, res) {
20:   try {
21:     const response = await axios.post(`${BASE_URL}/postCache`, {
22:       documentNumber: req.body.documentNumber,
23:       module: req.body.module,
24:       documentType: req.body.documentType,
25:       content: req.body.content,
26:       tenantId: req.body.tenantId,
27:       createDate: req.body.createDate,
28:       updateDate: req.body.updateDate,
29:       createdByUser: req.body.createdByUser,
30:       updatedByUser: req.body.updatedByUser,
31:       remark: req.body.remark,
32:       isDeleted: req.body.isDeleted,
33:     });
34:     if (response.status === 201) {
35:       return res.status(201).send(true);
36:     }
37:   } catch (error) {
38:     return res.status(500).send(error);
39:   }
40: }
41: async function deleteCache(req, res) {
42:   try {
43:     const response = await axios.delete(`${BASE_URL}/deleteCache/${req.params.id}`, {
44:       data: {
45:         content: req.body.content,
46:       },
47:     });
48:     if (response.status === 204) {
49:       return res.status(201).send(true);
50:     }
51:   } catch (error) {
52:     return res.status(500).send(error);
53:   }
54: }
55: async function patchCache(req, res) {
56:   try {
57:     const response = await axios.patch(`${BASE_URL}/patchCache/${req.params.id}`, {
58:       content: req.body.content,
59:       updateDate: req.body.updateDate,
60:       updatedByUser: req.body.updatedByUser,
61:     });
62:     if (response.status === 200 && response.data.length > 0) {
63:       return res.send(true);
64:     } else {
65:       return res.status(209).send(false);
66:     }
67:   } catch (error) {
68:     return res.status(500).send(error);
69:   }
70: }
71: module.exports = {
72:   checkCache,
73:   deleteCache,
74:   saveCache,
75:   patchCache,
76: };
