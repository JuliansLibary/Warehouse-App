<file path="WarehouseApp/nAG.Warehouse.App.Pack/controller/inventoryRequestController.js">
 1: const axios = require("axios");
 2: const SL = require("@nag/servicelayerconnector");
 3: const { generateBasicAuth, getError } = require("../controller/utilsController");
 4: const BASE_URL = "http://System-DatabaseConnector.warehouseapp:3000";
 5: // Function to handle posting an Inventory Request
 6: async function postInventoryRequest(req, res) {
 7:   try {
 8:     const tenantResponse = await axios.get(`${BASE_URL}/Tenant/${req.params.tenantId}`);
 9:     if (tenantResponse.status !== 200 || tenantResponse.data === "null") {
10:       return res.status(404).send("Tenant not found");
11:     }
12:     const tenant = tenantResponse.data.tenant;
13:     const detailModel = JSON.parse(req.body.detailModel);
14:     const inventoryRequest = {
15:       CardCode: detailModel.CardCode,
16:       CardName: detailModel.CardName,
17:       StockTransferLines: detailModel.PackListLines.map(line => ({
18:         LineNum: line.LineNumber,
19:         ItemCode: line.ItemCode,
20:         ItemDescription: line.ItemDescription,
21:         Quantity: line.PackedQuantity,
22:         BaseEntry: line.DocEntry,
23:         BaseLine: line.OrderRowID,
24:         BaseType: "InventoryTransferRequest",
25:         FromWarehouseCode: line.FromWarehouseCode,
26:         WarehouseCode: line.WarehouseCode,
27:         SerialNumbers: line.SerialNumbers,
28:         BatchNumbers: line.BatchNumbers,
29:       })),
30:     };
31:     const auth = await generateBasicAuth(req.headers, tenant);
32:     SL.POST(
33:       "StockTransfers",
34:       inventoryRequest,
35:       null,
36:       auth,
37:       {
38:         retryTimes: 2,
39:         retryDelay: 750,
40:         SLURL: tenant.SLURL,
41:         SLPort: tenant.SLPort,
42:       },
43:       async function (error, resp) {
44:         if (error) {
45:           res.status(error.httpStatusCode).send(await getError(error));
46:         } else {
47:           res.status(200).json(resp.value);
48:         }
49:       }
50:     );
51:   } catch (error) {
52:     res.status(500).send(`Error processing inventory request: ${error.message}`);
53:   }
54: }
55: module.exports = { postInventoryRequest };
</file>

