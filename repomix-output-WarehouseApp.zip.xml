  1: sap.ui.define(["sap/ui/model/type/Currency", "sap/ui/Device"], function (Currency, Device) {
  2:   "use strict";
  3:   return {
  4:     /**
  5:      * Rounds the currency value to 2 digits
  6:      *
  7:      * @public
  8:      * @param {string} sValue value to be formatted
  9:      * @returns {string} formatted currency value with 2 digits
 10:      */
 11:     currencyValue: function (sValue) {
 12:       if (!sValue) {
 13:         return "";
 14:       }
 15:       return parseFloat(sValue).toFixed(2);
 16:     },
 17:     /**
 18:      * Rounds the currency value to 2 digits
 19:      *
 20:      * @public
 21:      * @param {number} iQuantity product quantity
 22:      * @param {number} fPrice product price
 23:      * @param {string} sCurrencyCode currency code for the price
 24:      * @returns {string} formatted currency value with 2 digits
 25:      */
 26:     calculateItemTotal: function (iQuantity, fPrice, sCurrencyCode) {
 27:       var oCurrency = new Currency({
 28:         showMeasure: false,
 29:       }),
 30:         fTotal = iQuantity * fPrice;
 31:       return oCurrency.formatValue([fTotal.toFixed(2), sCurrencyCode], "string");
 32:     },
 33:     /**
 34:      * Converts a binary string into an image format suitable for the src attribute
 35:      *
 36:      * @public
 37:      * @param {string} vData a binary string representing the image data
 38:      * @returns {string} formatted string with image metadata based on the input or a default image when the input is empty
 39:      */
 40:     handleBinaryContent: function (vData) {
 41:       if (vData) {
 42:         var sMetaData1 = "data:image/jpeg;base64,",
 43:           sMetaData2 = vData.substr(104); // stripping the first 104 bytes from the binary data when using base64 encoding.
 44:         return sMetaData1 + sMetaData2;
 45:       } else {
 46:         return "../images/Employee.png";
 47:       }
 48:     },
 49:     concatString: function (string1, string2) {
 50:       var output = string1 + " " + string2;
 51:       return output;
 52:     },
 53:     visibleState: function (inp1, inp2) {
 54:       if (inp1 == inp2) {
 55:         return false;
 56:       } else {
 57:         return true;
 58:       }
 59:     },
 60:     // Todo check i18n
 61:     numText: function (frotendModel) {
 62:       var frontendString;
 63:       if (frotendModel.length > 0) {
 64:         frotendModel.forEach((check) => {
 65:           if (check.Check === "Batch") {
 66:             frontendString = "Chargennummern:  \n";
 67:           }
 68:           if (check.Check === "Serial") {
 69:             frontendString = "Seriennummern:  \n";
 70:           }
 71:           if (check.Check === "Bin") {
 72:             frontendString = "Lagerplätze:  \n";
 73:           }
 74:           if (frontendString.split(/\s+|\\n/).includes(check.SerialOrBatch) === false || frontendString === "") {
 75:             frontendString += check.SerialOrBatch + " \n";
 76:           }
 77:           return frontendString;
 78:         });
 79:       } else {
 80:         return "";
 81:       }
 82:     },
 83:     numCheck: function (oRequired) {
 84:       if (oRequired === "tNO" || oRequired === false) {
 85:         return false;
 86:       } else {
 87:         return true;
 88:       }
 89:     },
 90:     isEditable: function (sManageSerialNumbers, sManageBatchNumbers) {
 91:       return sManageSerialNumbers !== 'Y' && sManageBatchNumbers !== 'Y';
 92:     },
 93:     hasElements: function (aElements) {
 94:       return Array.isArray(aElements) && aElements.length > 0;
 95:     },
 96:     // Sucht im Array den Eintrag, bei dem BinActionType "batToWarehouse" ist, und gibt dessen Quantity zurück
 97:     getQuantityForWarehouse: function (aAllocations) {
 98:       if (Array.isArray(aAllocations)) {
 99:         var allocation = aAllocations.find(function (item) {
100:           return item.BinActionType === "batToWarehouse";
101:         });
102:         return allocation ? allocation.Quantity : "";
103:       }
104:       return "";
105:     },
106:     // Dynamischer Check ob ein Artikel Serien oder Chargennummern geführt ist.
107:     // Aufgrund dieses Status wird im Frontend der Input gesteuert
108:     numCheckSerialandBatch: function (batch, Serial) {
109:       if ((batch === "tNO" && Serial === "tNO") || (batch === false && Serial === false)) {
110:         return false;
111:       } else {
112:         return true;
113:       }
114:     },
115:     formatBinEntry: function (value) {
116:       return value ? value : "-";
117:     },
118:     pickStatus: function (status) {
119:       switch (status) {
120:         case "P":
121:           return sap.ui.getCore().getModel("i18n").getResourceBundle().getText("partlyPicked");
122:         case "R":
123:           return sap.ui.getCore().getModel("i18n").getResourceBundle().getText("released");
124:         case "Y":
125:           return sap.ui.getCore().getModel("i18n").getResourceBundle().getText("picked");
126:         case "D":
127:           return sap.ui.getCore().getModel("i18n").getResourceBundle().getText("partlyDelivered");
128:         case "ps_Picked":
129:           return sap.ui.getCore().getModel("i18n").getResourceBundle().getText("partlyPicked");
130:         case "ps_Released":
131:           return sap.ui.getCore().getModel("i18n").getResourceBundle().getText("released");
132:         case "ps_PartiallyDelivered":
133:           return sap.ui.getCore().getModel("i18n").getResourceBundle().getText("partlyDelivered");
134:         default:
135:           return sap.ui.getCore().getModel("i18n").getResourceBundle().getText("picked");
136:       }
137:     },
138:     pickState: function (status) {
139:       switch (status) {
140:         case "P":
141:           return sap.ui.core.ValueState.Warning;
142:         case "R":
143:           return sap.ui.core.ValueState.Error;
144:         case "Y":
145:           return sap.ui.core.ValueState.Success;
146:         case "D":
147:           return sap.ui.core.ValueState.Warning;
148:         case "ps_Picked":
149:           return sap.ui.core.ValueState.Warning;
150:         case "ps_Released":
151:           return sap.ui.core.ValueState.Error;
152:         case "ps_PartiallyDelivered":
153:           return sap.ui.core.ValueState.Warning;
154:         default:
155:           return sap.ui.core.ValueState.Success;
156:       }
157:     },
158:     serialNumText: function (statusSerial, statusBatch, serialNum, batchNum) {
159:       if (typeof serialNum !== "undefined") {
160:         return serialNum;
161:       } else if (typeof batchNum !== "undefined") {
162:         return batchNum;
163:       } else if (statusSerial === "tYES") {
164:         return sap.ui.getCore().getModel("i18n").getResourceBundle().getText("labelSerialNumbers");
165:       } else if (statusBatch === "tYES") {
166:         return sap.ui.getCore().getModel("i18n").getResourceBundle().getText("labelBatchNumber");
167:       } else {
168:         return sap.ui.getCore().getModel("i18n").getResourceBundle().getText("unmanaged");
169:         //return sap.ui.getCore().getModel("i18n").getResourceBundle().getText("noNumberRequired");
170:       }
171:     },
172:     serialNumState: function (statusSerial, statusBatch) {
173:       if (statusSerial === "tYES") {
174:         return "Error";
175:       } else if (statusBatch === "tYES") {
176:         return "Warning";
177:       } else {
178:         return "Success";
179:       }
180:     },
181:     selectQuantity: function (onHandQty, Quantity, CommitQty) {
182:       if (onHandQty !== null) {
183:         return onHandQty;
184:       } else {
185:         return Quantity - CommitQty;
186:       }
187:     },
188:     printIfNotEmpty: function (string1, string2) {
189:       if (string1 !== "" && string1 !== null && string2 !== "" && string2 !== null) {
190:         return string1 + " " + string2;
191:       } else {
192:         return "";
193:       }
194:     },
195:     isZero: function (string1) {
196:       if (string1 === 0 || string1 === "0") {
197:         return true;
198:       } else {
199:         return false;
200:       }
201:     },
202:     localDate: function (date) {
203:       var dateString = new Date(date);
204:       return dateString.toLocaleDateString(navigator.language, { year: "numeric", month: "2-digit", day: "2-digit" }) + " " + dateString.toLocaleTimeString(navigator.language, { hour: "2-digit", minute: "2-digit" });
205:     },
