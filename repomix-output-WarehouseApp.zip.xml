583:               .getData()
584:               .DocumentLines.filter((filtered) => {
585:                 return filtered.LineNum !== object.LineNum;
586:               });
587:           this.getModel("stockTransferFrontend").refresh();
588:         },
589:         // Add a new Line into Quantity Dialog
590:         // add entry into SL Object like BatchNumbers and into Table Object SerialOrBatchModel
591:         addLine: function (oEvent) {
592:           var object = oEvent
593:               .getSource()
594:               .getBindingContext("stockTransferFrontend")
595:               .getObject(),
596:             checkId,
597:             that = this;
598:           // Case if Object is Serial or Batch Number required
599:           if (object.ManageBatchNumbers === "tYES") {
600:             checkId = object.BatchNumbers.length + 1;
601:             object.BatchNumbers.push({
602:               Quantity: parseInt(
603:                 Fragment.byId("itemDetailsDialog", "PickedQuantity").getValue()
604:               ),
605:               BatchNumber: Fragment.byId(
606:                 "itemDetailsDialog",
607:                 "inpBatchNumber"
608:               ).getValue(),
609:               BaseLineNumber: object.LineNum,
610:               id: checkId,
611:             });
612:             object.SerialOrBatchModel.push({
613:               SerialorBatch: Fragment.byId(
614:                 "itemDetailsDialog",
615:                 "inpBatchNumber"
616:               ).getValue(),
617:               Quantity: parseInt(
618:                 Fragment.byId("itemDetailsDialog", "PickedQuantity").getValue()
619:               ),
620:               BinEntry: Fragment.byId(
621:                 "itemDetailsDialog",
622:                 "inpBinFrom"
623:               ).getValue(),
624:               id: checkId,
625:               Check: "Batch",
626:             });
627:           }
628:           if (object.ManageSerialNumbers === "tYES") {
629:             if (
630:               !this._checkForSerialNumber(
631:                 object.ItemCode,
632:                 Fragment.byId("itemDetailsDialog", "inpBatchNumber").getValue()
633:               )
634:             ) {
635:               checkId = object.SerialNumbers.length + 1;
636:               object.SerialNumbers.push({
637:                 Quantity: 1,
638:                 InternalSerialNumber: Fragment.byId(
639:                   "itemDetailsDialog",
640:                   "inpBatchNumber"
641:                 ).getValue(),
642:                 id: checkId,
643:               });
644:               object.SerialOrBatchModel.push({
645:                 SerialorBatch: Fragment.byId(
646:                   "itemDetailsDialog",
647:                   "inpBatchNumber"
648:                 ).getValue(),
649:                 Quantity: 1,
650:                 BinEntry: that.getModel("SessionModel").getData().DefaultBin,
651:                 id: checkId,
652:                 Check: "Serial",
653:               });
654:             } else {
655:               Fragment.byId(
656:                 "itemDetailsDialog",
657:                 "inpBatchNumber"
658:               ).setValueState("Error");
659:             }
660:           }
661:           if (
662:             this.getModel("SessionModel").getData().EnableBinLocations === true
663:           ) {
664:             if (checkId === undefined) {
665:               checkId = object.DocumentLinesBinAllocations.length + 1;
666:             }
667:             if (
668:               object.ManageSerialNumbers === "tNO" &&
669:               object.ManageBatchNumbers === "tNO"
670:             ) {
671:               object.SerialOrBatchModel.push({
672:                 SerialorBatch: "",
673:                 Quantity: parseInt(
674:                   Fragment.byId(
675:                     "itemDetailsDialog",
676:                     "PickedQuantity"
677:                   ).getValue()
678:                 ),
679:                 BinEntry: Fragment.byId(
680:                   "itemDetailsDialog",
681:                   "inpBinFrom"
682:                 ).getValue(),
683:                 id: checkId,
684:                 Check: "Bin",
685:               });
686:             }
687:             var index = -1;
688:             if (object.ManageSerialNumbers === "tYES") {
689:               index = object.SerialNumbers.length - 1;
690:             }
691:             object.DocumentLinesBinAllocations.push({
692:               BinAbsEntry: that.getModel("SessionModel").getData().DefaultBin,
693:               Quantity: parseInt(
694:                 Fragment.byId("itemDetailsDialog", "PickedQuantity").getValue()
695:               ),
696:               BaseLineNumber: object.LineNum,
697:               SerialandBatchNumberBaseLine: index,
698:               id: checkId,
699:             });
700:           }
701:           if (
702:             this.getModel("SessionModel").getData().EnableBinLocations ===
703:               false &&
704:             object.ManageBatchNumbers === "tNO" &&
705:             object.ManageSerialNumbers === "tNO"
706:           ) {
707:             object.SerialOrBatchModel.push({
708:               Quantity: parseInt(
709:                 Fragment.byId("itemDetailsDialog", "PickedQuantity").getValue()
710:               ),
711:               id: checkId,
712:               check: "No",
713:               SerialorBatch: "",
714:             });
715:           }
716:           // Last Step. Set Quantity and caluclated Quantity for Frontend model
717:           this.makeAjaxRequest(
718:             "POST",
719:             "businesslogic/CalculateQuantity",
720:             {
721:               Quantity: object,
722:             },
723:             "codeError",
724:             function (response) {
725:               object.Quantity = response.Quantity;
726:               that.getModel("stockTransferFrontend").refresh();
727:             }
728:           );
729:           // If Serial Number is yes the Value need to be a 1
730:           if (object.ManageSerialNumbers === "tYES") {
731:             Fragment.byId("itemDetailsDialog", "PickedQuantity").setValue(1);
732:           } else {
733:             Fragment.byId("itemDetailsDialog", "PickedQuantity").setValue(0);
734:           }
735:           this.getModel("stockTransferFrontend").refresh();
736:           Fragment.byId("itemDetailsDialog", "btnAddLine").setEnabled(true);
737:           // If everything is set refresh the Dialog for more Action and create the Frontend Overview
738:           this._refreshDialog(object);
739:           this._createOverview(object);
740:         },
741:         // Create a String for Frontend to Display used bin Locations / Batch or Serial Numbers
742:         _createOverview(object) {
743:           if (object.SerialOrBatchModel.length > 0) {
744:             object.SerialOrBatchModel.forEach((check) => {
745:               if (object.SerialOrBatch === "") {
746:                 if (check.Check === "Batch") {
747:                   object.SerialOrBatch =
748:                     this.getModel("i18n").getResourceBundle().getText("Batch") +
749:                     "\n ";
750:                 }
751:                 if (check.Check === "Serial") {
752:                   object.SerialOrBatch =
753:                     this.getModel("i18n")
754:                       .getResourceBundle()
755:                       .getText("Serial") + "\n ";
756:                 }
757:                 if (check.Check === "Bin") {
758:                   object.SerialOrBatch =
759:                     this.getModel("i18n").getResourceBundle().getText("Bin") +
760:                     "\n ";
761:                 }
762:               }
763:               if (
764:                 object.SerialOrBatch.split(/\s+|\\n/).includes(
765:                   check.SerialorBatch
766:                 ) === false ||
767:                 object.SerialOrBatch === ""
768:               ) {
769:                 object.SerialOrBatch += check.SerialorBatch + " \n";
770:               }
771:               return object.SerialOrBatch;
772:             });
773:           }
774:           this.getModel("stockTransferFrontend").refresh();
775:         },
776:         // Set Dialog back to Inital Stage and also Check the quantity
777:         _refreshDialog: function (object) {
778:           if (
779:             Fragment.byId("itemDetailsDialog", "inpBinFrom").getVisible() &&
780:             !Fragment.byId(
781:               "itemDetailsDialog",
782:               "inpBatchNumber"
783:             ).getVisible() &&
784:             !this.getModel("SessionModel").getData().DefaultBinEnforced
785:           ) {
786:             Fragment.byId("itemDetailsDialog", "inpBinFrom").setValue("");
787:             Fragment.byId("itemDetailsDialog", "btnAddLine").setEnabled(true);
788:           }
789:           if (
790:             Fragment.byId("itemDetailsDialog", "inpBatchNumber").getVisible()
791:           ) {
792:             Fragment.byId("itemDetailsDialog", "inpBatchNumber").setValue("");
793:             Fragment.byId("itemDetailsDialog", "btnAddLine").setEnabled(true);
794:           }
795:         },
796:         // Delete line at Quantity Dialog from SL Objects and from Table Modle
797:         // calculate Frontend String new after this
798:         removeLineFromModel: function (oEvent) {
799:           var objectTableLine = oEvent
800:             .getParameters()
801:             .listItem.getBindingContext("stockTransferFrontend")
802:             .getObject();
803:           var frontendLine = oEvent
804:             .getSource()
805:             .getBindingContext("stockTransferFrontend")
806:             .getObject();
807:           let stockTransferModel = this.getModel("stockTransferFrontend")
808:               .getData()
809:               .DocumentLines.filter((filtered) => {
810:                 return filtered === frontendLine;
811:               })[0],
812:             that = this;
813:           stockTransferModel.BatchNumbers =
814:             stockTransferModel.BatchNumbers.filter((filtered) => {
815:               return filtered.id !== objectTableLine.id;
816:             });
817:           stockTransferModel.SerialNumbers =
818:             stockTransferModel.SerialNumbers.filter((filtered) => {
819:               return filtered.id !== objectTableLine.id;
820:             });
821:           stockTransferModel.DocumentLinesBinAllocations =
822:             stockTransferModel.DocumentLinesBinAllocations.filter(
823:               (filtered) => {
824:                 return filtered.id !== objectTableLine.id;
825:               }
826:             );
827:           stockTransferModel.SerialOrBatchModel =
828:             stockTransferModel.SerialOrBatchModel.filter((filtered) => {
829:               return filtered.id !== objectTableLine.id;
830:             });
831:           this.makeAjaxRequest(
832:             "POST",
833:             "businesslogic/CalculateQuantity",
834:             {
835:               Quantity: stockTransferModel,
836:             },
837:             "codeError",
838:             function (response) {
839:               stockTransferModel.Quantity = response.Quantity;
840:               that.getModel("stockTransferFrontend").refresh();
841:             }
842:           );
843:           //  stockTransferModel.Quantity = stockTransferModel.Quantity - objectTableLine.Quantity;
844:           stockTransferModel.SerialOrBatch = "";
845:           if (
846:             stockTransferModel.calculatedQuantity ===
847:             stockTransferModel.Quantity
848:           ) {
849:             Fragment.byId("itemDetailsDialog", "btnAddLine").setEnabled(true);
850:           }
851:           this.getModel("stockTransferFrontend").refresh();
852:           this._createOverview(frontendLine);
853:         },
854:         onCreateStockTransfer: function () {
855:           var that = this;
856:           this.getDialog(that, "PrintDialog", "printDialog").then((dialog) => {
857:             dialog.setModel(
858:               this.getModel("stockTransferFrontend"),
859:               "stockTransferFrontend"
860:             );
861:             dialog.open();
862:           });
863:         },
864:         handlePrintConfirm: function (oEvent) {
865:           var object = [];
866:           var aContexts = oEvent.getParameter("selectedContexts");
867:           var that = this;
868:           aContexts.map(function (oContext) {
869:             object.push(oContext.getObject());
870:           });
871:           this.makeAjaxRequest(
872:             "POST",
873:             "businesslogic/handlePrintRequest",
874:             {
875:               printObject: object,
876:             },
877:             "codeError",
878:             function (response) {
879:               let mywindow = window.open("", "PRINT", "height=400,width=600");
880:               mywindow.document.write(response);
881:               mywindow.document.close();
882:               mywindow.focus();
883:               var text = that
884:                 .getModel("i18n")
885:                 .getResourceBundle()
886:                 .getText("Label");
887:               sap.m.MessageBox.success(text, {
888:                 actions: [
889:                   that.getModel("i18n").getResourceBundle().getText("Continue"),
890:                   that.getModel("i18n").getResourceBundle().getText("Break"),
891:                 ],
892:                 onClose: function (sAction) {
893:                   switch (sAction) {
894:                     case that
895:                       .getModel("i18n")
896:                       .getResourceBundle()
897:                       .getText("Continue"):
898:                       that.onCreateStockTransfer();
899:                       break;
900:                     case that
901:                       .getModel("i18n")
902:                       .getResourceBundle()
903:                       .getText("Break"):
904:                       that._onCreateStockTransfer();
905:                       break;
906:                   }
907:                 },
908:               });
909:             }
910:           );
911:         },
912:         // Post a Stock Transfer
913:         _onCreateStockTransfer: function () {
914:           var that = this;
915:           that.oEventBus.publish("nAG", "showBusyDialog");
916:           this.makeAjaxRequest(
917:             "POST",
918:             "businesslogic/PurchaseDeliveryNotes/" + this.getUrlVars().Tenant,
919:             {
920:               transferModel: JSON.stringify(
921:                 this.getModel("stockTransferFrontend").getData()
922:               ),
923:             },
924:             "postStockTransferError",
925:             function (response) {
926:               that.oEventBus.publish("nAG", "hideBusyDialog");
927:               var text = that
928:                 .getMessage("deliveryCreated")
929:                 .replace("@DocNum", response.DocNum);
930:               MessageBox.success(text, {
931:                 onClose: function () {
932:                   that.onPressClose();
933:                   that.oEventBus.publish("nAG", "hideBusyDialog");
934:                 },
935:               });
936:             }
937:           );
938:         },
939:       }
940:     );
941:   }
942: );
