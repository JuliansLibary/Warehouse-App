120: /**
121: /**
122:  * formats the Response from ServiceLayer for Frontend
123:  * Gets called if the PickListView does not exist
124:  * @param {json} picklist
125:  * @param {json} picklistsCache
126:  * @param {json} remarkList
127:  */
128: function formatPickListsForResponse(pickList, pickListCacheString, remarkList, documentLockString) {
129:   return new Promise((resolve, reject) => {
130:     try {
131:       const response = [];
132:       const mySet = new Set();
133:       const absEntrySet = new Set();
134:       pickList.forEach((picklist) => {
135:         if (!mySet.has(picklist.OrderEntry) && !absEntrySet.has(picklist.Absoluteentry)) {
136:           let hasEntry = false;
137:           try {
138:             hasEntry = JSON.parse(pickListCacheString).some((element) => element.documentNumber === picklist.Absoluteentry && !element.isDeleted);
139:           } catch (error) {
140:             console.error(error);
141:             hasEntry = false;
142:           }
143:           const remarkElement = remarkList.find((element) => element.AbsEntry === picklist.Absoluteentry);
144:           const remark = remarkElement ? remarkElement.Remarks : "";
145:           let isLocked = false;
146:           try {
147:             const currentDate = new Date();
148:             isLocked = JSON.parse(documentLockString).some((element) => element.documentNumber === picklist.Absoluteentry && new Date(Date.parse(element.latestChangeDate)).getTime() + parseInt(global.gConfig.documentLockTimer) * 60000 >= currentDate.getTime());
149:           } catch (error) {
150:             console.error(error);
151:             isLocked = false;
152:           }
153:           response.push({
154:             AbsoluteEntry: picklist.Absoluteentry,
155:             Status: picklist.Status,
156:             Name: picklist.Name,
157:             PickDate: picklist.PickDate,
158:             Remarks: remark,
159:             OrderEntry: picklist.OrderEntry,
160:             WarehouseCode: picklist.WhsCode,
161:             BaseObjectType: picklist.BaseObject,
162:             PickListsFromOrder: [picklist.Absoluteentry],
163:             isMultiPickList: "false",
164:             isCached: hasEntry,
165:             isLocked: isLocked,
166:           });
167:           mySet.add(picklist.OrderEntry);
168:           absEntrySet.add(picklist.Absoluteentry);
169:         } else {
170:           const orderIndex = response.findIndex((picklistEntry) => picklistEntry.OrderEntry === picklist.OrderEntry);
171:           if (orderIndex !== -1) {
172:             response[orderIndex].PickListsFromOrder.push(picklist.Absoluteentry);
173:           }
174:           if (absEntrySet.has(picklist.Absoluteentry)) {
175:             const absEntryIndex = response.findIndex((picklistEntry) => picklistEntry.AbsoluteEntry === picklist.Absoluteentry);
176:             if (absEntryIndex !== -1) {
177:               response[absEntryIndex].isMultiPickList = "true";
178:             }
179:           }
180:         }
181:       });
182:       resolve(response.sort((a, b) => parseInt(b.AbsoluteEntry) - parseInt(a.AbsoluteEntry)));
183:     } catch (error) {
184:       reject(error);
185:     }
186:   });
187: }
188: function mergeSplitPicking(picklist) {
189:   return new Promise((resolve, reject) => {
190:     try {
191:       // Create a new Picklist Object
192:       const newPickList = {
193:         Absoluteentry: picklist.Absoluteentry,
194:         Name: picklist.Name,
195:         PickDate: picklist.PickDate,
196:         Remarks: picklist.Remarks,
197:         OrderEntry: picklist.OrderEntry,
198:         PickListsLines: [],
199:       };
200:       // Search for Index in newPicklist Model.
201:       // If value exists recalculate Quantity
202:       // Else add whole Line
203:       picklist.PickListsLines.forEach((picklistline) => {
204:         const index = newPickList.PickListsLines.findIndex((pickline) => pickline.LineNumber === picklistline.LineNumber && pickline.AbsoluteEntry === picklistline.AbsoluteEntry);
205:         if (index >= 0) {
206:           const existingLine = newPickList.PickListsLines[index];
207:           existingLine.PickedQuantity += picklistline.PickedQuantity;
208:           existingLine.TempSplitQuantityAndBinModel.push({
209:             BinAbs: picklistline.BinAbs,
210:             Quantity: picklistline.PicklistQuantity,
211:           });
212:           if (Array.isArray(picklistline.DocumentLinesBinAllocations)) {
213:             picklistline.DocumentLinesBinAllocations.forEach((binAllocations) => {
214:               existingLine.DocumentLinesBinAllocations.push({
215:                 BinAbsEntry: binAllocations.BinAbsEntry,
216:                 Quantity: binAllocations.Quantity,
217:               });
218:             });
219:           }
220:           if (Array.isArray(picklistline.BatchNumbers)) {
221:             picklistline.BatchNumbers.forEach((batchLine) => {
222:               existingLine.BatchNumbers.push({
223:                 BinAbs: batchLine.BinAbs,
224:                 BatchNumber: batchLine.DistNumber,
225:                 Quantity: batchLine.Quantity,
226:               });
227:             });
228:           }
229:           if (Array.isArray(picklistline.SerialNumbers)) {
230:             picklistline.SerialNumbers.forEach((serialLine) => {
231:               existingLine.SerialNumbers.push({
232:                 InternalSerialNumber: serialLine.SerialNumber,
233:                 Quantity: serialLine.Quantity,
234:               });
235:             });
236:           }
237:         } else {
238:           newPickList.PickListsLines.push({
239:             AbsoluteEntry: picklistline.AbsoluteEntry,
240:             BaseObjectType: picklistline.BaseObjectType,
241:             BatchNumbers: picklistline.BatchNumbers,
242:             ItemCode: picklistline.ItemCode,
243:             LineNumber: picklistline.LineNumber,
244:             OrderEntry: picklistline.OrderEntry,
245:             OrderRowID: picklistline.OrderRowID,
246:             PickedQuantity: picklistline.PickedQuantity,
247:             SerialNumbers: picklistline.SerialNumbers,
248:             ReleasedQuantity: picklistline.ReleasedQuantity,
249:             DocumentLinesBinAllocations: picklistline.DocumentLinesBinAllocations,
250:             TempSplitQuantityAndBinModel: [
251:               {
252:                 BinAbs: picklistline.BinAbs,
253:                 Quantity: picklistline.PicklistQuantity,
254:               },
255:             ],
256:           });
257:         }
258:       });
259:       resolve(newPickList);
260:     } catch (error) {
261:       reject(error);
262:     }
263:   });
264: }
