 351: // expand deliveryNote to include all Lines from Order
 352: async function getDeliveryNoteLikeOrders(deliveryNote, packplatz, baseOrders) {
 353:   // Sortiere die DocumentLines im deliveryNote nach BaseEntry und BaseLine
 354:   deliveryNote.DocumentLines.sort((a, b) => (
 355:     a.BaseEntry > b.BaseEntry || (a.BaseEntry == b.BaseEntry && a.BaseLine > b.BaseLine) ? 1 : -1
 356:   ));
 357:   // Initialisiere zusätzliche Ausgaben und spezielle Zeilen
 358:   deliveryNote.DocumentAdditionalExpenses = [];
 359:   baseOrders.forEach((baseOrder) => {
 360:     // Kopiere UDFs (benutzerdefinierte Felder) vom baseOrder zum deliveryNote
 361:     const udfs = Object.keys(baseOrder).filter((key) => key.includes("U_"));
 362:     udfs.forEach((key) => {
 363:       if (!deliveryNote[key]) {
 364:         deliveryNote[key] = baseOrder[key];
 365:         if (key === "U_NAG_Packplatz") {
 366:           deliveryNote["U_NAG_Packplatz"] = packplatz;
 367:         }
 368:       }
 369:     });
 370:     // Kopiere zusätzliche Ausgaben von baseOrder zu deliveryNote
 371:     baseOrder.DocumentAdditionalExpenses.forEach((expense, idx) => {
 372:       deliveryNote.DocumentAdditionalExpenses.push({
 373:         BaseDocEntry: baseOrder.DocEntry,
 374:         BaseDocLine: baseOrder.DocumentAdditionalExpenses[idx].LineNum,
 375:         BaseDocType: baseOrder.BaseType,
 376:       });
 377:     });
 378:     // Spezielle Zeilen und Erweiterungen zuweisen, falls diese im deliveryNote noch nicht gesetzt sind
 379:     if (!deliveryNote.DocumentSpecialLines) {
 380:       deliveryNote.DocumentSpecialLines = [...baseOrder.DocumentSpecialLines];
 381:     } else {
 382:       deliveryNote.DocumentSpecialLines.push(...baseOrder.DocumentSpecialLines);
 383:     }
 384:     if (!deliveryNote.AddressExtension) {
 385:       deliveryNote.AddressExtension = baseOrder.AddressExtension;
 386:     }
 387:     if (!deliveryNote.TaxExtension) {
 388:       deliveryNote.TaxExtension = baseOrder.TaxExtension;
 389:     }
 390:     // Zeilen von baseOrder zu deliveryNote hinzufügen oder aktualisieren
 391:     baseOrder.DocumentLines.forEach((baseOrderLine, baseOrderIndex) => {
 392:       let headItem = {
 393:         ItemCode: baseOrderLine.ItemCode,
 394:         TreeType: baseOrderLine.TreeType,
 395:         Quantity: 0,
 396:         BaseEntry: baseOrderLine.DocEntry,
 397:         BaseLine: baseOrderLine.LineNum,
 398:         BaseType: baseOrderLine.BaseType,
 399:         BaseVisualOrder: baseOrderLine.VisualOrder,
 400:         DocumentLineAdditionalExpenses: baseOrderLine.DocumentLineAdditionalExpenses,
 401:       };
 402:       // UDFs für die Zeilen festlegen
 403:       const lineUdfs = Object.keys(baseOrderLine).filter((key) => key.includes("U_"));
 404:       lineUdfs.forEach((key) => (headItem[key] = baseOrderLine[key]));
 405:       // Bedingungen zum Einfügen oder Aktualisieren von Zeilen in DocumentLines
 406:       if (baseOrderIndex >= deliveryNote.DocumentLines.length ||
 407:         (baseOrderLine.LineNum < parseInt(deliveryNote.DocumentLines[baseOrderIndex].BaseLine) &&
 408:           baseOrderLine.DocEntry === deliveryNote.DocumentLines[baseOrderIndex].BaseEntry)) {
 409:         deliveryNote.DocumentLines.splice(baseOrderIndex, 0, headItem);
 410:       } else if (baseOrderLine.LineNum === parseInt(deliveryNote.DocumentLines[baseOrderIndex].BaseLine) &&
 411:         baseOrderLine.DocEntry === deliveryNote.DocumentLines[baseOrderIndex].BaseEntry) {
 412:         // Aktualisiere bestehende Zeilen
 413:         deliveryNote.DocumentLines[baseOrderIndex].BaseVisualOrder = baseOrderLine.VisualOrder;
 414:         deliveryNote.DocumentLines[baseOrderIndex].DocumentLineAdditionalExpenses = baseOrderLine.DocumentLineAdditionalExpenses;
 415:         lineUdfs.forEach((key) => {
 416:           deliveryNote.DocumentLines[baseOrderIndex][key] = baseOrderLine[key];
 417:         });
 418:       } else {
 419:         // Durchlaufe das Dokument und füge Zeilen an der passenden Stelle ein
 420:         let insertIndex = null;
 421:         deliveryNote.DocumentLines.forEach((deliveryLine, deliveryLineIndex) => {
 422:           if (parseInt(deliveryLine.BaseEntry) === parseInt(baseOrderLine.DocEntry) &&
 423:             parseInt(deliveryLine.BaseLine) > parseInt(baseOrderLine.LineNum) &&
 424:             insertIndex === null) {
 425:             insertIndex = deliveryLineIndex;
 426:           }
 427:         });
 428:         if (insertIndex !== null) {
 429:           deliveryNote.DocumentLines.splice(insertIndex, 0, headItem);
 430:         }
 431:       }
 432:     });
 433:   });
 434:   // Rückgabe des aktualisierten deliveryNote
 435:   return deliveryNote;
 436: }
