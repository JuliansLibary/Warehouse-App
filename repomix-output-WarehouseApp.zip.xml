151: /**
152:  * Get translated message
153:  * @param {string} key - Message key
154:  * @param {string} language - Language code ('en' or 'de')
155:  * @param {Array} params - Parameters for message formatting
156:  * @returns {string} Translated message
157:  */
158: function getMessage(key, language = 'en', params = []) {
159:   const messages = language === 'de' ? DE_MESSAGES : EN_MESSAGES;
160:   let message = messages[key] || EN_MESSAGES[key] || key;
161:   // Replace parameters {0}, {1}, etc.
162:   if (params && params.length > 0) {
163:     params.forEach((param, index) => {
164:       message = message.replace(`{${index}}`, param);
165:     });
166:   }
167:   return message;
168: }
169: /**
170:  * Get language from request headers or default to 'en'
171:  * @param {Object} req - Express request object
172:  * @returns {string} Language code
173:  */
174: function getLanguageFromRequest(req) {
175:   const acceptLanguage = req.headers['accept-language'] || '';
176:   if (acceptLanguage.includes('de')) return 'de';
177:   return 'en';
178: }
179: /**
180:  * Create response with i18n message
181:  * @param {string} messageKey - Message key
182:  * @param {string} language - Language code
183:  * @param {Array} params - Parameters for message formatting
184:  * @param {number} code - HTTP status code
185:  * @returns {Object} Response object
186:  */
187: function createI18nResponse(messageKey, language = 'en', params = [], code = 200) {
188:   return {
189:     message: getMessage(messageKey, language, params),
190:     code,
191:     messageKey,
192:     language
193:   };
194: }
195: /**
196:  * Create error response with i18n message
197:  * @param {string} messageKey - Message key
198:  * @param {string} language - Language code  
199:  * @param {Array} params - Parameters for message formatting
200:  * @param {number} code - HTTP status code (default 500)
201:  * @param {string} error - Technical error message
202:  * @returns {Object} Error response object
203:  */
204: function createI18nErrorResponse(messageKey, language = 'en', params = [], code = 500, error = null) {
205:   const response = {
206:     message: getMessage(messageKey, language, params),
207:     code,
208:     messageKey,
209:     language
210:   };
211:   if (error) {
212:     response.error = error;
213:   }
214:   return response;
215: }
216: module.exports = {
217:   getMessage,
218:   getLanguageFromRequest,
219:   createI18nResponse,
220:   createI18nErrorResponse,
221:   EN_MESSAGES,
222:   DE_MESSAGES
223: };
</file>

<file path="WarehouseApp/nAG.Warehouse.App.Pack/utils/i18nResponse.js">
 1: /**
 2:  * I18N RESPONSE FACTORY
 3:  * ====================
 4:  * Clean, typed response factory for backend controllers with i18n support
 5:  */
 6: // Message key constants to avoid typos
 7: const MESSAGE_KEYS = {
 8:   // Generic
 9:   GENERIC_ERROR: 'errorGeneral',
10:   INVALID_REQUEST: 'invalidRequest', 
11:   MISSING_DATA: 'missingRequiredData',
12:   // Validation
13:   PACK_LIST_REQUIRED: 'packListDataRequired',
14:   MODEL_DATA_REQUIRED: 'modelDataRequired',
15:   ITEM_DATA_REQUIRED: 'itemDataAndQuantityRequired',
16:   QUANTITY_POSITIVE: 'quantityMustBeGreaterThanZero',
17:   // Serial Numbers
18:   SERIAL_REQUIRED: 'serialNumberRequired',
19:   SERIAL_VALID: 'serialNumberIsValid',
20:   MIN_ONE_SERIAL: 'minOneSerialNumberRequired',
21:   // Operations
22:   PACK_LINE_SUCCESS: 'packLineProcessedSuccess',
23:   MODEL_SYNC_SUCCESS: 'modelSynchronizedSuccess'
24: };
25: /**
26:  * Get user language from request headers
27:  */
28: function getLanguageFromRequest(req) {
29:   const acceptLanguage = req.headers['accept-language'] || '';
30:   return acceptLanguage.includes('de') ? 'de' : 'en';
31: }
32: /**
33:  * Create success response with i18n
34:  */
35: function createSuccessResponse(messageKey, data = {}, language = 'en') {
36:   return {
37:     success: true,
38:     messageKey,
39:     language,
40:     ...data
41:   };
42: }
43: /**
44:  * Create error response with i18n  
45:  */
46: function createErrorResponse(messageKey, statusCode = 500, language = 'en', technicalError = null) {
47:   const response = {
48:     success: false,
49:     messageKey,
50:     code: statusCode,
51:     language
52:   };
53:   if (technicalError && process.env.NODE_ENV === 'development') {
54:     response.technicalError = technicalError;
55:   }
56:   return response;
57: }
58: /**
59:  * Send success response
60:  */
61: function sendSuccess(res, messageKey, data = {}, statusCode = 200) {
62:   const language = getLanguageFromRequest(res.req);
63:   res.status(statusCode).json(createSuccessResponse(messageKey, data, language));
64: }
65: /**
66:  * Send error response
67:  */
68: function sendError(res, messageKey, statusCode = 500, technicalError = null) {
69:   const language = getLanguageFromRequest(res.req);
70:   res.status(statusCode).json(createErrorResponse(messageKey, statusCode, language, technicalError));
71: }
72: /**
73:  * Validation helper with automatic error response
74:  */
75: function validateRequired(res, checks) {
76:   for (const [value, messageKey] of checks) {
77:     if (!value) {
78:       sendError(res, messageKey, 400);
79:       return false;
80:     }
81:   }
82:   return true;
83: }
84: module.exports = {
85:   MESSAGE_KEYS,
86:   getLanguageFromRequest,
87:   createSuccessResponse,
88:   createErrorResponse,
89:   sendSuccess,
90:   sendError,
91:   validateRequired
92: };
</file>

