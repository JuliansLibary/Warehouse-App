2456:         const foundInSession = currentSessionSerials.some((serial) => {
2457:           const serialNum = serial.DistNumber || serial.SerialNumber;
2458:           const manufacturerSerialNum = serial.ManufacturerSerialNumber || serial.InternalSerialNumber;
2459:           return serialNum === sSerialNumber || manufacturerSerialNum === sSerialNumber;
