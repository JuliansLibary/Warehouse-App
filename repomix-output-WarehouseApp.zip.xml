 33: /**
 34:  * Validate input quantities against business rules
 35:  * @param {Object} req - Express request object
 36:  * @param {Object} res - Express response object
 37:  */
 38: async function validatePackingInput(req, res) {
 39:   try {
 40:     const language = getLanguageFromRequest(req);
 41:     const { itemData, requestedQuantity, deliveryData } = req.body;
 42:     if (!itemData || typeof requestedQuantity !== 'number') {
 43:       return res.status(400).send({
 44:         isValid: false,
 45:         error: "INVALID_INPUT",
 46:         ...createI18nErrorResponse('itemDataAndQuantityRequired', language, [], 400)
 47:       });
 48:     }
 49:     // MIGRATED FROM FRONTEND: _validatePackingOperation complete logic
 50:     let currentlyPacked = 0;
 51:     if (deliveryData && deliveryData.Package) {
 52:       deliveryData.Package.forEach(pkg => {
 53:         if (pkg.DeliveryLines) {
 54:           pkg.DeliveryLines.forEach(line => {
 55:             if (isMatchingItem(line, itemData)) {
 56:               if (itemData.ManageSerialNumbers === "Y") {
 57:                 // For serial-managed items, count serial numbers
 58:                 currentlyPacked += (line.SerialNumbers?.length || 0);
 59:               } else {
 60:                 // For non-serial items, sum PackedQuantity
 61:                 currentlyPacked += (line.PackedQuantity || 0);
 62:               }
 63:             }
 64:           });
 65:         }
 66:       });
 67:     }
 68:     const totalPicked = itemData.PickedQuantity || 0;
 69:     const remaining = totalPicked - currentlyPacked;
 70:     // COMPLETE VALIDATION RULES FROM FRONTEND
 71:     if (requestedQuantity < 0) {
 72:       return res.status(400).send({
 73:         isValid: false,
 74:         error: "NEGATIVE_QUANTITY",
 75:         message: getMessage("quantityMustBeGreaterThanZero", language),
 76:         allowedQuantity: 0
 77:       });
 78:     }
 79:     if (requestedQuantity > remaining) {
 80:       return res.status(400).send({
 81:         isValid: false,
 82:         error: "OVERPACK_ATTEMPT", 
 83:         message: `Nur noch ${remaining} von ${totalPicked} können verpackt werden`,
 84:         allowedQuantity: remaining,
 85:         totalPicked,
 86:         currentlyPacked,
 87:         remaining
 88:       });
 89:     }
 90:     // Additional business rule: Check if item is complete
 91:     if (!itemData.ItemCode || !itemData.ItemDescription) {
 92:       return res.status(400).send({
 93:         isValid: false,
 94:         error: "INCOMPLETE_ITEM_INFO",
 95:         message: getMessage("incompleteItemInformation", language)
 96:       });
 97:     }
 98:     res.send({
 99:       isValid: true,
100:       allowedQuantity: requestedQuantity,
101:       remainingAfterPack: remaining - requestedQuantity,
102:       totalPicked,
103:       currentlyPacked,
104:       remaining,
105:       canPackMore: (remaining - requestedQuantity) > 0
106:     });
107:   } catch (error) {
108:     const language = getLanguageFromRequest(req);
109:     res.status(500).send(createI18nErrorResponse('errorValidatingPackingInput', language, [], 500, error.message));
110:   }
