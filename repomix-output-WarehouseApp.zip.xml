 10: >
 11: 	<App>
 12: 		<s:SemanticPage showFooter="true">
 13: 			<s:titleHeading>
 14: 				<Title
 15: 					text="{=${SessionModel>/BaseType} === 18 ? ${i18n>titlePurchaseInvoices} : ${i18n>titlePurchaseOrders}} {purchaseOrderModel>/DocNum} {
 16: 						parts: [{
 17: 							path: 'i18n>Reference'
 18: 						}, {
 19: 							path: 'purchaseOrderModel>/NumAtCard'
 20: 						}],
 21: 						formatter: '.formatter.printIfNotEmpty'
 22: 					} {SessionModel>/WarehouseName}"
 23: 					id="title0"
 24: 					wrapping="true"
 25: 				/>
 26: 			</s:titleHeading>
 27: 			<s:closeAction>
 28: 				<s:CloseAction
 29: 					tooltip="{i18n>closeAction}"
 30: 					id="claDetail"
 31: 					press="onPressClose"
 32: 				/>
 33: 			</s:closeAction>
 34: 			<s:footerCustomActions>
 35: 				<Button
 36: 					text="{i18n>addComment}"
 37: 					press="onAddComment"
 38: 				/>
 39: 				<Button
 40: 					text="{i18n>addImage}"
 41: 					activeIcon=""
 42: 					press="OpenFragment"
 43: 					width=""
 44: 				/>
 45: 			</s:footerCustomActions>
 46: 			<s:positiveAction>
 47: 				<s:PositiveAction
 48: 					text="{i18n>CreateDelivery}"
 49: 					id="action0"
 50: 					press="onCreateDelivery"
 51: 				/>
 52: 			</s:positiveAction>
 53: 			<s:content>
 54: 				<t:TreeTable
 55: 					class="testClass"
 56: 					id="treeTable"
 57: 					visibleRowCountMode="Auto"
 58: 					cellClick="onDeleteRow"
 59: 					selectionMode="None"
 60: 					selectionBehavior="RowOnly"
 61: 					rows="{
 62: 						path: 'purchaseDeliveryNoteModel>/DeliveryLines/',
 63: 						sorter: {
 64: 							path: 'NodeID'
 65: 						},
 66: 						parameters: {
 67: 							countMode: 'Inline',
 68: 							treeAnnotationProperties: {
 69: 								hierarchyLevelFor: 'HierarchyLevel',
 70: 								hierarchyNodeFor: 'NodeID',
 71: 								hierarchyParentNodeFor: 'ParentNodeId',
 72: 								hierarchyDrillStateFor: 'DrillState'
 73: 							}
 74: 						}
 75: 					}"
 76: 				>
 77: 					<t:extension>
 78: 						<OverflowToolbar style="Clear">
 79: 							<Button
 80: 								class="Button_packScan"
 81: 								type="Emphasized"
 82: 								press="packScan"
 83: 								id="btnPackScan"
 84: 								icon="sap-icon://bar-code"
 85: 								text="{i18n>packScan}"
 86: 								enabled="{buttonModel>/buttonsEnabled}"
 87: 							/>
 88: 						</OverflowToolbar>
 89: 					</t:extension>
 90: 					<t:columns>
 91: 						<t:Column
 92: 							label="{i18n>ItemCode}"
 93: 							autoResizable="true"
 94: 						>
 95: 							<t:template>
 96: 								<VBox alignItems="Start">
 97: 									<items>
 98: 										<HBox
 99: 											id="Clickable_Hbox"
100: 											visible="{=${purchaseDeliveryNoteModel>isScanned} === 'false' ? false : true}"
101: 										>
102: 											<core:Icon
103: 												class="IconTreeTable"
104: 												src="sap-icon://sap-box"
105: 												visible="{=${purchaseDeliveryNoteModel>_id} >= 1 ? true : false}"
106: 											/>
107: 											<Text
108: 												class="textTreeTable"
109: 												text="{purchaseDeliveryNoteModel>ItemCode}"
110: 												wrapping="true"
111: 												textAlign="Begin"
112: 											/>
113: 										</HBox>
114: 										<HBox visible="{=${purchaseDeliveryNoteModel>isScanned} === 'false' ? false : true}">
115: 											<Text
116: 												text="{purchaseDeliveryNoteModel>ItemDescription}"
117: 												wrapping="true"
118: 												textAlign="Begin"
119: 												visible="{=${purchaseDeliveryNoteModel>_id} >= 1 ? false : true}"
120: 											/>
121: 										</HBox>
122: 									</items>
123: 								</VBox>
124: 							</t:template>
125: 						</t:Column>
126: 						<t:Column
127: 							label="{i18n>RequiredQuantity}"
128: 							width="9%"
129: 						>
130: 							<t:template>
131: 								<HBox visible="{=${purchaseDeliveryNoteModel>isScanned} === 'false' ? false : true}">
132: 									<Text
133: 										text="{purchaseDeliveryNoteModel>openQuantity} / {purchaseDeliveryNoteModel>Quantity}"
134: 										wrapping="false"
135: 									/>
136: 								</HBox>
137: 							</t:template>
138: 						</t:Column>
139: 						<t:Column
140: 							label="{i18n>PrintQuantity}"
141: 							width="18%"
142: 							hAlign="Center"
143: 						>
144: 							<t:template>
145: 								<HBox visible="{=${purchaseDeliveryNoteModel>isScanned} === 'false' ? false : true}">
146: 									<Input
147: 										value="{purchaseDeliveryNoteModel>printQuantity}"
148: 										type="Number"
149: 									/>
150: 								</HBox>
151: 							</t:template>
152: 						</t:Column>
153: 						<t:Column
154: 							label="{i18n>defaultBinLocation}"
155: 							width="18%"
156: 						>
157: 							<t:template>
158: 								<HBox>
159: 									<Text text="{purchaseDeliveryNoteModel>DefaultBinLocation}" />
160: 								</HBox>
161: 							</t:template>
162: 						</t:Column>
163: 					</t:columns>
164: 				</t:TreeTable>
165: 			</s:content>
166: 		</s:SemanticPage>
167: 	</App>
168: </mvc:View>
</file>

<file path="WarehouseApp/nAG.Warehouse.App.PurchaseDeliveryNote/webapp/view/PurchaseOrders.view.xml">
 1: <mvc:View xmlns:core="sap.ui.core"
 2:   xmlns:mvc="sap.ui.core.mvc"
 3:   xmlns="sap.m"
 4:   xmlns:s="sap.f.semantic"
 5:   xmlns:layout="sap.ui.layout"
 6:   xmlns:html="http://www.w3.org/1999/xhtml" controllerName="nAG.PurchaseDeliveryNote.controller.PurchaseOrders"
 7:   xmlns:customData="http://schemas.sap.com/sapui5/extension/sap.ui.core.CustomData/1">
 8:   <s:SemanticPage id="pageMaster">
 9:     <s:titleHeading>
10:       <Title xmlns="sap.m" text="{i18n>titleMaster}" id="ttlMaster" />
11:     </s:titleHeading>
12:     <s:titleCustomTextActions>
13:       <Button icon="sap-icon://home" press="onLogout" type="Transparent" class="myGhostButton"/>
14:     </s:titleCustomTextActions>
15:     <s:content>
16:       <List noDataText=" {i18n>NoDataPurchaseOrders}" id="lstMaster" itemPress="onItemPressed" mode="SingleSelectMaster" items="{
17: 					path: 'MasterModel>/',
18: 					groupHeaderFactory: '.createGroupHeader'
19: 				}">
20:         <items>
21:           <ObjectListItem icon="{=${MasterModel>BaseType} === 18 ? 'sap-icon://expense-report' : 'sap-icon://timesheet'}" type="Active" title="{=${MasterModel>BaseType} === 18 ? ${i18n>titlePurchaseInvoices} : ${i18n>titlePurchaseOrders}} {MasterModel>DocNum} " id="itmMaster" intro="{MasterModel>Comments}" number="{
22: 							path: 'MasterModel>DocDueDate'
23: 						}">
24:             <attributes>
25:               <ObjectAttribute text="{
26: 									parts: [{
27: 										path: 'i18n>Reference'
28: 									}, {
29: 										path: 'MasterModel>NumAtCard'
30: 									}],
31: 									formatter: '.formatter.printIfNotEmpty'
32: 								}" id="numAtCard" />
33:               <ObjectAttribute text="{MasterModel>CardName}" id="attCardName" />
34:             </attributes>
35:             <firstStatus>
36:               <ObjectStatus class="sapUiSmallMarginBottom" text="{i18n>deleteIntermediateState}" active="true" visible="{MasterModel>isCached}" state="Information" customData:AbsoluteEntry="{MasterModel>DocNum}" press="handleStatusPressed" icon="sap-icon://delete" />
37:             </firstStatus>
38:             <markers>
39:               <ObjectMarker visibility="IconOnly" type="Locked" visible="{MasterModel>isLocked}" />
40:             </markers>
41:           </ObjectListItem>
42:         </items>
43:         <headerToolbar>
44:           <OverflowToolbar width="100%" id="tlb3">
45:             <SearchField id="sfd" tooltip="{i18n>masterSearchTooltip}" width="100%" search="onSearch">
46:               <layoutData>
47:                 <OverflowToolbarLayoutData minWidth="150px" maxWidth="2000px" shrinkable="true" priority="NeverOverflow" />
48:               </layoutData>
49:             </SearchField>
50:             <Button id="btnSort" press="onOpenViewSettings" icon="sap-icon://sort" type="Transparent" />
51:             <Button id="btnFilter" press="onOpenViewSettings" icon="sap-icon://filter" type="Transparent" />
52:             <Button id="btnGroup" press="onOpenViewSettings" icon="sap-icon://group-2" type="Transparent" />
53:             <Button id="btnonGroupBySupplierer" text="{i18n>groupBySupplier}" press="onGroupBySupplierer" icon="sap-icon://group" type="Transparent" />
54:             <Button id="refreshButton" icon="sap-icon://refresh" type="Transparent" tooltip="{i18n>refresh}" press="_updateModel" />
55:           </OverflowToolbar>
56:         </headerToolbar>
57:       </List>
58:     </s:content>
59:   </s:SemanticPage>
60: </mvc:View>
</file>

