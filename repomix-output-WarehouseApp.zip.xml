250:      * @public
251:      */
252:     showBusyDialog: function () {
253:       this.getDebugMode();
254:       const busyDialog = this.busyDialog;
255:       busyDialog.open();
256:       // Simple focus removal - only remove focus border, keep dialog functional
257:       setTimeout(() => {
258:         if (busyDialog && busyDialog.getDomRef()) {
259:           const domRef = busyDialog.getDomRef();
260:           if (domRef) {
261:             // Remove focus but don't break the dialog
262:             domRef.blur();
263:             // Remove focus classes that SAP might add
264:             domRef.classList.remove("sapMFocused");
265:             // If document focus is on the dialog, move it away
266:             if (document.activeElement && domRef.contains(document.activeElement)) {
267:               document.activeElement.blur();
268:             }
269:           }
