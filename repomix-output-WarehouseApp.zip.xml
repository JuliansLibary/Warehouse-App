<file path="WarehouseApp/nAG.Warehouse.App.DatabaseConnector/app.ts">
 1: import express from "express";
 2: import bodyParser from "body-parser";
 3: import { Request, Response } from "express";
 4: import morgan from "morgan";
 5: import { Routes } from "./routes";
 6: import { validationResult } from "express-validator";
 7: // Define a function to handle errors and send an appropriate response.
 8: function handleError(err, _req, res) {
 9:   res.status(err.statusCode || 500).send(err.message);
10: }
11: // Create an instance of the Express application.
12: const app = express();
13: // Use the 'tiny' format for request logging with Morgan middleware.
14: app.use(morgan("tiny"));
15: app.use(
16:   bodyParser.urlencoded({
17:     limit: "100mb",
18:     extended: true,
19:   })
20: );
21: app.use(
22:   bodyParser.json({
23:     limit: "100mb",
24:     extended: true,
25:   })
26: );
27: // Parse JSON request bodies using body-parser middleware.
28: app.use(bodyParser.json());
29: // configure the app to use bodyParser()
30: // Iterate through defined routes and set up route handlers with validation.
31: Routes.forEach((route) => {
32:   app[route.method](
33:     route.route,
34:     ...route.validation,
35:     async (req: Request, res: Response, next: () => void) => {
36:       try {
37:         // Validate incoming request data using express-validator.
38:         const errors = validationResult(req);
39:         if (!errors.isEmpty()) {
40:           return res.status(400).json({ errors: errors.array() });
41:         }
42:         // Invoke the appropriate controller action for the route.
43:         const result = await new route.controller()[route.action](
44:           req,
45:           res,
46:           next
47:         );
48:         res.json(result);
49:       } catch (err) {
50:         next();
51:       }
52:     }
53:   );
54: });
55: // Define a simple test route.
56: app.get("/test", async (req, res) => {
57:   res.json({ test: "yes" });
58: });
59: // Use the handleError function to catch and handle errors globally.
60: app.use(handleError);
61: export default app;
</file>

