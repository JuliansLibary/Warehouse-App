<file path="WarehouseApp/nAG.Warehouse.App.StockTransfer/middleware/configCheck.js">
 1: const http = require("http");
 2: async function configCheck(req, res, next) {
 3:   try {
 4:     const result = await getConfiguration("StockTransfer", req.headers.referer);
 5:     if (result === 200) {
 6:       next(); // Proceed to the route handler
 7:     } else if (result === 403 || result === 404 || result === 423) {
 8:       res.sendStatus(result); // Send the appropriate status if configuration fails
 9:     }
10:   } catch (error) {
11:     // Handle any unexpected errors (e.g., if getConfiguration throws an error)
12:     console.error(error);
13:     res.sendStatus(500);
14:   }
15: }
16: function getConfiguration(module, headers) {
17:   return new Promise((resolve, reject) => {
18:     // Extract tenant from headers
19:     const url = new URL(headers);
20:     const tenant = url.searchParams.get("Tenant");
21:     const configUrl = `http://Module-AdminPanel.warehouseapp:8005/databaseConfiguration/configurationForModule/${module}/${tenant}`;
22:     if (!tenant && !headers.includes("worker")) {
23:       return reject(new Error("Tenant not found in headers"));
24:     } else if (!tenant && headers.includes("worker")) {
25:       resolve(200);
26:     }
27:     http
28:       .get(configUrl, (response) => {
29:         let rawData = "";
30:         // Collect data chunks
31:         response.on("data", (chunk) => {
32:           rawData += chunk;
33:         });
34:         // Process data after the end of the response
35:         response.on("end", () => {
36:           try {
37:             if (response.statusCode === 423) {
38:               return resolve(response.statusCode);
39:             }
40:             // Parse JSON response
41:             const parsedData = JSON.parse(rawData);
42:             // Update global configuration if available
43:             if (parsedData.conf_config && parsedData.conf_config !== "{}") {
44:               const config = JSON.parse(parsedData.conf_config.replace(/\\/g, ""));
45:               Object.entries(config).forEach(([key, value]) => {
46:                 global.gConfig[key] = value;
47:               });
48:             }
49:             resolve(response.statusCode);
50:           } catch (e) {
51:             reject(new Error(`Failed to parse configuration data: ${e.message}`));
52:           }
53:         });
54:       })
55:       .on("error", (e) => {
56:         reject(new Error(`Request error: ${e.message}`));
57:       });
58:   });
59: }
60: module.exports = configCheck;
</file>

