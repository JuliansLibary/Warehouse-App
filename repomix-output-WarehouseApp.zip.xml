150:         return this.getView().getModel(sName);
151:       },
152:       getMessage: function (i18nInfo) {
153:         return this.getModel("i18n").getResourceBundle().getText(i18nInfo);
154:       },
155:       getAppConfig: function () {
156:         let that = this,
157:           pickmode = null,
158:           listmode = null;
159:         $.ajax({
160:           url: "tenant/getAppConfig",
161:           crossDomain: true,
162:           type: "GET",
163:           dataType: "json",
164:           success: function (data) {
165:             if (data.singlePick) {
166:               pickmode = "Single";
167:             } else {
168:               pickmode = "Multi";
169:             }
170:             if (data.onlyScan) {
171:               listmode = "Inactive";
172:             } else {
173:               listmode = "Active";
174:             }
175:             that.getViewModel("appView").setProperty("/pickMode", pickmode);
176:             that.getViewModel("appView").setProperty("/listMode", listmode);
177:             // Check if Launchpad is a Parameter at Configuration
178:             if (data.launchpad) {
179:               that
180:                 .getViewModel("appView")
181:                 .setProperty("/launchpad", data.launchpad);
182:             }
183:             if (data.mergePickLists) {
184:               that
185:                 .getViewModel("appView")
186:                 .setProperty("/mergePickLists", data.mergePickLists);
187:             }
188:             if (data.minimumScanQuantity) {
189:               that
190:                 .getViewModel("appView")
191:                 .setProperty("/minimumScanQuantity", data.minimumScanQuantity);
192:             }
193:             // Check if defaultBin is set for Items
194:             if (data.enforceDefaultBin) {
195:               that
196:                 .getViewModel("appView")
197:                 .setProperty("/enforceDefaultBin", data.enforceDefaultBin);
198:             }
199:             if (data.isDeleted) {
200:               that
201:                 .getViewModel("appView")
202:                 .setProperty("/isDeleted", data.isDeleted);
203:             }
204:             if (typeof data.saveInterval !== "undefined") {
205:               that.getViewModel("appView").setProperty("/saveInterval", data.saveInterval);
206:             }
207:             if (typeof data.documentLockTimer !== "undefined") {
208:               that
209:                 .getViewModel("appView")
210:                 .setProperty("/documentLockTimer", data.documentLockTimer);
211:             }
212:             if (typeof data.masterDataInterval !== "undefined") {
213:               that
214:                 .getViewModel("appView")
215:                 .setProperty("/masterDataInterval", data.masterDataInterval);
216:             }
217:           },
218:           error: function (jqXHR) {
219:             that.showError(
220:               { message: jqXHR.responseJSON.error.message.value, helpUrl: null },
221:               jqXHR.responseJSON.error.code
222:             );
223:           },
224:         });
225:       },
226:       getUrlVars: function () {
227:         const vars = {};
228:         window.location.href.replace(
229:           /[?&]+([^=&]+)=([^&#]*)/gi,
230:           function (m, key, value) {
231:             vars[key] = value;
232:           }
233:         );
234:         return vars;
235:       },
236:       makeAjaxRequest: function (method, url, postContent, callback) {
237:         const that = this;
238:         // Prepare request configuration
239:         const ajaxConfig = {
240:           url: url,
241:           xhrFields: {
242:             withCredentials: true,
243:           },
244:           crossDomain: true,
245:           type: method,
246:           tryCount: 0,
247:           retryLimit: 3,
248:           headers: {
249:             prefer: "odata.maxpagesize=0",
250:           },
251:           success: function (response) {
252:             callback(response);
253:           },
254:           error: function (jqXHR, textStatus) {
255:             const Language = that.getUrlVars().Language
256:             if (textStatus === "timeout") {
257:               ajaxConfig.tryCount++;
258:               if (ajaxConfig.tryCount <= ajaxConfig.retryLimit) {
259:                 $.ajax(ajaxConfig);
260:                 return;
261:               } else {
262:                 that.showError({ message: "NetworkError", helpUrl: null }, "9000");
263:               }
264:             }
265:             if (
266:               typeof jqXHR.responseText !== "undefined" &&
267:               jqXHR.status !== "undefined"
268:             ) {
269:               that.showError(that.findTranslation(jqXHR.responseJSON, Language), jqXHR.status);
270:             } else {
271:               that.showError(that.findTranslation(jqXHR.responseJSON, Language), 400);
272:             }
273:           },
274:         };
275:         // Handle POST/PATCH/PUT requests with data
276:         if (postContent && (method === "POST" || method === "PATCH" || method === "PUT")) {
277:           ajaxConfig.data = postContent;
278:           ajaxConfig.contentType = "application/json";
279:           // Don't let jQuery process the data if it's already a JSON string
280:           if (typeof postContent === "string") {
281:             ajaxConfig.processData = false;
282:           }
283:         }
284:         $.ajax(ajaxConfig);
285:       },
286:       findTranslation: function (json, languageCode) {
287:         let response;
288:         if (json.body.helpUrl) {
289:           response = {
290:             message: "",
291:             helpUrl: json.body.helpUrl || null
292:           };
293:         } else {
294:           response = {
295:             message: "",
296:           }
297:         }
298:         if (json.body.translations && json.body.translations.length > 0) {
299:           const translation = json.body.translations.find(translationFind => translationFind.language === languageCode);
300:           if (translation) {
301:             response.message = translation.text;
302:           }
303:         }
304:         if (!response.message && json.body.message) {
305:           response.message = json.body.message;
306:         }
307:         return response;
308:       },
309:     });
310:   }
311: );
