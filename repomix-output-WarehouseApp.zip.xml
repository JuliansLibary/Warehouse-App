<file path="WarehouseApp/nAG.Warehouse.App.SalesOrderDelivery/webapp/model/formatter.js">
 1: sap.ui.define(["sap/ui/model/type/Currency", "sap/ui/Device"], function (Currency, Device) {
 2:   "use strict";
 3:   return {
 4:     pickStatus: function (status) {
 5:       switch (status) {
 6:         case "tYES":
 7:           return sap.ui.getCore().getModel("i18n").getResourceBundle().getText("completeQuantity");
 8:         case "tNO":
 9:           return sap.ui.getCore().getModel("i18n").getResourceBundle().getText("partlyQuantity");
10:         default:
11:           return sap.ui.getCore().getModel("i18n").getResourceBundle().getText("completeQuantity");
12:       }
13:     },
14:     pickState: function (status) {
15:       switch (status) {
16:         case "tYES":
17:           return sap.ui.core.ValueState.Success;
18:         case "tNO":
19:           return sap.ui.core.ValueState.Warning;
20:         default:
21:           return sap.ui.core.ValueState.Success;
22:       }
23:     },
24:     serialNumText: function (statusSerial, statusBatch, serialNum, batchNum) {
25:       if (typeof serialNum !== "undefined") {
26:         return serialNum;
27:       } else if (typeof batchNum !== "undefined") {
28:         return batchNum;
29:       } else if (statusSerial === "tYES") {
30:         return sap.ui.getCore().getModel("i18n").getResourceBundle().getText("serialNumberRequired");
31:       } else if (statusBatch === "tYES") {
32:         return sap.ui.getCore().getModel("i18n").getResourceBundle().getText("batchNumberRequired");
33:       } else {
34:         return sap.ui.getCore().getModel("i18n").getResourceBundle().getText("unmanaged");
35:         //return sap.ui.getCore().getModel("i18n").getResourceBundle().getText("noNumberRequired");
36:       }
37:     },
38:     serialNumState: function (statusSerial, statusBatch) {
39:       if (statusSerial === "tYES") {
40:         return "Error";
41:       } else if (statusBatch === "tYES") {
42:         return "Warning";
43:       } else {
44:         return "Success";
45:       }
46:     },
47:     currencyValue: function (sValue) {
48:       if (!sValue) {
49:         return "";
50:       }
51:       return parseFloat(sValue).toFixed(2);
52:     },
53:     visibleState: function (inp2) {
54:       if (inp2 === 0) {
55:         return false;
56:       } else {
57:         return true;
58:       }
59:     },
60:   };
61: });
</file>

