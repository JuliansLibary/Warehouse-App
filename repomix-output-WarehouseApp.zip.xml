15: function getConfiguration(module, headers) {
16:   return new Promise((resolve, reject) => {
17:     // Extract tenant from headers
18:     const url = new URL(headers);
19:     const tenant = url.searchParams.get("Tenant");
20:     const configUrl = `http://Module-AdminPanel.warehouseapp:8005/databaseConfiguration/configurationForModule/${module}/${tenant}`;
21:     if (!tenant && !headers.includes("worker")) {
22:       return reject(new Error("Tenant not found in headers"));
23:     } else if (!tenant && headers.includes("worker")) {
24:       resolve(200);
25:     }
26:     http
27:       .get(configUrl, (response) => {
28:         let rawData = "";
29:         // Collect data chunks
30:         response.on("data", (chunk) => {
31:           rawData += chunk;
32:         });
33:         // Process data after the end of the response
34:         response.on("end", () => {
35:           try {
36:             if (response.statusCode === 423) {
37:               return resolve(response.statusCode);
38:             }
39:             // Parse JSON response
40:             const parsedData = JSON.parse(rawData);
41:             // Update global configuration if available
42:             if (parsedData.conf_config && parsedData.conf_config !== "{}") {
43:               const config = JSON.parse(parsedData.conf_config.replace(/\\/g, ""));
44:               Object.entries(config).forEach(([key, value]) => {
45:                 global.gConfig[key] = value;
46:               });
47:             }
48:             resolve(response.statusCode);
49:           } catch (e) {
50:             reject(new Error(`Failed to parse configuration data: ${e.message}`));
51:           }
52:         });
53:       })
54:       .on("error", (e) => {
55:         reject(new Error(`Request error: ${e.message}`));
56:       });
57:   });
58: }
59: module.exports = configCheck;
