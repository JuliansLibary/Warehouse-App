# ──────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and adjust values for your environment.
# docker-compose picks up .env automatically from the project root.
# The .env file already ships with safe defaults – you only need to
# change passwords for production deployments.
# ──────────────────────────────────────────────────────────────────────────────

# ── PostgreSQL ────────────────────────────────────────────────────────────────
# Password for the 'warehouse' DB user (shared by app DB + Keycloak DB)
POSTGRES_PASSWORD=change_me_in_production

# ── Keycloak Admin ────────────────────────────────────────────────────────────
KC_ADMIN=admin
KC_ADMIN_PASSWORD=change_me_in_production

# ── Keycloak Hostname ─────────────────────────────────────────────────────────
# Set to your server's public hostname when deploying remotely.
KC_HOSTNAME=localhost

# ── Frontend Build Args ────────────────────────────────────────────────────────
# Baked into the static JS bundle at build time by Vite.
# In production Keycloak is proxied through nginx at /auth,
# and the API is proxied at /api – no change needed unless deploying
# to a non-root path.
VITE_KEYCLOAK_URL=/auth
VITE_KEYCLOAK_REALM=warehouse
VITE_KEYCLOAK_CLIENT=warehouse-app
VITE_API_URL=/api

# ── Extra CORS origin (optional) ─────────────────────────────────────────────
# CORS_EXTRA_ORIGIN=https://your-domain.com

# ── Azure Container Registry (CI/CD) ─────────────────────────────────────────
# Set these as pipeline variables in Azure DevOps, not in this file.
# ACR_NAME=myregistry
# ACR_SERVICE_CONN=my-azure-service-connection
