# ──────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# docker-compose picks up .env automatically from the project root.
# ──────────────────────────────────────────────────────────────────────────────

# ── PostgreSQL ─────────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=change_me_in_production

# ── Keycloak ────────────────────────────────────────────────────────────────────
# Realm URL that the backend validates JWT tokens against.
# When running via docker-compose: http://keycloak:8180/realms/warehouse
# From the browser / nginx:        https://<host>/auth/realms/warehouse
KEYCLOAK_AUTHORITY=http://keycloak:8180/realms/warehouse

# Keycloak admin credentials (used to bootstrap the admin console)
KC_ADMIN=admin
KC_ADMIN_PASSWORD=change_me_in_production

# Public hostname Keycloak advertises (needed for token issuer validation)
KC_HOSTNAME=localhost
KC_HOSTNAME_PORT=443

# ── Backend CORS ────────────────────────────────────────────────────────────────
# Extra allowed origin in addition to https://localhost
CORS_EXTRA_ORIGIN=http://localhost:3000

# ── Azure Container Registry (CI/CD) ───────────────────────────────────────────
# Set these as pipeline variables in Azure DevOps, not here.
# ACR_NAME=myregistry
# ACR_SERVICE_CONN=my-azure-service-connection
